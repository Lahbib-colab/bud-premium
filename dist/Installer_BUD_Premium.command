cat << 'EOF_BUDSTORAGE_SWIFT' > "$SRC_DIR/BudStorage.swift"
import Cocoa

// ═══════════════════════════════════════════════════════════
//  Stockage interne et externe
// ═══════════════════════════════════════════════════════════

struct VolumeInfo {
    let url: URL
    let name: String
    let total: Int64
    let free: Int64
    let isInternal: Bool
    let isRemovable: Bool
    let isBoot: Bool

    var used: Int64 { max(0, total - free) }
    var usedRatio: Double { total > 0 ? Double(used) / Double(total) : 0 }
    var freePercent: Int { total > 0 ? Int((Double(free) / Double(total)) * 100.0) : 0 }
    var icon: String {
        if isBoot { return "internaldrive.fill" }
        if isRemovable { return "externaldrive.fill" }
        return isInternal ? "internaldrive" : "externaldrive.connected.to.line.below"
    }
    var tag: String {
        if isBoot { return "Démarrage" }
        if isRemovable { return "Externe" }
        return isInternal ? "Interne" : "Réseau"
    }
}

func scanVolumes() -> [VolumeInfo] {
    let keys: [URLResourceKey] = [.volumeNameKey, .volumeTotalCapacityKey,
                                  .volumeAvailableCapacityForImportantUsageKey,
                                  .volumeAvailableCapacityKey,
                                  .volumeIsRemovableKey, .volumeIsEjectableKey,
                                  .volumeIsInternalKey, .volumeIsBrowsableKey]
    let fm = FileManager.default
    guard let urls = fm.mountedVolumeURLs(includingResourceValuesForKeys: keys,
                                          options: [.skipHiddenVolumes]) else { return [] }
    var out: [VolumeInfo] = []
    for u in urls {
        guard let v = try? u.resourceValues(forKeys: Set(keys)) else { continue }
        guard v.volumeIsBrowsable ?? true else { continue }
        let total = Int64(v.volumeTotalCapacity ?? 0)
        guard total > 0 else { continue }
        let free = v.volumeAvailableCapacityForImportantUsage ?? Int64(v.volumeAvailableCapacity ?? 0)
        let removable = (v.volumeIsRemovable ?? false) || (v.volumeIsEjectable ?? false)
        out.append(VolumeInfo(url: u,
                              name: v.volumeName ?? u.lastPathComponent,
                              total: total,
                              free: max(0, free),
                              isInternal: (v.volumeIsInternal ?? false) && !removable,
                              isRemovable: removable,
                              isBoot: u.path == "/"))
    }
    return out.sorted { a, b in
        if a.isBoot != b.isBoot { return a.isBoot }
        if a.isInternal != b.isInternal { return a.isInternal }
        return a.name.localizedCaseInsensitiveCompare(b.name) == .orderedAscending
    }
}

func bootVolume() -> VolumeInfo? {
    let v = scanVolumes()
    return v.first { $0.isBoot } ?? v.first
}

final class StoragePanelView: NSView {

    private let hero: HeroHeader
    private let ring = GaugeRing(frame: .zero)
    private var tileFree: StatTile!, tileUsed: StatTile!, tileTotal: StatTile!, tileCount: StatTile!
    private var vitalCpu: NSTextField!, vitalMem: NSTextField!, vitalUp: NSTextField!
    private let scroll = NSScrollView(frame: .zero)
    private let listHost = NSView(frame: .zero)
    private var rowViews: [NSView] = []

    var onEject: ((String) -> Void)?

    override init(frame: NSRect) {
        hero = HeroHeader(frame: NSRect(x: 0, y: frame.height - 92, width: frame.width, height: 92),
                          title: "Stockage", subtitle: "Vos disques internes et externes, en un coup d'œil.")
        super.init(frame: frame)
        build()
    }
    required init?(coder: NSCoder) { fatalError() }

    private func build() {
        let W = bounds.width, H = bounds.height
        addSubview(hero)

        ring.frame = NSRect(x: W - 116, y: H - 86, width: 80, height: 80)
        addSubview(ring)

        let gap: CGFloat = 12
        let tw = (W - gap * 3) / 4
        let ty = H - 184
        tileFree  = StatTile(frame: NSRect(x: 0, y: ty, width: tw, height: 78), caption: "Libre")
        tileUsed  = StatTile(frame: NSRect(x: tw + gap, y: ty, width: tw, height: 78), caption: "Occupé")
        tileTotal = StatTile(frame: NSRect(x: (tw + gap) * 2, y: ty, width: tw, height: 78), caption: "Capacité")
        tileCount = StatTile(frame: NSRect(x: (tw + gap) * 3, y: ty, width: tw, height: 78), caption: "Volumes")
        [tileFree, tileUsed, tileTotal, tileCount].forEach { addSubview($0) }

        mkSection(self, H - 208, W, "Volumes")

        scroll.frame = NSRect(x: 0, y: 96, width: W, height: H - 312)
        scroll.hasVerticalScroller = true
        scroll.drawsBackground = false
        scroll.borderType = .noBorder
        scroll.autohidesScrollers = true
        scroll.scrollerStyle = .overlay
        scroll.documentView = listHost
        addSubview(scroll)

        // Constantes du Mac
        let cw = (W - 24) / 3
        vitalCpu = mkStatRow(self, 52, 0, cw, "cpu", "CPU")
        vitalMem = mkStatRow(self, 52, cw + 12, cw, "memorychip", "RAM")
        vitalUp  = mkStatRow(self, 52, (cw + 12) * 2, cw, "clock.arrow.circlepath", "Veille")

        let b1 = GlassButton(frame: NSRect(x: 0, y: 0, width: cw, height: 40),
                             title: "Actualiser", icon: "arrow.clockwise")
        b1.onClick = { [weak self] _ in self?.refresh(animated: true) }
        let b2 = GlassButton(frame: NSRect(x: cw + 12, y: 0, width: cw, height: 40),
                             title: "Volumes", icon: "folder.fill")
        b2.onClick = { _ in NSWorkspace.shared.open(URL(fileURLWithPath: "/Volumes")) }
        let b3 = GlassButton(frame: NSRect(x: (cw + 12) * 2, y: 0, width: cw, height: 40),
                             title: "Tout éjecter", icon: "eject.fill")
        b3.onClick = { [weak self] _ in
            guard let s = self else { return }
            s.onEject?(s.ejectAll())
        }
        [b1, b2, b3].forEach { addSubview($0) }
    }

    func stepRing() { ring.step() }

    /// Le seuil d'alerte, en pourcentage de place libre. Posé par
    /// l'application : relire le fichier d'état à chaque rafraîchissement,
    /// et pour chaque volume, serait payer un accès disque pour un entier.
    var lowThreshold: Int = 10

    func refresh(animated: Bool = false) {
        let vols = scanVolumes()

        if let boot = vols.first(where: { $0.isBoot }) ?? vols.first {
            let pct = Int((boot.usedRatio * 100).rounded())
            // L'anneau prend la couleur de l'alerte : un disque plein doit
            // se voir sans avoir à lire le chiffre.
            let low = lowThreshold
            ring.tint = boot.freePercent <= max(5, low / 2) ? dangerColor
                      : (boot.freePercent <= low ? warnColor : nil)
            ring.set(pct, caption: "occupé", animated: animated)
            tileFree.set(formatBytes(boot.free), hint: "\(boot.freePercent) % encore libres")
            tileUsed.set(formatBytes(boot.used), hint: "\(pct) % du disque")
            tileTotal.set(formatBytes(boot.total), hint: "disque de démarrage")
            // Le seuil d'alerte est celui réglé par l'utilisateur, pas un 10
            // en dur : afficher « disque saturé » à 10 % alors qu'on a
            // demandé d'être prévenu à 25 serait ignorer le réglage.
            let seuil = lowThreshold
            if boot.freePercent <= seuil {
                hero.trailingTint = boot.freePercent <= max(5, seuil / 2) ? dangerColor : warnColor
                hero.set(subtitle: "\(boot.name) · \(formatBytes(boot.free)) encore disponibles",
                         trailing: "\(boot.freePercent) % libres")
            } else {
                hero.trailingTint = nil
                hero.set(subtitle: "\(boot.name) · \(formatBytes(boot.free)) encore disponibles",
                         trailing: "")
            }
        }
        let ext = vols.filter { !$0.isBoot }.count
        tileCount.set("\(vols.count)", hint: ext == 0 ? "aucun volume externe" : "\(ext) en plus du démarrage")

        rowViews.forEach { $0.removeFromSuperview() }
        rowViews.removeAll()
        ThemeRegistry.shared.prune()

        let rowH: CGFloat = 64
        let W = scroll.bounds.width - 6
        let totalH = max(scroll.bounds.height, CGFloat(vols.count) * rowH)
        listHost.frame = NSRect(x: 0, y: 0, width: W, height: totalH)

        for (i, v) in vols.enumerated() {
            let y = totalH - CGFloat(i + 1) * rowH + 6
            let row = mkCard(listHost, NSRect(x: 0, y: y, width: W, height: rowH - 10), radius: 12)
            rowViews.append(row)
            let rh = row.bounds.height           // 54

            // Colonne droite : pourcentage puis bouton, largeurs mesurées
            let pctTxt = "\(Int((v.usedRatio * 100).rounded())) %"
            let pctW = textWidth(pctTxt, size: 14, weight: .bold, mono: true) + 10
            let ejectable = v.isRemovable || (!v.isInternal && !v.isBoot)
            let btnTitle = ejectable ? "Éjecter" : "Ouvrir"
            let btnW = max(74, textWidth(btnTitle, size: 11.5, weight: .semibold) + 26)
            // Garde-fou de mise en page. « 100 % » est plus large que « 7 % » :
            // sur un disque presque plein, la colonne de droite grossit, et
            // sans ce plancher la barre de progression recevait une largeur
            // négative et le nom passait sous le pourcentage. C'est le défaut
            // d'affichage qu'on voyait précisément quand le stockage était bas.
            let rightEdge = max(150, W - 12 - btnW - 10 - pctW)

            // Ligne 1 : icône, nom, étiquette de type
            let iv = mkIcon(row, v.icon, x: 13, y: rh - 22, size: 15, alpha: 0.6)
            if v.isRemovable { iv.contentTintColor = TH.accent }

            let tagW = textWidth(v.tag, size: 9.5, weight: .semibold) + 16
            // L'étiquette de type cède la place avant le nom : mieux vaut
            // savoir quel volume c'est que de quel genre il est.
            let roomForTag = rightEdge - 38 - 14 - 90 > tagW
            let nameMax = max(70, rightEdge - 38 - (roomForTag ? tagW : 0) - 14)
            var name = v.name
            if textWidth(name, size: 12.5, weight: .semibold) > nameMax {
                while name.count > 4 && textWidth(name + "…", size: 12.5, weight: .semibold) > nameMax {
                    name.removeLast()
                }
                name += "…"
            }
            let nameW = textWidth(name, size: 12.5, weight: .semibold) + 10
            row.addSubview(mkLabel(name, NSRect(x: 37, y: rh - 22, width: nameW, height: 18), 12.5, .semibold))

            if roomForTag && 37 + nameW + 4 + tagW <= rightEdge - 6 {
                let tagRect = NSRect(x: 37 + nameW + 4, y: rh - 21, width: tagW, height: 16)
                let tagView = mkCard(row, tagRect, radius: 8, alpha: 0.09)
                tagView.addSubview(mkLabel(v.tag, NSRect(x: 0, y: 0, width: tagW, height: 14),
                                           9.5, .semibold, alpha: 0.55, .center))
            }

            // Ligne 2 : barre puis volumétrie, bien séparées du nom
            let bar = ProgressBar(frame: NSRect(x: 37, y: 23, width: max(40, rightEdge - 45), height: 5))
            bar.value = CGFloat(v.usedRatio)
            bar.tint = v.freePercent <= 10 ? dangerColor : (v.freePercent <= 20 ? warnColor : nil)
            row.addSubview(bar)

            let detail = "\(formatBytes(v.free)) libres sur \(formatBytes(v.total))"
            row.addSubview(mkLabel(detail, NSRect(x: 37, y: 3, width: max(40, rightEdge - 45), height: 15),
                                   10.5, .regular, alpha: 0.5))

            let pctLabel = mkLabel(pctTxt, NSRect(x: rightEdge, y: rh / 2 - 9, width: pctW, height: 19),
                                   14, .bold, alpha: 1, .right, mono: true)
            if v.freePercent <= 10 { pctLabel.textColor = dangerColor }
            else if v.freePercent <= 20 { pctLabel.textColor = warnColor }
            row.addSubview(pctLabel)

            let action = GlassButton(frame: NSRect(x: W - 12 - btnW, y: rh / 2 - 16, width: btnW, height: 32),
                                     title: btnTitle, compact: true)
            let url = v.url
            if ejectable {
                action.onClick = { [weak self] _ in self?.eject(url) }
            } else {
                action.onClick = { _ in NSWorkspace.shared.open(url) }
            }
            row.addSubview(action)
        }

        var l = [Double](repeating: 0, count: 3)
        getloadavg(&l, 3)
        vitalCpu.stringValue = String(format: "%.2f", l[0])
        let m = memoryStats()
        vitalMem.stringValue = m.total > 0 ? String(format: "%.1f Go", m.used / 1_073_741_824) : "—"
        vitalUp.stringValue = formatUptime(ProcessInfo.processInfo.systemUptime)
    }

    /// Éjecte tous les volumes amovibles ou réseau. Renvoie un compte rendu.
    @discardableResult
    func ejectAll() -> String {
        let candidates = scanVolumes().filter { !$0.isBoot && ($0.isRemovable || !$0.isInternal) }
        guard !candidates.isEmpty else { return "Aucun disque externe monté." }
        var done: [String] = []
        var failed: [String] = []
        for v in candidates {
            do {
                try NSWorkspace.shared.unmountAndEjectDevice(at: v.url)
                done.append(v.name)
            } catch {
                failed.append(v.name)
            }
        }
        refresh()
        if done.isEmpty { return "Éjection refusée : \(failed.joined(separator: ", ")) est encore utilisé." }
        var msg = "Éjecté : \(done.joined(separator: ", "))"
        if !failed.isEmpty { msg += " · encore occupé : \(failed.joined(separator: ", "))" }
        return msg
    }

    private func eject(_ url: URL) {
        do {
            try NSWorkspace.shared.unmountAndEjectDevice(at: url)
            onEject?("\(url.lastPathComponent) éjecté proprement")
        } catch {
            onEject?("Impossible d'éjecter \(url.lastPathComponent)")
        }
        refresh()
    }
}
EOF_BUDSTORAGE_SWIFT

cat << 'EOF_BUDTOOLS_SWIFT' > "$SRC_DIR/BudTools.swift"
import Cocoa
import ImageIO

// ═══════════════════════════════════════════════════════════
//  Les outils du chat
//
//  L'onglet Outils a disparu : ses boutons vivent maintenant
//  dans le chat, derrière une pilule. Un outil est une action
//  en un clic — capture, veille, verrouillage, un agent du
//  Flux — que BUD exécute et dont il rend compte dans le fil.
//
//  Le partage des rôles :
//    • `BudTool` décrit un outil et sait l'exécuter ;
//    • `BudToolManager` les range, les retrouve à partir d'une
//      phrase du chat, et pilote l'expression de BUDs ;
//    • le chat, lui, présente : la confirmation, la bulle qui
//      tourne, la bulle du résultat.
//
//  Ajouter un outil, c'est écrire un `BudTool` et l'inscrire
//  dans `BudToolCatalog.registerDefaults` : la pilule, le menu,
//  la reconnaissance dans le chat et les expressions suivent.
// ═══════════════════════════════════════════════════════════

/// Le niveau de prudence avant d'exécuter.
enum ToolRisk: Equatable {
    /// Exécuté au clic.
    case none
    /// Une question, un bouton : pour l'irréversible.
    case confirm(String)
    /// Un compte à rebours annulable : pour ce qui interrompt le travail
    /// mais ne détruit rien, comme la veille.
    case countdown(Int)
}

enum ToolCategory: Int, CaseIterable {
    case capture, system, agents, more
    var title: String {
        switch self {
        case .capture: return "CAPTURE"
        case .system:  return "SYSTÈME"
        case .agents:  return "AGENTS"
        case .more:    return "PLUS"
        }
    }
}

/// Ce qu'un outil rend. Le chat en fait une bulle.
struct ToolOutcome {
    var ok: Bool
    var text: String
    /// Une miniature à montrer dans la bulle.
    var image: NSImage? = nil
    /// Un geste au clic sur la bulle : révéler la capture, ouvrir les
    /// réglages d'autorisation, ouvrir le Flux…
    var tapLabel: String? = nil
    var tap: (() -> Void)? = nil
    /// L'expression de BUDs. `nil` : celle par défaut (content ou déçu).
    var expression: BudExpression? = nil
    /// Vrai quand l'outil a déjà réglé l'expression lui-même — un agent
    /// du Flux le fait, et le doubler ferait sauter le visage.
    var expressionHandled = false

    static func cancelled(_ why: String = "Annulé.") -> ToolOutcome {
        ToolOutcome(ok: true, text: why, expression: .neutral)
    }
}

/// Ce que l'application prête aux outils. Les outils n'ont pas accès à
/// `BudApp` : ils reçoivent ces quelques gestes, et rien d'autre.
struct ToolHost {
    /// Replie le panneau et l'encoche, pour que BUD ne figure pas sur la
    /// capture.
    var hidePanel: () -> Void = {}
    /// Les ramène, sur l'onglet Chat.
    var showChat: () -> Void = {}
    var openTab: (String) -> Void = { _ in }
    var lockScreen: () -> String = { "" }
    var setAppearance: (String) -> String = { _ in "" }
    var emptyTrash: (@escaping (String) -> Void) -> Void = { _ in }
    var openKeyboardShortcuts: () -> Void = {}
    var battery: () -> String = { "" }
    var network: () -> String = { "" }
}

final class BudTool {
    let id: String
    let title: String
    let subtitle: String
    let icon: String
    let tint: NSColor
    let category: ToolCategory
    let risk: ToolRisk
    /// Les tournures du chat qui le déclenchent, sans accents ni
    /// ponctuation. La plus longue qui correspond l'emporte : « capture la
    /// fenêtre » bat « capture ».
    let phrases: [String]
    /// Libellé de la bulle pendant le travail.
    let working: String
    private let body: (@escaping (String) -> Void, @escaping (ToolOutcome) -> Void) -> Void

    /// `body` reçoit une fonction d'avancement et la fonction de fin ; il
    /// peut appeler la fin de n'importe quel fil.
    init(id: String, title: String, subtitle: String, icon: String, tint: NSColor,
         category: ToolCategory, risk: ToolRisk = .none, phrases: [String] = [],
         working: String = "Un instant…",
         body: @escaping (@escaping (String) -> Void, @escaping (ToolOutcome) -> Void) -> Void) {
        self.id = id; self.title = title; self.subtitle = subtitle; self.icon = icon
        self.tint = tint; self.category = category; self.risk = risk
        self.phrases = phrases; self.working = working; self.body = body
    }

    fileprivate func execute(progress: @escaping (String) -> Void, done: @escaping (ToolOutcome) -> Void) {
        body(progress, done)
    }
}

// ═══════════════════════════════════════════════════════════
//  Le gestionnaire
// ═══════════════════════════════════════════════════════════

final class BudToolManager {
    static let shared = BudToolManager()

    private(set) var tools: [BudTool] = []
    private var running = Set<String>()
    var host = ToolHost()
    /// Le même chemin que les agents : bureau, encoche et Flux ensemble.
    var onExpression: ((BudExpression, TimeInterval) -> Void)?

    func register(_ t: BudTool) {
        tools.removeAll { $0.id == t.id }
        tools.append(t)
    }

    func tool(_ id: String) -> BudTool? { tools.first { $0.id == id } }

    func tools(in c: ToolCategory) -> [BudTool] { tools.filter { $0.category == c } }

    func isRunning(_ id: String) -> Bool { running.contains(id) }

    /// Minuscules, sans accents, ponctuation remplacée par des espaces :
    /// « Mets le Mac en veille ! » → « mets le mac en veille ».
    static func normalize(_ s: String) -> String {
        let f = s.folding(options: [.diacriticInsensitive, .caseInsensitive], locale: Locale(identifier: "fr_FR"))
        let cleaned = f.unicodeScalars.map { CharacterSet.alphanumerics.contains($0) ? Character($0) : " " }
        return String(cleaned).split(separator: " ").joined(separator: " ")
    }

    /// L'outil qu'une phrase demande, s'il y en a un.
    func intent(for phrase: String) -> BudTool? {
        let t = " " + BudToolManager.normalize(phrase) + " "
        var best: (BudTool, Int)?
        for tool in tools {
            for p in tool.phrases where t.contains(" " + p + " ") || (p.count >= 9 && t.contains(p)) {
                if best == nil || p.count > best!.1 { best = (tool, p.count) }
            }
        }
        return best?.0
    }

    /// Exécute, en pilotant BUDs : au travail pendant, puis le résultat.
    /// La confirmation a déjà eu lieu — c'est le rôle de la vue.
    func execute(_ t: BudTool, progress: @escaping (String) -> Void,
                 done: @escaping (ToolOutcome) -> Void) {
        guard !running.contains(t.id) else { return }
        running.insert(t.id)
        onExpression?(.working, 60)
        t.execute(progress: { p in DispatchQueue.main.async { progress(p) } }) { [weak self] out in
            DispatchQueue.main.async {
                guard let s = self else { return }
                s.running.remove(t.id)
                if !out.expressionHandled {
                    let e = out.expression ?? (out.ok ? .happy : .sad)
                    s.onExpression?(e, out.ok ? 2.6 : 3.5)
                }
                done(out)
            }
        }
    }
}

// ═══════════════════════════════════════════════════════════
//  Les outils d'origine
// ═══════════════════════════════════════════════════════════

enum BudToolCatalog {

    private static func c(_ r: CGFloat, _ g: CGFloat, _ b: CGFloat) -> NSColor {
        NSColor(calibratedRed: r / 255, green: g / 255, blue: b / 255, alpha: 1)
    }

    static func registerDefaults() {
        let m = BudToolManager.shared
        let indigo = c(124, 122, 255), amber = c(240, 176, 70), teal = c(70, 205, 195)
        let blue = c(90, 165, 255), violet = c(190, 120, 255), green = c(100, 210, 140)
        let red = c(255, 110, 100), cyan = c(90, 205, 245), orange = c(245, 140, 80)

        // ── Capture ──
        m.register(captureTool(id: "capture-screen", title: "Capture d'écran",
                               subtitle: "Tout l'écran, sur le Bureau", mode: .screen, target: .desktop,
                               tint: teal, phrases: ["capture", "capture d ecran", "copie d ecran",
                                                     "screenshot", "photo de l ecran", "capture l ecran"]))
        m.register(captureTool(id: "capture-window", title: "Capturer une fenêtre",
                               subtitle: "Cliquez la fenêtre voulue", mode: .window, target: .desktop,
                               tint: teal, phrases: ["capture la fenetre", "capture une fenetre",
                                                     "capture de la fenetre", "capture fenetre"]))
        m.register(captureTool(id: "capture-zone", title: "Capturer une zone",
                               subtitle: "Tracez le rectangle", mode: .selection, target: .desktop,
                               tint: teal, phrases: ["capture une zone", "capture la zone", "capture une selection",
                                                     "capture la selection", "capture un morceau"]))
        m.register(captureTool(id: "capture-clip", title: "Capture vers le presse-papiers",
                               subtitle: "Une zone, prête à coller", mode: .selection, target: .clipboard,
                               tint: cyan, phrases: ["capture dans le presse papiers",
                                                     "capture vers le presse papiers"]))

        // ── Système ──
        m.register(BudTool(id: "sleep-mac", title: "Mettre le Mac en veille",
                           subtitle: "Après un compte à rebours de 5 s", icon: "moon.zzz.fill", tint: indigo,
                           category: .system, risk: .countdown(5),
                           phrases: ["mets le mac en veille", "mac en veille", "endors le mac", "mets en veille",
                                     "mise en veille", "suspends le mac", "veille le mac"],
                           working: "Mise en veille…") { _, done in
            done(ToolOutcome(ok: true, text: "Bonne nuit. Le Mac s'endort.", expression: .happy))
            // Le message d'abord, la veille ensuite : on veut le lire au
            // réveil, pas le perdre dans la mise en veille.
            DispatchQueue.global().asyncAfter(deadline: .now() + 0.9) {
                let r = runShellDetailed("/usr/bin/pmset", ["sleepnow"])
                if r.status != 0 {
                    _ = runShellDetailed("/usr/bin/osascript",
                                         ["-e", "tell application \"System Events\" to sleep"])
                }
            }
        })
        m.register(BudTool(id: "sleep-display", title: "Veille de l'écran",
                           subtitle: "Le Mac continue de tourner", icon: "display", tint: blue,
                           category: .system,
                           phrases: ["eteins l ecran", "veille ecran", "veille de l ecran", "coupe l ecran",
                                     "endors l ecran", "ecran en veille"],
                           working: "Extinction de l'écran…") { _, done in
            done(ToolOutcome(ok: true, text: "Écran éteint. Touchez une touche pour le rallumer."))
            DispatchQueue.global().asyncAfter(deadline: .now() + 0.6) {
                _ = runShellDetailed("/usr/bin/pmset", ["displaysleepnow"])
            }
        })
        m.register(BudTool(id: "lock", title: "Verrouiller l'écran",
                           subtitle: "Après 3 s, annulable", icon: "lock.fill", tint: violet,
                           category: .system, risk: .countdown(3),
                           phrases: ["verrouille", "verrouiller", "bloque l ecran", "bloque la session",
                                     "verrouille l ecran"],
                           working: "Verrouillage…") { _, done in
            let r = m.host.lockScreen()
            done(ToolOutcome(ok: true, text: r))
        })
        m.register(BudTool(id: "appearance", title: "Basculer clair / sombre",
                           subtitle: "L'apparence de tout macOS", icon: "circle.lefthalf.fill", tint: amber,
                           category: .system, phrases: ["bascule le theme", "clair sombre", "apparence"]) { _, done in
            let r = m.host.setAppearance("toggle")
            done(ToolOutcome(ok: true, text: r, expression: .cool))
        })
        m.register(BudTool(id: "trash", title: "Vider la corbeille",
                           subtitle: "Définitif, avec confirmation", icon: "trash.fill", tint: orange,
                           category: .system,
                           risk: .confirm("Vider la corbeille ? Ce qu'elle contient sera supprimé définitivement."),
                           phrases: ["vide la corbeille", "vider la corbeille", "purge la corbeille"],
                           working: "Vidage de la corbeille…") { _, done in
            m.host.emptyTrash { msg in done(ToolOutcome(ok: true, text: "Corbeille vidée : \(msg)")) }
        })
        m.register(BudTool(id: "network", title: "Infos réseau", subtitle: "Wi-Fi, adresse locale",
                           icon: "wifi", tint: teal, category: .system) { _, done in
            done(ToolOutcome(ok: true, text: m.host.network(), expression: .neutral))
        })
        m.register(BudTool(id: "battery", title: "Batterie", subtitle: "Charge et autonomie",
                           icon: "battery.75", tint: green, category: .system) { _, done in
            done(ToolOutcome(ok: true, text: m.host.battery(), expression: .neutral))
        })

        // ── Agents du Flux ──
        m.register(agentTool(id: "agent-cleanup", agent: "cleanup", title: "Rangement & nettoyage",
                             subtitle: "Téléchargements, apps dormantes", icon: "sparkles", tint: green,
                             phrases: ["agent de rangement", "lance le rangement", "range mon mac",
                                       "apps inutiles", "applications inutiles"]))
        m.register(agentTool(id: "agent-security", agent: "security", title: "Cybersécurité",
                             subtitle: "Liens du presse-papiers et courrier", icon: "lock.shield.fill", tint: red,
                             phrases: ["cybersecurite", "verifie ce lien", "analyse ce lien",
                                       "ce lien est il sur", "phishing", "hameconnage"]))
        m.register(agentTool(id: "agent-weather", agent: "weatherhome", title: "Météo & Maison",
                             subtitle: "Le ciel et vos commandes", icon: "cloud.sun.fill", tint: blue,
                             phrases: []))

        // ── Plus ──
        m.register(BudTool(id: "keys", title: "Raccourcis clavier…",
                           subtitle: "Et les pastilles de l'aperçu", icon: "keyboard", tint: violet,
                           category: .more) { _, done in
            m.host.openKeyboardShortcuts()
            done(ToolOutcome(ok: true, text: "Fenêtre des raccourcis ouverte.", expression: .neutral))
        })
        for (name, icon, tint) in [("Finder", "folder.fill", blue), ("Terminal", "terminal.fill", green)] {
            m.register(BudTool(id: "open-\(name.lowercased())", title: "Ouvrir \(name)", subtitle: "Application",
                               icon: icon, tint: tint, category: .more,
                               phrases: ["ouvre \(name.lowercased())", "lance \(name.lowercased())"]) { _, done in
                let r = runShellDetailed("/usr/bin/open", ["-a", name])
                done(r.status == 0 ? ToolOutcome(ok: true, text: "\(name) ouvert.", expression: .neutral)
                                   : ToolOutcome(ok: false, text: "\(name) n'a pas pu s'ouvrir."))
            })
        }
    }

    // ─────────────────────────────────────────────────────────
    //  La capture
    //
    //  L'autorisation d'abord. Sans « Enregistrement de l'écran »,
    //  macOS ne refuse pas : il rend une image vide ou le seul fond
    //  d'écran. On le demande donc avant, et on dit où l'accorder
    //  plutôt que de laisser une capture inutile sur le Bureau.
    // ─────────────────────────────────────────────────────────

    static let screenSettings = URL(string: "x-apple.systempreferences:com.apple.preference.security?Privacy_ScreenCapture")!

    static func captureTool(id: String, title: String, subtitle: String, mode: CaptureMode,
                            target: CaptureTarget, tint: NSColor, phrases: [String]) -> BudTool {
        let m = BudToolManager.shared
        return BudTool(id: id, title: title, subtitle: subtitle, icon: mode.icon, tint: tint,
                       category: .capture, phrases: phrases,
                       working: mode.interactive ? "Cliquez la fenêtre ou tracez la zone…" : "Capture dans un instant…") { _, done in
            if !CGPreflightScreenCaptureAccess() {
                // Montre la demande du système la première fois ; ensuite
                // macOS ne la remontre plus, d'où le lien vers les réglages.
                _ = CGRequestScreenCaptureAccess()
                done(ToolOutcome(ok: false,
                                 text: "BUD n'a pas encore le droit d'enregistrer l'écran. Autorisez-le dans "
                                     + "Confidentialité et sécurité → Enregistrement de l'écran, puis relancez BUD.",
                                 tapLabel: "Ouvrir les réglages",
                                 tap: { BudToolCatalog.screenSettingsOpen() }))
                return
            }
            m.host.hidePanel()
            ScreenCapture.run(mode, to: target) { r in
                m.host.showChat()
                guard r.ok else {
                    let cancelled = r.message.hasPrefix("Capture annulée")
                    var out = ToolOutcome(ok: cancelled, text: r.message,
                                          expression: cancelled ? .neutral : .sad)
                    if r.message.contains("Enregistrement de l'écran") {
                        out.tapLabel = "Ouvrir les réglages"
                        out.tap = { BudToolCatalog.screenSettingsOpen() }
                    }
                    done(out)
                    return
                }
                guard let u = r.url else {
                    done(ToolOutcome(ok: true, text: r.message))
                    return
                }
                done(ToolOutcome(ok: true, text: "Capture enregistrée sur le Bureau.\n\(u.lastPathComponent)",
                                 image: BudToolCatalog.thumbnail(u, max: 520),
                                 tapLabel: "Afficher dans le Finder",
                                 tap: { ScreenCapture.reveal(u) }))
            }
        }
    }

    static func screenSettingsOpen() { NSWorkspace.shared.open(screenSettings) }

    /// Une miniature légère : une capture 5K pèse des dizaines de
    /// mégaoctets en mémoire, la bulle n'en montre que quelques centaines
    /// de points.
    static func thumbnail(_ u: URL, max: Int) -> NSImage? {
        guard let src = CGImageSourceCreateWithURL(u as CFURL, nil) else { return nil }
        let opts: [CFString: Any] = [
            kCGImageSourceCreateThumbnailFromImageAlways: true,
            kCGImageSourceThumbnailMaxPixelSize: max,
            kCGImageSourceCreateThumbnailWithTransform: true
        ]
        guard let cg = CGImageSourceCreateThumbnailAtIndex(src, 0, opts as CFDictionary) else { return nil }
        return NSImage(cgImage: cg, size: NSSize(width: cg.width, height: cg.height))
    }

    // ─────────────────────────────────────────────────────────
    //  Un agent du Flux, en outil
    //
    //  L'agent pilote lui-même l'expression de BUDs ; l'outil se
    //  contente d'attendre qu'il ait fini et d'en rapporter la
    //  ligne, avec un accès direct au Flux pour les cartes et la
    //  fiche d'approbation.
    // ─────────────────────────────────────────────────────────

    static func agentTool(id: String, agent: String, title: String, subtitle: String,
                          icon: String, tint: NSColor, phrases: [String]) -> BudTool {
        let m = BudToolManager.shared
        return BudTool(id: id, title: title, subtitle: subtitle, icon: icon, tint: tint,
                       category: .agents, phrases: phrases, working: "\(title) au travail…") { progress, done in
            let am = BudAgentManager.shared
            guard am.agent(agent) != nil else {
                done(ToolOutcome(ok: false, text: "Cet agent n'est pas disponible."))
                return
            }
            am.run(agent)
            var ticks = 0
            Timer.scheduledTimer(withTimeInterval: 0.3, repeats: true) { tm in
                ticks += 1
                let st = am.state(agent)
                if st.status == .running {
                    if !st.line.isEmpty { progress(st.line) }
                    if ticks < 400 { return }
                }
                tm.invalidate()
                let ok = st.status != .failure
                let open: () -> Void = { m.host.openTab("flow") }
                var text = st.line.isEmpty ? "Terminé." : st.line
                if st.status == .needsApproval { text += "\nRien n'a été touché : la fiche attend votre accord dans le Flux." }
                done(ToolOutcome(ok: ok, text: text,
                                 tapLabel: st.status == .needsApproval ? "Examiner dans le Flux" : "Voir les cartes",
                                 tap: open, expressionHandled: true))
            }
        }
    }
}
EOF_BUDTOOLS_SWIFT

cat << 'EOF_BUDUI_SWIFT' > "$SRC_DIR/BudUI.swift"
import Cocoa
import QuartzCore

// ═══════════════════════════════════════════════════════════
//  Registre de thème
// ═══════════════════════════════════════════════════════════

final class ThemeRegistry {
    static let shared = ThemeRegistry()
    private var labels: [(NSTextField, CGFloat)] = []
    private var boxes: [(NSView, CGFloat)] = []
    private var icons: [(NSImageView, CGFloat)] = []

    func register(_ l: NSTextField, alpha: CGFloat) { labels.append((l, alpha)) }
    func register(box: NSView, alpha: CGFloat = 0.06) { boxes.append((box, alpha)) }
    func register(icon: NSImageView, alpha: CGFloat) { icons.append((icon, alpha)) }

    func prune() {
        labels.removeAll { $0.0.superview == nil }
        boxes.removeAll { $0.0.superview == nil }
        icons.removeAll { $0.0.superview == nil }
    }

    func apply() {
        prune()
        for (l, a) in labels { l.textColor = TH.dim(a) }
        for (b, a) in boxes { b.layer?.backgroundColor = TH.fill(a).cgColor }
        for (iv, a) in icons { iv.contentTintColor = TH.dim(a) }
    }
}

// ═══════════════════════════════════════════════════════════
//  Helpers de construction
// ═══════════════════════════════════════════════════════════

/// Applique l'accent choisi en tenant compte du thème (le blanc devient graphite en clair).
func resolvedAccent(_ index: Int, dark: Bool) -> NSColor {
    let c = accentPalette[max(0, min(accentPalette.count - 1, index))].1
    if index == whiteAccentIndex && !dark { return NSColor(calibratedWhite: 0.20, alpha: 1) }
    return c
}

func mkLabel(_ s: String, _ f: NSRect, _ size: CGFloat, _ w: NSFont.Weight = .regular,
             alpha: CGFloat = 1, _ a: NSTextAlignment = .left, mono: Bool = false) -> NSTextField {
    let t = NSTextField(frame: f)
    t.stringValue = s
    t.isBezeled = false
    t.drawsBackground = false
    t.isEditable = false
    t.isSelectable = false
    t.font = mono ? NSFont.monospacedDigitSystemFont(ofSize: size, weight: w)
                  : NSFont.systemFont(ofSize: size, weight: w)
    t.textColor = TH.dim(alpha)
    t.alignment = a
    t.lineBreakMode = .byTruncatingTail
    t.cell?.usesSingleLineMode = true
    ThemeRegistry.shared.register(t, alpha: alpha)
    return t
}

/// Étiquette dimensionnée sur mesure : jamais tronquée.
func mkFitLabel(_ s: String, x: CGFloat, y: CGFloat, _ size: CGFloat, _ w: NSFont.Weight = .regular,
                alpha: CGFloat = 1, mono: Bool = false) -> NSTextField {
    // Un NSTextField ajoute ~4 pt de marge interne de chaque côté : sans cette
    // réserve, le libellé se termine par une ellipse alors qu'il tiendrait.
    let width = textWidth(s, size: size, weight: w, mono: mono) + 10
    let l = mkLabel(s, NSRect(x: x, y: y, width: width, height: ceil(size * 1.6)), size, w,
                    alpha: alpha, .left, mono: mono)
    l.lineBreakMode = .byClipping
    return l
}

@discardableResult
/// Une carte de verre. `alpha` est conservé dans la signature pour les
/// quarante appels existants, mais il ne sert plus de couleur : il est
/// traduit en niveau d'élévation, afin que l'application entière passe
/// au même matériau sans toucher à chaque appel.
func mkCard(_ parent: NSView, _ f: NSRect, radius: CGFloat = Radius.m,
            alpha: CGFloat = 0.06) -> NSView {
    let level = alpha <= 0.05 ? 0 : (alpha <= 0.08 ? 1 : 2)
    let v = GlassCard(frame: f, radius: radius, level: level)
    parent.addSubview(v)
    return v
}

func mkIcon(_ parent: NSView, _ name: String, x: CGFloat, y: CGFloat,
            size: CGFloat = 13, weight: NSFont.Weight = .semibold, alpha: CGFloat = 0.55) -> NSImageView {
    let iv = NSImageView(frame: NSRect(x: x, y: y, width: size + 4, height: size + 4))
    iv.image = symbol(name, size, weight)
    iv.contentTintColor = TH.dim(alpha)
    iv.imageScaling = .scaleProportionallyUpOrDown
    parent.addSubview(iv)
    ThemeRegistry.shared.register(icon: iv, alpha: alpha)
    return iv
}

@discardableResult
func mkStatRow(_ parent: NSView, _ y: CGFloat, _ x: CGFloat, _ w: CGFloat,
               _ icon: String, _ key: String) -> NSTextField {
    mkCard(parent, NSRect(x: x, y: y, width: w, height: 32), radius: 10)
    mkIcon(parent, icon, x: x + 12, y: y + 8)
    let keyW = textWidth(key, size: 11.5, weight: .medium) + 4
    parent.addSubview(mkLabel(key, NSRect(x: x + 36, y: y + 8, width: keyW, height: 16), 11.5, .medium, alpha: 0.6))
    let valX = x + 40 + keyW
    let v = mkLabel("—", NSRect(x: valX, y: y + 8, width: max(60, x + w - 14 - valX), height: 16),
                    12, .semibold, alpha: 1, .right, mono: true)
    parent.addSubview(v)
    return v
}

func mkSection(_ parent: NSView, _ y: CGFloat, _ w: CGFloat, _ t: String) {
    parent.addSubview(mkLabel(t.uppercased(), NSRect(x: 2, y: y, width: w, height: 14),
                              Typo.micro.size, Typo.micro.weight, alpha: Typo.Ink.ghost))
}

/// Tuile de statistique : grande valeur, légende en dessous.
final class StatTile: NSView {
    private let valueLabel: NSTextField
    private let captionLabel: NSTextField
    private let hintLabel: NSTextField

    init(frame: NSRect, caption: String, hint: String = "") {
        valueLabel = mkLabel("—", NSRect(x: 14, y: frame.height - 52, width: frame.width - 28, height: 34),
                             26, .bold, alpha: 1, .left, mono: true)
        captionLabel = mkLabel(caption, NSRect(x: 14, y: frame.height - 24, width: frame.width - 28, height: 16),
                               10.5, .medium, alpha: 0.5)
        hintLabel = mkLabel(hint, NSRect(x: 14, y: 10, width: frame.width - 28, height: 14), 10, .regular, alpha: 0.35)
        super.init(frame: frame)
        wantsLayer = true
        layer?.cornerRadius = 14
        layer?.backgroundColor = TH.fill(0.06).cgColor
        ThemeRegistry.shared.register(box: self, alpha: 0.06)
        [captionLabel, valueLabel, hintLabel].forEach { addSubview($0) }
    }
    required init?(coder: NSCoder) { fatalError() }

    func set(_ value: String, hint: String? = nil) {
        valueLabel.stringValue = value
        // Réduit la taille jusqu'à ce que la valeur tienne : aucune troncature.
        let avail = bounds.width - 28
        var size: CGFloat = 26
        while size > 13 && textWidth(value, size: size, weight: .bold, mono: true) > avail {
            size -= 1
        }
        valueLabel.font = NSFont.monospacedDigitSystemFont(ofSize: size, weight: .bold)
        if let h = hint { hintLabel.stringValue = h }
    }
}

/// Bandeau d'en-tête d'un panneau : titre, sous-titre, dégradé d'accent.
final class HeroHeader: NSView {
    private var titleText: String
    private var subtitleText: String
    var trailing: String = ""
    /// Teinte de la capsule de droite. Une alerte affichée dans le même
    /// gris que le reste n'alerte personne.
    var trailingTint: NSColor?

    init(frame: NSRect, title: String, subtitle: String) {
        titleText = title
        subtitleText = subtitle
        super.init(frame: frame)
        wantsLayer = true
    }
    required init?(coder: NSCoder) { fatalError() }

    func set(title: String? = nil, subtitle: String? = nil, trailing: String? = nil) {
        if let t = title { titleText = t }
        if let s = subtitle { subtitleText = s }
        if let r = trailing { self.trailing = r }
        needsDisplay = true
    }

    override func draw(_ dirty: NSRect) {
        let r = bounds
        let path = NSBezierPath(roundedRect: r, xRadius: Radius.xl, yRadius: Radius.xl)
        let a = TH.accent
        let c1 = a.withAlphaComponent(TH.dark ? 0.26 : 0.20)
        let c2 = a.withAlphaComponent(TH.dark ? 0.05 : 0.04)
        if let g = NSGradient(starting: c1, ending: c2) { g.draw(in: path, angle: -25) }
        TH.fill(0.05).setFill()
        path.fill()
        TH.fill(0.08).setStroke()
        path.lineWidth = 1
        path.stroke()

        // Poussière lumineuse discrète
        for i in 0..<14 {
            let fx = CGFloat((i * 71) % 97) / 97.0
            let fy = CGFloat((i * 37) % 53) / 53.0
            let d: CGFloat = (i % 3 == 0) ? 2.4 : 1.5
            TH.fill(0.10 + 0.05 * CGFloat(i % 3)).setFill()
            NSBezierPath(ovalIn: NSRect(x: r.minX + 20 + fx * (r.width - 60),
                                        y: r.minY + 12 + fy * (r.height - 28),
                                        width: d, height: d)).fill()
        }

        drawString(titleText, in: NSRect(x: 22, y: r.height - 50, width: r.width - 160, height: 30),
                   size: Typo.display.size, weight: Typo.display.weight, color: TH.text)
        drawString(subtitleText, in: NSRect(x: 22, y: r.height - 74, width: r.width - 160, height: 20),
                   size: Typo.body.size, weight: Typo.body.weight, color: TH.dim(Typo.Ink.muted))
        if !trailing.isEmpty {
            // La capsule ne déborde jamais sur le titre : au besoin elle
            // rétrécit, et c'est le texte qui est coupé, pas la mise en page.
            let want = textWidth(trailing, size: 11.5, weight: .semibold) + 26
            let w = min(want, max(60, r.width - 200))
            let cap = NSRect(x: r.maxX - w - 18, y: r.height - 44, width: w, height: 26)
            let tint = trailingTint
            (tint?.withAlphaComponent(0.22) ?? TH.fill(0.12)).setFill()
            capsule(cap).fill()
            if let t = tint {
                t.withAlphaComponent(0.70).setStroke()
                let s = capsule(cap); s.lineWidth = 1; s.stroke()
            }
            drawString(trailing, in: NSRect(x: cap.minX, y: cap.midY - 8, width: cap.width, height: 16),
                       size: 11.5, weight: .semibold, color: tint ?? TH.text, align: .center)
        }
    }
}

// ═══════════════════════════════════════════════════════════
//  Matière de verre
//
//  Deux primitives partagées par les boutons et les cartes,
//  pour que tout l'habillage réagisse à la lumière de la même
//  façon. Les écrire une fois plutôt qu'à chaque endroit est
//  ce qui rend l'ensemble harmonieux : vingt reflets réglés
//  séparément finissent par diverger.
// ═══════════════════════════════════════════════════════════

/// Le reflet spéculaire : une bande claire sur la moitié haute, bornée
/// à la forme, qui s'éteint vers le milieu.
func specular(_ shape: NSBezierPath, _ r: NSRect, strength: CGFloat) {
    guard strength > 0.01, r.height > 6 else { return }
    NSGraphicsContext.current?.saveGraphicsState()
    shape.addClip()
    let top = NSColor.white.withAlphaComponent(strength * (TH.dark ? 0.22 : 0.42))
    let fade = NSColor.white.withAlphaComponent(0)
    if let g = NSGradient(starting: top, ending: fade) {
        g.draw(in: NSRect(x: r.minX, y: r.midY, width: r.width, height: r.height / 2), angle: -90)
    }
    NSGraphicsContext.current?.restoreGraphicsState()
}

/// Le liseré : vif en haut, éteint en bas. C'est ce dégradé qui donne
/// l'épaisseur ; un contour uniforme reste un trait.
func rim(_ shape: NSBezierPath, _ r: NSRect, color: NSColor, strength: CGFloat) {
    guard strength > 0.01, r.height > 4 else { return }
    // Un dégradé le long d'un contour n'existe pas en AppKit : on ne peut
    // pas clipper sur un trait. On trace donc le même contour par bandes
    // horizontales, d'opacité décroissante. Quatre suffisent — à cette
    // échelle, les marches ne se voient pas.
    let a = strength * (TH.dark ? 1.0 : 0.55)
    let bands = 4
    for i in 0..<bands {
        let f = CGFloat(i) / CGFloat(bands - 1)         // 0 en haut, 1 en bas
        let h = r.height / CGFloat(bands)
        let band = NSRect(x: r.minX - 2, y: r.maxY - h * CGFloat(i + 1),
                          width: r.width + 4, height: h)
        NSGraphicsContext.current?.saveGraphicsState()
        NSBezierPath(rect: band).setClip()
        color.withAlphaComponent(a * (1 - f) * (1 - f)).setStroke()
        shape.lineWidth = 1.4
        shape.stroke()
        NSGraphicsContext.current?.restoreGraphicsState()
    }
}

// ═══════════════════════════════════════════════════════════
//  Boutons
// ═══════════════════════════════════════════════════════════

/// Le capteur de raccourci : un clic, puis la combinaison qu'on tape.
///
/// Le moniteur est **local** et non global : il ne doit intercepter les
/// touches que pendant qu'on enregistre, et seulement dans la fenêtre de
/// BUD. Un moniteur global avalerait les frappes de toutes les
/// applications tant que l'enregistrement serait ouvert.
final class KeyRecorder: NSView {
    var combo: String { didSet { needsDisplay = true } }
    var onChange: ((String) -> Void)?
    /// Phrase à afficher quand une combinaison est refusée.
    var onRefuse: ((String) -> Void)?
    /// Rend le nom de l'action qui utilise déjà ce raccourci, ou `nil`.
    /// Deux actions sur la même combinaison, et l'une des deux ne part
    /// jamais : laquelle dépendrait de l'ordre du tableau, ce qui est
    /// indéfendable. On refuse donc le doublon à la saisie.
    var conflict: ((String) -> String?)?

    private var recording = false { didSet { needsDisplay = true } }
    private var monitor: Any?
    private var hover = false
    private var track: NSTrackingArea?

    init(frame: NSRect, combo: String) {
        self.combo = combo
        super.init(frame: frame)
        wantsLayer = true
    }
    required init?(coder: NSCoder) { fatalError() }
    deinit { stopRecording() }

    override func updateTrackingAreas() {
        super.updateTrackingAreas()
        if let a = track { removeTrackingArea(a) }
        let a = NSTrackingArea(rect: bounds, options: [.mouseEnteredAndExited, .activeInKeyWindow],
                               owner: self, userInfo: nil)
        addTrackingArea(a)
        track = a
    }
    override func mouseEntered(with e: NSEvent) { hover = true; needsDisplay = true }
    override func mouseExited(with e: NSEvent) { hover = false; needsDisplay = true }

    override func mouseDown(with e: NSEvent) {
        recording ? stopRecording() : startRecording()
    }

    private func startRecording() {
        recording = true
        monitor = NSEvent.addLocalMonitorForEvents(matching: .keyDown) { [weak self] ev in
            guard let s = self else { return ev }
            // Échap annule, sans rien changer.
            if ev.keyCode == 53 { s.stopRecording(); return nil }
            guard let ch = ev.charactersIgnoringModifiers?.lowercased(), !ch.isEmpty,
                  let first = ch.first, first.isLetter || first.isNumber else {
                s.onRefuse?("Choisissez une lettre ou un chiffre.")
                return nil
            }
            let candidate = Shortcuts.encode(ev.modifierFlags, String(first))
            guard Shortcuts.isUsable(candidate) else {
                s.onRefuse?("Il faut au moins ⌘, ⌥ ou ⌃ — sans quoi le raccourci "
                    + "intercepterait votre frappe dans toutes les applications.")
                return nil
            }
            if let taken = s.conflict?(candidate) {
                s.onRefuse?("\(Shortcuts.display(candidate)) sert déjà à « \(taken) ». "
                    + "Changez d'abord celui-là, ou choisissez une autre touche.")
                return nil
            }
            s.combo = candidate
            s.onChange?(candidate)
            s.stopRecording()
            return nil
        }
    }

    private func stopRecording() {
        if let m = monitor { NSEvent.removeMonitor(m) }
        monitor = nil
        recording = false
    }

    override func draw(_ dirty: NSRect) {
        let r = bounds.insetBy(dx: 0.5, dy: 0.5)
        let p = capsule(r)
        TH.fill(recording ? 0.18 : (hover ? 0.12 : 0.07)).setFill()
        p.fill()
        (recording ? TH.accent.withAlphaComponent(0.8) : TH.fill(0.12)).setStroke()
        p.lineWidth = recording ? 1.5 : 1
        p.stroke()
        drawString(recording ? "tapez…" : Shortcuts.display(combo),
                   in: NSRect(x: r.minX, y: r.midY - 7, width: r.width, height: 15),
                   size: 11.5, weight: .semibold,
                   color: recording ? TH.accent : TH.text, align: .center, mono: !recording)
    }
}

final class GlassButton: NSView {
    var title: String { didSet { needsDisplay = true } }
    var iconName: String? { didSet { needsDisplay = true } }
    var prominent = false { didSet { needsDisplay = true } }
    var destructive = false { didSet { needsDisplay = true } }
    var selected = false { didSet { needsDisplay = true } }
    var enabledFlag = true { didSet { needsDisplay = true } }
    var alignLeft = false
    var compact = false
    var idx = 0
    /// Teinte propre au bouton, pour colorer un groupe d'outils. `nil`
    /// laisse l'accent général choisi par l'utilisateur.
    var accentTint: NSColor? { didSet { needsDisplay = true } }
    var onClick: ((GlassButton) -> Void)?

    private var hoverT: CGFloat = 0
    private var pressT: CGFloat = 0
    private var hovering = false
    private var pressing = false
    private var anim: Timer?

    init(frame: NSRect, title: String, icon: String? = nil,
         prominent: Bool = false, alignLeft: Bool = false, compact: Bool = false) {
        self.title = title
        self.iconName = icon
        self.prominent = prominent
        self.alignLeft = alignLeft
        self.compact = compact
        super.init(frame: frame)
        wantsLayer = true
    }
    required init?(coder: NSCoder) { fatalError() }

    /// Largeur minimale pour afficher le libellé en entier.
    func idealWidth() -> CGFloat {
        let t = textWidth(title, size: compact ? 11.5 : 12, weight: .semibold)
        return t + (iconName == nil ? 32 : 58)
    }

    override func updateTrackingAreas() {
        super.updateTrackingAreas()
        trackingAreas.forEach { removeTrackingArea($0) }
        addTrackingArea(NSTrackingArea(rect: bounds,
                                       options: [.mouseEnteredAndExited, .activeAlways, .inVisibleRect],
                                       owner: self, userInfo: nil))
    }

    private func startAnim() {
        guard anim == nil else { return }
        let t = Timer(timeInterval: 1.0 / 60.0, repeats: true) { [weak self] tm in
            guard let s = self else { tm.invalidate(); return }
            let hT: CGFloat = s.hovering ? 1 : 0
            let pT: CGFloat = s.pressing ? 1 : 0
            s.hoverT += (hT - s.hoverT) * 0.25
            s.pressT += (pT - s.pressT) * 0.35
            if abs(hT - s.hoverT) < 0.01 && abs(pT - s.pressT) < 0.01 {
                s.hoverT = hT; s.pressT = pT
                tm.invalidate(); s.anim = nil
            }
            s.needsDisplay = true
        }
        anim = t
        RunLoop.main.add(t, forMode: .common)
    }

    override func mouseEntered(with e: NSEvent) { hovering = true; startAnim() }
    override func mouseExited(with e: NSEvent) { hovering = false; pressing = false; startAnim() }
    override func mouseDown(with e: NSEvent) {
        guard enabledFlag else { return }
        pressing = true
        startAnim()
    }
    override func mouseUp(with e: NSEvent) {
        let was = pressing
        pressing = false
        startAnim()
        guard enabledFlag, was, bounds.contains(convert(e.locationInWindow, from: nil)) else { return }
        onClick?(self)
    }

    override func draw(_ dirty: NSRect) {
        let lift = pressT
        let r = bounds.insetBy(dx: 0.5 + lift, dy: 0.5 + lift)
        let path = capsule(r)
        // La teinte propre du bouton l'emporte sur l'accent général, sauf
        // pour un bouton destructeur, qui reste rouge quoi qu'on demande.
        let tint = destructive ? dangerColor : (accentTint ?? TH.accent)

        // ── Matière ──
        //
        //  Le verre d'iOS 26 n'existe pas en AppKit sur macOS 12 : il n'y a
        //  pas d'API à appeler, et BUD vise Monterey. On en reprend donc
        //  les trois principes à la main, sans prétendre à autre chose —
        //  une matière épaisse plutôt qu'un aplat, un reflet spéculaire en
        //  haut, un liseré qui s'éclaire sur le bord supérieur.
        //
        //  C'est le liseré qui fait le plus : un contour d'intensité
        //  constante lit comme un trait dessiné, un contour qui s'éteint
        //  vers le bas lit comme une épaisseur.
        if !enabledFlag {
            Surface.fill(0).setFill()
            path.fill()
        } else if prominent || selected {
            let top = tint.blended(withFraction: 0.22, of: NSColor.white) ?? tint
            let bottom = tint.blended(withFraction: 0.16, of: NSColor.black) ?? tint
            if let g = NSGradient(starting: top, ending: bottom) { g.draw(in: path, angle: -90) }
            else { tint.setFill(); path.fill() }
            if hoverT > 0.01 {
                NSColor.white.withAlphaComponent(0.10 * hoverT).setFill()
                path.fill()
            }
            specular(path, r, strength: 0.30 + 0.12 * hoverT)
            rim(path, r, color: NSColor.white, strength: 0.42)
        } else {
            // Un bouton au repos est une surface de niveau 1 qui monte au
            // niveau 2 sous le curseur : la même matière que les cartes,
            // le même reflet, le même liseré. C'est ce partage qui évite
            // qu'un bouton du Courrier ait l'air d'un autre matériau
            // qu'une carte du Chat.
            let hovering = hoverT > 0.5 || pressT > 0.01
            drawGlass(in: bounds.insetBy(dx: lift, dy: lift),
                      radius: Radius.pill(r.height), level: hovering ? 2 : 1,
                      hover: hoverT, tint: accentTint?.withAlphaComponent(0.5))
            // Pas de contour supplémentaire ici : `drawGlass` ferme déjà
            // la forme. En ajouter un doublerait le trait et épaissirait
            // le bord d'un bouton sur deux.
        }

        let fg: NSColor = !enabledFlag ? TH.dim(0.25)
                        : ((prominent || selected) ? TH.onAccent : (destructive ? dangerColor : TH.text))
        // L'icône peut porter la teinte du groupe pendant que le titre
        // reste lisible : colorer les deux rendrait le texte pâle.
        let ig: NSColor = !enabledFlag ? TH.dim(0.25)
                        : ((prominent || selected) ? TH.onAccent
                           : (destructive ? dangerColor : (accentTint ?? TH.text)))
        let fontSize: CGFloat = compact ? 11.5 : 12
        let tw = textWidth(title, size: fontSize, weight: .semibold)

        if title.isEmpty {
            if let icon = iconName {
                drawSymbol(icon, center: NSPoint(x: r.midX, y: r.midY), size: compact ? 12 : 13,
                           weight: .semibold, color: ig)
            }
            return
        }

        if alignLeft {
            var x = r.minX + 14
            if let icon = iconName {
                drawSymbol(icon, center: NSPoint(x: x + 7, y: r.midY), size: compact ? 12 : 13,
                           weight: .semibold, color: ig)
                x += 26
            }
            drawString(title, in: NSRect(x: x, y: r.midY - 8, width: max(10, r.maxX - 12 - x), height: 16),
                       size: fontSize, weight: .semibold, color: fg)
        } else {
            let iconW: CGFloat = iconName == nil ? 0 : 20
            let block = min(r.width - 16, tw + iconW)
            var x = r.midX - block / 2
            if let icon = iconName {
                drawSymbol(icon, center: NSPoint(x: x + 7, y: r.midY), size: compact ? 12 : 13,
                           weight: .semibold, color: ig)
                x += iconW
            }
            drawString(title, in: NSRect(x: x, y: r.midY - 8, width: max(10, r.maxX - 8 - x), height: 16),
                       size: fontSize, weight: .semibold, color: fg)
        }
    }
}

/// Rangée de la barre latérale : icône + libellé + pastille de notification.
final class SidebarItem: NSView {
    let iconName: String
    let title: String
    var selected = false { didSet { needsDisplay = true } }
    var badgeCount = 0 { didSet { needsDisplay = true } }
    var idx = 0
    var onClick: ((Int) -> Void)?
    private var hover = false

    init(frame: NSRect, icon: String, title: String, index: Int) {
        self.iconName = icon
        self.title = title
        self.idx = index
        super.init(frame: frame)
        wantsLayer = true
    }
    required init?(coder: NSCoder) { fatalError() }

    override func updateTrackingAreas() {
        super.updateTrackingAreas()
        trackingAreas.forEach { removeTrackingArea($0) }
        addTrackingArea(NSTrackingArea(rect: bounds, options: [.mouseEnteredAndExited, .activeAlways, .inVisibleRect],
                                       owner: self, userInfo: nil))
    }
    override func mouseEntered(with e: NSEvent) { hover = true; needsDisplay = true }
    override func mouseExited(with e: NSEvent) { hover = false; needsDisplay = true }
    override func mouseUp(with e: NSEvent) {
        if bounds.contains(convert(e.locationInWindow, from: nil)) { onClick?(idx) }
    }

    override func draw(_ dirty: NSRect) {
        let r = bounds.insetBy(dx: 0, dy: 1)
        if hover && !selected {
            TH.fill(0.06).setFill()
            NSBezierPath(roundedRect: r, xRadius: 9, yRadius: 9).fill()
        }
        let fg = selected ? TH.text : TH.dim(hover ? 0.8 : 0.6)
        drawSymbol(iconName, center: NSPoint(x: r.minX + 20, y: r.midY), size: 14,
                   weight: selected ? .semibold : .regular, color: selected ? TH.accent : fg)
        drawString(title, in: NSRect(x: r.minX + 38, y: r.midY - 8, width: r.width - 72, height: 17),
                   size: 12.5, weight: selected ? .semibold : .regular, color: fg)
        if badgeCount > 0 {
            let txt = badgeCount > 9 ? "9+" : "\(badgeCount)"
            let w = max(18, textWidth(txt, size: 9.5, weight: .bold) + 12)
            let br = NSRect(x: r.maxX - w - 8, y: r.midY - 8, width: w, height: 16)
            dangerColor.setFill()
            capsule(br).fill()
            drawString(txt, in: NSRect(x: br.minX, y: br.minY + 2, width: br.width, height: 12),
                       size: 9.5, weight: .bold, color: .white, align: .center, mono: true)
        }
    }
}

final class SwatchButton: NSView {
    let color: NSColor
    var selected = false { didSet { needsDisplay = true } }
    var idx = 0
    var onClick: ((Int) -> Void)?
    private var hover = false

    init(frame: NSRect, color: NSColor, index: Int) {
        self.color = color
        self.idx = index
        super.init(frame: frame)
    }
    required init?(coder: NSCoder) { fatalError() }

    override func updateTrackingAreas() {
        super.updateTrackingAreas()
        trackingAreas.forEach { removeTrackingArea($0) }
        addTrackingArea(NSTrackingArea(rect: bounds, options: [.mouseEnteredAndExited, .activeAlways, .inVisibleRect],
                                       owner: self, userInfo: nil))
    }
    override func mouseEntered(with e: NSEvent) { hover = true; needsDisplay = true }
    override func mouseExited(with e: NSEvent) { hover = false; needsDisplay = true }
    override func mouseUp(with e: NSEvent) {
        if bounds.contains(convert(e.locationInWindow, from: nil)) { onClick?(idx) }
    }
    override func draw(_ dirty: NSRect) {
        let inset: CGFloat = selected ? 4 : (hover ? 4.5 : 6)
        color.setFill()
        NSBezierPath(ovalIn: bounds.insetBy(dx: inset, dy: inset)).fill()
        if selected {
            let ring = NSBezierPath(ovalIn: bounds.insetBy(dx: 1, dy: 1))
            color.withAlphaComponent(0.55).setStroke()
            ring.lineWidth = 2
            ring.stroke()
            drawSymbol("checkmark", center: NSPoint(x: bounds.midX, y: bounds.midY),
                       size: 10, weight: .bold, color: TH.onAccent)
        }
    }
}

final class ProgressBar: NSView {
    var value: CGFloat = 0 { didSet { needsDisplay = true } }
    var tint: NSColor? = nil
    override func draw(_ dirty: NSRect) {
        let r = bounds
        TH.fill(0.10).setFill()
        capsule(r).fill()
        guard value > 0.001 else { return }
        (tint ?? TH.accent).setFill()
        capsule(NSRect(x: r.minX, y: r.minY, width: max(r.height, r.width * min(1, value)), height: r.height)).fill()
    }
}

final class GaugeRing: NSView {
    var percent = 0
    var caption = ""
    var tint: NSColor? = nil
    private var progress: CGFloat = 1

    func set(_ v: Int, caption c: String, animated: Bool) {
        percent = max(0, min(100, v))
        caption = c
        progress = animated ? 0 : 1
        needsDisplay = true
    }
    func step() { if progress < 1 { progress = min(1, progress + 0.07); needsDisplay = true } }

    override func draw(_ dirty: NSRect) {
        let cx = bounds.midX, cy = bounds.midY, r = min(cx, cy) - 8
        let bg = NSBezierPath()
        bg.appendArc(withCenter: NSPoint(x: cx, y: cy), radius: r, startAngle: 0, endAngle: 360)
        bg.lineWidth = 8
        TH.fill(0.10).setStroke()
        bg.stroke()

        let col: NSColor = tint ?? (percent >= 90 ? dangerColor : (percent >= 75 ? warnColor : TH.accent))
        let ratio = CGFloat(percent) / 100 * progress
        if ratio > 0.001 {
            let fg = NSBezierPath()
            fg.appendArc(withCenter: NSPoint(x: cx, y: cy), radius: r,
                         startAngle: 90, endAngle: 90 - 360 * ratio, clockwise: true)
            fg.lineWidth = 8
            fg.lineCapStyle = .round
            col.setStroke()
            fg.stroke()
        }
        drawString("\(percent)%", in: NSRect(x: 0, y: cy - 1, width: bounds.width, height: 24),
                   size: 18, weight: .bold, color: TH.text, align: .center, mono: true)
        drawString(caption, in: NSRect(x: 0, y: cy - 19, width: bounds.width, height: 14),
                   size: 9.5, weight: .semibold, color: TH.dim(0.42), align: .center)
    }
}

// ═══════════════════════════════════════════════════════════
//  Compagnon
// ═══════════════════════════════════════════════════════════

final class CompanionView: NSView {
    let sprite = BudSprite()
    var sleepy = false {
        didSet { if alertCount == 0 { sprite.mood = sleepy ? .sleepy : .calm } }
    }
    var alertCount = 0 {
        didSet {
            sprite.mood = alertCount > 0 ? .alert : (sleepy ? .sleepy : .calm)
            needsDisplay = true
        }
    }
    var onTap: (() -> Void)?

    func react() { sprite.poke() }
    func wave() { sprite.wave() }
    var musicPlaying: Bool {
        get { sprite.equalizer }
        set { sprite.equalizer = newValue }
    }

    func step(follow: Bool) {
        if sprite.step(follow: follow, in: self, anchor: NSPoint(x: bounds.midX, y: bounds.midY)) {
            needsDisplay = true
        }
    }

    override func mouseUp(with e: NSEvent) {
        sprite.poke()
        onTap?()
    }

    override func draw(_ dirty: NSRect) {
        sprite.render(in: bounds.insetBy(dx: 1, dy: 1), detail: bounds.width >= 40,
                      glowColor: alertCount > 0 ? warnColor : TH.accent)
        if alertCount > 0 {
            let txt = alertCount > 9 ? "9+" : "\(alertCount)"
            let d: CGFloat = 18
            let br = NSRect(x: bounds.maxX - d, y: bounds.maxY - d - 2, width: d, height: d)
            dangerColor.setFill()
            NSBezierPath(ovalIn: br).fill()
            drawString(txt, in: NSRect(x: br.minX, y: br.minY + 3, width: d, height: 12),
                       size: 9.5, weight: .bold, color: .white, align: .center, mono: true)
        }
    }
}

// ═══════════════════════════════════════════════════════════
//  Notch
// ═══════════════════════════════════════════════════════════

enum NotchState { case collapsed, glance, approval, open }

final class Backdrop: NSVisualEffectView {
    var radius: CGFloat = 15 { didSet { if radius != oldValue { needsLayout = true } } }
    override func layout() {
        super.layout()
        guard bounds.width > 1, bounds.height > 1 else { return }
        let rad = radius
        maskImage = NSImage(size: bounds.size, flipped: false) { r in
            NSColor.black.setFill()
            notchShape(r, radius: rad).fill()
            return true
        }
    }
}

final class NotchChrome: NSView {
    var state: NotchState = .collapsed
    var greeting = "Coucou"
    var subtitle = ""
    var mono = ""                      // ligne de commande d'une demande d'agent
    /// Icône, valeur, teinte. La teinte à `nil` garde l'ancien gris.
    var chips: [(String, String, NSColor?)] = []
    /// Les rectangles des pastilles, mémorisés au dessin pour savoir
    /// laquelle est sous le curseur. Calculer la mise en page deux fois —
    /// une pour dessiner, une pour viser — serait deux occasions de
    /// diverger.
    private var chipRects: [NSRect] = []
    private var chipHover = -1
    /// Appelé avec l'indice de la pastille cliquée.
    var onChipClick: ((Int) -> Void)?
    var progress: CGFloat = 0
    var badge: NSColor?
    var alertCount = 0
    var dropActive = false { didSet { needsDisplay = true } }
    var onHover: ((Bool) -> Void)?
    var onClick: (() -> Void)?

    /// Lecture en cours : le replié montre le titre au lieu de l'heure,
    /// et BUD prend le rythme.
    var nowPlaying = "" { didSet { if nowPlaying != oldValue { marquee = 0 } } }
    /// La pochette du morceau, vignette dans le replié.
    var nowPlayingArt: NSImage? { didSet { needsDisplay = true } }
    var musicPlaying = false {
        didSet {
            sprite.equalizer = musicPlaying
            if !musicPlaying { marquee = 0 }
            needsDisplay = true
        }
    }

    // ═══════════════════════════════════════════════════════════
    //  Le lecteur réduit
    //
    //  Un clic sur la pastille Musique ne quitte plus l'aperçu
    //  pour ouvrir le grand panneau : la pastille se déplie sur
    //  place en un petit lecteur — pochette, titre, artiste,
    //  avancement, précédent, lecture, suivant. On change de
    //  morceau sans perdre ce qu'on faisait.
    //
    //  Il naît de la pastille, littéralement : son rectangle
    //  part de celui de la pastille cliquée et s'étire jusqu'à
    //  la largeur de l'aperçu, avec un léger dépassement. Un
    //  lecteur qui apparaîtrait ailleurs, en fondu, ne dirait
    //  pas d'où il vient.
    // ═══════════════════════════════════════════════════════════

    enum PlayerAction { case previous, toggle, next, open, close }
    var onPlayer: ((PlayerAction) -> Void)?

    /// Ce que le lecteur affiche, en lecture comme en pause.
    var playerTitle = "" { didSet { if playerTitle != oldValue { marquee = 0 } } }
    var playerArtist = ""
    /// Teinte de la pastille Musique, reprise par le lecteur : il en est
    /// le prolongement, il en garde la couleur.
    var playerTint: NSColor = .systemPink

    /// Position et durée connues, et l'instant où on les a apprises :
    /// la barre avance entre deux relevés au lieu de sauter de quatre
    /// secondes en quatre secondes.
    private var playerPos: Double = 0
    private var playerDur: Double = 0
    private var playerStamp = Date()

    func setPlayback(position: Double, duration: Double, known: Bool) {
        playerPos = known ? position : 0
        playerDur = known ? duration : 0
        playerStamp = Date()
    }

    private(set) var playerShown = false
    private var playerMorph: CGFloat = 0          // 0 pastilles · 1 lecteur
    private var playerOrigin = NSRect.zero
    private var playerRects: [(PlayerAction, NSRect)] = []
    private var playerHover: PlayerAction?

    /// Déplie le lecteur depuis la pastille `i`.
    func showPlayer(fromChip i: Int) {
        playerOrigin = chipRects.indices.contains(i) ? chipRects[i] : playerFrame()
        if chips.indices.contains(i), let tint = chips[i].2 { playerTint = tint }
        playerShown = true
        chipHover = -1
        needsDisplay = true
    }

    /// Replie le lecteur dans sa pastille ; `instant` saute l'animation,
    /// pour un aperçu qui se ferme de toute façon.
    func hidePlayer(instant: Bool = false) {
        playerShown = false
        playerHover = nil
        if instant { playerMorph = 0 }
        needsDisplay = true
    }

    /// La place du lecteur déplié : la bande des pastilles et de la ligne
    /// d'aide, qu'il remplace le temps qu'il est ouvert.
    private func playerFrame() -> NSRect {
        NSRect(x: 22, y: 10, width: bounds.width - 44, height: 52)
    }

    let sprite = BudSprite()
    private var phase: CGFloat = 0, dash: CGFloat = 0
    private var frames = 0
    private var marquee: CGFloat = 0
    private var eqLevels: [CGFloat] = [0.35, 0.65, 0.45, 0.80]
    private var eqClock: CGFloat = 0

    override func updateTrackingAreas() {
        super.updateTrackingAreas()
        trackingAreas.forEach { removeTrackingArea($0) }
        addTrackingArea(NSTrackingArea(rect: bounds,
                                       options: [.mouseEnteredAndExited, .mouseMoved,
                                                 .activeAlways, .inVisibleRect],
                                       owner: self, userInfo: nil))
    }
    override func mouseEntered(with e: NSEvent) { onHover?(true) }
    override func mouseExited(with e: NSEvent) {
        onHover?(false)
        if chipHover != -1 { chipHover = -1; needsDisplay = true }
    }

    override func mouseMoved(with e: NSEvent) {
        let p = convert(e.locationInWindow, from: nil)
        let a = playerAction(at: p)
        if a != playerHover { playerHover = a; needsDisplay = true }
        let i = chipIndex(at: p)
        if i != chipHover { chipHover = i; needsDisplay = true }
    }

    override func mouseUp(with e: NSEvent) {
        guard state != .open else { return }
        let p = convert(e.locationInWindow, from: nil)
        // Le lecteur d'abord : ses boutons sont posés là où étaient les
        // pastilles. Un clic dans le lecteur mais hors d'un bouton ne fait
        // rien — ouvrir le grand panneau parce qu'on a visé à côté de
        // « suivant » serait une punition.
        if playerShown && playerMorph > 0.8 {
            if let a = playerAction(at: p) { onPlayer?(a); return }
            if playerFrame().contains(p) { return }
        }
        // Une pastille cliquée mène à son panneau ; partout ailleurs, le
        // clic ouvre BUD comme avant.
        let i = chipIndex(at: p)
        if i >= 0 { onChipClick?(i); return }
        onClick?()
    }

    private func playerAction(at p: NSPoint) -> PlayerAction? {
        guard state == .glance, playerShown, playerMorph > 0.8 else { return nil }
        for (a, r) in playerRects where r.contains(p) { return a }
        return nil
    }

    /// L'indice de la pastille sous le point, ou -1.
    private func chipIndex(at p: NSPoint) -> Int {
        guard state == .glance, !playerShown, playerMorph < 0.05 else { return -1 }
        for (i, r) in chipRects.enumerated() where r.contains(p) { return i }
        return -1
    }

    private func budRect() -> NSRect {
        switch state {
        case .collapsed: return NSRect(x: 9, y: bounds.midY - 16, width: 34, height: 32)
        default:         return NSRect(x: 14, y: bounds.maxY - 94, width: 74, height: 74)
        }
    }

    func step(follow: Bool) {
        frames += 1
        phase += alertCount > 0 ? 0.20 : 0.12
        dash += 0.6
        sprite.mood = alertCount > 0 ? .alert : .calm

        if musicPlaying {
            eqClock += 1.0 / 30.0
            let f: [CGFloat] = [5.3, 7.1, 4.3, 8.7]
            let ph: [CGFloat] = [0, 1.7, 0.9, 2.4]
            for i in eqLevels.indices {
                var v = 0.5 + 0.34 * sin(eqClock * f[i] + ph[i])
                        + 0.16 * sin(eqClock * f[(i + 2) % 4] * 0.37)
                v += CGFloat.random(in: -0.06...0.06)
                eqLevels[i] = max(0.12, min(1, eqLevels[i] * 0.45 + v * 0.55))
            }
            marquee += 0.9
        }

        // Le dépli prend trois dixièmes, le repli un peu moins : on
        // referme plus vite qu'on n'ouvre, l'attention est déjà ailleurs.
        let target: CGFloat = playerShown ? 1 : 0
        if playerMorph != target {
            let speed: CGFloat = playerShown ? 1.0 / (30 * 0.30) : 1.0 / (30 * 0.22)
            playerMorph = playerShown ? min(1, playerMorph + speed) : max(0, playerMorph - speed)
            needsDisplay = true
        }
        if playerShown && musicPlaying && state == .glance { needsDisplay = true }

        let r = budRect()
        var dirty = sprite.step(follow: follow, in: self, anchor: NSPoint(x: r.midX, y: r.midY))
        if dropActive || state != .collapsed { dirty = true }
        if state == .collapsed && frames % 2 == 0 { dirty = true }
        if musicPlaying { dirty = true }
        if dirty && state != .open { needsDisplay = true }
    }

    func wave() { sprite.wave() }
    func poke() { sprite.poke() }

    /// Quatre barres, dessinées directement : imbriquer une vue dans le
    /// notch replié pour 20 pt de large serait disproportionné.
    private func drawEqBars(in r: NSRect) {
        let n = eqLevels.count
        let gap: CGFloat = 2.5
        let w = (r.width - gap * CGFloat(n - 1)) / CGFloat(n)
        guard w > 0 else { return }
        for i in 0..<n {
            let h = max(2.5, r.height * eqLevels[i])
            let bar = NSRect(x: r.minX + CGFloat(i) * (w + gap), y: r.minY, width: w, height: h)
            TH.accent.withAlphaComponent(0.55 + 0.40 * eqLevels[i]).setFill()
            NSBezierPath(roundedRect: bar, xRadius: w / 2, yRadius: w / 2).fill()
        }
    }

    /// Titre défilant. Un texte plus large que la place disponible est
    /// dessiné deux fois, à une longueur d'écart, pour que la boucle ne
    /// montre jamais de trou. En dessous, il reste simplement centré.
    private func drawMarquee(_ s: String, in r: NSRect, size: CGFloat, color: NSColor) {
        let tw = textWidth(s, size: size, weight: .semibold)
        guard tw > r.width else {
            drawString(s, in: r, size: size, weight: .semibold, color: color)
            return
        }
        let gapWidth: CGFloat = 36
        let span = tw + gapWidth
        let off = marquee.truncatingRemainder(dividingBy: span)

        NSGraphicsContext.current?.saveGraphicsState()
        NSBezierPath(rect: r).addClip()
        for k in 0..<2 {
            let x = r.minX - off + CGFloat(k) * span
            drawString(s, in: NSRect(x: x, y: r.minY, width: tw + 4, height: r.height),
                       size: size, weight: .semibold, color: color)
        }
        // Dégradés aux deux bords : le texte s'efface au lieu d'être coupé.
        if let g = NSGradient(colors: [TH.base.withAlphaComponent(TH.baseAlpha),
                                       TH.base.withAlphaComponent(0)],
                              atLocations: [0, 1], colorSpace: .deviceRGB) {
            g.draw(in: NSRect(x: r.minX, y: r.minY, width: 10, height: r.height), angle: 0)
            g.draw(in: NSRect(x: r.maxX - 10, y: r.minY, width: 10, height: r.height), angle: 180)
        }
        NSGraphicsContext.current?.restoreGraphicsState()
    }

    override func draw(_ dirty: NSRect) {
        let b = bounds
        let radius: CGFloat = state == .collapsed ? 15 : (state == .open ? 30 : 26)
        let shape = notchShape(b, radius: radius)
        TH.base.withAlphaComponent(TH.baseAlpha).setFill()
        shape.fill()
        if alertCount > 0 && state != .open {
            warnColor.withAlphaComponent(0.22 + 0.18 * CGFloat(abs(sin(phase)))).setStroke()
            shape.lineWidth = 2
        } else {
            TH.fill(0.07).setStroke()
            shape.lineWidth = 1
        }
        shape.stroke()

        if dropActive {
            let zone = b.insetBy(dx: 16, dy: 16)
            let p = NSBezierPath(roundedRect: zone, xRadius: 18, yRadius: 18)
            TH.accent.withAlphaComponent(0.08).setFill()
            p.fill()
            p.lineWidth = 2
            p.setLineDash([7, 5], count: 2, phase: dash)
            TH.accent.withAlphaComponent(0.85).setStroke()
            p.stroke()
            drawSymbol("tray.and.arrow.down.fill", center: NSPoint(x: b.midX, y: b.midY + 18),
                       size: 26, weight: .semibold, color: TH.accent)
            drawString("Déposez vos fichiers, je les range",
                       in: NSRect(x: 0, y: b.midY - 24, width: b.width, height: 20),
                       size: 13, weight: .semibold, color: TH.text, align: .center)
            return
        }

        if state == .open { return }

        if state == .collapsed {
            sprite.render(in: budRect(), detail: false,
                          glowColor: alertCount > 0 ? warnColor : TH.accent)
            // Pendant la lecture, le titre prend la place de l'heure :
            // 214 pt ne suffisent pas pour les deux, et savoir ce qui joue
            // vaut mieux qu'une horloge présente partout ailleurs.
            if musicPlaying && !nowPlaying.isEmpty && alertCount == 0 {
                let reserved: CGFloat = badge != nil ? 34 : 14
                var x: CGFloat = 48
                if let art = nowPlayingArt {
                    let ar = NSRect(x: x, y: b.midY - 9, width: 18, height: 18)
                    let cp = NSBezierPath(roundedRect: ar, xRadius: 5, yRadius: 5)
                    NSGraphicsContext.current?.saveGraphicsState()
                    cp.addClip()
                    let s = art.size
                    if s.width > 0 && s.height > 0 {
                        let k = max(ar.width / s.width, ar.height / s.height)
                        let w = s.width * k, h = s.height * k
                        art.draw(in: NSRect(x: ar.midX - w / 2, y: ar.midY - h / 2,
                                            width: w, height: h))
                    }
                    NSGraphicsContext.current?.restoreGraphicsState()
                    TH.fill(0.10).setStroke()
                    cp.lineWidth = 1
                    cp.stroke()
                    x = ar.maxX + 7
                }
                drawEqBars(in: NSRect(x: x, y: b.midY - 7, width: 20, height: 14))
                let mx = x + 26
                drawMarquee(nowPlaying,
                            in: NSRect(x: mx, y: b.midY - 8,
                                       width: max(40, b.maxX - mx - reserved), height: 16),
                            size: 11.5, color: TH.text)
            } else {
                // L'heure comme sur un iPhone : collée à gauche, en gras,
                // avec la date du jour à sa droite en plus discret. Les
                // chiffres sont à largeur fixe, sinon l'heure tremblerait
                // à chaque minute — un « 1 » est plus étroit qu'un « 8 ».
                let t = clockString()
                let tw = textWidth(t, size: 14, weight: .bold, mono: true)
                drawString(t, in: NSRect(x: 50, y: b.midY - 9, width: tw + 3, height: 19),
                           size: 14, weight: .bold, color: TH.text, mono: true)

                let reserved: CGFloat = alertCount > 0 || badge != nil ? 34 : 14
                let dx = 50 + tw + 9
                let dw = b.maxX - dx - reserved
                if dw > 40 {
                    drawString(shortDateString(),
                               in: NSRect(x: dx, y: b.midY - 7, width: dw, height: 15),
                               size: 10.5, weight: .medium, color: TH.dim(0.42))
                }
            }
            if alertCount > 0 {
                let txt = alertCount > 9 ? "9+" : "\(alertCount)"
                let w = max(17, textWidth(txt, size: 9.5, weight: .bold) + 11)
                let br = NSRect(x: b.maxX - w - 12, y: b.midY - 8, width: w, height: 16)
                dangerColor.setFill()
                capsule(br).fill()
                drawString(txt, in: NSRect(x: br.minX, y: br.minY + 2, width: br.width, height: 12),
                           size: 9.5, weight: .bold, color: .white, align: .center, mono: true)
            } else if let badge = badge {
                let p = 5 + sin(phase) * 1.0
                badge.setFill()
                NSBezierPath(ovalIn: NSRect(x: b.maxX - 24 - p / 2, y: b.midY - p / 2,
                                            width: p, height: p)).fill()
            }
            return
        }

        // ── Aperçu et carte d'approbation ──
        sprite.render(in: budRect(), detail: true,
                    glowColor: alertCount > 0 ? warnColor : TH.accent)

        let top = b.maxY
        let left: CGFloat = 98
        let right = b.width - 22

        drawString(greeting, in: NSRect(x: left, y: top - 50, width: right - left, height: 24),
                   size: 16.5, weight: .bold, color: TH.text)
        drawString(subtitle, in: NSRect(x: left, y: top - 74, width: right - left, height: 20),
                   size: 12, weight: .medium, color: TH.dim(0.58))

        if state == .approval {
            if !mono.isEmpty {
                let boxRect = NSRect(x: left, y: top - 116, width: right - left, height: 34)
                TH.fill(0.09).setFill()
                NSBezierPath(roundedRect: boxRect, xRadius: 10, yRadius: 10).fill()
                TH.fill(0.07).setStroke()
                let bp = NSBezierPath(roundedRect: boxRect, xRadius: 10, yRadius: 10)
                bp.lineWidth = 1
                bp.stroke()
                drawString(mono, in: NSRect(x: boxRect.minX + 12, y: boxRect.midY - 8,
                                            width: boxRect.width - 24, height: 17),
                           size: 12, weight: .medium, color: TH.text, mono: true)
            }
            return   // les boutons sont de vraies vues, posées par le délégué
        }

        if progress > 0.001 {
            let t = NSRect(x: 22, y: top - 92, width: b.width - 44, height: 4)
            TH.fill(0.12).setFill()
            NSBezierPath(roundedRect: t, xRadius: 2, yRadius: 2).fill()
            TH.accent.setFill()
            NSBezierPath(roundedRect: NSRect(x: t.minX, y: t.minY, width: t.width * min(1, progress), height: 4),
                         xRadius: 2, yRadius: 2).fill()
        }

        // Les pastilles et la ligne d'aide s'effacent pendant que le
        // lecteur se déplie : on les dessine dans un calque dont
        // l'opacité suit le dépli, plutôt que de les retirer d'un coup.
        let chipAlpha = 1 - min(1, playerMorph * 1.6)
        let ctx = NSGraphicsContext.current?.cgContext
        if chipAlpha < 1 {
            ctx?.saveGState()
            ctx?.setAlpha(chipAlpha)
            ctx?.beginTransparencyLayer(auxiliaryInfo: nil)
        }
        if !chips.isEmpty && chipAlpha > 0 {
            let gap: CGFloat = 8
            let cw = (b.width - 44 - gap * CGFloat(chips.count - 1)) / CGFloat(chips.count)
            chipRects.removeAll()
            for (i, chip) in chips.enumerated() {
                let r = NSRect(x: 22 + CGFloat(i) * (cw + gap), y: top - 128, width: cw, height: 28)
                chipRects.append(r)
                let tint = chip.2 ?? TH.dim(0.68)
                let live = (i == chipHover)
                // La pastille survolée s'éclaire de sa propre teinte : c'est
                // ce qui dit qu'elle se clique, sans ajouter un libellé.
                (live ? tint.withAlphaComponent(0.20) : TH.fill(0.09)).setFill()
                capsule(r).fill()
                let sp = capsule(r)
                (live ? tint.withAlphaComponent(0.50) : TH.fill(0.07)).setStroke()
                sp.lineWidth = 1
                sp.stroke()
                drawSymbol(chip.0, center: NSPoint(x: r.minX + 17, y: r.midY), size: 11.5,
                           weight: .semibold, color: tint)
                let maxW = r.width - 32
                drawString(chip.1, in: NSRect(x: r.minX + 28, y: r.midY - 8, width: maxW, height: 16),
                           size: 11.5, weight: .semibold, color: TH.text, mono: true)
            }
        }

        if chipAlpha > 0 {
            drawString("Cliquer pour ouvrir · déposer des fichiers ici",
                       in: NSRect(x: 0, y: 8, width: b.width, height: 14),
                       size: 9.5, weight: .medium, color: TH.dim(0.26), align: .center)
        }
        if chipAlpha < 1 {
            ctx?.endTransparencyLayer()
            ctx?.restoreGState()
        }

        if playerMorph > 0.001 { drawPlayer() } else { playerRects.removeAll() }
    }

    // ─────────────────────────────────────────────────────────
    //  Le lecteur réduit, dessiné
    // ─────────────────────────────────────────────────────────

    /// Dépli élastique : le lecteur dépasse un peu sa largeur puis s'y
    /// pose. Au repli, une courbe douce — un ressort qui se referme en
    /// rebondissant aurait l'air de résister.
    private func playerEase(_ x: CGFloat) -> CGFloat {
        let c = max(0, min(1, x))
        if !playerShown { return c * c * (3 - 2 * c) }
        if c >= 1 { return 1 }
        return 1 - exp(-6.0 * c) * cos(8.0 * c)
    }

    private func lerp(_ a: NSRect, _ b: NSRect, _ t: CGFloat) -> NSRect {
        NSRect(x: a.minX + (b.minX - a.minX) * t, y: a.minY + (b.minY - a.minY) * t,
               width: a.width + (b.width - a.width) * t,
               height: a.height + (b.height - a.height) * t)
    }

    private func drawPlayer() {
        let full = playerFrame()
        let origin = playerOrigin == .zero ? full : playerOrigin
        let e = playerEase(playerMorph)
        let r = lerp(origin, full, e)
        let radius = min(r.height / 2, 14 + (1 - e) * 6)

        // La coque garde la teinte de la pastille : c'est elle qui grandit.
        let shell = NSBezierPath(roundedRect: r, xRadius: radius, yRadius: radius)
        playerTint.withAlphaComponent(0.10 + 0.06 * (1 - e)).setFill()
        shell.fill()
        TH.fill(0.06).setFill()
        shell.fill()
        playerTint.withAlphaComponent(0.42).setStroke()
        shell.lineWidth = 1
        shell.stroke()

        // Le contenu n'apparaît qu'une fois la coque presque dépliée :
        // un titre qui s'étire avec elle serait illisible le temps du
        // mouvement.
        let ca = max(0, min(1, (playerMorph - 0.45) / 0.55))
        playerRects.removeAll()
        guard ca > 0.01 else { return }

        NSGraphicsContext.current?.saveGraphicsState()
        NSBezierPath(roundedRect: r, xRadius: radius, yRadius: radius).addClip()
        let ctx = NSGraphicsContext.current?.cgContext
        ctx?.setAlpha(ca)
        ctx?.beginTransparencyLayer(auxiliaryInfo: nil)

        // ── La pochette, ou une note quand il n'y en a pas ──
        let art = NSRect(x: full.minX + 6, y: full.minY + 6, width: 40, height: 40)
        let ap = NSBezierPath(roundedRect: art, xRadius: 9, yRadius: 9)
        if let img = nowPlayingArt, img.size.width > 0, img.size.height > 0 {
            NSGraphicsContext.current?.saveGraphicsState()
            ap.addClip()
            let k = max(art.width / img.size.width, art.height / img.size.height)
            let w = img.size.width * k, h = img.size.height * k
            img.draw(in: NSRect(x: art.midX - w / 2, y: art.midY - h / 2, width: w, height: h))
            NSGraphicsContext.current?.restoreGraphicsState()
        } else {
            playerTint.withAlphaComponent(0.22).setFill()
            ap.fill()
            drawSymbol("music.note", center: NSPoint(x: art.midX, y: art.midY), size: 16,
                       weight: .semibold, color: playerTint)
        }
        TH.fill(0.10).setStroke()
        ap.lineWidth = 1
        ap.stroke()
        // Pendant la lecture, l'égaliseur se pose sur un coin de la
        // pochette : on voit d'un coup d'œil que ça joue.
        if musicPlaying {
            let eq = NSRect(x: art.maxX - 15, y: art.minY + 4, width: 11, height: 9)
            NSColor.black.withAlphaComponent(0.35).setFill()
            NSBezierPath(roundedRect: eq.insetBy(dx: -2.5, dy: -2), xRadius: 3, yRadius: 3).fill()
            drawEqBars(in: eq)
        }

        // ── Les commandes, à droite ──
        let cy = full.midY
        let close = NSRect(x: full.maxX - 26, y: cy - 10, width: 20, height: 20)
        let next = NSRect(x: close.minX - 34, y: cy - 14, width: 28, height: 28)
        let play = NSRect(x: next.minX - 38, y: cy - 16, width: 32, height: 32)
        let prev = NSRect(x: play.minX - 34, y: cy - 14, width: 28, height: 28)
        let textX = art.maxX + 10
        let textW = max(40, prev.minX - 10 - textX)
        playerRects = [(.previous, prev), (.toggle, play), (.next, next), (.close, close),
                       (.open, NSRect(x: art.minX, y: full.minY, width: textX + textW - art.minX,
                                      height: full.height))]

        func button(_ a: PlayerAction, _ rect: NSRect, _ symbol: String, _ size: CGFloat,
                    filled: Bool = false) {
            let hot = playerHover == a
            if filled {
                (hot ? playerTint : playerTint.withAlphaComponent(0.88)).setFill()
                NSBezierPath(ovalIn: rect).fill()
                drawSymbol(symbol, center: NSPoint(x: rect.midX + (symbol == "play.fill" ? 1 : 0),
                                                   y: rect.midY),
                           size: size, weight: .bold, color: .white)
            } else {
                if hot {
                    TH.fill(0.12).setFill()
                    NSBezierPath(ovalIn: rect).fill()
                }
                drawSymbol(symbol, center: NSPoint(x: rect.midX, y: rect.midY), size: size,
                           weight: .semibold, color: hot ? TH.text : TH.dim(0.78))
            }
        }
        button(.previous, prev, "backward.fill", 12)
        button(.toggle, play, musicPlaying ? "pause.fill" : "play.fill", 13, filled: true)
        button(.next, next, "forward.fill", 12)
        button(.close, close, "chevron.down", 10)

        // ── Titre, artiste, avancement ──
        let hasTrack = !playerTitle.isEmpty
        let title = hasTrack ? playerTitle : "Rien en lecture"
        let sub = hasTrack ? (playerArtist.isEmpty ? "Musique" : playerArtist)
                           : "Touchez lecture pour lancer Musique"
        drawMarquee(title, in: NSRect(x: textX, y: cy + 3, width: textW, height: 16),
                    size: 12.5, color: TH.text)
        drawString(sub, in: NSRect(x: textX, y: cy - 12, width: textW, height: 14),
                   size: 10.5, weight: .medium, color: TH.dim(0.55))

        if playerDur > 0 {
            let elapsed = musicPlaying ? Date().timeIntervalSince(playerStamp) : 0
            let f = CGFloat(max(0, min(1, (playerPos + elapsed) / playerDur)))
            let track = NSRect(x: textX, y: full.minY + 7, width: textW, height: 3)
            TH.fill(0.14).setFill()
            NSBezierPath(roundedRect: track, xRadius: 1.5, yRadius: 1.5).fill()
            playerTint.setFill()
            NSBezierPath(roundedRect: NSRect(x: track.minX, y: track.minY,
                                             width: max(3, track.width * f), height: 3),
                         xRadius: 1.5, yRadius: 1.5).fill()
        }

        ctx?.endTransparencyLayer()
        NSGraphicsContext.current?.restoreGraphicsState()
    }
}

final class DropHost: NSView {
    var onEnter: (() -> Void)?
    var onExit: (() -> Void)?
    var onDrop: (([URL]) -> Void)?

    override init(frame: NSRect) {
        super.init(frame: frame)
        registerForDraggedTypes([.fileURL])
    }
    required init?(coder: NSCoder) { fatalError() }

    override func draggingEntered(_ s: NSDraggingInfo) -> NSDragOperation { onEnter?(); return .copy }
    override func draggingUpdated(_ s: NSDraggingInfo) -> NSDragOperation { .copy }
    override func draggingExited(_ s: NSDraggingInfo?) { onExit?() }
    override func prepareForDragOperation(_ s: NSDraggingInfo) -> Bool { true }
    override func performDragOperation(_ s: NSDraggingInfo) -> Bool {
        let opts: [NSPasteboard.ReadingOptionKey: Any] = [.urlReadingFileURLsOnly: true]
        let urls = s.draggingPasteboard.readObjects(forClasses: [NSURL.self], options: opts) as? [URL] ?? []
        guard !urls.isEmpty else { onExit?(); return false }
        onDrop?(urls)
        return true
    }
}

final class NotchPanel: NSPanel {
    override var canBecomeKey: Bool { true }
    override var canBecomeMain: Bool { false }
}

// ═══════════════════════════════════════════════════════════
//  Contrôles sobres : segments et interrupteurs
// ═══════════════════════════════════════════════════════════

/// Groupe de segments dans un seul cadre, à la manière des réglages macOS.
final class SegmentedBar: NSView {
    struct Item { let title: String; let icon: String? }
    private let items: [Item]
    var selected = 0 { didSet { needsDisplay = true } }
    var onSelect: ((Int) -> Void)?
    private var hoverIndex = -1

    init(frame: NSRect, items: [Item], selected: Int = 0) {
        self.items = items
        self.selected = selected
        super.init(frame: frame)
        wantsLayer = true
    }
    required init?(coder: NSCoder) { fatalError() }

    private func indexAt(_ p: NSPoint) -> Int {
        guard !items.isEmpty, bounds.contains(p) else { return -1 }
        let w = bounds.width / CGFloat(items.count)
        return min(items.count - 1, max(0, Int(p.x / w)))
    }

    override func updateTrackingAreas() {
        super.updateTrackingAreas()
        trackingAreas.forEach { removeTrackingArea($0) }
        addTrackingArea(NSTrackingArea(rect: bounds,
                                       options: [.mouseEnteredAndExited, .mouseMoved, .activeAlways, .inVisibleRect],
                                       owner: self, userInfo: nil))
    }
    override func mouseMoved(with e: NSEvent) {
        let i = indexAt(convert(e.locationInWindow, from: nil))
        if i != hoverIndex { hoverIndex = i; needsDisplay = true }
    }
    override func mouseExited(with e: NSEvent) { hoverIndex = -1; needsDisplay = true }
    override func mouseUp(with e: NSEvent) {
        let i = indexAt(convert(e.locationInWindow, from: nil))
        guard i >= 0 else { return }
        selected = i
        onSelect?(i)
    }

    override func draw(_ dirty: NSRect) {
        let r = bounds.insetBy(dx: 0.5, dy: 0.5)
        // Le conteneur est creux — niveau 0 — et la cellule choisie
        // ressort au niveau 2 : c'est le même langage d'élévation que
        // les cartes et les boutons, et non un style propre à la barre.
        drawGlass(in: bounds, radius: Radius.m, level: 0)

        let w = r.width / CGFloat(items.count)
        for (i, it) in items.enumerated() {
            let cell = NSRect(x: r.minX + CGFloat(i) * w, y: r.minY, width: w, height: r.height).insetBy(dx: 3, dy: 3)
            if i == selected {
                drawGlass(in: cell, radius: Radius.s, level: 2,
                          tint: TH.accent.withAlphaComponent(0.42))
            } else if i == hoverIndex {
                drawGlass(in: cell, radius: Radius.s, level: 1, hover: 0.6)
            }

            let fg = i == selected ? TH.text : TH.dim(i == hoverIndex ? 0.75 : 0.5)
            let tw = textWidth(it.title, size: 12, weight: i == selected ? .semibold : .medium)
            let iconW: CGFloat = it.icon == nil ? 0 : 20
            var x = cell.midX - (tw + iconW) / 2
            if let ic = it.icon {
                drawSymbol(ic, center: NSPoint(x: x + 7, y: cell.midY), size: 12.5,
                           weight: .semibold, color: i == selected ? TH.accent : fg)
                x += iconW
            }
            drawString(it.title, in: NSRect(x: x, y: cell.midY - 8, width: tw + 4, height: 16),
                       size: 12, weight: i == selected ? .semibold : .medium, color: fg)
        }
    }
}

/// Rangée d'option : icône, libellé, interrupteur à droite.
final class ToggleRow: NSView {
    let title: String
    let iconName: String
    var isOn = false {
        didSet { if isOn != oldValue { animateKnob() } }
    }
    var onToggle: (() -> Void)?

    private var knobT: CGFloat = 0
    private var hover = false
    private var anim: Timer?

    init(frame: NSRect, title: String, icon: String) {
        self.title = title
        self.iconName = icon
        super.init(frame: frame)
        wantsLayer = true
    }
    required init?(coder: NSCoder) { fatalError() }

    func setOn(_ v: Bool, animated: Bool = true) {
        if !animated { knobT = v ? 1 : 0 }
        isOn = v
        needsDisplay = true
    }

    private func animateKnob() {
        guard anim == nil else { return }
        let t = Timer(timeInterval: 1.0 / 60.0, repeats: true) { [weak self] tm in
            guard let s = self else { tm.invalidate(); return }
            let target: CGFloat = s.isOn ? 1 : 0
            s.knobT += (target - s.knobT) * 0.3
            if abs(target - s.knobT) < 0.01 { s.knobT = target; tm.invalidate(); s.anim = nil }
            s.needsDisplay = true
        }
        anim = t
        RunLoop.main.add(t, forMode: .common)
    }

    override func updateTrackingAreas() {
        super.updateTrackingAreas()
        trackingAreas.forEach { removeTrackingArea($0) }
        addTrackingArea(NSTrackingArea(rect: bounds, options: [.mouseEnteredAndExited, .activeAlways, .inVisibleRect],
                                       owner: self, userInfo: nil))
    }
    override func mouseEntered(with e: NSEvent) { hover = true; needsDisplay = true }
    override func mouseExited(with e: NSEvent) { hover = false; needsDisplay = true }
    override func mouseUp(with e: NSEvent) {
        guard bounds.contains(convert(e.locationInWindow, from: nil)) else { return }
        onToggle?()
    }

    override func draw(_ dirty: NSRect) {
        let r = bounds.insetBy(dx: 0.5, dy: 0.5)
        let card = NSBezierPath(roundedRect: r, xRadius: 12, yRadius: 12)
        TH.fill(hover ? 0.09 : 0.05).setFill()
        card.fill()
        TH.fill(isOn ? 0.10 : 0.07).setStroke()
        card.lineWidth = 1
        card.stroke()

        drawSymbol(iconName, center: NSPoint(x: r.minX + (r.width < 230 ? 18 : 20), y: r.midY),
                   size: r.width < 230 ? 12.5 : 13, weight: .semibold,
                   color: isOn ? TH.accent : TH.dim(0.45))

        // Interrupteur, réduit quand la rangée est étroite
        let narrow = r.width < 230
        let tw: CGFloat = narrow ? 34 : 40
        let th: CGFloat = narrow ? 19 : 22
        let track = NSRect(x: r.maxX - tw - 12, y: r.midY - th / 2, width: tw, height: th)
        if isOn || knobT > 0.01 {
            TH.fill(0.12).setFill()
            capsule(track).fill()
            TH.accent.withAlphaComponent(knobT).setFill()
            capsule(track).fill()
        } else {
            TH.fill(0.12).setFill()
            capsule(track).fill()
        }
        let kd: CGFloat = th - 6
        let kx = track.minX + 3 + knobT * (tw - kd - 6)
        let knob = NSRect(x: kx, y: track.midY - kd / 2, width: kd, height: kd)
        NSColor.white.withAlphaComponent(TH.dark ? 0.95 : 1).setFill()
        NSBezierPath(ovalIn: knob).fill()

        let labelX = r.minX + (narrow ? 34 : 38)
        let labelMax = max(10, track.minX - labelX - 8)
        drawString(title, in: NSRect(x: labelX, y: r.midY - 8, width: labelMax, height: 16),
                   size: narrow ? 11 : 11.5, weight: .medium, color: isOn ? TH.text : TH.dim(0.65))
    }
}

// ═══════════════════════════════════════════════════════════
//  La fenêtre des raccourcis
//
//  Une fenêtre à part, et non une section des Réglages : les
//  cinq rangées d'interrupteurs occupent déjà le panneau jusqu'à
//  six points du bord. Dix raccourcis n'y entraient pas sans
//  tout recomposer, et une liste qu'on modifie mérite de la
//  place.
// ═══════════════════════════════════════════════════════════

final class ShortcutsWindow: NSWindowController {

    /// Appelé à chaque changement : l'action et son nouveau raccourci.
    var onSet: ((String, String) -> Void)?
    /// Appelé quand l'utilisateur rend tout à l'usine.
    var onReset: (() -> Void)?

    private var recorders: [String: KeyRecorder] = [:]
    private var note: NSTextField!
    private var current: (String) -> String

    /// Les quatre pastilles de l'aperçu en vigueur.
    var chipsNow: () -> [String] = { PreviewChips.fallback }
    /// Appelé quand une pastille change : l'emplacement et la nouvelle clé.
    var onChipSet: ((Int, String) -> Void)?
    private var chipPops: [NSPopUpButton] = []

    /// Largeur et hauteur fixes : la fenêtre n'est pas redimensionnable, et
    /// toute la mise en page part de ces deux nombres.
    private static let W: CGFloat = 560
    private static var H: CGFloat { CGFloat(Shortcuts.actions.count) * 42 + 322 }

    init(current: @escaping (String) -> String) {
        self.current = current
        let H = ShortcutsWindow.H

        // Un NSPanel, et non une fenêtre ordinaire.
        //
        //  Le panneau de BUD vit au niveau `.statusBar`, au-dessus de tout.
        //  Une fenêtre de niveau normal passait donc derrière lui dès qu'on
        //  le rouvrait, et devenait inatteignable sans replier BUD. Le
        //  panneau se place juste au-dessus, et `isFloatingPanel` le garde
        //  devant les autres fenêtres de l'application.
        //
        //  Il doit pouvoir devenir fenêtre clé : le capteur de raccourci
        //  écoute par un moniteur local, qui ne reçoit les touches que si
        //  la fenêtre a le focus.
        let w = NSPanel(contentRect: NSRect(x: 0, y: 0, width: ShortcutsWindow.W, height: H),
                        styleMask: [.titled, .closable, .utilityWindow],
                        backing: .buffered, defer: false)
        w.title = "Raccourcis et aperçu"
        w.isReleasedWhenClosed = false
        w.isFloatingPanel = true
        w.hidesOnDeactivate = false
        w.becomesKeyOnlyIfNeeded = false
        w.level = NSWindow.Level(rawValue: NSWindow.Level.statusBar.rawValue + 1)
        w.center()
        super.init(window: w)
        build(H)
    }
    required init?(coder: NSCoder) { fatalError() }

    private func build(_ H: CGFloat) {
        guard let content = window?.contentView else { return }
        let W = ShortcutsWindow.W

        let title = mkLabel("Choisissez vos raccourcis",
                            NSRect(x: 22, y: H - 42, width: W - 44, height: 22), 15, .bold)
        content.addSubview(title)
        let sub = mkLabel("Cliquez un raccourci, puis tapez la combinaison. Échap annule.",
                          NSRect(x: 22, y: H - 66, width: W - 44, height: 16), 11.5, .regular, alpha: 0.5)
        content.addSubview(sub)

        for (i, a) in Shortcuts.actions.enumerated() {
            let y = H - 98 - CGFloat(i) * 42
            let lab = mkLabel(a.label, NSRect(x: 22, y: y, width: W - 190, height: 20), 12.5, .medium)
            content.addSubview(lab)

            let rec = KeyRecorder(frame: NSRect(x: W - 152, y: y - 5, width: 130, height: 30),
                                  combo: current(a.key))
            let key = a.key
            rec.conflict = { [weak self] candidate in
                guard let s = self else { return nil }
                for other in Shortcuts.actions where other.key != key {
                    if s.current(other.key) == candidate { return other.label }
                }
                return nil
            }
            rec.onChange = { [weak self] combo in
                self?.onSet?(key, combo)
                self?.note.stringValue = "\(a.label) : \(Shortcuts.display(combo))"
                self?.note.textColor = TH.dim(0.55)
            }
            rec.onRefuse = { [weak self] why in
                self?.note.stringValue = why
                self?.note.textColor = dangerColor
            }
            content.addSubview(rec)
            recorders[a.key] = rec
        }

        // ── Les quatre pastilles de l'aperçu ──
        //
        //  Deux rangées de deux, et non quatre de front. À quatre, chaque
        //  menu recevait 113 points et tronquait ses intitulés — « Disques
        //  ex… », « Focus en c… ». Deux par rangée en donnent 252, où
        //  « Disques externes » tient en entier.
        let sec = mkLabel("Pastilles de l'aperçu",
                          NSRect(x: 22, y: 194, width: W - 44, height: 18), 12.5, .bold)
        content.addSubview(sec)
        let hint2 = mkLabel("Ce que montrent les quatre capsules sous la salutation. Un clic dessus ouvre le panneau correspondant.",
                            NSRect(x: 22, y: 170, width: W - 44, height: 16), 10.5, .regular, alpha: 0.45)
        content.addSubview(hint2)

        let keys = chipsNow()
        let pw = (W - 44 - 12) / 2
        for slot in 0..<4 {
            let col = CGFloat(slot % 2), row = CGFloat(slot / 2)
            let pop = NSPopUpButton(frame: NSRect(x: 22 + col * (pw + 12),
                                                  y: 134 - row * 34, width: pw, height: 28))
            for c in PreviewChips.catalogue { pop.addItem(withTitle: c.label) }
            if slot < keys.count,
               let i = PreviewChips.catalogue.firstIndex(where: { $0.key == keys[slot] }) {
                pop.selectItem(at: i)
            }
            pop.tag = slot
            pop.target = self
            pop.action = #selector(chipPicked(_:))
            content.addSubview(pop)
            chipPops.append(pop)
        }

        // La note de statut vivait à 50..80 et les menus à 60..86 : elle les
        // recouvrait de vingt points. Posée après eux, elle était au-dessus,
        // et comme un NSTextField reste une cible de clic même non
        // modifiable, elle avalait les clics destinés aux menus. C'est
        // pourquoi ils paraissaient inertes : ils ne recevaient rien.
        note = mkLabel("", NSRect(x: 22, y: 58, width: W - 44, height: 32), 11, .regular, alpha: 0.55)
        note.lineBreakMode = .byWordWrapping
        note.maximumNumberOfLines = 2
        note.cell?.usesSingleLineMode = false
        note.cell?.wraps = true
        // Et par précaution, elle ne prend plus aucun clic : une étiquette
        // de statut n'a rien à intercepter, quelle que soit sa position.
        note.isSelectable = false
        note.refusesFirstResponder = true
        content.addSubview(note)

        let reset = GlassButton(frame: NSRect(x: 22, y: 14, width: 210, height: 34),
                                title: "Rendre les raccourcis d'usine", icon: "arrow.counterclockwise")
        reset.onClick = { [weak self] _ in
            guard let s = self else { return }
            s.onReset?()
            for a in Shortcuts.actions { s.recorders[a.key]?.combo = a.fallback }
            s.note.stringValue = "Raccourcis d'usine rétablis."
            s.note.textColor = TH.dim(0.55)
        }
        content.addSubview(reset)

        let done = GlassButton(frame: NSRect(x: W - 122, y: 14, width: 100, height: 34),
                               title: "Terminé", icon: "checkmark", prominent: true)
        done.onClick = { [weak self] _ in self?.window?.close() }
        content.addSubview(done)
    }

    @objc private func chipPicked(_ sender: NSPopUpButton) {
        let i = sender.indexOfSelectedItem
        guard i >= 0, i < PreviewChips.catalogue.count else { return }
        let c = PreviewChips.catalogue[i]
        onChipSet?(sender.tag, c.key)
        note.stringValue = "Pastille \(sender.tag + 1) : \(c.label)."
        note.textColor = TH.dim(0.55)
    }

    /// Relit les raccourcis en vigueur — utile si l'état a changé ailleurs.
    func refresh() {
        for a in Shortcuts.actions { recorders[a.key]?.combo = current(a.key) }
        let keys = chipsNow()
        for (slot, pop) in chipPops.enumerated() where slot < keys.count {
            if let i = PreviewChips.catalogue.firstIndex(where: { $0.key == keys[slot] }) {
                pop.selectItem(at: i)
            }
        }
    }
}
EOF_BUDUI_SWIFT

cat << 'EOF_BUDUPDATE_SWIFT' > "$SRC_DIR/BudUpdate.swift"
import Cocoa
import CryptoKit

// ═══════════════════════════════════════════════════════════
//  Mise à jour intégrée
//
//  BUD interroge l'API des releases GitHub, seule source de
//  vérité : la release porte à la fois le numéro de version,
//  l'archive et les empreintes. Rien n'ouvre le navigateur.
//
//  Le parcours, et ce qui l'arrête :
//
//    1. Vérifier    la release est plus récente que ce paquet
//    2. Télécharger l'archive .zip, avec progression réelle
//    3. Contrôler   SHA-256 publié, puis le paquet extrait :
//                   identifiant, version, architecture
//    4. Installer   un script détaché attend la fin de BUD
//                   (par son PID), échange les paquets,
//                   relance, et revient à l'ancien si le
//                   nouveau ne tient pas debout
//
//  Tant que l'étape 4 n'a pas commencé, l'installation
//  actuelle n'est pas touchée : tout le reste se passe dans
//  un dossier temporaire. Un échec avant ce point ne coûte
//  qu'un téléchargement.
//
//  Un canal personnalisé au vieux format reste accepté :
//  { "version": "…", "notes": "…", "url": "…" }
// ═══════════════════════════════════════════════════════════

struct UpdateInfo {
    let version: String
    let notes: String
    let url: String            // l'archive que BUD télécharge
    var pageURL: String = ""   // la page de la release
    var assetName: String = "" // son nom, pour retrouver sa ligne d'empreinte
    var sha256URL: String = "" // SHA256.txt publié avec la release
    var size: Int64 = 0        // annoncée par GitHub, pour la progression

    /// Une archive s'installe sans intervention ; un .dmg demanderait
    /// qu'on le monte et qu'on glisse — ce n'est plus de l'intégré.
    var installable: Bool { url.lowercased().hasSuffix(".zip") }

    /// La première ligne utile des notes, pour une bannière d'une ligne.
    var headline: String {
        notes.split(separator: "\n")
            .map { $0.trimmingCharacters(in: CharacterSet(charactersIn: "#*-> ").union(.whitespaces)) }
            .first { !$0.isEmpty } ?? ""
    }
}

/// Les outils sans état : lecture du canal, comparaison, empreintes.
enum BudUpdater {

    static let repo = "Lahbib-colab/bud-premium"
    static let defaultChannel =
        "https://api.github.com/repos/Lahbib-colab/bud-premium/releases/latest"

    /// L'architecture de CE binaire, décidée à la compilation.
    static var myArch: String {
        #if arch(arm64)
        return "arm64"
        #else
        return "x86_64"
        #endif
    }

    /// La version de ce paquet, lue dans son Info.plist — celle que macOS
    /// affiche — avec la constante du code en secours.
    static var currentVersion: String {
        Bundle.main.infoDictionary?["CFBundleShortVersionString"] as? String ?? budVersion
    }

    /// Compare « 14.10 » et « 14.9 » correctement, segment par segment.
    static func isNewer(_ candidate: String, than current: String) -> Bool {
        let a = candidate.split(separator: ".").map { Int($0) ?? 0 }
        let b = current.split(separator: ".").map { Int($0) ?? 0 }
        for i in 0..<max(a.count, b.count) {
            let x = i < a.count ? a[i] : 0
            let y = i < b.count ? b[i] : 0
            if x != y { return x > y }
        }
        return false
    }

    static func check(_ channel: String, done: @escaping (UpdateInfo?, String?) -> Void) {
        guard let url = URL(string: channel) else {
            done(nil, "adresse de canal invalide")
            return
        }
        var req = URLRequest(url: url)
        req.cachePolicy = .reloadIgnoringLocalCacheData
        req.timeoutInterval = 20
        // L'API GitHub refuse les requêtes sans identification de client.
        req.setValue("BUD-Premium/\(currentVersion)", forHTTPHeaderField: "User-Agent")
        req.setValue("application/vnd.github+json", forHTTPHeaderField: "Accept")

        URLSession.shared.dataTask(with: req) { data, resp, err in
            DispatchQueue.main.async {
                if let e = err { done(nil, e.localizedDescription); return }
                if let http = resp as? HTTPURLResponse, http.statusCode != 200 {
                    done(nil, http.statusCode == 404 ? "aucune version publiée pour l'instant"
                              : (http.statusCode == 403 ? "GitHub limite les requêtes, réessayez dans une heure"
                                 : "canal introuvable (code \(http.statusCode))"))
                    return
                }
                guard let d = data,
                      let j = try? JSONSerialization.jsonObject(with: d) as? [String: Any] else {
                    done(nil, "réponse illisible")
                    return
                }

                // Forme 1 : une release GitHub.
                if let tag = j["tag_name"] as? String {
                    let v = tag.hasPrefix("v") ? String(tag.dropFirst()) : tag
                    var zip = "", zipName = "", other = "", sums = ""
                    var size: Int64 = 0
                    for a in j["assets"] as? [[String: Any]] ?? [] {
                        guard let raw = a["name"] as? String,
                              let u = a["browser_download_url"] as? String else { continue }
                        let name = raw.lowercased()
                        if name.hasSuffix(".zip") {
                            zip = u; zipName = raw
                            size = (a["size"] as? NSNumber)?.int64Value ?? 0
                        } else if name.hasSuffix(".dmg") && other.isEmpty { other = u }
                        else if name == "sha256.txt" { sums = u }
                    }
                    var info = UpdateInfo(version: v, notes: j["body"] as? String ?? "",
                                          url: zip.isEmpty ? other : zip,
                                          pageURL: j["html_url"] as? String ?? "")
                    info.assetName = zipName
                    info.sha256URL = sums
                    info.size = size
                    done(info, nil)
                    return
                }

                // Forme 2 : un canal personnalisé à l'ancien format.
                guard let v = j["version"] as? String else {
                    done(nil, "fichier de version illisible")
                    return
                }
                done(UpdateInfo(version: v, notes: j["notes"] as? String ?? "",
                                url: j["url"] as? String ?? ""), nil)
            }
        }.resume()
    }

    /// La ligne du fichier d'empreintes qui correspond à l'archive.
    /// Appelée depuis un fil de fond : l'attente synchrone est voulue.
    static func publishedHash(_ info: UpdateInfo) -> String? {
        guard let u = URL(string: info.sha256URL), !info.assetName.isEmpty else { return nil }
        var req = URLRequest(url: u)
        req.timeoutInterval = 20
        req.setValue("BUD-Premium/\(currentVersion)", forHTTPHeaderField: "User-Agent")
        let sem = DispatchSemaphore(value: 0)
        var text: String?
        URLSession.shared.dataTask(with: req) { d, _, _ in
            if let d = d { text = String(data: d, encoding: .utf8) }
            sem.signal()
        }.resume()
        _ = sem.wait(timeout: .now() + 25)
        guard let body = text else { return nil }
        // Format de shasum : « <64 hex>  <nom de fichier> »
        for line in body.split(separator: "\n") {
            let parts = line.split(separator: " ", omittingEmptySubsequences: true)
            guard parts.count >= 2 else { continue }
            let hash = String(parts[0]), name = String(parts[parts.count - 1])
            if name == info.assetName && hash.count == 64 { return hash }
        }
        return nil
    }

    /// SHA-256 lu par tranches d'un mégaoctet : l'archive n'est jamais
    /// chargée entière en mémoire.
    static func sha256(ofFile url: URL) -> String? {
        guard let h = FileHandle(forReadingAtPath: url.path) else { return nil }
        defer { try? h.close() }
        var hasher = SHA256()
        while true {
            let chunk = h.readData(ofLength: 1 << 20)
            if chunk.isEmpty { break }
            hasher.update(data: chunk)
        }
        return hasher.finalize().map { String(format: "%02x", $0) }.joined()
    }

    /// Insère un chemin dans un script sans se faire piéger par une
    /// apostrophe ou une espace.
    static func shellQuote(_ s: String) -> String {
        "'" + s.replacingOccurrences(of: "'", with: "'\\''") + "'"
    }
}

// ═══════════════════════════════════════════════════════════
//  Le gestionnaire
//
//  Un seul état pour toute l'application : la carte « À
//  propos » et la bannière de la barre latérale l'observent
//  et ne peuvent donc jamais se contredire — l'une qui dit
//  « à jour » pendant que l'autre télécharge.
// ═══════════════════════════════════════════════════════════

final class BudUpdateManager: NSObject, URLSessionDownloadDelegate {
    static let shared = BudUpdateManager()

    enum Phase: Equatable {
        case idle, checking, upToDate, available
        case downloading, verifying, extracting, installing
        case failed
    }

    private(set) var phase: Phase = .idle
    /// 0…1, ou négatif quand la durée n'est pas connue : la barre passe
    /// alors en navette plutôt que d'inventer un pourcentage.
    private(set) var fraction: Double = -1
    /// L'étape en mots : « Téléchargement… 42 % ».
    private(set) var message = "Vérifiez si une nouvelle version existe."
    /// Le détail sous l'étape : « 8,1 Mo sur 19 Mo ».
    private(set) var detail = ""
    private(set) var found: UpdateInfo?

    var channel: () -> String = { BudUpdater.defaultChannel }
    var onStatus: ((String) -> Void)?
    /// Le même chemin que les outils et les agents : bureau, encoche, Flux.
    var onMood: ((BudExpression, TimeInterval) -> Void)?

    private var observers: [() -> Void] = []
    func observe(_ f: @escaping () -> Void) { observers.append(f) }
    private func changed() { observers.forEach { $0() } }

    var busy: Bool {
        [.checking, .downloading, .verifying, .extracting, .installing].contains(phase)
    }

    private var session: URLSession?
    private var task: URLSessionDownloadTask?
    private var lastPercent = -1
    private let work = DispatchQueue(label: "fr.lahbib.bud.update")

    private func set(_ p: Phase, _ msg: String, fraction f: Double = -1, detail d: String = "") {
        phase = p
        message = msg
        fraction = f
        detail = d
        changed()
    }

    // ═════════════ 1. Vérifier ═════════════

    func check(silent: Bool = false) {
        guard !busy else { return }
        set(.checking, "Interrogation du canal de mise à jour…")
        BudUpdater.check(channel()) { [weak self] info, err in
            guard let s = self else { return }
            if let e = err {
                s.set(.failed, "Canal injoignable : \(e)")
                if !silent { s.onStatus?("Mise à jour : canal injoignable"); s.onMood?(.sad, 3) }
            } else if let i = info, BudUpdater.isNewer(i.version, than: BudUpdater.currentVersion) {
                s.found = i
                s.set(.available, "Version \(i.version) disponible", detail: i.headline)
                s.onStatus?("BUD \(i.version) disponible")
                // Une bonne nouvelle, même trouvée en silence : BUDs le montre.
                s.onMood?(.cool, 3)
            } else {
                s.found = nil
                s.set(.upToDate, "BUD \(BudUpdater.currentVersion) est à jour.")
                if !silent { s.onStatus?("BUD est à jour"); s.onMood?(.happy, 2) }
            }
        }
    }

    // ═════════════ 2. Télécharger ═════════════

    /// Où ce paquet peut-il être remplacé, et faut-il un mot de passe ?
    /// `nil` dans `error` : on peut y aller.
    func preflight() -> (admin: Bool, error: String?) {
        let app = Bundle.main.bundleURL.resolvingSymlinksInPath()
        let path = app.path
        // Lancé depuis l'image disque, ou « transloqué » par Gatekeeper :
        // le paquet vit dans un endroit en lecture seule, ou qui disparaîtra.
        if path.hasPrefix("/Volumes/") {
            return (false, "BUD tourne depuis l'image disque. Glissez-le dans Applications, puis relancez-le.")
        }
        if path.contains("/AppTranslocation/") {
            return (false, "macOS a isolé BUD (translocation). Déplacez-le dans Applications et relancez-le.")
        }
        let fm = FileManager.default
        let parent = app.deletingLastPathComponent().path
        // Il faut pouvoir écrire dans le dossier parent (renommer le paquet)
        // ET dans le paquet (effacer l'ancien) : un BUD.app possédé par root
        // dans un /Applications ouvert à l'utilisateur ne passerait que la
        // première épreuve, et laisserait une sauvegarde impossible à effacer.
        let admin = !fm.isWritableFile(atPath: parent)
            || !fm.isWritableFile(atPath: path)
            || !fm.isWritableFile(atPath: app.appendingPathComponent("Contents").path)
        return (admin, nil)
    }

    func install() {
        guard !busy, let f = found else { return }
        guard f.installable, let url = URL(string: f.url) else {
            set(.failed, "Cette version ne fournit pas d'archive installable.")
            onMood?(.sad, 3)
            return
        }
        let pre = preflight()
        if let e = pre.error {
            set(.failed, e)
            onMood?(.sad, 4)
            return
        }

        lastPercent = -1
        let total = f.size > 0 ? " sur \(formatBytes(f.size))" : ""
        set(.downloading, "Téléchargement…", fraction: 0, detail: "0 Mo\(total)")
        onStatus?("Téléchargement de BUD \(f.version)")
        onMood?(.working, 600)

        // Une session à nous, avec délégué : elle rapporte chaque bloc reçu,
        // et l'annulation la referme proprement. Pas de cache : une archive
        // à moitié servie par un proxy serait pire qu'un échec.
        let cfg = URLSessionConfiguration.ephemeral
        cfg.requestCachePolicy = .reloadIgnoringLocalCacheData
        cfg.timeoutIntervalForRequest = 30
        let q = OperationQueue()
        q.maxConcurrentOperationCount = 1
        let s = URLSession(configuration: cfg, delegate: self, delegateQueue: q)
        var req = URLRequest(url: url)
        req.setValue("BUD-Premium/\(BudUpdater.currentVersion)", forHTTPHeaderField: "User-Agent")
        let t = s.downloadTask(with: req)
        session = s
        task = t
        t.resume()
    }

    /// Possible tant que l'installation n'a pas commencé.
    func cancel() {
        guard phase == .downloading else { return }
        task?.cancel()
        teardown()
        set(.available, "Téléchargement annulé.", detail: found?.headline ?? "")
        onMood?(.neutral, 2)
    }

    private func teardown() {
        session?.finishTasksAndInvalidate()
        session = nil
        task = nil
    }

    func urlSession(_ s: URLSession, downloadTask: URLSessionDownloadTask, didWriteData _: Int64,
                    totalBytesWritten written: Int64, totalBytesExpectedToWrite expected: Int64) {
        let total = expected > 0 ? expected : (found?.size ?? 0)
        let frac = total > 0 ? Double(written) / Double(total) : -1
        // Un rappel par bloc de quelques kilo-octets : on ne redessine qu'à
        // chaque point de pourcentage, sinon l'interface travaille pour rien.
        let pc = frac >= 0 ? Int(frac * 100) : Int(written / 1_000_000)
        guard pc != lastPercent else { return }
        lastPercent = pc
        let d = formatBytes(written) + (total > 0 ? " sur \(formatBytes(total))" : "")
        DispatchQueue.main.async {
            guard self.phase == .downloading else { return }
            self.set(.downloading, frac >= 0 ? "Téléchargement… \(Int(frac * 100)) %" : "Téléchargement…",
                     fraction: frac, detail: d)
        }
    }

    func urlSession(_ s: URLSession, downloadTask: URLSessionDownloadTask, didFinishDownloadingTo tmp: URL) {
        // Le fichier temporaire disparaît au retour de cette méthode : on le
        // met de côté avant toute autre chose, ici même, sur ce fil.
        let status = (downloadTask.response as? HTTPURLResponse)?.statusCode ?? 0
        let fm = FileManager.default
        let keep = fm.temporaryDirectory.appendingPathComponent("bud-dl-\(UUID().uuidString).zip")
        let moved = (try? fm.moveItem(at: tmp, to: keep)) != nil
        DispatchQueue.main.async {
            self.teardown()
            guard status == 200 else { return self.fail("téléchargement refusé (code \(status))") }
            guard moved else { return self.fail("archive non conservée") }
            self.verifyAndInstall(keep)
        }
    }

    func urlSession(_ s: URLSession, task: URLSessionTask, didCompleteWithError error: Error?) {
        guard let e = error as NSError? else { return }
        // L'annulation est un choix, pas une erreur : `cancel` a déjà parlé.
        if e.code == NSURLErrorCancelled { return }
        DispatchQueue.main.async {
            self.teardown()
            self.fail(e.code == NSURLErrorNotConnectedToInternet ? "pas de connexion Internet"
                                                                  : e.localizedDescription)
        }
    }

    private func fail(_ why: String) {
        set(.failed, "Mise à jour impossible : \(why)", detail: "L'installation actuelle n'a pas été touchée.")
        onStatus?("Mise à jour échouée")
        onMood?(.sad, 4)
    }

    // ═════════════ 3. Contrôler, puis 4. installer ═════════════

    private func verifyAndInstall(_ archive: URL) {
        guard let f = found else { return }
        set(.verifying, "Vérification de l'empreinte…")
        let pre = preflight()

        work.async {
            let fm = FileManager.default
            let report: (Phase, String) -> Void = { p, m in DispatchQueue.main.async { self.set(p, m) } }
            let abort: (String) -> Void = { why in
                try? fm.removeItem(at: archive)
                DispatchQueue.main.async { self.fail(why) }
            }

            // ── L'empreinte publiée ──
            //  Une archive abîmée en route, ou remplacée, n'a pas la même.
            var integrity = "empreinte non publiée"
            if !f.sha256URL.isEmpty {
                guard let expected = BudUpdater.publishedHash(f) else {
                    return abort("empreinte publiée illisible")
                }
                guard let got = BudUpdater.sha256(ofFile: archive) else {
                    return abort("empreinte incalculable")
                }
                guard got.lowercased() == expected.lowercased() else {
                    return abort("empreinte incorrecte — téléchargement abîmé, réessayez")
                }
                integrity = "empreinte conforme"
            }

            // ── Extraction, dans un dossier à part ──
            report(.extracting, "Extraction…")
            let stage = fm.temporaryDirectory.appendingPathComponent("bud-update-\(UUID().uuidString)")
            do { try fm.createDirectory(at: stage, withIntermediateDirectories: true) }
            catch { return abort("dossier de travail impossible") }
            // ditto plutôt qu'unzip : il restitue les attributs étendus et la
            // signature, et c'est lui qui a fabriqué l'archive en CI.
            let x = runShellDetailed("/usr/bin/ditto", ["-x", "-k", archive.path, stage.path])
            try? fm.removeItem(at: archive)
            guard x.status == 0 else {
                try? fm.removeItem(at: stage)
                return abort("archive illisible — \(x.err.trimmingCharacters(in: .whitespacesAndNewlines))")
            }

            // ── Le paquet extrait ──
            report(.extracting, "Vérification du paquet…")
            if let why = BudUpdateManager.validate(stage, expecting: f.version) {
                try? fm.removeItem(at: stage)
                return abort(why)
            }
            let newApp = stage.appendingPathComponent("BUD.app")

            // ── Le script, puis la main ──
            let script: URL
            do { script = try BudUpdateManager.writeSwapScript(in: stage, newApp: newApp, version: f.version) }
            catch {
                try? fm.removeItem(at: stage)
                return abort("script de remplacement impossible")
            }
            report(.installing, "Installation et redémarrage…")
            let launched = BudUpdateManager.launchDetached(script, admin: pre.admin)
            DispatchQueue.main.async {
                if let why = launched {
                    try? fm.removeItem(at: stage)
                    self.fail(why)
                    return
                }
                self.set(.installing, "Installation et redémarrage…", fraction: 1, detail: integrity)
                self.onStatus?("BUD redémarre sur la version \(f.version)")
                // Le script attend la fin de ce processus : à nous de la lui
                // offrir. Un temps pour que la barre pleine soit vue.
                DispatchQueue.main.asyncAfter(deadline: .now() + 0.8) { NSApp.terminate(nil) }
            }
        }
    }

    /// Le paquet extrait doit être BUD, dans la bonne version, pour cette
    /// machine. Renvoie le motif du refus, ou `nil`.
    static func validate(_ stage: URL, expecting version: String) -> String? {
        let fm = FileManager.default
        let items = (try? fm.contentsOfDirectory(atPath: stage.path)) ?? []
        let apps = items.filter { $0.hasSuffix(".app") }
        // Exactement un paquet, à la racine, nommé BUD.app : une archive qui
        // en contient deux, ou un dossier intermédiaire, n'est pas la nôtre.
        guard apps == ["BUD.app"] else {
            return apps.isEmpty ? "aucune application dans l'archive"
                                : "archive inattendue (\(apps.joined(separator: ", ")))"
        }
        let app = stage.appendingPathComponent("BUD.app")
        guard let plist = NSDictionary(contentsOf: app.appendingPathComponent("Contents/Info.plist")) else {
            return "Info.plist manquant"
        }
        // Même identifiant que ce paquet : une archive qui contiendrait une
        // autre application ne prendra pas la place de BUD.
        if let mine = Bundle.main.bundleIdentifier,
           (plist["CFBundleIdentifier"] as? String) != mine {
            return "l'archive contient une autre application"
        }
        // La version annoncée : une release mal assemblée réinstallerait
        // sinon l'ancienne, en boucle, à chaque vérification.
        if let got = plist["CFBundleShortVersionString"] as? String, !version.isEmpty, got != version {
            return "l'archive contient la version \(got), pas \(version)"
        }
        let exe = (plist["CFBundleExecutable"] as? String) ?? "BUD"
        let bin = app.appendingPathComponent("Contents/MacOS/\(exe)")
        guard fm.isExecutableFile(atPath: bin.path) else { return "l'archive ne contient pas d'exécutable" }
        // Une version compilée pour la seule autre architecture serait tuée
        // au lancement, sans un mot.
        let archs = runShellDetailed("/usr/bin/lipo", ["-archs", bin.path]).out
        if !archs.isEmpty && !archs.contains(BudUpdater.myArch) {
            return "cette version ne contient pas \(BudUpdater.myArch)"
        }
        return nil
    }

    // ─────────────────────────────────────────────────────────
    //  Le script de remplacement
    //
    //  Détaché, il survit à BUD. Il attend ce processus-ci par
    //  son PID — et non par son nom, qui désignerait aussi un
    //  second BUD lancé à côté —, met l'ancien paquet de côté
    //  au lieu de l'effacer, pose le nouveau, le relance, et
    //  regarde s'il tient debout. S'il ne démarre pas, ou meurt
    //  dans les secondes qui suivent, l'ancien revient à sa place
    //  et c'est lui qui redémarre.
    //
    //  Il laisse une ligne dans `update-result`, que BUD lit au
    //  lancement suivant pour dire ce qui s'est passé.
    // ─────────────────────────────────────────────────────────

    static var resultFile: URL { budSupportDir.appendingPathComponent("update-result") }
    static var logFile: URL { budSupportDir.appendingPathComponent("update.log") }

    static func writeSwapScript(in stage: URL, newApp: URL, version: String) throws -> URL {
        let q = BudUpdater.shellQuote
        let app = Bundle.main.bundleURL.resolvingSymlinksInPath().path
        let body = """
        #!/bin/bash
        # Remplacement de BUD — écrit par BUD \(BudUpdater.currentVersion), version visée \(version).
        APP=\(q(app))
        NEW=\(q(newApp.path))
        STAGE=\(q(stage.path))
        PID=\(ProcessInfo.processInfo.processIdentifier)
        OWNER=\(getuid())
        VERSION=\(q(version))
        RESULT=\(q(resultFile.path))
        LOG=\(q(logFile.path))
        BACKUP="$APP.bud-old"
        exec >>"$LOG" 2>&1
        echo "== $(date '+%F %T') · vers $VERSION · $(id -un)"

        # Relance en tant que l'utilisateur, même quand le script tourne en
        # administrateur : un BUD lancé par root aurait d'autres réglages,
        # un autre trousseau, et n'afficherait rien au bon endroit.
        launch() {
          if [ "$(id -u)" = 0 ]; then
            /bin/launchctl asuser "$OWNER" /usr/bin/sudo -u "#$OWNER" /usr/bin/open -n "$1"
          else
            /usr/bin/open -n "$1"
          fi
        }
        finish() {
          echo "$1" > "$RESULT"
          [ "$(id -u)" = 0 ] && /usr/sbin/chown "$OWNER" "$RESULT" "$LOG" 2>/dev/null
          rm -rf "$STAGE"
        }

        # 1. Attendre la fin de BUD : 20 s de politesse, puis on insiste.
        for i in $(seq 1 100); do kill -0 "$PID" 2>/dev/null || break; sleep 0.2; done
        if kill -0 "$PID" 2>/dev/null; then
          kill -TERM "$PID"; sleep 2; kill -KILL "$PID" 2>/dev/null; sleep 0.5
        fi

        # 2. Mettre l'ancien de côté, sans l'effacer.
        rm -rf "$BACKUP"
        if [ -d "$APP" ] && ! mv "$APP" "$BACKUP"; then
          echo "sauvegarde impossible"; finish "fail $VERSION sauvegarde impossible"; launch "$APP"; exit 1
        fi

        # 3. Poser le nouveau. Un échec ici remet l'ancien.
        if ! /usr/bin/ditto "$NEW" "$APP"; then
          echo "copie impossible"
          rm -rf "$APP"; mv "$BACKUP" "$APP"
          finish "rollback $VERSION copie impossible"; launch "$APP"; exit 1
        fi
        # Rendre le paquet à son propriétaire d'origine si root l'a posé.
        if [ "$(id -u)" = 0 ] && [ -d "$BACKUP" ]; then
          /usr/sbin/chown -R "$(/usr/bin/stat -f '%u:%g' "$BACKUP")" "$APP"
        fi
        /usr/bin/xattr -dr com.apple.quarantine "$APP" 2>/dev/null
        /usr/bin/codesign --force --sign - "$APP" 2>/dev/null

        # 4. Relancer, et vérifier qu'il tient : présent en 15 s, encore là 4 s après.
        #    Un processus est « le nôtre » si sa commande COMMENCE par le chemin
        #    de l'exécutable : comparaison exacte, pas une expression régulière
        #    (un chemin avec « + » ou des parenthèses fausserait pgrep -f), et
        #    awk ne se trouve pas lui-même, sa commande commençant par « awk ».
        BIN="$APP/Contents/MacOS/"
        pids() { /bin/ps -axo pid=,command= | /usr/bin/awk -v b="$BIN" \
                   '{ p = $1; sub(/^ *[0-9]+ /, ""); if (index($0, b) == 1) print p }'; }
        launch "$APP"
        up=0
        for i in $(seq 1 30); do [ -n "$(pids)" ] && { up=1; break; }; sleep 0.5; done
        [ $up = 1 ] && { sleep 4; [ -n "$(pids)" ] || up=0; }

        if [ $up = 1 ]; then
          rm -rf "$BACKUP"
          finish "ok $VERSION"
        else
          echo "le nouveau paquet ne démarre pas : retour à l'ancien"
          for p in $(pids); do kill "$p" 2>/dev/null; done
          rm -rf "$APP"; mv "$BACKUP" "$APP"
          finish "rollback $VERSION la nouvelle version ne démarrait pas"
          launch "$APP"
        fi
        """
        let script = stage.appendingPathComponent("swap.sh")
        try body.write(to: script, atomically: true, encoding: .utf8)
        try FileManager.default.setAttributes([.posixPermissions: 0o700], ofItemAtPath: script.path)
        return script
    }

    /// Lance le script hors de BUD. En mode administrateur, c'est macOS qui
    /// demande le mot de passe, et BUD attend la réponse : si l'on refuse,
    /// BUD ne quitte pas — se fermer pour rien serait pire que l'échec.
    /// Renvoie le motif d'un échec, ou `nil`.
    static func launchDetached(_ script: URL, admin: Bool) -> String? {
        if !admin {
            let p = Process()
            p.executableURL = URL(fileURLWithPath: "/bin/bash")
            p.arguments = [script.path]
            p.standardOutput = FileHandle.nullDevice
            p.standardError = FileHandle.nullDevice
            do { try p.run() } catch { return "lancement du remplacement impossible" }
            return nil
        }
        // « do shell script » rend la main dès que la commande est partie en
        // arrière-plan : le script continue en administrateur, BUD peut quitter.
        let cmd = "/bin/bash " + BudUpdater.shellQuote(script.path) + " >/dev/null 2>&1 &"
        let escaped = cmd.replacingOccurrences(of: "\\", with: "\\\\").replacingOccurrences(of: "\"", with: "\\\"")
        let src = "do shell script \"\(escaped)\" with prompt "
            + "\"BUD a besoin de votre mot de passe pour se mettre à jour dans ce dossier.\" "
            + "with administrator privileges"
        let r = runShellDetailed("/usr/bin/osascript", ["-e", src])
        if r.status != 0 {
            return r.err.contains("-128") ? "autorisation refusée" : "autorisation impossible"
        }
        return nil
    }

    /// Lu une fois au lancement : ce que le dernier remplacement a donné.
    /// `ok`, `rollback` ou `fail`, suivis de la version et d'un motif.
    func consumeLastResult() -> (ok: Bool, text: String)? {
        let f = BudUpdateManager.resultFile
        guard let raw = try? String(contentsOf: f, encoding: .utf8) else { return nil }
        try? FileManager.default.removeItem(at: f)
        let parts = raw.trimmingCharacters(in: .whitespacesAndNewlines).split(separator: " ", maxSplits: 2)
        guard parts.count >= 2 else { return nil }
        let v = String(parts[1]), why = parts.count > 2 ? String(parts[2]) : ""
        switch parts[0] {
        case "ok":       return (true, "BUD est passé en version \(v).")
        case "rollback": return (false, "La version \(v) a été annulée : \(why). L'ancienne est revenue.")
        default:         return (false, "La mise à jour vers \(v) a échoué : \(why).")
        }
    }
}

// ═══════════════════════════════════════════════════════════
//  La barre de progression
//
//  Une piste en creux, un remplissage dégradé dans la couleur
//  d'accent avec un reflet qui la parcourt — c'est ce qui dit
//  « ça avance » même quand le pourcentage stagne —, et une
//  navette quand la durée est inconnue. L'avancée est lissée :
//  la barre glisse vers sa valeur au lieu de sauter.
// ═══════════════════════════════════════════════════════════

final class BudProgressBar: NSView {
    var target: Double = 0 { didSet { wake() } }
    var tint: NSColor = TH.accent { didSet { needsDisplay = true } }
    private var shown: CGFloat = 0
    private var t: CGFloat = 0
    private var timer: Timer?

    override init(frame: NSRect) { super.init(frame: frame); wantsLayer = true }
    required init?(coder: NSCoder) { fatalError() }

    private func wake() {
        guard timer == nil else { return }
        let tm = Timer(timeInterval: 1.0 / 60.0, repeats: true) { [weak self] tm in
            guard let s = self, s.window != nil, !s.isHiddenOrHasHiddenAncestor else {
                tm.invalidate(); self?.timer = nil; return
            }
            s.t += 1.0 / 60.0
            if s.target >= 0 { s.shown += (CGFloat(s.target) - s.shown) * 0.18 }
            s.needsDisplay = true
        }
        RunLoop.main.add(tm, forMode: .common)
        timer = tm
    }
    override func viewDidMoveToWindow() { super.viewDidMoveToWindow(); if window != nil { wake() } }
    override func viewDidUnhide() { super.viewDidUnhide(); wake() }

    override func draw(_ dirty: NSRect) {
        let r = bounds.insetBy(dx: 0.5, dy: 0.5)
        let track = capsule(r)
        TH.fill(0.12).setFill()
        track.fill()
        NSGraphicsContext.current?.saveGraphicsState()
        track.addClip()
        if target < 0 {
            // Navette : la durée est inconnue, on montre seulement le travail.
            let w = r.width * 0.32
            let x = r.minX + (r.width - w) * (sin(t * 2.4) + 1) / 2
            NSGradient(colors: [tint.withAlphaComponent(0.2), tint, tint.withAlphaComponent(0.2)])?
                .draw(in: NSRect(x: x, y: r.minY, width: w, height: r.height), angle: 0)
        } else {
            let w = max(r.height, r.width * min(1, shown))
            let fill = NSRect(x: r.minX, y: r.minY, width: w, height: r.height)
            NSGradient(colors: [tint.blended(withFraction: 0.25, of: .white) ?? tint, tint])?
                .draw(in: capsule(fill), angle: 0)
            // Le reflet qui parcourt la partie remplie.
            let gw = r.height * 6
            let gx = r.minX - gw + (t * 0.8).truncatingRemainder(dividingBy: 1) * (w + gw)
            NSGraphicsContext.current?.saveGraphicsState()
            capsule(fill).addClip()
            NSGradient(colors: [NSColor(white: 1, alpha: 0), NSColor(white: 1, alpha: 0.45), NSColor(white: 1, alpha: 0)])?
                .draw(in: NSRect(x: gx, y: r.minY, width: gw, height: r.height), angle: 0)
            NSGraphicsContext.current?.restoreGraphicsState()
        }
        NSGraphicsContext.current?.restoreGraphicsState()
    }
}

// ═══════════════════════════════════════════════════════════
//  La bannière
//
//  Elle n'existe que lorsqu'il y a quelque chose à dire : une
//  version disponible, une installation en cours, un échec.
//  Elle vit en bas de la barre latérale, au-dessus de la
//  pastille d'état : visible depuis n'importe quel onglet,
//  sans couvrir aucun panneau.
// ═══════════════════════════════════════════════════════════

final class BudUpdateView: NSView {
    static let height: CGFloat = 112
    private let bar: BudProgressBar
    private let button: GlassButton
    private let notes: GlassButton
    /// La barre latérale se range quand la bannière apparaît ou disparaît.
    var onVisibility: ((Bool) -> Void)?

    override init(frame: NSRect) {
        let W = frame.width
        bar = BudProgressBar(frame: NSRect(x: 14, y: 46, width: W - 28, height: 6))
        button = GlassButton(frame: NSRect(x: 12, y: 10, width: W - 24 - 34, height: 28),
                             title: "Mettre à jour maintenant", icon: "arrow.down.circle.fill",
                             prominent: true, compact: true)
        notes = GlassButton(frame: NSRect(x: W - 12 - 28, y: 10, width: 28, height: 28),
                            title: "", icon: "doc.text", compact: true)
        super.init(frame: frame)
        wantsLayer = true
        addSubview(bar)
        addSubview(button)
        addSubview(notes)
        notes.toolTip = "Lire les notes de version"
        button.onClick = { [weak self] _ in self?.primary() }
        notes.onClick = { [weak self] _ in self?.showNotes() }
        setAccessibilityRole(.group)
        BudUpdateManager.shared.observe { [weak self] in self?.refresh() }
        refresh()
    }
    required init?(coder: NSCoder) { fatalError() }

    private var wanted: Bool {
        let p = BudUpdateManager.shared.phase
        return p == .available || p == .downloading || p == .verifying || p == .extracting
            || p == .installing || (p == .failed && BudUpdateManager.shared.found != nil)
    }

    func refresh() {
        let m = BudUpdateManager.shared
        let show = wanted
        if show != !isHidden {
            if show {
                isHidden = false
                alphaValue = 0
                NSAnimationContext.runAnimationGroup { ctx in
                    ctx.duration = 0.25
                    self.animator().alphaValue = 1
                }
            } else {
                isHidden = true
            }
            onVisibility?(show)
        }
        bar.isHidden = !(m.busy || m.phase == .installing)
        bar.target = m.fraction
        bar.tint = m.phase == .failed ? dangerColor : TH.accent
        switch m.phase {
        case .downloading:
            button.title = "Annuler"; button.iconName = "xmark"; button.prominent = false
            button.enabledFlag = true
        case .verifying, .extracting, .installing:
            button.title = "Un instant…"; button.iconName = "hourglass"; button.prominent = false
            button.enabledFlag = false
        case .failed:
            button.title = "Réessayer"; button.iconName = "arrow.clockwise"; button.prominent = true
            button.enabledFlag = true
        default:
            button.title = "Mettre à jour maintenant"; button.iconName = "arrow.down.circle.fill"
            button.prominent = true; button.enabledFlag = true
        }
        notes.isHidden = m.found?.notes.isEmpty ?? true
        setAccessibilityLabel(m.message)
        needsDisplay = true
    }

    private func primary() {
        let m = BudUpdateManager.shared
        switch m.phase {
        case .downloading: m.cancel()
        case .available, .failed:
            // Une confirmation courte : BUD va quitter et revenir.
            let pre = m.preflight()
            if let e = pre.error {
                let a = NSAlert(); a.messageText = "Mise à jour impossible ici"; a.informativeText = e
                a.runModal()
                return
            }
            let a = NSAlert()
            a.messageText = "Installer BUD \(m.found?.version ?? "") ?"
            a.informativeText = "BUD va télécharger la nouvelle version, se fermer, se remplacer et se rouvrir. "
                + "Vos réglages, notes et rappels sont conservés."
                + (pre.admin ? "\n\nCe dossier est protégé : macOS vous demandera votre mot de passe." : "")
            a.addButton(withTitle: "Installer et redémarrer")
            a.addButton(withTitle: "Plus tard")
            NSApp.activate(ignoringOtherApps: true)
            if a.runModal() == .alertFirstButtonReturn { m.install() }
        default: break
        }
    }

    /// Les notes, dans BUD : la page web n'est plus nécessaire pour savoir
    /// ce qui change.
    private func showNotes() {
        guard let f = BudUpdateManager.shared.found else { return }
        let a = NSAlert()
        a.messageText = "Nouveautés de BUD \(f.version)"
        let tv = NSTextView(frame: NSRect(x: 0, y: 0, width: 440, height: 260))
        tv.string = f.notes
        tv.isEditable = false
        tv.font = NSFont.systemFont(ofSize: 12)
        tv.textContainerInset = NSSize(width: 6, height: 6)
        let sc = NSScrollView(frame: tv.frame)
        sc.hasVerticalScroller = true
        sc.documentView = tv
        a.accessoryView = sc
        a.addButton(withTitle: "Fermer")
        NSApp.activate(ignoringOtherApps: true)
        a.runModal()
    }

    override func draw(_ dirty: NSRect) {
        let m = BudUpdateManager.shared
        let r = bounds.insetBy(dx: 0.5, dy: 0.5)
        let p = NSBezierPath(roundedRect: r, xRadius: 14, yRadius: 14)
        drawLiquidGlass(p, in: r, active: m.phase == .available, hover: 0)

        let failed = m.phase == .failed
        let tint = failed ? dangerColor : TH.accent
        let c = NSPoint(x: r.minX + 22, y: r.maxY - 22)
        tint.withAlphaComponent(0.2).setFill()
        NSBezierPath(ovalIn: NSRect(x: c.x - 11, y: c.y - 11, width: 22, height: 22)).fill()
        let icon = failed ? "exclamationmark.triangle.fill"
                 : (m.busy || m.phase == .installing ? "arrow.down" : "sparkles")
        drawSymbol(icon, center: c, size: 10, weight: .bold, color: tint)

        let title = m.phase == .available ? "BUD \(m.found?.version ?? "") est là" : m.message
        drawString(title, in: NSRect(x: r.minX + 40, y: r.maxY - 30, width: r.width - 48, height: 16),
                   size: 12, weight: .bold, color: TH.text)
        let sub: String
        switch m.phase {
        case .available: sub = m.detail.isEmpty ? "Une nouvelle version est prête." : m.detail
        case .failed:    sub = m.detail
        default:         sub = m.detail
        }
        drawString(sub, in: NSRect(x: r.minX + 14, y: r.maxY - 56, width: r.width - 26, height: 15),
                   size: 10.5, weight: .medium, color: failed ? dangerColor.withAlphaComponent(0.9) : TH.dim(0.55))
    }
}

// ═══════════════════════════════════════════════════════════
//  La carte « À propos »
//
//  Elle montre la version, vérifie à la demande, et suit le
//  même état que la bannière.
// ═══════════════════════════════════════════════════════════

final class UpdateCardView: NSView {
    private var spin: CGFloat = 0
    private var timer: Timer?
    private var actionBtn: GlassButton!
    private var channelBtn: GlassButton!
    private var bar: BudProgressBar!

    var onChannelEdit: (() -> Void)?

    override init(frame: NSRect) {
        super.init(frame: frame)
        wantsLayer = true
        let W = bounds.width, H = bounds.height
        actionBtn = GlassButton(frame: NSRect(x: W - 232, y: H / 2 - 18, width: 118, height: 36),
                                title: "Vérifier", icon: "arrow.triangle.2.circlepath", compact: true)
        actionBtn.onClick = { [weak self] _ in self?.primaryAction() }
        channelBtn = GlassButton(frame: NSRect(x: W - 106, y: H / 2 - 18, width: 98, height: 36),
                                 title: "Canal", icon: "antenna.radiowaves.left.and.right", compact: true)
        channelBtn.onClick = { [weak self] _ in self?.onChannelEdit?() }
        bar = BudProgressBar(frame: NSRect(x: 72, y: 9, width: W - 72 - 248, height: 5))
        addSubview(actionBtn)
        addSubview(channelBtn)
        addSubview(bar)
        BudUpdateManager.shared.observe { [weak self] in self?.refresh() }
        refresh()
    }
    required init?(coder: NSCoder) { fatalError() }

    /// Gardé pour les appels existants.
    func check(silent: Bool = false) { BudUpdateManager.shared.check(silent: silent) }

    private func primaryAction() {
        let m = BudUpdateManager.shared
        switch m.phase {
        case .available:   m.install()
        case .downloading: m.cancel()
        default:           m.check()
        }
    }

    private func refresh() {
        let m = BudUpdateManager.shared
        bar.isHidden = !(m.busy && m.phase != .checking) && m.phase != .installing
        bar.target = m.fraction
        channelBtn.enabledFlag = !m.busy
        switch m.phase {
        case .checking:
            actionBtn.title = "Vérification"; actionBtn.enabledFlag = false
        case .available:
            actionBtn.title = "Installer"; actionBtn.iconName = "arrow.down.circle.fill"
            actionBtn.prominent = true; actionBtn.enabledFlag = true
        case .downloading:
            actionBtn.title = "Annuler"; actionBtn.iconName = "xmark"
            actionBtn.prominent = false; actionBtn.enabledFlag = true
        case .verifying, .extracting, .installing:
            actionBtn.title = "En cours"; actionBtn.enabledFlag = false
        case .failed:
            actionBtn.title = "Réessayer"; actionBtn.iconName = "arrow.clockwise"
            actionBtn.prominent = false; actionBtn.enabledFlag = true
        default:
            actionBtn.title = "Vérifier"; actionBtn.iconName = "arrow.triangle.2.circlepath"
            actionBtn.prominent = false; actionBtn.enabledFlag = true
        }
        if m.busy && timer == nil {
            let t = Timer(timeInterval: 1.0 / 30.0, repeats: true) { [weak self] tm in
                guard let s = self else { tm.invalidate(); return }
                s.spin += 0.22
                if !BudUpdateManager.shared.busy { tm.invalidate(); s.timer = nil }
                s.needsDisplay = true
            }
            RunLoop.main.add(t, forMode: .common)
            timer = t
        }
        needsDisplay = true
    }

    override func draw(_ dirty: NSRect) {
        let m = BudUpdateManager.shared
        let r = bounds
        let card = NSBezierPath(roundedRect: r, xRadius: 16, yRadius: 16)
        TH.fill(0.05).setFill()
        card.fill()
        TH.fill(0.08).setStroke()
        card.lineWidth = 1
        card.stroke()

        let c = NSPoint(x: r.minX + 40, y: r.midY)
        let tint: NSColor = m.phase == .available ? warnColor : (m.phase == .failed ? dangerColor : TH.accent)
        tint.withAlphaComponent(0.16).setFill()
        NSBezierPath(ovalIn: NSRect(x: c.x - 19, y: c.y - 19, width: 38, height: 38)).fill()
        if m.busy {
            let arc = NSBezierPath()
            let start = spin * 57.3
            arc.appendArc(withCenter: c, radius: 16, startAngle: start, endAngle: start + 250)
            arc.lineWidth = 3
            arc.lineCapStyle = .round
            tint.setStroke()
            arc.stroke()
        } else {
            let icon = m.phase == .available ? "arrow.down.circle.fill"
                     : (m.phase == .failed ? "exclamationmark.triangle.fill"
                        : (m.phase == .upToDate ? "checkmark.circle.fill" : "sparkles"))
            drawSymbol(icon, center: c, size: 20, weight: .semibold, color: tint)
        }

        let textW = r.width - 80 - 240
        drawString("BUD Premium \(BudUpdater.currentVersion)",
                   in: NSRect(x: r.minX + 72, y: r.midY + 5, width: textW, height: 20),
                   size: 13.5, weight: .bold, color: TH.text)
        let line = m.detail.isEmpty || m.phase == .available ? m.message : "\(m.message) · \(m.detail)"
        drawString(line, in: NSRect(x: r.minX + 72, y: r.midY - 14, width: textW, height: 18),
                   size: 11, weight: .medium, color: m.phase == .failed ? dangerColor : TH.dim(0.5))
    }
}
EOF_BUDUPDATE_SWIFT

cat << 'EOF_BUDVOICE_SWIFT' > "$SRC_DIR/BudVoice.swift"
import Cocoa
import Speech
import AVFoundation

// ═══════════════════════════════════════════════════════════
//  Dictée — reconnaissance vocale, sur l'appareil seulement
//
//  Le reste de BUD ne fait rien sortir de la machine : l'analyse
//  de hameçonnage est locale, la conversation est locale, les
//  jetons restent dans le trousseau. La dictée ne fera pas
//  exception.
//
//  Or `SFSpeechRecognizer` envoie l'audio aux serveurs d'Apple
//  par défaut. `requiresOnDeviceRecognition` l'en empêche, mais
//  la documentation est explicite : « The request only honors
//  this setting if supportsOnDeviceRecognition is also true. »
//  Autrement dit, poser le drapeau sans vérifier ne garantit
//  rien du tout.
//
//  Donc : si ce Mac ne sait pas reconnaître le français hors
//  ligne, BUD refuse la dictée et dit pourquoi. Pas de repli
//  silencieux sur le réseau.
//
//  Deux modes partagent le même moteur audio, et un seul à la
//  fois. On ne peut pas poser deux prises sur la même entrée :
//  armer le mot d'activation pendant une dictée, ou l'inverse,
//  ferait tomber l'application. L'un cède donc la place à
//  l'autre, et le mot d'activation se réarme tout seul après.
// ═══════════════════════════════════════════════════════════

final class BudVoice {

    static let shared = BudVoice()

    private let recognizer = SFSpeechRecognizer(locale: Locale(identifier: "fr_FR"))
    private let engine = AVAudioEngine()
    private var request: SFSpeechAudioBufferRecognitionRequest?
    private var task: SFSpeechRecognitionTask?
    private var hardStop: Timer?
    private var silence: Timer?
    private var lastText = ""

    private enum Mode { case idle, dictation, wake }
    private var mode: Mode = .idle

    /// Vrai pendant une dictée demandée par le bouton micro. L'écoute du
    /// mot d'activation ne compte pas : elle n'est pas une dictée, et le
    /// bouton ne doit pas pulser en permanence.
    var listening: Bool { mode == .dictation }

    /// Vrai quand BUD guette « Hey Bud ».
    private(set) var wakeArmed = false

    /// Texte en cours de reconnaissance, à chaque mot.
    var onPartial: ((String) -> Void)?
    /// Texte retenu quand l'utilisateur s'arrête de parler.
    var onFinal: ((String) -> Void)?
    /// Une phrase à montrer : refus, autorisation manquante, panne.
    var onTrouble: ((String) -> Void)?
    /// Changement d'état, pour que le bouton suive.
    var onState: (() -> Void)?

    /// Le mot d'activation vient d'être entendu : BUD se déverrouille et
    /// attend la suite. Sert à montrer qu'on écoute avant de comprendre.
    var onWake: (() -> Void)?
    /// La phrase prononcée après le mot d'activation, une fois terminée.
    var onWakeCommand: ((String) -> Void)?

    private init() {}

    // ─────────────────────────────────────────────────────────
    //  Disponibilité
    // ─────────────────────────────────────────────────────────

    /// `nil` si la dictée est possible, sinon la raison, en clair.
    func unavailableReason() -> String? {
        guard let r = recognizer else {
            return "La reconnaissance du français n'est pas installée sur ce Mac."
        }
        guard r.supportsOnDeviceRecognition else {
            return "Ce Mac ne sait pas reconnaître la parole sans l'envoyer aux serveurs d'Apple. "
                + "BUD ne fera pas sortir votre voix de la machine, donc la dictée reste fermée. "
                + "Pour l'activer : Réglages Système → Clavier → Dictée, et téléchargez le français."
        }
        guard r.isAvailable else {
            return "La reconnaissance vocale est momentanément indisponible."
        }
        return nil
    }

    // ─────────────────────────────────────────────────────────
    //  Marche et arrêt
    // ─────────────────────────────────────────────────────────

    func toggle() { listening ? stop(final: true) : start() }

    func start() { begin(.dictation) }

    private func begin(_ want: Mode) {
        guard mode != want else { return }
        if let why = unavailableReason() { onTrouble?(why); return }

        // Deux autorisations distinctes, et deux refus distincts : la
        // reconnaissance vocale et le microphone sont deux réglages de
        // confidentialité séparés, qu'on peut accorder l'un sans l'autre.
        SFSpeechRecognizer.requestAuthorization { [weak self] status in
            DispatchQueue.main.async {
                guard let s = self else { return }
                switch status {
                case .authorized:
                    s.askMicrophone(want)
                case .denied, .restricted:
                    s.onTrouble?("La reconnaissance vocale est refusée pour BUD. "
                        + "Réglages Système → Confidentialité et sécurité → Reconnaissance vocale.")
                case .notDetermined:
                    s.onTrouble?("Autorisation de reconnaissance vocale non accordée.")
                @unknown default:
                    s.onTrouble?("Autorisation de reconnaissance vocale indéterminée.")
                }
            }
        }
    }

    private func askMicrophone(_ want: Mode) {
        switch AVCaptureDevice.authorizationStatus(for: .audio) {
        case .authorized:
            beginListening(want)
        case .notDetermined:
            AVCaptureDevice.requestAccess(for: .audio) { [weak self] ok in
                DispatchQueue.main.async {
                    guard let s = self else { return }
                    if ok { s.beginListening(want) }
                    else { s.onTrouble?("Sans microphone, BUD ne peut pas vous entendre.") }
                }
            }
        default:
            onTrouble?("Le microphone est refusé pour BUD. "
                + "Réglages Système → Confidentialité et sécurité → Microphone.")
        }
    }

    private func beginListening(_ want: Mode) {
        guard let recognizer = recognizer else { return }
        // Le moteur est unique : on démonte proprement avant de remonter.
        teardown()

        let req = SFSpeechAudioBufferRecognitionRequest()
        req.shouldReportPartialResults = true
        // Le drapeau qui compte. `unavailableReason()` a déjà vérifié que
        // ce Mac l'honore : sans cette vérification, le poser ne serait
        // qu'une intention.
        req.requiresOnDeviceRecognition = true
        request = req

        let input = engine.inputNode
        let fmt = input.outputFormat(forBus: 0)
        // Sans entrée audio valable, `installTap` lève une exception
        // Objective-C, que Swift ne sait pas rattraper : l'application
        // s'arrêterait net. On regarde donc avant de poser la prise.
        guard fmt.channelCount > 0, fmt.sampleRate > 0 else {
            onTrouble?("Aucune entrée audio utilisable. Vérifiez le microphone dans Réglages Système → Son.")
            request = nil
            return
        }

        input.installTap(onBus: 0, bufferSize: 1024, format: fmt) { [weak self] buf, _ in
            self?.request?.append(buf)
        }

        engine.prepare()
        do {
            try engine.start()
        } catch {
            input.removeTap(onBus: 0)
            request = nil
            onTrouble?("Le moteur audio n'a pas démarré : \(error.localizedDescription)")
            return
        }

        lastText = ""
        wakeHeard = false
        wakeTail = ""
        mode = want
        onState?()

        task = recognizer.recognitionTask(with: req) { [weak self] result, error in
            DispatchQueue.main.async {
                guard let s = self, s.mode != .idle else { return }
                if let r = result {
                    let text = r.bestTranscription.formattedString
                    if !text.isEmpty { s.heard(text) }
                    if r.isFinal {
                        if s.mode == .wake { s.recycleWake() } else { s.stop(final: true) }
                    }
                } else if error != nil {
                    if s.mode == .wake {
                        // En veille, une erreur est presque toujours la fin
                        // d'un flux silencieux. On se remet à écouter.
                        s.recycleWake()
                    } else {
                        // Une erreur après de la parole reconnue n'est pas un
                        // échec : c'est souvent la fin du flux. On garde le texte.
                        s.stop(final: !s.lastText.isEmpty)
                        if s.lastText.isEmpty {
                            s.onTrouble?("Je n'ai rien compris. Réessayez en parlant un peu plus fort.")
                        }
                    }
                }
            }
        }

        if want == .dictation {
            // Deux garde-fous : on ne reste pas à écouter indéfiniment, et on
            // conclut dès que la phrase est finie plutôt que d'attendre.
            hardStop?.invalidate()
            hardStop = Timer.scheduledTimer(withTimeInterval: 20, repeats: false) { [weak self] _ in
                self?.stop(final: true)
            }
            armSilence()
        } else {
            armWakeRecycle()
        }
    }

    private func heard(_ text: String) {
        lastText = text
        switch mode {
        case .dictation:
            onPartial?(text)
            armSilence()
        case .wake:
            absorbWake(text)
        case .idle:
            break
        }
    }

    /// Relancé à chaque mot reconnu : deux secondes sans rien de neuf, et
    /// BUD considère la phrase terminée.
    private func armSilence() {
        silence?.invalidate()
        silence = Timer.scheduledTimer(withTimeInterval: 2.0, repeats: false) { [weak self] _ in
            self?.stop(final: true)
        }
    }

    /// Démonte le moteur sans toucher au mode : la remontée s'en charge.
    private func teardown() {
        hardStop?.invalidate(); hardStop = nil
        silence?.invalidate();  silence = nil
        wakeRecycle?.invalidate(); wakeRecycle = nil
        if engine.isRunning {
            engine.stop()
            engine.inputNode.removeTap(onBus: 0)
        }
        request?.endAudio()
        task?.cancel()
        request = nil
        task = nil
    }

    func stop(final: Bool) {
        let wasDictation = mode == .dictation
        guard mode != .idle else { return }
        teardown()
        mode = .idle
        onState?()

        let text = lastText.trimmingCharacters(in: .whitespacesAndNewlines)
        lastText = ""
        if final && wasDictation && !text.isEmpty { onFinal?(text) }

        // La dictée rend la main : si la veille était armée, elle reprend.
        if wasDictation && wakeArmed {
            DispatchQueue.main.asyncAfter(deadline: .now() + 0.3) { [weak self] in
                guard let s = self, s.wakeArmed, s.mode == .idle else { return }
                s.begin(.wake)
            }
        }
    }

    // ═══════════════════════════════════════════════════════════
    //  Le mot d'activation
    //
    //  Écouter en permanence n'est pas gratuit, et BUD ne le fera
    //  pas dans votre dos : la veille s'arme explicitement, et
    //  l'interface le montre tant qu'elle est armée. Le micro
    //  reste ouvert, la reconnaissance tourne sur le processeur,
    //  et sur batterie cela se sent. C'est pourquoi c'est un
    //  interrupteur et non un réglage par défaut.
    //
    //  Ce qui est écouté ne quitte toujours pas la machine :
    //  même moteur sur l'appareil, même refus de repli réseau.
    //
    //  Une tâche de reconnaissance ne vit pas indéfiniment —
    //  autour d'une minute — et son texte s'accumule. On la
    //  renouvelle donc pendant un silence, jamais au milieu
    //  d'une phrase, sinon on couperait la commande en deux.
    // ═══════════════════════════════════════════════════════════

    private var wakeHeard = false
    private var wakeTail = ""
    private var wakeRecycle: Timer?
    private var wakeQuiet: Timer?
    private var wakeLastChange = Date()

    /// Les formes que la reconnaissance rend pour « Hey Bud ». Le français
    /// n'écrit pas « Hey », et « Bud » n'est pas un mot du dictionnaire :
    /// la transcription varie. On accepte donc une famille, et au-delà une
    /// petite distance d'édition.
    private static let wakeForms = [
        "hey bud", "hey bude", "he bud", "hé bud", "et bud", "eh bud",
        "ok bud", "hey buddy", "hey but", "hey boude", "hey boud"
    ]

    func armWake() {
        guard !wakeArmed else { return }
        if let why = unavailableReason() { onTrouble?(why); return }
        wakeArmed = true
        onState?()
        if mode == .idle { begin(.wake) }
    }

    func disarmWake() {
        wakeArmed = false
        if mode == .wake { stop(final: false) }
        onState?()
    }

    func toggleWake() { wakeArmed ? disarmWake() : armWake() }

    private func armWakeRecycle() {
        wakeRecycle?.invalidate()
        // Toutes les dix secondes on regarde s'il est temps de renouveler
        // la tâche : seulement si plus rien n'a bougé depuis deux secondes
        // et qu'aucune commande n'est en cours.
        wakeRecycle = Timer.scheduledTimer(withTimeInterval: 10, repeats: true) { [weak self] _ in
            guard let s = self, s.mode == .wake else { return }
            guard !s.wakeHeard, Date().timeIntervalSince(s.wakeLastChange) > 2 else { return }
            s.recycleWake()
        }
    }

    /// Repart sur une tâche neuve, texte vidé.
    private func recycleWake() {
        guard wakeArmed else { stop(final: false); return }
        teardown()
        mode = .idle
        DispatchQueue.main.asyncAfter(deadline: .now() + 0.2) { [weak self] in
            guard let s = self, s.wakeArmed, s.mode == .idle else { return }
            s.begin(.wake)
        }
    }

    private func absorbWake(_ text: String) {
        wakeLastChange = Date()
        let norm = BudVoice.normalize(text)

        if !wakeHeard {
            guard let after = BudVoice.afterWake(norm, raw: text) else { return }
            wakeHeard = true
            wakeTail = after
            onWake?()
        } else if let after = BudVoice.afterWake(norm, raw: text) {
            wakeTail = after
        }

        // La commande est close par un silence court : on vient de parler,
        // on n'attend pas deux secondes de plus comme pour une dictée.
        wakeQuiet?.invalidate()
        wakeQuiet = Timer.scheduledTimer(withTimeInterval: 1.4, repeats: false) { [weak self] _ in
            self?.closeWakeCommand()
        }
    }

    private func closeWakeCommand() {
        wakeQuiet?.invalidate(); wakeQuiet = nil
        let cmd = wakeTail.trimmingCharacters(in: .whitespacesAndNewlines)
        wakeHeard = false
        wakeTail = ""
        if !cmd.isEmpty { onWakeCommand?(cmd) }
        recycleWake()
    }

    // ─────────────────────────────────────────────────────────
    //  Reconnaître « Hey Bud » dans un flux
    // ─────────────────────────────────────────────────────────

    /// Minuscules, sans accents, sans ponctuation, espaces réduits à un.
    static func normalize(_ s: String) -> String {
        let folded = s.folding(options: [.diacriticInsensitive, .caseInsensitive],
                               locale: Locale(identifier: "fr_FR"))
        let kept = folded.map { ch -> Character in
            (ch.isLetter || ch.isNumber) ? ch : " "
        }
        return String(kept).split(separator: " ").joined(separator: " ")
    }

    /// Rend ce qui suit le mot d'activation, ou `nil` s'il n'y est pas.
    ///
    /// Le découpage se fait sur le texte normalisé, mais la commande rendue
    /// vient du texte brut : « Réponds au mail de Free » doit garder ses
    /// accents et ses majuscules pour la suite.
    static func afterWake(_ norm: String, raw: String) -> String? {
        let words = norm.split(separator: " ").map(String.init)
        guard words.count >= 2 else { return nil }

        for i in 0..<(words.count - 1) {
            let pair = "\(words[i]) \(words[i + 1])"
            guard matchesWake(pair) else { continue }
            // Position du mot d'activation dans la suite normalisée : on
            // reprend le brut au même rang de mot, les deux listes ayant le
            // même nombre d'éléments à la ponctuation près.
            let rawWords = raw.split(separator: " ").map(String.init)
            let start = i + 2
            guard start < rawWords.count else { return "" }
            return rawWords[start...].joined(separator: " ")
        }
        return nil
    }

    private static func matchesWake(_ pair: String) -> Bool {
        if wakeForms.contains(pair) { return true }
        // Une faute de reconnaissance près : « hey bad », « ey bud ».
        for f in wakeForms where abs(f.count - pair.count) <= 2 {
            if editDistance(f, pair) <= 1 { return true }
        }
        return false
    }

    /// Distance de Levenshtein, deux lignes de tampon.
    static func editDistance(_ a: String, _ b: String) -> Int {
        let x = Array(a), y = Array(b)
        if x.isEmpty { return y.count }
        if y.isEmpty { return x.count }
        var prev = Array(0...y.count)
        var cur = [Int](repeating: 0, count: y.count + 1)
        for i in 1...x.count {
            cur[0] = i
            for j in 1...y.count {
                let cost = x[i - 1] == y[j - 1] ? 0 : 1
                cur[j] = min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost)
            }
            prev = cur
        }
        return prev[y.count]
    }
}

// ═══════════════════════════════════════════════════════════
//  Le bouton de dictée
//
//  Un micro qui pulse pendant l'écoute, et trois anneaux qui
//  s'écartent : il faut voir d'un coup d'œil que le Mac écoute.
// ═══════════════════════════════════════════════════════════

final class MicButton: NSView {
    var listening = false { didSet { listening ? startPulse() : stopPulse(); needsDisplay = true } }
    var onClick: (() -> Void)?

    private var t: CGFloat = 0
    private var anim: Timer?
    private var hover = false
    private var track: NSTrackingArea?

    override init(frame: NSRect) { super.init(frame: frame); wantsLayer = true }
    required init?(coder: NSCoder) { fatalError() }
    deinit { anim?.invalidate() }

    override func updateTrackingAreas() {
        super.updateTrackingAreas()
        if let a = track { removeTrackingArea(a) }
        let a = NSTrackingArea(rect: bounds, options: [.mouseEnteredAndExited, .activeInKeyWindow],
                               owner: self, userInfo: nil)
        addTrackingArea(a)
        track = a
    }
    override func mouseEntered(with e: NSEvent) { hover = true; needsDisplay = true }
    override func mouseExited(with e: NSEvent) { hover = false; needsDisplay = true }
    override func mouseDown(with e: NSEvent) { onClick?() }

    private func startPulse() {
        anim?.invalidate()
        anim = Timer.scheduledTimer(withTimeInterval: 1.0 / 30, repeats: true) { [weak self] _ in
            guard let s = self else { return }
            s.t += 0.055
            s.needsDisplay = true
        }
    }
    private func stopPulse() { anim?.invalidate(); anim = nil; t = 0 }

    override func draw(_ dirty: NSRect) {
        let b = bounds
        let c = NSPoint(x: b.midX, y: b.midY)
        let col = listening ? dangerColor : (hover ? TH.text : TH.dim(0.55))

        if listening {
            // Trois anneaux décalés d'un tiers de cycle, qui grandissent
            // en s'effaçant : l'onde qui part du micro.
            for k in 0..<3 {
                let ph = (t + CGFloat(k) / 3).truncatingRemainder(dividingBy: 1)
                let rad = 9 + ph * 11
                let a = (1 - ph) * 0.34
                col.withAlphaComponent(a).setStroke()
                let p = NSBezierPath(ovalIn: NSRect(x: c.x - rad, y: c.y - rad,
                                                    width: rad * 2, height: rad * 2))
                p.lineWidth = 1.4
                p.stroke()
            }
        }

        let disc = NSRect(x: c.x - 13, y: c.y - 13, width: 26, height: 26)
        TH.fill(listening ? 0.16 : (hover ? 0.12 : 0.07)).setFill()
        NSBezierPath(ovalIn: disc).fill()
        drawSymbol(listening ? "waveform" : "mic.fill", center: c, size: 13,
                   weight: .semibold, color: col)
    }
}
EOF_BUDVOICE_SWIFT

cat << 'EOF_BUDWEATHER_SWIFT' > "$SRC_DIR/BudWeather.swift"
import Cocoa

// ═══════════════════════════════════════════════════════════
//  La météo
//
//  La source d'abord, parce qu'elle a été choisie par
//  élimination. La météo d'Apple — WeatherKit — exige un
//  compte développeur payant et une application signée par
//  lui ; BUD ne l'est pas. Open-Meteo est gratuit sans clé
//  pour un usage personnel, sous licence CC BY 4.0 : la
//  mention de la source est donc affichée, et elle n'est pas
//  une politesse mais une condition.
//
//  Ce qui part de la machine : les coordonnées d'une ville,
//  arrondies au centième. Pas la position du Mac — BUD ne la
//  demande pas —, pas d'identifiant, pas de clé.
//
//  Le relevé a lieu toutes les trente minutes au plus, et le
//  dernier est gardé sur disque : la météo s'affiche
//  instantanément à l'ouverture, puis se met à jour.
// ═══════════════════════════════════════════════════════════

struct WeatherPlace: Codable, Equatable {
    var name: String
    var country: String
    var latitude: Double
    var longitude: Double
}

struct WeatherHour: Codable {
    var time: Date
    var temp: Double
    var code: Int
    var isDay: Bool
}

struct WeatherDay: Codable {
    var date: Date
    var code: Int
    var tmin: Double
    var tmax: Double
    var rain: Int          // probabilité maximale de précipitation, %
}

struct WeatherReport: Codable {
    var place: WeatherPlace
    var fetchedAt: Date
    var temp: Double
    var feels: Double
    var code: Int
    var isDay: Bool
    var wind: Double
    var humidity: Int
    var hours: [WeatherHour]
    var days: [WeatherDay]

    var condition: WeatherCondition { WeatherCondition(code: code, isDay: isDay) }
}

// ─────────────────────────────────────────────────────────
//  Les codes météo
//
//  Open-Meteo rend le code de l'Organisation météorologique
//  mondiale. On le traduit en trois choses : un libellé en
//  français, un symbole, et une scène — c'est la scène qui
//  décide de l'animation de fond.
// ─────────────────────────────────────────────────────────

enum WeatherScene { case clear, partly, cloudy, fog, drizzle, rain, snow, storm }

struct WeatherCondition {
    let code: Int
    let isDay: Bool

    var scene: WeatherScene {
        switch code {
        case 0:                         return .clear
        case 1, 2:                      return .partly
        case 3:                         return .cloudy
        case 45, 48:                    return .fog
        case 51, 53, 55, 56, 57:        return .drizzle
        case 61, 63, 65, 66, 67, 80, 81, 82: return .rain
        case 71, 73, 75, 77, 85, 86:    return .snow
        case 95, 96, 99:                return .storm
        default:                        return .cloudy
        }
    }

    var label: String {
        switch code {
        case 0:          return isDay ? "Ensoleillé" : "Dégagé"
        case 1:          return "Plutôt dégagé"
        case 2:          return "Partiellement nuageux"
        case 3:          return "Couvert"
        case 45, 48:     return "Brouillard"
        case 51, 53, 55: return "Bruine"
        case 56, 57:     return "Bruine verglaçante"
        case 61:         return "Pluie faible"
        case 63:         return "Pluie"
        case 65:         return "Forte pluie"
        case 66, 67:     return "Pluie verglaçante"
        case 71:         return "Neige faible"
        case 73:         return "Neige"
        case 75:         return "Forte neige"
        case 77:         return "Grains de neige"
        case 80, 81:     return "Averses"
        case 82:         return "Fortes averses"
        case 85, 86:     return "Averses de neige"
        case 95:         return "Orage"
        case 96, 99:     return "Orage et grêle"
        default:         return "—"
        }
    }

    /// Symboles présents depuis macOS 12 : un symbole absent ne
    /// s'affiche pas, il ne retombe sur rien.
    var symbol: String {
        switch scene {
        case .clear:   return isDay ? "sun.max.fill" : "moon.stars.fill"
        case .partly:  return isDay ? "cloud.sun.fill" : "cloud.moon.fill"
        case .cloudy:  return "cloud.fill"
        case .fog:     return "cloud.fog.fill"
        case .drizzle: return "cloud.drizzle.fill"
        case .rain:    return code == 65 || code == 82 ? "cloud.heavyrain.fill" : "cloud.rain.fill"
        case .snow:    return "cloud.snow.fill"
        case .storm:   return "cloud.bolt.rain.fill"
        }
    }

    /// Intensité 0 à 1 : le nombre de gouttes ou de flocons.
    var intensity: CGFloat {
        switch code {
        case 51, 56, 61, 71, 80, 85: return 0.45
        case 53, 63, 73, 81, 95:     return 0.75
        case 55, 57, 65, 67, 75, 82, 86, 96, 99: return 1.0
        default:                     return 0.6
        }
    }
}

/// Un symbole météo dans ses couleurs d'origine — le soleil jaune, la
/// pluie bleue —, comme dans l'application Météo. `drawSymbol` teinte
/// d'une seule couleur ; ici on veut l'inverse.
func drawWeatherSymbol(_ name: String, center: NSPoint, size: CGFloat) {
    let cfg = NSImage.SymbolConfiguration(pointSize: size, weight: .medium)
        .applying(.preferringMulticolor())
    guard let img = NSImage(systemSymbolName: name, accessibilityDescription: nil)?
            .withSymbolConfiguration(cfg) else { return }
    let s = img.size
    img.draw(in: NSRect(x: (center.x - s.width / 2).rounded(),
                        y: (center.y - s.height / 2).rounded(),
                        width: s.width, height: s.height))
}

// ═══════════════════════════════════════════════════════════
//  Le service
// ═══════════════════════════════════════════════════════════

final class WeatherService {
    static let shared = WeatherService()

    private(set) var report: WeatherReport?
    /// Prévenu sur le fil principal quand un relevé arrive.
    var onUpdate: ((WeatherReport?) -> Void)?
    /// La dernière erreur, en clair, ou rien.
    private(set) var trouble = ""

    private let file = budSupportDir.appendingPathComponent("weather.json")
    private var inFlight = false
    private var timer: Timer?

    private init() {
        if let d = try? Data(contentsOf: file) {
            let dec = JSONDecoder()
            dec.dateDecodingStrategy = .secondsSince1970
            report = try? dec.decode(WeatherReport.self, from: d)
        }
    }

    /// Relève toutes les trente minutes. La tolérance laisse le système
    /// regrouper le réveil avec d'autres : une météo n'a pas besoin de
    /// la seconde près.
    func start(city: @escaping () -> String) {
        guard timer == nil else { return }
        refresh(city: city())
        let t = Timer(timeInterval: 30 * 60, repeats: true) { [weak self] _ in
            self?.refresh(city: city())
        }
        t.tolerance = 120
        RunLoop.main.add(t, forMode: .common)
        timer = t
    }

    /// `force` ignore la fraîcheur du relevé gardé.
    func refresh(city: String, force: Bool = false) {
        let name = city.trimmingCharacters(in: .whitespacesAndNewlines)
        guard !name.isEmpty, !inFlight else { return }
        if !force, let r = report,
           r.place.name.lowercased() == name.lowercased() || placeKey == name.lowercased(),
           Date().timeIntervalSince(r.fetchedAt) < 25 * 60 { return }
        inFlight = true

        geocode(name) { [weak self] place in
            guard let s = self else { return }
            guard let place = place else {
                s.finish(nil, trouble: "Ville introuvable : « \(name) ».")
                return
            }
            s.placeKey = name.lowercased()
            s.forecast(place) { rep in
                s.finish(rep, trouble: rep == nil ? "Météo indisponible pour l'instant." : "")
            }
        }
    }

    /// La ville telle qu'elle a été tapée, pour reconnaître un relevé déjà
    /// fait quand le nom rendu par le service diffère — « paris » tapé,
    /// « Paris » rendu.
    private var placeKey = ""

    private func finish(_ r: WeatherReport?, trouble t: String) {
        DispatchQueue.main.async {
            self.inFlight = false
            self.trouble = t
            if let r = r {
                self.report = r
                let enc = JSONEncoder()
                enc.dateEncodingStrategy = .secondsSince1970
                if let d = try? enc.encode(r) { try? d.write(to: self.file, options: .atomic) }
            }
            self.onUpdate?(self.report)
        }
    }

    // ─────────────────────────────────────────────────────────
    //  Réseau
    // ─────────────────────────────────────────────────────────

    private func get(_ url: URL, done: @escaping ([String: Any]?) -> Void) {
        var req = URLRequest(url: url, timeoutInterval: 15)
        req.setValue("BUD-Premium/\(budVersion)", forHTTPHeaderField: "User-Agent")
        URLSession.shared.dataTask(with: req) { data, resp, _ in
            guard let data = data,
                  (resp as? HTTPURLResponse)?.statusCode == 200,
                  let obj = try? JSONSerialization.jsonObject(with: data) as? [String: Any]
            else { done(nil); return }
            done(obj)
        }.resume()
    }

    private func geocode(_ name: String, done: @escaping (WeatherPlace?) -> Void) {
        var c = URLComponents(string: "https://geocoding-api.open-meteo.com/v1/search")!
        c.queryItems = [URLQueryItem(name: "name", value: name),
                        URLQueryItem(name: "count", value: "1"),
                        URLQueryItem(name: "language", value: "fr"),
                        URLQueryItem(name: "format", value: "json")]
        guard let url = c.url else { done(nil); return }
        get(url) { obj in
            guard let r = (obj?["results"] as? [[String: Any]])?.first,
                  let lat = r["latitude"] as? Double, let lon = r["longitude"] as? Double
            else { done(nil); return }
            done(WeatherPlace(name: r["name"] as? String ?? name,
                              country: r["country"] as? String ?? "",
                              latitude: lat, longitude: lon))
        }
    }

    private func forecast(_ p: WeatherPlace, done: @escaping (WeatherReport?) -> Void) {
        var c = URLComponents(string: "https://api.open-meteo.com/v1/forecast")!
        // Coordonnées arrondies au centième, un peu plus d'un kilomètre :
        // la précision d'un modèle météo, pas celle d'une adresse.
        let lat = (p.latitude * 100).rounded() / 100
        let lon = (p.longitude * 100).rounded() / 100
        c.queryItems = [
            URLQueryItem(name: "latitude", value: String(lat)),
            URLQueryItem(name: "longitude", value: String(lon)),
            URLQueryItem(name: "current", value: "temperature_2m,relative_humidity_2m,"
                         + "apparent_temperature,is_day,weather_code,wind_speed_10m"),
            URLQueryItem(name: "hourly", value: "temperature_2m,weather_code,is_day"),
            URLQueryItem(name: "daily", value: "weather_code,temperature_2m_max,"
                         + "temperature_2m_min,precipitation_probability_max"),
            URLQueryItem(name: "timezone", value: "auto"),
            URLQueryItem(name: "forecast_days", value: "7")
        ]
        guard let url = c.url else { done(nil); return }
        get(url) { obj in done(obj.flatMap { WeatherService.parse($0, place: p) }) }
    }

    /// Fonction pure : rejouable sur une réponse enregistrée.
    static func parse(_ o: [String: Any], place: WeatherPlace) -> WeatherReport? {
        guard let cur = o["current"] as? [String: Any] else { return nil }
        let offset = o["utc_offset_seconds"] as? Int ?? 0

        // Les heures arrivent en heure locale du lieu, sans fuseau :
        // « 2026-11-27T17:00 ». On les lit dans le fuseau du lieu.
        let fmt = DateFormatter()
        fmt.locale = Locale(identifier: "en_US_POSIX")
        fmt.timeZone = TimeZone(secondsFromGMT: offset)
        func date(_ s: Any?, _ f: String) -> Date? {
            guard let s = s as? String else { return nil }
            fmt.dateFormat = f
            return fmt.date(from: s)
        }
        func num(_ a: Any?) -> Double { (a as? NSNumber)?.doubleValue ?? 0 }

        var hours: [WeatherHour] = []
        if let h = o["hourly"] as? [String: Any],
           let times = h["time"] as? [Any],
           let temps = h["temperature_2m"] as? [Any],
           let codes = h["weather_code"] as? [Any] {
            let days = h["is_day"] as? [Any] ?? []
            let now = Date().addingTimeInterval(-3600)
            for i in times.indices where i < temps.count && i < codes.count {
                guard let t = date(times[i], "yyyy-MM-dd'T'HH:mm"), t >= now else { continue }
                hours.append(WeatherHour(time: t, temp: num(temps[i]), code: Int(num(codes[i])),
                                         isDay: i < days.count ? num(days[i]) > 0 : true))
                if hours.count >= 24 { break }
            }
        }

        var days: [WeatherDay] = []
        if let d = o["daily"] as? [String: Any],
           let times = d["time"] as? [Any],
           let codes = d["weather_code"] as? [Any],
           let tmax = d["temperature_2m_max"] as? [Any],
           let tmin = d["temperature_2m_min"] as? [Any] {
            let rain = d["precipitation_probability_max"] as? [Any] ?? []
            for i in times.indices where i < codes.count && i < tmax.count && i < tmin.count {
                guard let t = date(times[i], "yyyy-MM-dd") else { continue }
                days.append(WeatherDay(date: t, code: Int(num(codes[i])),
                                       tmin: num(tmin[i]), tmax: num(tmax[i]),
                                       rain: i < rain.count ? Int(num(rain[i])) : 0))
            }
        }

        return WeatherReport(place: place, fetchedAt: Date(),
                             temp: num(cur["temperature_2m"]),
                             feels: num(cur["apparent_temperature"]),
                             code: Int(num(cur["weather_code"])),
                             isDay: num(cur["is_day"]) > 0,
                             wind: num(cur["wind_speed_10m"]),
                             humidity: Int(num(cur["relative_humidity_2m"])),
                             hours: hours, days: days)
    }

    /// Une phrase pour le chat et pour la pastille.
    func summary() -> String {
        guard let r = report else {
            return trouble.isEmpty ? "Je n'ai pas encore de relevé météo." : trouble
        }
        var s = "\(r.place.name) : \(Int(r.temp.rounded()))°, \(r.condition.label.lowercased())"
        if let d = r.days.first {
            s += ". Max \(Int(d.tmax.rounded()))°, min \(Int(d.tmin.rounded()))°"
            if d.rain >= 30 { s += ", \(d.rain) % de risque de pluie" }
        }
        return s + "."
    }
}

// ═══════════════════════════════════════════════════════════
//  La scène animée
//
//  Le fond de l'application Météo n'est pas une image : c'est
//  un ciel qui bouge. Soleil qui rayonne, nuages qui dérivent
//  sur trois plans à des vitesses différentes, pluie oblique,
//  neige qui oscille, éclair qui illumine tout le ciel.
//
//  Tout est dessiné, rien n'est chargé. Les particules sont
//  tirées une fois, d'une graine fixe : elles recommencent
//  leur course au lieu d'être recréées, et la scène ne coûte
//  pas plus à la centième seconde qu'à la première.
//
//  L'horloge ne tourne que quand la vue est visible. Un
//  panneau caché qui redessine trente fois par seconde est
//  une batterie qui fond pour personne.
// ═══════════════════════════════════════════════════════════

final class WeatherSceneView: NSView {

    var condition = WeatherCondition(code: 1, isDay: true) {
        didSet { needsDisplay = true }
    }

    private var timer: Timer?
    private var t: CGFloat = 0
    private var flash: CGFloat = 0
    private var nextBolt: CGFloat = 3

    private struct Drop { var x: CGFloat; var y: CGFloat; var speed: CGFloat; var len: CGFloat; var size: CGFloat; var phase: CGFloat }
    private var drops: [Drop] = []
    private var stars: [(CGPoint, CGFloat, CGFloat)] = []

    override init(frame: NSRect) {
        super.init(frame: frame)
        wantsLayer = true
        layer?.cornerRadius = 18
        layer?.masksToBounds = true
        // Graine fixe : la même pluie à chaque ouverture, et aucune
        // allocation pendant l'animation.
        var g = SeededRandom(seed: 27)
        for _ in 0..<160 {
            drops.append(Drop(x: g.next(), y: g.next(), speed: 0.6 + g.next() * 0.6,
                              len: 0.7 + g.next() * 0.6, size: 0.6 + g.next() * 0.8,
                              phase: g.next() * 6.28))
        }
        for _ in 0..<70 {
            stars.append((CGPoint(x: g.next(), y: 0.35 + g.next() * 0.65),
                          0.6 + g.next() * 1.3, g.next() * 6.28))
        }
    }
    required init?(coder: NSCoder) { fatalError() }

    override func viewDidMoveToWindow() {
        super.viewDidMoveToWindow()
        updateClock()
    }
    override func viewDidHide() { super.viewDidHide(); updateClock() }
    override func viewDidUnhide() { super.viewDidUnhide(); updateClock() }

    func updateClock() {
        let visible = window != nil && !isHiddenOrHasHiddenAncestor
        if visible && timer == nil {
            let tm = Timer(timeInterval: 1.0 / 30.0, repeats: true) { [weak self] _ in self?.tick() }
            RunLoop.main.add(tm, forMode: .common)
            timer = tm
        } else if !visible {
            timer?.invalidate()
            timer = nil
        }
    }

    private func tick() {
        guard !isHiddenOrHasHiddenAncestor else { updateClock(); return }
        // Fenêtre repliée : l'horloge reste, mais on ne dessine plus rien.
        guard window?.isVisible == true,
              window?.occlusionState.contains(.visible) == true else { return }
        t += 1.0 / 30.0
        if condition.scene == .storm {
            if t >= nextBolt {
                flash = 1
                // Irrégulier, comme un orage : entre trois et neuf secondes.
                nextBolt = t + 3 + CGFloat(abs(sin(t * 12.9898)) * 6)
            }
            flash = max(0, flash - 0.07)
        } else {
            flash = 0
        }
        needsDisplay = true
    }

    // ─────────────────────────────────────────────────────────
    //  Les ciels
    //
    //  Les dégradés reprennent ceux de l'application Météo : un
    //  bleu franc et lumineux le jour, un bleu nuit presque
    //  noir, des gris bleutés quand le ciel se couvre, plus
    //  sombres sous la pluie, presque violets sous l'orage.
    // ─────────────────────────────────────────────────────────

    private func sky() -> [NSColor] {
        func c(_ r: Int, _ g: Int, _ b: Int) -> NSColor {
            NSColor(srgbRed: CGFloat(r) / 255, green: CGFloat(g) / 255, blue: CGFloat(b) / 255, alpha: 1)
        }
        let day = condition.isDay
        switch condition.scene {
        case .clear:   return day ? [c(46, 120, 214), c(110, 172, 235)] : [c(8, 16, 42), c(28, 46, 92)]
        case .partly:  return day ? [c(64, 128, 204), c(132, 176, 222)] : [c(14, 22, 48), c(40, 56, 96)]
        case .cloudy:  return day ? [c(96, 118, 146), c(150, 168, 188)] : [c(26, 32, 46), c(56, 64, 82)]
        case .fog:     return day ? [c(132, 142, 154), c(182, 188, 196)] : [c(38, 42, 50), c(70, 74, 84)]
        case .drizzle, .rain:
                       return day ? [c(60, 78, 102), c(108, 126, 148)] : [c(18, 24, 36), c(44, 54, 70)]
        case .snow:    return day ? [c(118, 140, 168), c(196, 210, 226)] : [c(30, 38, 58), c(78, 90, 116)]
        case .storm:   return day ? [c(42, 44, 66), c(82, 84, 112)] : [c(12, 12, 24), c(38, 36, 58)]
        }
    }

    override func draw(_ dirty: NSRect) {
        let b = bounds
        let colors = sky()
        NSGradient(colors: [colors[1], colors[0]])?.draw(in: b, angle: 90)

        let scene = condition.scene
        let day = condition.isDay

        if !day && (scene == .clear || scene == .partly) { drawStars(b) }
        if scene == .clear || scene == .partly {
            if day { drawSun(b) } else { drawMoon(b) }
        }
        switch scene {
        case .partly:
            drawClouds(b, layers: 2, opacity: day ? 0.85 : 0.35, dark: !day)
        case .cloudy:
            drawClouds(b, layers: 3, opacity: day ? 0.75 : 0.45, dark: true)
        case .fog:
            drawClouds(b, layers: 2, opacity: 0.35, dark: false)
            drawFog(b)
        case .drizzle:
            drawClouds(b, layers: 3, opacity: 0.55, dark: true)
            drawRain(b, amount: 0.35, heavy: false)
        case .rain:
            drawClouds(b, layers: 3, opacity: 0.55, dark: true)
            drawRain(b, amount: condition.intensity, heavy: condition.intensity > 0.9)
        case .snow:
            drawClouds(b, layers: 2, opacity: 0.5, dark: false)
            drawSnow(b, amount: condition.intensity)
        case .storm:
            drawClouds(b, layers: 3, opacity: 0.65, dark: true)
            drawRain(b, amount: 1, heavy: true)
            drawLightning(b)
        case .clear:
            break
        }

        // Un voile en bas : le texte et les cartes posés dessus restent
        // lisibles quel que soit le ciel.
        NSGradient(colors: [NSColor.black.withAlphaComponent(0.28), .clear])?
            .draw(in: NSRect(x: 0, y: 0, width: b.width, height: b.height * 0.55), angle: 90)
    }

    private func drawSun(_ b: NSRect) {
        let c = CGPoint(x: b.maxX - b.width * 0.18, y: b.maxY - b.height * 0.16)
        let r = min(b.width, b.height) * 0.07
        // Le halo respire lentement ; les rayons tournent à peine.
        let breath = 1 + 0.06 * sin(t * 0.9)
        NSGradient(colors: [NSColor(srgbRed: 1, green: 0.93, blue: 0.62, alpha: 0.55),
                            NSColor(srgbRed: 1, green: 0.85, blue: 0.45, alpha: 0)])?
            .draw(in: NSRect(x: c.x - r * 4.2 * breath, y: c.y - r * 4.2 * breath,
                             width: r * 8.4 * breath, height: r * 8.4 * breath),
                  relativeCenterPosition: .zero)
        NSGraphicsContext.current?.saveGraphicsState()
        let tr = NSAffineTransform()
        tr.translateX(by: c.x, yBy: c.y)
        tr.rotate(byRadians: t * 0.05)
        tr.concat()
        NSColor(srgbRed: 1, green: 0.95, blue: 0.75, alpha: 0.10).setFill()
        for i in 0..<12 {
            let a = CGFloat(i) / 12 * .pi * 2
            let p = NSBezierPath()
            p.move(to: .zero)
            p.line(to: CGPoint(x: cos(a - 0.06) * r * 6, y: sin(a - 0.06) * r * 6))
            p.line(to: CGPoint(x: cos(a + 0.06) * r * 6, y: sin(a + 0.06) * r * 6))
            p.close()
            p.fill()
        }
        NSGraphicsContext.current?.restoreGraphicsState()
        NSGradient(colors: [NSColor(srgbRed: 1, green: 0.98, blue: 0.86, alpha: 1),
                            NSColor(srgbRed: 1, green: 0.86, blue: 0.42, alpha: 1)])?
            .draw(in: NSBezierPath(ovalIn: NSRect(x: c.x - r, y: c.y - r, width: r * 2, height: r * 2)),
                  relativeCenterPosition: NSPoint(x: -0.3, y: 0.3))
    }

    private func drawMoon(_ b: NSRect) {
        let c = CGPoint(x: b.maxX - b.width * 0.20, y: b.maxY - b.height * 0.18)
        let r = min(b.width, b.height) * 0.07
        NSGradient(colors: [NSColor(white: 1, alpha: 0.22), NSColor(white: 1, alpha: 0)])?
            .draw(in: NSRect(x: c.x - r * 3.5, y: c.y - r * 3.5, width: r * 7, height: r * 7),
                  relativeCenterPosition: .zero)
        // Un croissant : un disque clair, mordu par un disque de la
        // couleur du ciel.
        NSColor(srgbRed: 0.96, green: 0.95, blue: 0.88, alpha: 1).setFill()
        NSBezierPath(ovalIn: NSRect(x: c.x - r, y: c.y - r, width: r * 2, height: r * 2)).fill()
        sky()[0].blended(withFraction: 0.35, of: sky()[1])?.setFill()
        NSBezierPath(ovalIn: NSRect(x: c.x - r * 0.45, y: c.y - r * 0.75, width: r * 2, height: r * 2)).fill()
    }

    private func drawStars(_ b: NSRect) {
        for (p, size, ph) in stars {
            let tw = 0.35 + 0.65 * (0.5 + 0.5 * sin(t * 1.6 + ph))
            NSColor(white: 1, alpha: 0.55 * tw).setFill()
            let s = size * (0.8 + 0.3 * tw)
            NSBezierPath(ovalIn: NSRect(x: p.x * b.width - s / 2, y: p.y * b.height - s / 2,
                                        width: s, height: s)).fill()
        }
    }

    /// Un nuage : cinq disques qui se chevauchent sur une base plate.
    private func cloud(at c: CGPoint, w: CGFloat, color: NSColor) {
        let h = w * 0.42
        let p = NSBezierPath()
        p.appendRoundedRect(NSRect(x: c.x - w / 2, y: c.y - h * 0.25, width: w, height: h * 0.5),
                            xRadius: h * 0.25, yRadius: h * 0.25)
        let lobes: [(CGFloat, CGFloat, CGFloat)] = [(-0.30, 0.10, 0.26), (-0.08, 0.28, 0.34),
                                                    (0.18, 0.20, 0.28), (0.34, 0.04, 0.20),
                                                    (-0.42, -0.02, 0.17)]
        for (dx, dy, r) in lobes {
            p.appendOval(in: NSRect(x: c.x + dx * w - r * w / 2, y: c.y + dy * h * 1.4 - r * w / 2,
                                    width: r * w, height: r * w))
        }
        color.setFill()
        p.fill()
    }

    private func drawClouds(_ b: NSRect, layers: Int, opacity: CGFloat, dark: Bool) {
        // Trois plans : le plus lointain est le plus petit, le plus pâle
        // et le plus lent. C'est la différence de vitesse qui donne la
        // profondeur, pas la taille.
        let specs: [(y: CGFloat, w: CGFloat, speed: CGFloat, alpha: CGFloat, n: Int)] = [
            (0.84, 0.24, 4, 0.55, 3), (0.77, 0.32, 7, 0.75, 3), (0.92, 0.42, 11, 1.0, 2)
        ]
        for (i, s) in specs.prefix(layers).enumerated() {
            let base = dark ? NSColor(white: 0.78 - CGFloat(i) * 0.08, alpha: 1) : NSColor(white: 1, alpha: 1)
            let col = base.withAlphaComponent(opacity * s.alpha)
            let w = b.width * s.w
            let span = b.width + w
            for k in 0..<s.n {
                let x0 = CGFloat(k) / CGFloat(s.n) * span + CGFloat(i) * 47
                let x = (x0 + t * s.speed).truncatingRemainder(dividingBy: span) - w / 2
                let y = b.height * s.y + sin(t * 0.3 + CGFloat(k * 2 + i)) * 3
                cloud(at: CGPoint(x: x, y: y), w: w, color: col)
            }
        }
    }

    private func drawRain(_ b: NSRect, amount: CGFloat, heavy: Bool) {
        let n = Int(CGFloat(drops.count) * max(0.2, min(1, amount)))
        let slant: CGFloat = 0.18
        let p = NSBezierPath()
        p.lineWidth = heavy ? 1.6 : 1.2
        p.lineCapStyle = .round
        for d in drops.prefix(n) {
            let fall = (d.y + t * d.speed * (heavy ? 1.3 : 1.0)).truncatingRemainder(dividingBy: 1.15)
            let y = b.maxY - fall * b.height
            let x = d.x * (b.width + 40) - 20 - fall * b.height * slant
            let len = (heavy ? 22 : 15) * d.len
            p.move(to: CGPoint(x: x, y: y))
            p.line(to: CGPoint(x: x + len * slant, y: y + len))
        }
        NSColor(srgbRed: 0.82, green: 0.90, blue: 1, alpha: heavy ? 0.55 : 0.42).setStroke()
        p.stroke()
    }

    private func drawSnow(_ b: NSRect, amount: CGFloat) {
        let n = Int(CGFloat(drops.count) * 0.7 * max(0.3, min(1, amount)))
        NSColor(white: 1, alpha: 0.85).setFill()
        for d in drops.prefix(n) {
            let fall = (d.y + t * d.speed * 0.12).truncatingRemainder(dividingBy: 1.1)
            let y = b.maxY - fall * b.height
            // Le flocon oscille : il tombe en se balançant, pas en ligne.
            let x = d.x * b.width + sin(t * 1.2 + d.phase) * 9
            let s = 2 + d.size * 2.2
            NSBezierPath(ovalIn: NSRect(x: x - s / 2, y: y - s / 2, width: s, height: s)).fill()
        }
    }

    private func drawFog(_ b: NSRect) {
        for i in 0..<4 {
            let y = b.height * (0.18 + CGFloat(i) * 0.17)
            let x = sin(t * 0.15 + CGFloat(i)) * 40
            let band = NSRect(x: x - 60, y: y, width: b.width + 120, height: b.height * 0.12)
            NSGradient(colors: [NSColor(white: 1, alpha: 0), NSColor(white: 1, alpha: 0.16),
                                NSColor(white: 1, alpha: 0)])?.draw(in: band, angle: 90)
        }
    }

    private func drawLightning(_ b: NSRect) {
        guard flash > 0 else { return }
        // L'éclair illumine tout le ciel une fraction de seconde : c'est
        // la lumière qu'on remarque, l'arc vient après.
        NSColor(white: 1, alpha: 0.35 * flash).setFill()
        b.fill(using: .sourceOver)
        if flash > 0.55 {
            let x0 = b.width * (0.3 + 0.4 * abs(sin(nextBolt * 3.1)))
            let p = NSBezierPath()
            p.move(to: CGPoint(x: x0, y: b.maxY))
            var x = x0, y = b.maxY
            var k: CGFloat = 1
            while y > b.height * 0.45 {
                y -= b.height * 0.07
                x += (sin(k * 7.7 + nextBolt) * 14)
                p.line(to: CGPoint(x: x, y: y))
                k += 1
            }
            p.lineWidth = 2
            NSColor(srgbRed: 0.95, green: 0.95, blue: 1, alpha: flash).setStroke()
            p.stroke()
        }
    }
}

/// Générateur déterministe : la même suite à chaque ouverture.
struct SeededRandom {
    private var s: UInt64
    init(seed: UInt64) { s = seed &* 0x9E3779B97F4A7C15 }
    mutating func next() -> CGFloat {
        s ^= s << 13; s ^= s >> 7; s ^= s << 17
        return CGFloat(s % 1_000_000) / 1_000_000
    }
}

// ═══════════════════════════════════════════════════════════
//  Le panneau Météo
//
//  La disposition de l'application Météo : la ville, la
//  température en grand et en léger, le ciel en mots, le
//  maximum et le minimum. Puis les heures qui viennent, en
//  bande. Puis la semaine, avec pour chaque jour une barre
//  qui situe ses températures dans celles de toute la
//  semaine — c'est ce qui permet de voir d'un coup d'œil
//  qu'il fera froid jeudi.
// ═══════════════════════════════════════════════════════════

final class WeatherPanelView: NSView {

    private let scene: WeatherSceneView
    private let overlay: WeatherOverlay
    private var cityField: NSTextField!
    var onCity: ((String) -> Void)?
    var onRefresh: (() -> Void)?

    override init(frame: NSRect) {
        scene = WeatherSceneView(frame: NSRect(origin: .zero, size: frame.size))
        overlay = WeatherOverlay(frame: NSRect(origin: .zero, size: frame.size))
        super.init(frame: frame)
        scene.autoresizingMask = [.width, .height]
        overlay.autoresizingMask = [.width, .height]
        addSubview(scene)
        addSubview(overlay)

        let W = frame.width
        cityField = NSTextField(frame: NSRect(x: W - 252, y: 12, width: 150, height: 24))
        cityField.placeholderString = "Ville"
        cityField.bezelStyle = .roundedBezel
        cityField.font = NSFont.systemFont(ofSize: 12)
        cityField.target = self
        cityField.action = #selector(cityEntered)
        addSubview(cityField)

        let refresh = GlassButton(frame: NSRect(x: W - 94, y: 10, width: 80, height: 28),
                                  title: "Actualiser", icon: "arrow.clockwise", compact: true)
        refresh.onClick = { [weak self] _ in self?.onRefresh?() }
        addSubview(refresh)
    }
    required init?(coder: NSCoder) { fatalError() }

    @objc private func cityEntered() {
        let c = cityField.stringValue.trimmingCharacters(in: .whitespaces)
        if !c.isEmpty { onCity?(c) }
    }

    func apply(_ r: WeatherReport?, city: String, trouble: String) {
        if cityField.currentEditor() == nil { cityField.stringValue = city }
        overlay.report = r
        overlay.trouble = trouble
        if let r = r { scene.condition = r.condition }
        overlay.needsDisplay = true
        scene.updateClock()
    }

    override func viewDidUnhide() { super.viewDidUnhide(); scene.updateClock() }
    override func viewDidHide() { super.viewDidHide(); scene.updateClock() }
}

/// Le texte et les cartes, posés sur la scène. Une vue à part : la scène
/// se redessine trente fois par seconde, le texte une fois par relevé.
final class WeatherOverlay: NSView {
    var report: WeatherReport?
    var trouble = ""

    override func hitTest(_ p: NSPoint) -> NSView? { nil }

    private let white = NSColor.white
    private func soft(_ a: CGFloat) -> NSColor { NSColor.white.withAlphaComponent(a) }

    override func draw(_ dirty: NSRect) {
        let b = bounds
        guard let r = report else {
            drawString(trouble.isEmpty ? "Relevé en cours…" : trouble,
                       in: NSRect(x: 0, y: b.midY - 10, width: b.width, height: 20),
                       size: 14, weight: .semibold, color: soft(0.85), align: .center)
            return
        }
        NSGraphicsContext.current?.saveGraphicsState()
        let sh = NSShadow()
        sh.shadowColor = NSColor.black.withAlphaComponent(0.25)
        sh.shadowBlurRadius = 6
        sh.shadowOffset = NSSize(width: 0, height: -1)
        sh.set()

        // ── L'en-tête ──
        let top = b.maxY
        drawString(r.place.name, in: NSRect(x: 0, y: top - 44, width: b.width, height: 26),
                   size: 22, weight: .semibold, color: white, align: .center)
        drawString("\(Int(r.temp.rounded()))°",
                   in: NSRect(x: 0, y: top - 112, width: b.width + 12, height: 70),
                   size: 64, weight: .thin, color: white, align: .center)
        drawString(r.condition.label, in: NSRect(x: 0, y: top - 136, width: b.width, height: 20),
                   size: 15, weight: .medium, color: soft(0.92), align: .center)
        if let d = r.days.first {
            drawString("Max. \(Int(d.tmax.rounded()))°  Min. \(Int(d.tmin.rounded()))°",
                       in: NSRect(x: 0, y: top - 158, width: b.width, height: 18),
                       size: 13, weight: .medium, color: soft(0.85), align: .center)
        }
        NSGraphicsContext.current?.restoreGraphicsState()

        // ── Les heures ──
        let hourCard = NSRect(x: 16, y: top - 270, width: b.width - 32, height: 100)
        card(hourCard)
        let feels = Int(r.feels.rounded())
        drawString("Ressenti \(feels)° · vent \(Int(r.wind.rounded())) km/h · humidité \(r.humidity) %",
                   in: NSRect(x: hourCard.minX + 14, y: hourCard.maxY - 22,
                              width: hourCard.width - 28, height: 15),
                   size: 11, weight: .medium, color: soft(0.70))
        NSColor.white.withAlphaComponent(0.15).setFill()
        NSRect(x: hourCard.minX + 14, y: hourCard.maxY - 27, width: hourCard.width - 28, height: 0.5).fill()

        let hours = Array(r.hours.prefix(12))
        if !hours.isEmpty {
            let cw = (hourCard.width - 20) / CGFloat(hours.count)
            let hf = DateFormatter()
            hf.locale = Locale(identifier: "fr_FR")
            hf.dateFormat = "HH"
            for (i, h) in hours.enumerated() {
                let cx = hourCard.minX + 10 + cw * (CGFloat(i) + 0.5)
                let label = i == 0 ? "Maint." : hf.string(from: h.time) + " h"
                drawString(label, in: NSRect(x: cx - cw / 2, y: hourCard.minY + 50, width: cw, height: 14),
                           size: 10.5, weight: .semibold, color: soft(0.85), align: .center)
                drawWeatherSymbol(WeatherCondition(code: h.code, isDay: h.isDay).symbol,
                                  center: NSPoint(x: cx, y: hourCard.minY + 36), size: 15)
                drawString("\(Int(h.temp.rounded()))°",
                           in: NSRect(x: cx - cw / 2, y: hourCard.minY + 8, width: cw + 4, height: 16),
                           size: 12.5, weight: .semibold, color: white, align: .center)
            }
        }

        // ── La semaine ──
        let dayCard = NSRect(x: 16, y: 48, width: b.width - 32, height: hourCard.minY - 58)
        card(dayCard)
        drawSymbol("calendar", center: NSPoint(x: dayCard.minX + 20, y: dayCard.maxY - 15),
                   size: 10, weight: .semibold, color: soft(0.6))
        drawString("PRÉVISIONS SUR 7 JOURS",
                   in: NSRect(x: dayCard.minX + 30, y: dayCard.maxY - 22, width: 220, height: 14),
                   size: 10, weight: .semibold, color: soft(0.6))

        let days = Array(r.days.prefix(7))
        guard !days.isEmpty else { return }
        let lo = days.map { $0.tmin }.min() ?? 0
        let hi = days.map { $0.tmax }.max() ?? 1
        let span = max(1, hi - lo)
        let rowH = (dayCard.height - 30) / CGFloat(days.count)
        let df = DateFormatter()
        df.locale = Locale(identifier: "fr_FR")
        df.dateFormat = "EEE"
        let barX = dayCard.minX + dayCard.width * 0.50
        let barW = dayCard.width * 0.30

        for (i, d) in days.enumerated() {
            let y = dayCard.maxY - 30 - rowH * CGFloat(i + 1)
            let mid = y + rowH / 2
            if i > 0 {
                NSColor.white.withAlphaComponent(0.12).setFill()
                NSRect(x: dayCard.minX + 14, y: y + rowH - 0.5, width: dayCard.width - 28, height: 0.5).fill()
            }
            let name = i == 0 ? "Auj." : df.string(from: d.date).capitalized
            drawString(name, in: NSRect(x: dayCard.minX + 14, y: mid - 9, width: 60, height: 18),
                       size: 13.5, weight: .semibold, color: white)
            let cond = WeatherCondition(code: d.code, isDay: true)
            drawWeatherSymbol(cond.symbol, center: NSPoint(x: dayCard.minX + 96, y: mid + (d.rain >= 20 ? 4 : 0)),
                              size: 15)
            // La probabilité de pluie sous le symbole, en bleu clair, et
            // seulement quand elle compte : à dix pour cent, l'afficher
            // inquiéterait pour rien.
            if d.rain >= 20 {
                drawString("\(d.rain) %", in: NSRect(x: dayCard.minX + 76, y: mid - 16, width: 40, height: 12),
                           size: 9.5, weight: .bold,
                           color: NSColor(srgbRed: 0.55, green: 0.80, blue: 1, alpha: 1), align: .center)
            }
            drawString("\(Int(d.tmin.rounded()))°",
                       in: NSRect(x: barX - 46, y: mid - 9, width: 38, height: 18),
                       size: 13.5, weight: .medium, color: soft(0.6), align: .right)
            drawString("\(Int(d.tmax.rounded()))°",
                       in: NSRect(x: barX + barW + 8, y: mid - 9, width: 38, height: 18),
                       size: 13.5, weight: .semibold, color: white)

            // La barre de la semaine : la piste couvre toute l'amplitude
            // des sept jours, le segment coloré celle du jour.
            let track = NSRect(x: barX, y: mid - 2.5, width: barW, height: 5)
            NSColor.black.withAlphaComponent(0.22).setFill()
            NSBezierPath(roundedRect: track, xRadius: 2.5, yRadius: 2.5).fill()
            let x0 = barX + barW * CGFloat((d.tmin - lo) / span)
            let x1 = barX + barW * CGFloat((d.tmax - lo) / span)
            let seg = NSRect(x: x0, y: track.minY, width: max(5, x1 - x0), height: 5)
            NSGraphicsContext.current?.saveGraphicsState()
            NSBezierPath(roundedRect: seg, xRadius: 2.5, yRadius: 2.5).addClip()
            // Le dégradé est celui de toute la semaine, découpé par le
            // segment : un jour froid est bleu, un jour doux jaune.
            NSGradient(colors: [tempColor(lo), tempColor((lo + hi) / 2), tempColor(hi)])?
                .draw(in: track, angle: 0)
            NSGraphicsContext.current?.restoreGraphicsState()

            // Aujourd'hui : un point blanc à la température actuelle.
            if i == 0 {
                let xn = barX + barW * CGFloat(max(0, min(1, (r.temp - lo) / span)))
                NSColor.black.withAlphaComponent(0.35).setFill()
                NSBezierPath(ovalIn: NSRect(x: xn - 4.5, y: mid - 4.5, width: 9, height: 9)).fill()
                NSColor.white.setFill()
                NSBezierPath(ovalIn: NSRect(x: xn - 3, y: mid - 3, width: 6, height: 6)).fill()
            }
        }

        // ── La source ──
        let ago = Int(Date().timeIntervalSince(r.fetchedAt) / 60)
        let when = ago < 1 ? "à l'instant" : (ago < 60 ? "il y a \(ago) min" : "il y a \(ago / 60) h")
        drawString("Données Open-Meteo · CC BY 4.0 · mis à jour \(when)",
                   in: NSRect(x: 18, y: 16, width: b.width - 290, height: 14),
                   size: 9.5, weight: .medium, color: soft(0.55))
    }

    /// Une carte de verre : fond sombre translucide et liseré clair.
    private func card(_ r: NSRect) {
        let p = NSBezierPath(roundedRect: r, xRadius: 14, yRadius: 14)
        NSColor.black.withAlphaComponent(0.20).setFill()
        p.fill()
        NSColor.white.withAlphaComponent(0.14).setStroke()
        p.lineWidth = 0.8
        p.stroke()
    }

    /// Du bleu froid au orange chaud, comme les barres de l'application
    /// Météo : −5° bleu, 10° vert d'eau, 20° jaune, 30° orange.
    private func tempColor(_ c: Double) -> NSColor {
        let stops: [(Double, (CGFloat, CGFloat, CGFloat))] = [
            (-5, (0.35, 0.60, 1.00)), (5, (0.38, 0.82, 0.95)), (12, (0.55, 0.88, 0.62)),
            (20, (0.98, 0.84, 0.30)), (28, (1.00, 0.58, 0.22)), (36, (0.96, 0.32, 0.24))
        ]
        if c <= stops[0].0 { let v = stops[0].1; return NSColor(srgbRed: v.0, green: v.1, blue: v.2, alpha: 1) }
        for i in 1..<stops.count where c <= stops[i].0 {
            let (a0, c0) = stops[i - 1], (a1, c1) = stops[i]
            let f = CGFloat((c - a0) / (a1 - a0))
            return NSColor(srgbRed: c0.0 + (c1.0 - c0.0) * f, green: c0.1 + (c1.1 - c0.1) * f,
                           blue: c0.2 + (c1.2 - c0.2) * f, alpha: 1)
        }
        let v = stops[stops.count - 1].1
        return NSColor(srgbRed: v.0, green: v.1, blue: v.2, alpha: 1)
    }
}
EOF_BUDWEATHER_SWIFT

cat << 'EOF_MAIN_SWIFT' > "$SRC_DIR/main.swift"
import Cocoa

// Point d'entrée : avec plusieurs fichiers, le code au niveau racine
// doit obligatoirement se trouver dans un fichier nommé main.swift.
let app = NSApplication.shared
app.setActivationPolicy(.accessory)
let budDelegate = BudDelegate()
app.delegate = budDelegate
app.run()
EOF_MAIN_SWIFT

cat << 'EOF_MAKEICON_X9' > "$TOOLS_DIR/MakeIcon.swift"
import Cocoa

// Génère l'iconset de BUD : un squircle dégradé portant le visage du compagnon.
// Usage : budicon <dossier .iconset>

let accent = NSColor(calibratedRed: 0.22, green: 0.85, blue: 0.62, alpha: 1)
let accentDeep = NSColor(calibratedRed: 0.06, green: 0.42, blue: 0.36, alpha: 1)

/// Le corps du compagnon, identique à squirclePath() de BudFace.swift.
/// Dupliqué parce que ce générateur se compile seul.
func budSquircle(size: CGFloat, ratio: CGFloat = 0.30) -> NSBezierPath {
    let h = size / 2, r = size * ratio, k = r / 3
    let p = NSBezierPath()
    p.move(to: NSPoint(x: -h + r, y: -h))
    p.line(to: NSPoint(x: h - r, y: -h))
    p.curve(to: NSPoint(x: h, y: -h + r),
            controlPoint1: NSPoint(x: h - k, y: -h),
            controlPoint2: NSPoint(x: h, y: -h + k))
    p.line(to: NSPoint(x: h, y: h - r))
    p.curve(to: NSPoint(x: h - r, y: h),
            controlPoint1: NSPoint(x: h, y: h - k),
            controlPoint2: NSPoint(x: h - k, y: h))
    p.line(to: NSPoint(x: -h + r, y: h))
    p.curve(to: NSPoint(x: -h, y: h - r),
            controlPoint1: NSPoint(x: -h + k, y: h),
            controlPoint2: NSPoint(x: -h, y: h - k))
    p.line(to: NSPoint(x: -h, y: -h + r))
    p.curve(to: NSPoint(x: -h + r, y: -h),
            controlPoint1: NSPoint(x: -h, y: -h + k),
            controlPoint2: NSPoint(x: -h + k, y: -h))
    p.close()
    return p
}

func squircle(_ r: NSRect, _ radius: CGFloat) -> NSBezierPath {
    NSBezierPath(roundedRect: r, xRadius: radius, yRadius: radius)
}

func renderIcon(size: CGFloat) -> NSImage {
    let img = NSImage(size: NSSize(width: size, height: size))
    img.lockFocus()
    let ctx = NSGraphicsContext.current!
    ctx.imageInterpolation = .high

    let u = size / 1024.0
    let pad = 92 * u
    let body = NSRect(x: pad, y: pad, width: size - pad * 2, height: size - pad * 2)
    let corner = body.width * 0.236

    let shadow = NSShadow()
    shadow.shadowColor = NSColor.black.withAlphaComponent(0.35)
    shadow.shadowBlurRadius = 40 * u
    shadow.shadowOffset = NSSize(width: 0, height: -18 * u)
    ctx.saveGraphicsState()
    shadow.set()
    let shape = squircle(body, corner)
    let night = NSGradient(colors: [NSColor(calibratedWhite: 0.17, alpha: 1),
                                    NSColor(calibratedWhite: 0.04, alpha: 1)])
    night?.draw(in: shape, angle: -90)
    ctx.restoreGraphicsState()

    ctx.saveGraphicsState()
    shape.addClip()

    // Halo d'accent
    let haloR = body.width * 0.40
    NSGradient(colors: [accent.withAlphaComponent(0.50), accent.withAlphaComponent(0.0)])?
        .draw(in: NSBezierPath(ovalIn: NSRect(x: body.midX - haloR, y: body.midY - haloR * 0.95,
                                              width: haloR * 2, height: haloR * 2)),
              relativeCenterPosition: NSPoint(x: 0, y: 0))

    // ── Le compagnon : même squircle que dans l'application ──
    ctx.saveGraphicsState()
    ctx.cgContext.translateBy(x: body.midX, y: body.midY - body.height * 0.01)
    let s = body.width * 0.60

    let shell = budSquircle(size: s, ratio: 0.30)
    NSColor.white.setFill()
    shell.fill()

    // Liseré interne, comme le style à plat
    ctx.saveGraphicsState()
    shell.addClip()
    let ring = budSquircle(size: s, ratio: 0.30)
    ring.lineWidth = s * 0.065
    NSColor(calibratedRed: 0.847, green: 0.886, blue: 0.910, alpha: 0.85).setStroke()
    ring.stroke()
    ctx.restoreGraphicsState()

    // Joues
    NSColor(calibratedRed: 1.00, green: 0.710, blue: 0.710, alpha: 1).setFill()
    for side in [CGFloat(-1), CGFloat(1)] {
        NSBezierPath(ovalIn: NSRect(x: side * s * 0.235 - s * 0.072,
                                    y: -s * 0.095 - s * 0.041,
                                    width: s * 0.144, height: s * 0.082)).fill()
    }

    // Yeux
    let ink = NSColor(calibratedRed: 0.137, green: 0.152, blue: 0.200, alpha: 1)
    let eyeR = s * 0.044
    for side in [CGFloat(-1), CGFloat(1)] {
        let cxE = side * s * 0.145, cyE = -s * 0.012
        ink.setFill()
        NSBezierPath(ovalIn: NSRect(x: cxE - eyeR, y: cyE - eyeR,
                                    width: eyeR * 2, height: eyeR * 2)).fill()
        NSColor.white.withAlphaComponent(0.72).setFill()
        let g = eyeR * 0.26
        NSBezierPath(ovalIn: NSRect(x: cxE - eyeR * 0.30 - g, y: cyE + eyeR * 0.30 - g,
                                    width: g * 2, height: g * 1.5)).fill()
    }

    // Bouche en « O » et langue rose
    let my = -s * 0.125, mw = s * 0.042, mh = s * 0.056
    ink.setFill()
    NSBezierPath(ovalIn: NSRect(x: -mw, y: my - mh, width: mw * 2, height: mh * 2)).fill()
    ctx.saveGraphicsState()
    NSBezierPath(ovalIn: NSRect(x: -mw * 0.78, y: my - mh * 0.80,
                                width: mw * 1.56, height: mh * 1.60)).addClip()
    NSColor(calibratedRed: 1.00, green: 0.557, blue: 0.620, alpha: 1).setFill()
    NSBezierPath(ovalIn: NSRect(x: -mw * 0.72, y: my - mh * 0.90,
                                width: mw * 1.44, height: mh * 1.04)).fill()
    ctx.restoreGraphicsState()

    ctx.restoreGraphicsState()

    // Verre sur la moitié haute
    let gloss = NSBezierPath()
    gloss.move(to: NSPoint(x: body.minX, y: body.midY + body.height * 0.18))
    gloss.curve(to: NSPoint(x: body.maxX, y: body.midY + body.height * 0.32),
                controlPoint1: NSPoint(x: body.midX - body.width * 0.1, y: body.midY + body.height * 0.42),
                controlPoint2: NSPoint(x: body.midX + body.width * 0.1, y: body.midY + body.height * 0.12))
    gloss.line(to: NSPoint(x: body.maxX, y: body.maxY))
    gloss.line(to: NSPoint(x: body.minX, y: body.maxY))
    gloss.close()
    NSColor.white.withAlphaComponent(0.06).setFill()
    gloss.fill()
    ctx.restoreGraphicsState()

    accent.withAlphaComponent(0.28).setStroke()
    shape.lineWidth = 3 * u
    shape.stroke()

    img.unlockFocus()
    return img
}

func writePNG(_ img: NSImage, _ px: Int, _ url: URL) {
    guard let rep = NSBitmapImageRep(bitmapDataPlanes: nil, pixelsWide: px, pixelsHigh: px,
                                     bitsPerSample: 8, samplesPerPixel: 4, hasAlpha: true,
                                     isPlanar: false, colorSpaceName: .deviceRGB,
                                     bytesPerRow: 0, bitsPerPixel: 0) else { return }
    rep.size = NSSize(width: px, height: px)
    NSGraphicsContext.saveGraphicsState()
    NSGraphicsContext.current = NSGraphicsContext(bitmapImageRep: rep)
    renderIcon(size: CGFloat(px)).draw(in: NSRect(x: 0, y: 0, width: px, height: px))
    NSGraphicsContext.restoreGraphicsState()
    if let d = rep.representation(using: .png, properties: [:]) { try? d.write(to: url) }
}

let args = CommandLine.arguments
guard args.count > 1 else { exit(1) }
let out = URL(fileURLWithPath: args[1])
try? FileManager.default.createDirectory(at: out, withIntermediateDirectories: true)

let sizes: [(Int, String)] = [
    (16, "icon_16x16.png"), (32, "icon_16x16@2x.png"),
    (32, "icon_32x32.png"), (64, "icon_32x32@2x.png"),
    (128, "icon_128x128.png"), (256, "icon_128x128@2x.png"),
    (256, "icon_256x256.png"), (512, "icon_256x256@2x.png"),
    (512, "icon_512x512.png"), (1024, "icon_512x512@2x.png")
]
for (px, name) in sizes {
    writePNG(NSImage(), px, out.appendingPathComponent(name))
}
print("iconset écrit : \(out.path)")
EOF_MAKEICON_X9

cat << 'EOF_BUDBUILD_7K2' > "$SUPPORT_DIR/build.sh"
#!/bin/bash
#
#  BUD Premium — compilation et installation
#
#  Usage :
#    ./build.sh            compile et installe dans ~/Applications, puis lance
#    ./build.sh check      compile seulement, sans rien installer (utilisé par la CI)
#    ./build.sh install    comme sans argument
#
#  Options :
#    --src DIR     dossier des sources Swift      (défaut : ./Sources)
#    --tools DIR   dossier des outils annexes     (défaut : ./Tools)
#    --app DIR     paquet .app à produire         (défaut : ~/Applications/BUD.app)
#    --no-open     ne pas lancer l'application à la fin
#    --universal   binaire pour arm64 ET x86_64, fusionné par lipo
#                  (ce que produit la CI : la machine GitHub est en
#                   arm64, mais l'application doit tourner sur Intel)
#
#  Ce fichier est le seul endroit où vit la logique de compilation.
#  L'installeur en un seul fichier (dist/) embarque les sources puis
#  appelle ce script : il n'y a donc rien à tenir en double.
#
set -euo pipefail

MODE="install"
UNIVERSAL=0
SRC_DIR=""
TOOLS_DIR=""
ART_DIR=""
APP_DIR="$HOME/Applications/BUD.app"
DO_OPEN=1

while [ $# -gt 0 ]; do
  case "$1" in
    check|install) MODE="$1"; shift ;;
    --src)   SRC_DIR="$2"; shift 2 ;;
    --tools) TOOLS_DIR="$2"; shift 2 ;;
    --art)   ART_DIR="$2"; shift 2 ;;
    --app)   APP_DIR="$2"; shift 2 ;;
    --no-open) DO_OPEN=0; shift ;;
    --universal) UNIVERSAL=1; shift ;;
    -h|--help) sed -n '2,20p' "$0" | sed 's/^#//'; exit 0 ;;
    *) echo "Option inconnue : $1" >&2; exit 2 ;;
  esac
done

HERE="$(cd "$(dirname "$0")" && pwd)"
[ -n "$SRC_DIR" ]   || SRC_DIR="$HERE/Sources"
[ -n "$TOOLS_DIR" ] || TOOLS_DIR="$HERE/Tools"
[ -n "$ART_DIR" ]   || ART_DIR="$HERE/Art"

if [ ! -d "$SRC_DIR" ]; then
  echo "Sources introuvables : $SRC_DIR" >&2
  exit 1
fi

ARCH="$(uname -m)"
OSVER="$(sw_vers -productVersion 2>/dev/null || echo inconnue)"
VERSION="$(sed -n 's/^let budVersion = "\(.*\)"/\1/p' "$SRC_DIR/BudCore.swift" | head -1)"
[ -n "$VERSION" ] || VERSION="0.0"

# ─────────────────────────────────────────────────────────────────
#  Chaîne d'outils
#
#  swiftc est TOUJOURS appelé par xcrun, jamais par son chemin
#  résolu : c'est xcrun qui positionne SDKROOT. Sans lui, le
#  compilateur ne trouve pas la bibliothèque standard et échoue sur
#  « unable to load standard library ».
# ─────────────────────────────────────────────────────────────────

unset TOOLCHAINS || true          # une chaîne tierce sélectionnée fausserait tout

SWIFT_VIA="xcrun"
run_swiftc() {
  if [ "$SWIFT_VIA" = "plain" ]; then
    command swiftc "$@"
  else
    xcrun --sdk macosx swiftc "$@"
  fi
}

sdk_version() { xcrun --show-sdk-version 2>/dev/null || echo 0; }

if ! command -v swiftc >/dev/null 2>&1 && ! xcrun --find swiftc >/dev/null 2>&1; then
  echo "swiftc est introuvable. Installez les outils : xcode-select --install" >&2
  exit 1
fi

SDKVER="$(sdk_version)"
SDKMAJ="${SDKVER%%.*}"
[ -n "$SDKMAJ" ] || SDKMAJ=0

# Outils antérieurs à Big Sur mais Xcode complet présent : on bascule
# dessus pour cette exécution, sans sudo ni modification du système.
if [ "$SDKMAJ" -ge 1 ] 2>/dev/null && [ "$SDKMAJ" -lt 11 ] 2>/dev/null; then
  for X in /Applications/Xcode.app /Applications/Xcode-beta.app; do
    if [ -d "$X/Contents/Developer" ]; then
      export DEVELOPER_DIR="$X/Contents/Developer"
      NEW="$(sdk_version)"; NEWMAJ="${NEW%%.*}"
      if [ "${NEWMAJ:-0}" -ge 11 ] 2>/dev/null; then
        SDKVER="$NEW"; SDKMAJ="$NEWMAJ"
        echo "Outils de ligne de commande trop anciens : bascule sur $X."
        break
      fi
      unset DEVELOPER_DIR
    fi
  done
fi

SDKPATH="$(xcrun --sdk macosx --show-sdk-path 2>/dev/null || true)"
[ -n "$SDKPATH" ] && export SDKROOT="$SDKPATH"

echo "BUD Premium $VERSION — macOS ${OSVER} · ${ARCH}"
echo "Outils     : $(xcode-select -p 2>/dev/null || echo inconnu)"
if [ "$SDKMAJ" -ge 1 ] 2>/dev/null; then
  echo "SDK macOS  : $SDKVER"
else
  echo "SDK macOS  : illisible (xcrun muet)"
fi

# Un SDK à 0 veut dire « illisible », pas « ancien » : seul un numéro
# réellement antérieur à 11 justifie ce verdict.
if [ "$SDKMAJ" -ge 1 ] 2>/dev/null && [ "$SDKMAJ" -lt 11 ] 2>/dev/null; then
  cat <<'DIAG' >&2

────────────────────────────────────────────────────────────────
  Vos outils de développement sont antérieurs à macOS 11, alors
  que BUD a besoin d'API apparues avec Big Sur.

    sudo rm -rf /Library/Developer/CommandLineTools
    sudo xcode-select --install

  Si Xcode complet est installé :

    sudo xcode-select --switch /Applications/Xcode.app/Contents/Developer
────────────────────────────────────────────────────────────────

DIAG
  exit 1
fi

# ─────────────────────────────────────────────────────────────────
#  Cible de déploiement
#
#  Les chaînes récentes écrivent « macos12.0 », les anciennes
#  « macosx12.0 ». On sonde pour de vrai plutôt que de supposer.
# ─────────────────────────────────────────────────────────────────

BUILD_TMP="$(mktemp -d)"
cleanup() { rm -rf "$BUILD_TMP"; }
trap cleanup EXIT
PROBE="$BUILD_TMP/budprobe.swift"
echo 'public let budProbe = 1' > "$PROBE"

probe_compile() {
  if [ -n "${1:-}" ]; then
    run_swiftc -target "$1" -typecheck "$PROBE" >/dev/null 2>&1
  else
    run_swiftc -typecheck "$PROBE" >/dev/null 2>&1
  fi
}

if ! probe_compile ""; then
  # xcrun peut être en cause alors que le swiftc du PATH fonctionne.
  SWIFT_VIA="plain"
  if probe_compile ""; then
    echo "xcrun indisponible : utilisation directe de swiftc."
  else
    SWIFT_VIA="xcrun"
  fi
fi

if ! probe_compile ""; then
  RESCUED=""
  for X in /Applications/Xcode.app /Applications/Xcode-beta.app; do
    if [ -d "$X/Contents/Developer" ]; then
      export DEVELOPER_DIR="$X/Contents/Developer"
      SDKPATH="$(xcrun --sdk macosx --show-sdk-path 2>/dev/null || true)"
      [ -n "$SDKPATH" ] && export SDKROOT="$SDKPATH"
      if probe_compile ""; then
        RESCUED="$X"
        echo "Chaîne d'outils inutilisable : bascule sur $X."
        break
      fi
    fi
  done
  if [ -z "$RESCUED" ]; then
    cat <<'DIAG' >&2

────────────────────────────────────────────────────────────────
  Le compilateur Swift est présent mais ne trouve pas sa
  bibliothèque standard. L'installation des outils est incomplète.

    sudo rm -rf /Library/Developer/CommandLineTools
    sudo xcode-select --install

  Vérification :

    echo 'print(1)' > /tmp/t.swift && xcrun swiftc -typecheck /tmp/t.swift
────────────────────────────────────────────────────────────────

DIAG
    exit 1
  fi
fi

# Quelle orthographe de cible pour une architecture donnée ?
target_for() {
  local a="$1"
  local t
  for t in "${a}-apple-macos12.0" "${a}-apple-macosx12.0"; do
    if probe_compile "$t"; then echo "$t"; return 0; fi
  done
  echo ""
}

TARGET="$(target_for "$ARCH")"
if [ -n "$TARGET" ]; then
  echo "Cible      : $TARGET"
else
  export MACOSX_DEPLOYMENT_TARGET=12.0
  echo "Cible      : par défaut du SDK, MACOSX_DEPLOYMENT_TARGET=12.0"
fi

FRAMEWORKS=(-framework Cocoa -framework IOKit -framework Carbon
            -framework Security -framework Network -framework CoreImage
            -framework Speech -framework AVFoundation
            -framework CoreAudio -framework AudioToolbox)

# ─────────────────────────────────────────────────────────────────
#  Compilation
# ─────────────────────────────────────────────────────────────────

if [ "$MODE" = "check" ]; then
  OUT="$BUILD_TMP/BUD"
  echo "Compilation de contrôle…"
  # shellcheck disable=SC2086
  run_swiftc -O -suppress-warnings -swift-version 5 ${TARGET:+-target "$TARGET"} \
    "$SRC_DIR"/*.swift "${FRAMEWORKS[@]}" -o "$OUT"
  echo "Compilation du générateur d'icône…"
  run_swiftc -O -suppress-warnings -swift-version 5 ${TARGET:+-target "$TARGET"} \
    "$TOOLS_DIR/MakeIcon.swift" -framework Cocoa -o "$BUILD_TMP/budicon"
  echo "BUD Premium $VERSION compile."
  exit 0
fi

pkill -x BUD 2>/dev/null || true
rm -rf "$APP_DIR"
mkdir -p "$APP_DIR/Contents/MacOS" "$APP_DIR/Contents/Resources"

BIN="$APP_DIR/Contents/MacOS/BUD"

if [ "$UNIVERSAL" -eq 1 ]; then
  # Le SDK macOS porte les deux tranches : on compile chaque
  # architecture depuis la même machine, puis lipo les réunit.
  echo "Compilation universelle (arm64 + x86_64)…"
  SLICES=()
  for A in arm64 x86_64; do
    T="$(target_for "$A")"
    if [ -z "$T" ]; then
      echo "Cible introuvable pour $A : ce SDK ne sait pas compiler cette architecture." >&2
      exit 1
    fi
    echo "  · $T"
    # shellcheck disable=SC2086
    run_swiftc -O -suppress-warnings -swift-version 5 -target "$T" \
      "$SRC_DIR"/*.swift "${FRAMEWORKS[@]}" -o "$BUILD_TMP/BUD-$A"
    SLICES+=("$BUILD_TMP/BUD-$A")
  done
  lipo -create "${SLICES[@]}" -output "$BIN"
  echo "Binaire universel : $(lipo -archs "$BIN")"
else
  echo "Compilation native…"
  # shellcheck disable=SC2086
  run_swiftc -O -suppress-warnings -swift-version 5 ${TARGET:+-target "$TARGET"} \
    "$SRC_DIR"/*.swift "${FRAMEWORKS[@]}" -o "$BIN"
fi

# ── Illustrations ──
#  Le logo et ses deux calques. Copiés tels quels : ce sont les images
#  d'origine, pas une reconstitution.
if [ -d "$ART_DIR" ]; then
  cp -f "$ART_DIR"/*.png "$ART_DIR"/*.wav "$APP_DIR/Contents/Resources/" 2>/dev/null \
    && echo "Illustrations et son copiés." || echo "Rien à copier depuis Art." 
else
  # Sans illustrations, l'habillage « Logo » retombe sur le dessin
  # vectoriel et le démarrage se passe du splash. Rien ne casse.
  echo "Dossier Art absent : habillage vectoriel seul."
fi

# ── Icône ──
if [ -f "$TOOLS_DIR/MakeIcon.swift" ]; then
  TMPI="$BUILD_TMP/icon"; mkdir -p "$TMPI"
  if run_swiftc -O -suppress-warnings -swift-version 5 ${TARGET:+-target "$TARGET"} \
       "$TOOLS_DIR/MakeIcon.swift" -framework Cocoa -o "$TMPI/budicon" 2>/dev/null; then
    "$TMPI/budicon" "$TMPI/BUD.iconset" >/dev/null 2>&1 || true
    if [ -d "$TMPI/BUD.iconset" ]; then
      iconutil -c icns "$TMPI/BUD.iconset" -o "$APP_DIR/Contents/Resources/BUD.icns" 2>/dev/null \
        && echo "Icône créée." || echo "iconutil indisponible, icône ignorée."
    fi
  else
    echo "Icône non générée."
  fi
fi

# ── Info.plist ──
#  ATTENTION : seules CFBundleShortVersionString et CFBundleVersion
#  suivent la version. LSMinimumSystemVersion doit RESTER 12.0, sinon
#  macOS refuse de lancer l'application (erreur -10825).
cat > "$APP_DIR/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key>
  <string>BUD</string>
  <key>CFBundleIconFile</key>
  <string>BUD</string>
  <key>CFBundleIconName</key>
  <string>BUD</string>
  <key>CFBundleIdentifier</key>
  <string>local.lahbib.bud.assistant.monterey</string>
  <key>CFBundleName</key>
  <string>BUD Premium</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>${VERSION}</string>
  <key>CFBundleVersion</key>
  <string>${VERSION}</string>
  <key>LSMinimumSystemVersion</key>
  <string>12.0</string>
  <key>LSUIElement</key>
  <true/>
  <key>NSAppleEventsUsageDescription</key>
  <string>BUD utilise les événements système pour piloter Mail, la musique et l'apparence.</string>
  <key>NSDesktopFolderUsageDescription</key>
  <string>BUD range les fichiers que vous déposez sur le notch.</string>
  <key>NSDocumentsFolderUsageDescription</key>
  <string>BUD range les fichiers que vous déposez sur le notch.</string>
  <key>NSDownloadsFolderUsageDescription</key>
  <string>BUD analyse les fichiers téléchargés et range ceux que vous déposez.</string>
  <key>NSRemovableVolumesUsageDescription</key>
  <string>BUD affiche et éjecte vos disques externes.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>BUD écoute le microphone uniquement pendant que vous tenez la dictée ouverte, et la reconnaissance se fait sur votre Mac.</string>
  <key>NSSpeechRecognitionUsageDescription</key>
  <string>BUD transforme votre parole en texte sur l'appareil. Si ce Mac ne sait pas le faire hors ligne, BUD refuse la dictée plutôt que d'envoyer votre voix sur le réseau.</string>
</dict>
</plist>
PLIST

xattr -cr "$APP_DIR" 2>/dev/null || true

# ── Signature ad hoc ──
#  Obligatoire pour exécuter du arm64 : remplacer le binaire d'un
#  paquet signé invalide la signature et macOS tue l'application.
if codesign --force --sign - "$APP_DIR" 2>/dev/null; then
  echo "Signature ad hoc apposée."
else
  echo "Signature ad hoc impossible (sans effet sur Intel)."
fi

LSREG="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
[ -x "$LSREG" ] && "$LSREG" -f "$APP_DIR" >/dev/null 2>&1 || true

echo ""
echo "BUD Premium $VERSION installé dans $APP_DIR"
[ "$DO_OPEN" -eq 1 ] && open "$APP_DIR"
exit 0
EOF_BUDBUILD_7K2

