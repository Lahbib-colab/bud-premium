struct FileCategory {
    let name: String
    let icon: String
    let exts: Set<String>
}

let fileCategories: [FileCategory] = [
    FileCategory(name: "Images", icon: "photo.fill",
                 exts: ["png","jpg","jpeg","gif","heic","heif","webp","tiff","tif","bmp","svg","raw","cr2","nef"]),
    FileCategory(name: "Vidéos", icon: "film.fill",
                 exts: ["mp4","mov","avi","mkv","m4v","webm","mpg","mpeg","wmv"]),
    FileCategory(name: "Audio", icon: "music.note",
                 exts: ["mp3","wav","aiff","aif","m4a","flac","aac","ogg","caf"]),
    FileCategory(name: "Documents", icon: "doc.text.fill",
                 exts: ["pdf","doc","docx","pages","txt","rtf","md","odt","epub","tex"]),
    FileCategory(name: "Tableurs", icon: "tablecells.fill",
                 exts: ["xls","xlsx","xlsm","numbers","csv","tsv","ods"]),
    FileCategory(name: "Présentations", icon: "rectangle.on.rectangle",
                 exts: ["ppt","pptx","key","odp"]),
    FileCategory(name: "Archives", icon: "archivebox.fill",
                 exts: ["zip","rar","7z","tar","gz","bz2","xz","tgz"]),
    FileCategory(name: "Installeurs", icon: "shippingbox.fill",
                 exts: ["dmg","pkg","mpkg","app","command","iso"]),
    FileCategory(name: "Code", icon: "chevron.left.forwardslash.chevron.right",
                 exts: ["swift","py","js","mjs","ts","tsx","jsx","html","htm","css","json","xml","yml","yaml",
                        "sh","bash","zsh","c","cpp","cc","h","hpp","java","rb","go","php","rs","kt","plist","sql"]),
    FileCategory(name: "Polices", icon: "textformat",
                 exts: ["ttf","otf","woff","woff2","ttc"])
]

func categoryFor(_ url: URL) -> FileCategory {
    let ext = url.pathExtension.lowercased()
    for c in fileCategories where c.exts.contains(ext) { return c }
    return FileCategory(name: "Divers", icon: "questionmark.folder.fill", exts: [])
}

struct SortMove { let from: URL; let to: URL }
EOF_BUDCORE_SWIFT

cat << 'EOF_BUDDESIGN_SWIFT' > "$SRC_DIR/BudDesign.swift"
import Cocoa

// ═══════════════════════════════════════════════════════════
//  La charte, en code
//
//  Un système de design n'est pas une liste de règles écrites
//  quelque part : c'est le fait qu'il n'existe qu'un seul
//  endroit d'où sortent les valeurs. Tant qu'un rayon de 12
//  peut être tapé à la main dans un panneau, il finira par
//  valoir 13 dans un autre, et aucune relecture ne rattrapera
//  cela durablement.
//
//  Ce fichier est donc cet endroit unique. Les primitives
//  partagées — GlassButton, les cartes, la barre segmentée,
//  l'entête, les tuiles, les interrupteurs — y puisent, et
//  comme elles servent dans les seize panneaux, Compagnon,
//  Chat, Agents et Courrier compris, la cohérence n'est pas
//  à maintenir : elle est structurelle.
//
//  BUD est une application AppKit : il n'y a pas de CSS ici,
//  et une feuille de style n'aurait rien à styler. Les jetons
//  en tiennent lieu, avec le même rôle — nommer les valeurs
//  une fois, les employer partout.
// ═══════════════════════════════════════════════════════════

// ───────────────────────────────────────────────────────────
//  Espacement
//
//  Une échelle géométrique de base 4. Les valeurs intermédiaires
//  n'existent pas : un espace de 10 points dans une interface
//  réglée sur 8 et 12 ne se remarque pas isolément, mais trois
//  d'entre eux suffisent à donner cette impression de à-peu-près
//  qu'on n'arrive plus à nommer.
// ───────────────────────────────────────────────────────────

enum Space {
    static let xxs: CGFloat = 2
    static let xs:  CGFloat = 4
    static let s:   CGFloat = 8
    static let m:   CGFloat = 12
    static let l:   CGFloat = 16
    static let xl:  CGFloat = 24
    static let xxl: CGFloat = 32

    /// L'écart entre un intertitre et le groupe qu'il annonce,
    /// et celui entre deux groupes. Le second est plus grand que
    /// le premier : c'est cette différence qui dit au regard
    /// lesquels vont ensemble.
    static let withinGroup: CGFloat = s
    static let betweenGroups: CGFloat = m
}

// ───────────────────────────────────────────────────────────
//  Rayons
// ───────────────────────────────────────────────────────────

enum Radius {
    static let xs: CGFloat = 6     // étiquettes, puces
    static let s:  CGFloat = 10    // champs, petites cartes
    static let m:  CGFloat = 13    // cartes de contenu
    static let l:  CGFloat = 16    // panneaux
    static let xl: CGFloat = 20    // entêtes

    /// Entièrement arrondi. Les boutons de BUD sont des capsules :
    /// c'est le seul rayon qui ne change pas d'aspect avec la
    /// hauteur, donc le seul qui reste identique d'un bouton de
    /// 28 points à un bouton de 56.
    static func pill(_ height: CGFloat) -> CGFloat { height / 2 }
}

// ───────────────────────────────────────────────────────────
//  Typographie
//
//  Six rôles, et des graisses franchement contrastées : gras
//  pour les grandes tailles, demi-gras pour les moyennes,
//  normal pour les petites. Le contraste de graisse fait la
//  hiérarchie bien mieux que le contraste de taille, et il
//  survit aux écrans à faible densité, où deux points d'écart
//  ne se distinguent plus.
//
//  Les chiffres qui changent — heures, pourcentages, volumes —
//  passent en chasse fixe : sinon la valeur tremble à chaque
//  mise à jour, un « 1 » étant plus étroit qu'un « 8 ».
// ───────────────────────────────────────────────────────────

enum Typo {
    typealias Role = (size: CGFloat, weight: NSFont.Weight)

    static let display: Role = (22,   .bold)       // titre d'entête
    static let title:   Role = (17,   .bold)       // titre de carte
    static let heading: Role = (13.5, .semibold)   // sous-titre, expéditeur
    static let body:    Role = (12.5, .medium)     // texte courant
    static let caption: Role = (11,   .regular)    // légende, aide
    static let micro:   Role = (9.5,  .bold)       // intertitre, en capitales

    /// Opacités du texte, du plus affirmé au plus discret.
    enum Ink {
        static let strong:  CGFloat = 1.00
        static let normal:  CGFloat = 0.78
        static let muted:   CGFloat = 0.55
        static let faint:   CGFloat = 0.38
        static let ghost:   CGFloat = 0.26
    }
}

// ───────────────────────────────────────────────────────────
//  Mouvement
//
//  Trois durées, pas davantage. Une interface où chaque
//  transition a sa propre durée paraît hésitante, alors même
//  que chaque animation prise séparément semble correcte.
//
//  Les courbes ne sont pas symétriques : ce qui apparaît
//  démarre vite et ralentit, ce qui disparaît fait l'inverse.
//  Une sortie lente donne l'impression que l'application
//  réfléchit avant d'obéir.
// ───────────────────────────────────────────────────────────

enum Motion {
    static let quick: TimeInterval = 0.12   // survol, pression
    static let base:  TimeInterval = 0.22   // bascule, apparition
    static let slow:  TimeInterval = 0.38   // ouverture de panneau

    /// 60 images par seconde, le pas des animations dessinées à la main.
    static let frame: TimeInterval = 1.0 / 60

    static var enter: CAMediaTimingFunction {
        CAMediaTimingFunction(controlPoints: 0.22, 0.90, 0.28, 1.0)
    }
    static var exit: CAMediaTimingFunction {
        CAMediaTimingFunction(controlPoints: 0.40, 0.0, 0.70, 0.30)
    }

    /// Approche exponentielle d'une cible, indépendante de la cadence.
    /// `rate` est la fraction de l'écart rattrapée en une seconde.
    static func ease(_ value: CGFloat, to target: CGFloat,
                     rate: CGFloat, dt: CGFloat) -> CGFloat {
        value + (target - value) * (1 - exp(-rate * dt))
    }
}

// ───────────────────────────────────────────────────────────
//  Matières
//
//  Le verre dépoli de BUD tient en quatre couches, toujours
//  dans cet ordre : le fond translucide, le reflet spéculaire
//  en haut, le liseré qui s'éteint vers le bas, et l'ombre
//  portée. Les intervertir donne du plastique.
//
//  La valeur la plus importante est la plus discrète : les
//  fonds portent une pointe de bleu. Un gris parfaitement
//  neutre sur fond sombre paraît sale ; deux pour cent de
//  bleu suffisent à le rendre calme, sans qu'on puisse dire
//  pourquoi.
// ───────────────────────────────────────────────────────────

enum Surface {
    /// Niveaux d'élévation. 0 est le panneau lui-même, 3 un
    /// élément survolé qui se détache.
    static func fill(_ level: Int) -> NSColor {
        let a: CGFloat
        switch level {
        case 0:  a = 0.040
        case 1:  a = 0.065
        case 2:  a = 0.095
        default: a = 0.130
        }
        return tinted(a)
    }

    /// Le liseré d'une surface au repos.
    static func stroke(_ level: Int) -> NSColor {
        tinted(level >= 2 ? 0.14 : 0.085)
    }

    /// Le gris bleuté commun à toutes les surfaces.
    private static func tinted(_ a: CGFloat) -> NSColor {
        TH.dark
            ? NSColor(calibratedRed: 0.76, green: 0.82, blue: 0.95, alpha: a)
            : NSColor(calibratedRed: 0.10, green: 0.13, blue: 0.20, alpha: a * 0.88)
    }

    /// Force du reflet selon l'élévation.
    static func specularStrength(_ level: Int, hover: CGFloat = 0) -> CGFloat {
        (level >= 2 ? 0.22 : 0.14) + 0.10 * hover
    }
    static func rimStrength(_ level: Int) -> CGFloat {
        level >= 2 ? 0.34 : 0.22
    }
}

// ───────────────────────────────────────────────────────────
//  Le dessin d'une surface de verre
//
//  Une seule fonction pour toutes les cartes et tous les
//  boutons. C'est elle qui garantit qu'un bouton du Courrier
//  et une carte du Chat réagissent à la lumière de la même
//  façon — non par discipline, mais parce qu'il n'y a qu'un
//  seul code qui les dessine.
// ───────────────────────────────────────────────────────────

func drawGlass(in rect: NSRect, radius: CGFloat, level: Int,
               hover: CGFloat = 0, tint: NSColor? = nil) {
    let r = rect.insetBy(dx: 0.5, dy: 0.5)
    guard r.width > 1, r.height > 1 else { return }
    let path = NSBezierPath(roundedRect: r, xRadius: radius, yRadius: radius)

    // 1. Le fond, légèrement dégradé : deux pour cent d'écart entre le
    //    haut et le bas suffisent à ce qu'une surface ait du corps.
    let base = Surface.fill(level)
    let lift = base.withAlphaComponent(min(1, base.alphaComponent + 0.025 + 0.03 * hover))
    if let g = NSGradient(starting: lift, ending: base) {
        g.draw(in: path, angle: -90)
    } else {
        base.setFill(); path.fill()
    }

    // 2. La teinte, s'il y en a une, posée par-dessus sans masquer le fond.
    if let t = tint {
        t.withAlphaComponent(0.16 + 0.08 * hover).setFill()
        path.fill()
    }

    // 3. Reflet puis liseré, dans cet ordre.
    specular(path, r, strength: Surface.specularStrength(level, hover: hover))
    rim(path, r, color: tint ?? NSColor.white, strength: Surface.rimStrength(level))

    // 4. Le contour de base, qui ferme la forme là où le liseré s'est éteint.
    Surface.stroke(level).setStroke()
    path.lineWidth = 1
    path.stroke()
}

// ───────────────────────────────────────────────────────────
//  La carte
//
//  `mkCard` rendait une NSView dont on colorait le calque.
//  Elle rend maintenant une carte qui se dessine, donc qui
//  relit le thème à chaque affichage : le changement de thème
//  ne peut plus la laisser avec une couleur périmée, et toutes
//  les cartes de l'application héritent du verre d'un coup.
// ───────────────────────────────────────────────────────────

final class GlassCard: NSView {
    var radius: CGFloat = Radius.m { didSet { needsDisplay = true } }
    var level: Int = 1 { didSet { needsDisplay = true } }
    var tint: NSColor? { didSet { needsDisplay = true } }

    init(frame: NSRect, radius: CGFloat, level: Int) {
        self.radius = radius
        self.level = level
        super.init(frame: frame)
        wantsLayer = true
    }
    required init?(coder: NSCoder) { fatalError() }

    override func draw(_ dirty: NSRect) {
        drawGlass(in: bounds, radius: radius, level: level, tint: tint)
    }
}
EOF_BUDDESIGN_SWIFT

cat << 'EOF_BUDFACE_SWIFT' > "$SRC_DIR/BudFace.swift"
import Cocoa

// ═══════════════════════════════════════════════════════════
//  BUD — le personnage, dessiné en vectoriel et animé
//
//  Portage fidèle du compagnon « standard » : un squircle blanc,
//  deux joues rose pastel, deux yeux ronds et une bouche en « O »
//  avec la langue rose. Tout est tracé en Bézier, donc net du
//  16 px au 1024 px.
//
//  Attention à l'axe Y : le prototype était en Canvas HTML, où Y
//  descend. AppKit a Y qui monte. Tous les décalages verticaux sont
//  donc inversés, et les arcs sont redonnés en degrés dans le sens
//  antihoraire d'AppKit — un arc « bas » du Canvas (0,15π → 0,85π)
//  devient ici 200° → 340°.
// ═══════════════════════════════════════════════════════════

/// Les humeurs de BUD.
///
/// Chacune est attachée à un fait, jamais décorative : il écoute quand
/// la veille l'a entendu, parle quand il répond, est fier quand une
/// tâche a abouti, déçu quand elle a échoué, perplexe quand il n'a pas
/// compris. Une humeur qui ne correspond à rien finit par être ignorée,
/// et c'est alors toute l'expressivité qui ne veut plus rien dire.
enum BudMood {
    case calm, happy, alert, sleepy, wink, dizzy, angry, thinking
    case listening, speaking, proud, sad, confused
    /// Un agent travaille : les deux billes du tréma jonglent.
    case working
}

/// Trois habillages : à plat, nacré-or, et métal.
enum BudStyle { case flat, premium, metal, logo }

/// Palette du personnage, indépendante du thème de l'interface.
enum BudSkin {
    // Style à plat
    static let shell      = NSColor(calibratedRed: 1.00, green: 1.00, blue: 1.00, alpha: 1)
    static let shellEdge  = NSColor(calibratedRed: 0.847, green: 0.886, blue: 0.910, alpha: 0.85)
    static let ink        = NSColor(calibratedRed: 0.137, green: 0.152, blue: 0.200, alpha: 1)
    static let blush      = NSColor(calibratedRed: 1.00, green: 0.710, blue: 0.710, alpha: 1)
    static let tongue     = NSColor(calibratedRed: 1.00, green: 0.557, blue: 0.620, alpha: 1)
    static let sweat      = NSColor(calibratedRed: 0.647, green: 0.847, blue: 1.00, alpha: 1)
    static let anger      = NSColor(calibratedRed: 0.910, green: 0.478, blue: 0.302, alpha: 1)

    // Style nacré-or
    static let goldHi     = NSColor(calibratedRed: 0.965, green: 0.906, blue: 0.824, alpha: 1)
    static let goldMid    = NSColor(calibratedRed: 0.875, green: 0.757, blue: 0.616, alpha: 1)
    static let goldLo     = NSColor(calibratedRed: 0.784, green: 0.635, blue: 0.478, alpha: 1)
    static let pearlHi    = NSColor(calibratedRed: 1.00, green: 1.00, blue: 1.00, alpha: 1)
    static let pearlMid   = NSColor(calibratedRed: 0.961, green: 0.949, blue: 0.933, alpha: 1)
    static let pearlLo    = NSColor(calibratedRed: 0.890, green: 0.867, blue: 0.835, alpha: 1)
    static let inkWarm    = NSColor(calibratedRed: 0.141, green: 0.118, blue: 0.102, alpha: 1)
    static let blushWarm  = NSColor(calibratedRed: 0.894, green: 0.643, blue: 0.576, alpha: 1)
    static let tongueWarm = NSColor(calibratedRed: 0.851, green: 0.541, blue: 0.486, alpha: 1)
    static let smileGold  = NSColor(calibratedRed: 0.831, green: 0.643, blue: 0.349, alpha: 1)
    static let smileEdge  = NSColor(calibratedRed: 0.620, green: 0.443, blue: 0.196, alpha: 1)

    // Style métal : coque ardoise, cadre argenté, écran sombre
    static let shellSlate = NSColor(calibratedRed: 0.169, green: 0.188, blue: 0.251, alpha: 1)
    static let shellSlateHi = NSColor(calibratedRed: 0.235, green: 0.259, blue: 0.341, alpha: 1)
    static let shellSlateLo = NSColor(calibratedRed: 0.114, green: 0.129, blue: 0.180, alpha: 1)
    static let bezel      = NSColor(calibratedRed: 0.553, green: 0.600, blue: 0.682, alpha: 1)
    static let bezelHi    = NSColor(calibratedRed: 0.796, green: 0.835, blue: 0.882, alpha: 1)
    static let bezelLo    = NSColor(calibratedRed: 0.392, green: 0.455, blue: 0.545, alpha: 1)
    static let screen     = NSColor(calibratedRed: 0.051, green: 0.063, blue: 0.090, alpha: 1)
    static let screenHi   = NSColor(calibratedRed: 0.078, green: 0.098, blue: 0.137, alpha: 1)
    static let sensor     = NSColor(calibratedRed: 0.118, green: 0.161, blue: 0.231, alpha: 1)
    static let cyan       = NSColor(calibratedRed: 0.133, green: 0.890, blue: 0.961, alpha: 1)
    static let rose       = NSColor(calibratedRed: 0.984, green: 0.443, blue: 0.522, alpha: 1)
    static let indigo     = NSColor(calibratedRed: 0.506, green: 0.549, blue: 0.972, alpha: 1)
}

/// Les yeux du BUD métal suivent la couleur d'accent, mais un accent
/// sombre disparaîtrait sur l'écran noir : on retombe alors sur le cyan.
func metalEyeColor(_ accent: NSColor) -> NSColor {
    guard let c = accent.usingColorSpace(.deviceRGB) else { return BudSkin.cyan }
    let lum = 0.299 * c.redComponent + 0.587 * c.greenComponent + 0.114 * c.blueComponent
    return lum < 0.42 ? BudSkin.cyan : accent
}

/// Le corps : un squircle centré sur l'origine, coins très arrondis.
/// `radiusRatio` vaut 0,30 pour le compagnon standard.
func squirclePath(size: CGFloat, radiusRatio: CGFloat = 0.30) -> NSBezierPath {
    let h = size / 2
    let r = size * radiusRatio
    // Le prototype trace des quadratiques dont le point de contrôle est
    // le coin. En cubique, cela place les deux contrôles à r/3 du coin.
    let k = r / 3
    let p = NSBezierPath()
    p.move(to: NSPoint(x: -h + r, y: -h))
    p.line(to: NSPoint(x: h - r, y: -h))
    p.curve(to: NSPoint(x: h, y: -h + r),
            controlPoint1: NSPoint(x: h - k, y: -h),
            controlPoint2: NSPoint(x: h, y: -h + k))
    p.line(to: NSPoint(x: h, y: h - r))
    p.curve(to: NSPoint(x: h - r, y: h),
            controlPoint1: NSPoint(x: h, y: h - k),
            controlPoint2: NSPoint(x: h - k, y: h))
    p.line(to: NSPoint(x: -h + r, y: h))
    p.curve(to: NSPoint(x: -h, y: h - r),
            controlPoint1: NSPoint(x: -h + k, y: h),
            controlPoint2: NSPoint(x: -h, y: h - k))
    p.line(to: NSPoint(x: -h, y: -h + r))
    p.curve(to: NSPoint(x: -h + r, y: -h),
            controlPoint1: NSPoint(x: -h, y: -h + k),
            controlPoint2: NSPoint(x: -h + k, y: -h))
    p.close()
    return p
}

/// État animé de BUD : ressorts, clignements, regard, humeur.
/// Une instance par vue ; les deux rendus (notch et panneau) partagent ce code.
final class BudSprite {

    /// Habillage commun à toutes les instances, piloté par les réglages.
    static var style: BudStyle = .flat

    /// Pendant la lecture, BUD danse. Honnêteté : macOS n'expose aucun
    /// niveau audio en sortie sans capturer le flux, ce que BUD ne fait
    /// pas. Le rythme est donc régulier et synthétique — un signe de vie,
    /// pas une mesure du morceau.
    var equalizer = false { didSet { if !equalizer { beat = 0 } } }
    private var beat: CGFloat = 0

    // Humeur
    var mood: BudMood = .calm
    private var happyUntil = Date.distantPast
    private var winkUntil = Date.distantPast
    private var dizzyUntil = Date.distantPast

    /// Humeurs passagères, posées par `flash(_:for:)` : elles l'emportent
    /// le temps qu'elles durent, puis l'humeur de fond revient.
    /// Le visage affiché, celui d'avant, et l'instant du changement.
    /// Sur l'instance : le notch et le panneau changent d'expression
    /// chacun à son rythme, sans se voler leur transition.
    private var shownFace: BudsFace = .happy
    private var previousFace: BudsFace = .happy
    private var faceSince: CGFloat = -10

    private var flashMood: BudMood = .calm
    private var flashUntil = Date.distantPast

    /// Montre une humeur pendant quelques secondes. Rien à remettre en
    /// place ensuite : l'échéance s'en charge.
    func flash(_ m: BudMood, for seconds: TimeInterval) {
        flashMood = m
        flashUntil = Date().addingTimeInterval(seconds)
    }

    private var effectiveMood: BudMood {
        let now = Date()
        // Une alerte prime sur tout, sauf sur une humeur passagère plus
        // précise : « en colère » dit déjà qu'il y a un problème, et le
        // dit mieux.
        if now < flashUntil { return flashMood }
        if mood == .alert { return .alert }
        if now < dizzyUntil { return .dizzy }
        if now < winkUntil { return .wink }
        if now < happyUntil { return .happy }
        return mood
    }

    // Horloge continue, en secondes
    private var clock: CGFloat = 0
    private let dt: CGFloat = 1.0 / 30.0

    // Ressorts d'écrasement et de saut (portés du prototype)
    private var scaleX: CGFloat = 1, velScaleX: CGFloat = 0
    private var scaleY: CGFloat = 1, velScaleY: CGFloat = 0
    private var jump: CGFloat = 0, velJump: CGFloat = 0
    /// Danse : balancement latéral, et le côté vers lequel part le
    /// prochain temps. Alterner donne un pas à deux temps ; sans cela,
    /// BUD tremblerait sur place au lieu de danser.
    private var sway: CGFloat = 0, velSway: CGFloat = 0
    private var danceSide: CGFloat = 1
    private var tilt: CGFloat = 0, tiltVel: CGFloat = 0
    private var waveUntil = Date.distantPast

    // Regard et paupières
    private var lookX: CGFloat = 0, lookY: CGFloat = 0
    private var blink: CGFloat = 0
    private var blinkTimer: CGFloat = 2.2
    private var closing = false

    // Oscillateurs
    private var spiral: CGFloat = 0
    private var glow: CGFloat = 0
    private var drops: [CGFloat] = [0.0, 0.45, 0.75]
    private let dropSpeed: [CGFloat] = [0.24, 0.20, 0.22]
    private let dropSize: [CGFloat] = [1.0, 0.78, 0.68]

    /// Rebond élastique : clic, réaction, bonne nouvelle.
    /// Le prototype enchaînait standard → clin d'œil → souriant ;
    /// on garde cet enchaînement.
    func poke(strength: CGFloat = 1, joyful: Bool = true) {
        velScaleX += 0.14 * strength
        velScaleY -= 0.16 * strength
        velJump += 250 * strength
        closing = true
        blinkTimer = 0
        if joyful {
            winkUntil = Date().addingTimeInterval(0.55)
            happyUntil = Date().addingTimeInterval(1.9)
        }
    }

    /// Petit salut : le compagnon se balance deux fois.
    func wave() {
        waveUntil = Date().addingTimeInterval(1.6)
        tiltVel += 0.22
        happyUntil = Date().addingTimeInterval(1.8)
    }

    /// Tête qui tourne : utile pendant un nettoyage ou une longue tâche.
    func spin(for seconds: TimeInterval = 2.4) {
        dizzyUntil = Date().addingTimeInterval(seconds)
        velScaleX += 0.07
    }

    /// Avance d'une image. Renvoie true si la vue doit se redessiner.
    @discardableResult
    func step(follow: Bool, in view: NSView, anchor: NSPoint) -> Bool {
        let m = effectiveMood
        clock += dt

        glow += m == .alert ? 0.16 : 0.055
        if glow > .pi * 2 { glow -= .pi * 2 }
        spiral += dt * 4.5
        if spiral > .pi * 2 { spiral -= .pi * 2 }

        // Gouttes de sueur : chute cyclique
        for i in drops.indices {
            drops[i] = (drops[i] + dt * dropSpeed[i] * 3.2).truncatingRemainder(dividingBy: 1)
        }

        // Regard : suivi souple du curseur, curiosité au repos
        var targetX: CGFloat = 0, targetY: CGFloat = 0
        if follow, m != .sleepy, let w = view.window {
            let eye = w.convertPoint(toScreen: view.convert(anchor, to: nil))
            let p = NSEvent.mouseLocation
            let dx = (p.x - eye.x) / 460
            let dy = (p.y - eye.y) / 340
            let dist = sqrt(dx * dx + dy * dy)
            if dist > 1 {
                targetX = dx / dist
                targetY = dy / dist
            } else {
                targetX = dx
                targetY = dy
            }
        } else if m != .sleepy {
            targetX = sin(clock * 0.7) * 0.18
            targetY = cos(clock * 0.5) * 0.12
        }
        let lerp = 1 - exp(-8 * dt)
        lookX += (targetX - lookX) * lerp
        lookY += (targetY - lookY) * lerp

        // Clignement : fermeture rapide, ouverture plus douce
        blinkTimer -= dt
        let interval: CGFloat = m == .alert ? 1.4 : (m == .happy ? 2.4 : 3.6)
        if m == .sleepy {
            blink += (1 - blink) * 0.2
        } else if closing {
            blink += (1 - blink) * 0.45
            if blink > 0.96 { closing = false }
        } else {
            blink += (0 - blink) * 0.22
            if blinkTimer <= 0 { closing = true; blinkTimer = interval + CGFloat.random(in: 0...2.4) }
        }

        // Battement de lecture : une impulsion régulière dans les ressorts
        // suffit à faire danser le personnage, sans animation séparée.
        if equalizer {
            beat += dt * 2.1
            if beat >= 1 {
                beat -= 1
                danceSide = -danceSide
                velJump += 38
                velScaleX += 0.030
                velScaleY -= 0.034
                // Le pas de côté et l'inclinaison partent du même temps et
                // du même côté : c'est leur accord qui fait la danse. Les
                // dissocier donnerait deux mouvements qui se contrarient.
                velSway += 54 * danceSide
                tiltVel += 0.034 * danceSide
            }
        }

        // Balancement du salut, ou frisson d'alerte
        if Date() < waveUntil {
            tiltVel += sin(clock * 9) * 0.012
        } else if m == .alert {
            tiltVel += sin(clock * 7) * 0.004
        }
        tiltVel = (tiltVel - 0.22 * tilt) * 0.84
        tilt += tiltVel
        if abs(tilt) < 0.0005 && abs(tiltVel) < 0.0005 { tilt = 0; tiltVel = 0 }

        // Ressorts écrasement / étirement et saut, amortis en exponentielle
        let stiffness: CGFloat = 180, damping: CGFloat = 12
        velScaleX = (velScaleX + (1 - scaleX) * stiffness * dt) * exp(-damping * dt)
        scaleX += velScaleX * dt
        velScaleY = (velScaleY + (1 - scaleY) * stiffness * dt) * exp(-damping * dt)
        scaleY += velScaleY * dt
        velJump = (velJump + (0 - jump) * 160 * dt) * exp(-11 * dt)
        jump += velJump * dt
        // Ressort plus mou que celui du saut : le balancement doit traîner
        // un peu derrière le temps, comme un corps qui suit la musique.
        velSway = (velSway + (0 - sway) * 95 * dt) * exp(-8 * dt)
        sway += velSway * dt
        if !equalizer && abs(sway) < 0.05 && abs(velSway) < 0.05 { sway = 0; velSway = 0 }

        return true   // la respiration anime en continu, très légèrement
    }

    // ═══════════ Rendu ═══════════

    /// `detail` active l'ombre portée, les reflets et les effets d'humeur
    /// (tailles moyennes et grandes).
    /// L'habillage « Logo » : votre Ü, animé par calques.
    ///
    /// La même horloge et le même battement que le dessin vectoriel, pour
    /// que les deux habillages respirent au même rythme et qu'un
    /// changement de réglage ne change que l'apparence.
    ///
    /// Les billes montent et penchent, le corps se tasse. Pendant la
    /// lecture, le rebond est franc et la tête penche en mesure — c'est
    /// là que la séparation en deux calques paie.
    /// La seule entrée de dessin du compagnon.
    ///
    /// Avant, chaque vue choisissait : le panneau savait traiter
    /// l'habillage Logo, le notch non — il appelait `draw` directement et
    /// montrait donc toujours le personnage vectoriel, quel que soit le
    /// réglage. Un aiguillage dupliqué est un aiguillage qu'on oublie
    /// quelque part ; il n'y en a plus qu'un.
    func render(in rect: NSRect, detail: Bool, glowColor: NSColor) {
        if BudSprite.style == .logo && BudArt.hasCompanion {
            drawLogo(in: rect)
        } else {
            draw(in: rect, detail: detail, glowColor: glowColor)
        }
    }

    func drawLogo(in rect: NSRect) {
        let t = clock
        // Respiration au repos : un sixième du rebond de la danse, assez
        // pour qu'on voie que BUD est vivant sans qu'il s'agite.
        let breath = (sin(t * 2.3) + 1) / 2
        var bounce = breath * 0.18
        var tilt = sin(t * 0.9) * 1.2
        var squash = breath * 0.018

        if equalizer {
            // `beat` est avancé par `step()`, comme pour l'égaliseur du
            // dessin vectoriel : la danse ne dépend pas de la cadence de
            // rafraîchissement de la vue.
            let b = (sin(beat * 6.2) + 1) / 2
            bounce = 0.25 + b * 0.75
            tilt = sin(beat * 3.1) * 7
            squash = 0.02 + b * 0.085
        }
        if effectiveMood == .alert {
            // L'alerte secoue, sans monter : une alerte qui saute de joie
            // dit le contraire de ce qu'elle doit dire.
            tilt = sin(t * 18) * 5
            bounce = 0.1
        }
        if effectiveMood == .sleepy {
            bounce = breath * 0.06
            tilt = -3 + sin(t * 0.6) * 1.0
            squash = 0.03 + breath * 0.01
        }

        // Chaque humeur a son corps, et pas seulement son visage. Une
        // expression posée sur une posture qui la contredit ne se lit
        // pas : on croit au dessin le moins ambigu des deux.
        switch effectiveMood {
        case .angry:
            // Tassé, bas sur ses appuis, et il tremble. La colère
            // n'allonge pas, elle ramasse.
            bounce = 0
            tilt = sin(t * 23) * 2.6
            squash = 0.075 + breath * 0.012
        case .dizzy:
            // La tête part d'un côté puis de l'autre, en retard sur
            // elle-même : deux sinus de périodes différentes ne
            // repassent pas par le même point, et c'est ce décalage qui
            // fait le tangage.
            bounce = 0.12 + (sin(t * 3.1) + 1) / 2 * 0.22
            tilt = sin(t * 2.2) * 9 + sin(t * 3.7) * 4
            squash = 0.02 + breath * 0.02
        case .thinking:
            // Penché d'un seul côté, immobile, très légèrement relevé.
            // L'inclinaison est lente et asymétrique : on ne réfléchit
            // pas en balançant la tête en cadence.
            bounce = 0.05 + breath * 0.05
            tilt = -6.5 + sin(t * 0.45) * 1.6
            squash = breath * 0.01
        case .listening:
            // Dressé et droit. Les billes montent au rythme du visage,
            // comme deux antennes qui captent : c'est le seul mouvement,
            // et il suffit parce qu'il est régulier.
            bounce = 0.30 + (sin(t * 5.2) + 1) / 2 * 0.30
            tilt = 0
            squash = 0
        case .speaking:
            // Un léger balancement, de l'amplitude d'une conversation.
            // Le corps accompagne la bouche sans la concurrencer.
            bounce = 0.10 + (sin(t * 7.4) + 1) / 2 * 0.14
            tilt = sin(t * 2.6) * 2.2
            squash = 0.01 + breath * 0.012
        case .proud:
            // Haut sur ses appuis, et un rebond lent. La fierté se tient
            // droite ; elle ne saute pas, elle se redresse.
            bounce = 0.55 + (sin(t * 2.4) + 1) / 2 * 0.45
            tilt = sin(t * 1.1) * 1.4
            squash = 0
        case .sad:
            // Tassé, penché, immobile. C'est la posture qui porte la
            // tristesse — le visage seul, sur un corps qui respire
            // normalement, se lirait comme une grimace passagère.
            bounce = 0
            tilt = -4.0 + sin(t * 0.5) * 0.8
            squash = 0.09 + breath * 0.008
        case .confused:
            // La tête penche d'un côté puis de l'autre, lentement, sans
            // jamais s'arrêter au milieu : c'est l'hésitation.
            bounce = 0.08 + breath * 0.06
            tilt = sin(t * 1.3) * 7.5
            squash = breath * 0.012
        case .working:
            // Le corps se tient tranquille, concentré : tout le travail
            // est dans les billes, plus bas.
            bounce = 0.05
            tilt = sin(t * 1.7) * 1.2
            squash = 0.015
        default:
            break
        }

        // ── Le visage ──
        let target = BudArt.face(for: effectiveMood, music: equalizer)
        if target != shownFace {
            previousFace = shownFace
            shownFace = target
            faceSince = t
        }
        let since = t - faceSince
        // Fondu de seize centièmes. À deux dixièmes, on apercevait les deux
        // expressions superposées — des arches et des points en même
        // temps. Plus court, l'œil voit le visage changer sans le voir
        // dédoublé, et le petit bond du corps achève de masquer le
        // passage.
        let mix = min(1, since / 0.16)

        // Un petit bond à chaque changement : le corps s'étire, puis se
        // tasse un instant avant de reprendre sa posture. C'est ce qui
        // fait passer une expression pour un geste plutôt que pour un
        // changement d'image.
        var pop: CGFloat = 0
        if since < 0.42 {
            let q = since / 0.42
            pop = -sin(q * .pi) * 0.07 * (1 - q) + sin(q * .pi * 2) * 0.03 * (1 - q)
        }

        // ── Les billes, chacune son rythme ──
        //  Même rebond de fond, plus un battement propre déphasé de trois
        //  dixièmes de période. Ensemble elles avaient l'air d'un seul
        //  objet ; décalées, d'antennes.
        let own = 0.12 * (1 - min(1, abs(squash) * 6))
        var liftL = max(0, bounce + own * sin(t * 2.9))
        var liftR = max(0, bounce + own * sin(t * 2.9 - 1.9))
        if effectiveMood == .working {
            // Elles jonglent : quand l'une est en haut, l'autre est en bas.
            // Un rebond en valeur absolue, pas un sinus, pour qu'elles
            // touchent le corps et repartent — c'est le toc d'un sablier.
            liftL = abs(sin(t * 6.4)) * 0.95
            liftR = abs(sin(t * 6.4 + .pi / 2)) * 0.95
        }

        let side = min(rect.width, rect.height)
        // Les rendus sont plus hauts que larges : on les inscrit sur la
        // hauteur, centrés, pour qu'ils ne se déforment jamais.
        let h = side * 0.96
        let w = h * BudArt.ratio
        let box = NSRect(x: rect.midX - w / 2, y: rect.midY - h / 2,
                         width: w, height: h)
        var pose = BudArt.Pose()
        pose.face = shownFace
        pose.previous = previousFace
        pose.mix = mix
        pose.liftL = liftL
        pose.liftR = liftR
        pose.tilt = tilt
        pose.squash = squash + pop
        BudArt.drawBuds(in: box, pose: pose)
    }

    func draw(in rect: NSRect, detail: Bool, glowColor: NSColor) {
        guard let ctx = NSGraphicsContext.current?.cgContext else { return }
        let m = effectiveMood
        let premium = BudSprite.style == .premium
        let s = min(rect.width, rect.height) * 0.80
        let t = clock

        // Respiration : flottement vertical et dilatation croisée
        let floatY = sin(t * 2.3) * (s * 0.032)
        let breathX = 1 + sin(t * 2.3 - 0.6) * 0.014
        let breathY = 1 - sin(t * 2.3 - 0.6) * 0.014

        // Tremblement de colère
        let shakeX: CGFloat = m == .alert ? sin(t * 42) * (s * 0.0075) : 0
        let shakeY: CGFloat = m == .alert ? cos(t * 37) * (s * 0.0048) : 0

        let cx = rect.midX
        let cy = rect.midY

        // ── Ombre au sol, qui se resserre quand le compagnon monte ──
        if detail {
            let lift = floatY + jump
            let hf = max(0.7, min(1.2, 1 - lift / (s * 0.25)))
            let sy = cy - s * 0.60
            let sw = s * 0.42 * hf
            let sh = s * 0.055 * hf
            ctx.saveGState()
            if let g = NSGradient(colors: [NSColor.black.withAlphaComponent(0.42),
                                           NSColor.black.withAlphaComponent(0)],
                                  atLocations: [0, 1], colorSpace: .deviceRGB) {
                NSBezierPath(ovalIn: NSRect(x: cx - sw, y: sy - sh,
                                            width: sw * 2, height: sh * 2)).addClip()
                g.draw(fromCenter: NSPoint(x: cx, y: sy), radius: 1,
                       toCenter: NSPoint(x: cx, y: sy), radius: sw,
                       options: [])
            }
            ctx.restoreGState()
        }

        ctx.saveGState()
        // Le balancement est en proportion de la taille : un sprite de
        // 34 pt dans le notch et un de 200 pt dans le panneau doivent
        // danser de la même façon, pas du même nombre de points.
        ctx.translateBy(x: cx + shakeX + sway * (s / 160), y: cy + floatY + jump + shakeY)
        ctx.rotate(by: tilt)
        ctx.scaleBy(x: scaleX * breathX, y: scaleY * breathY)

        // ── Halo d'ambiance : un dégradé radial, jamais un disque plein,
        //    sinon le bord net se voit sur fond sombre. ──
        // Rayon contenu dans le rectangle du sprite (s vaut 0,80 × rect) :
        // au-delà, la vue couperait le dégradé net.
        let haloR = s * (0.58 + 0.025 * sin(glow))
        let inner = s * 0.40
        let a: CGFloat = m == .alert ? 0.34 : (premium ? 0.22 : 0.16)
        if let halo = NSGradient(colors: [glowColor.withAlphaComponent(a),
                                          glowColor.withAlphaComponent(a * 0.55),
                                          glowColor.withAlphaComponent(0)],
                                 atLocations: [0, 0.45, 1], colorSpace: .deviceRGB) {
            NSGraphicsContext.current?.saveGraphicsState()
            NSBezierPath(ovalIn: NSRect(x: -haloR, y: -haloR,
                                        width: haloR * 2, height: haloR * 2)).addClip()
            halo.draw(fromCenter: .zero, radius: inner,
                      toCenter: .zero, radius: haloR, options: [])
            NSGraphicsContext.current?.restoreGraphicsState()
        }

        if BudSprite.style == .metal {
            let eye = metalEyeColor(m == .alert ? BudSkin.rose : glowColor)
            drawMetalBody(ctx, size: s, detail: detail, t: t)
            drawMetalFace(ctx, size: s, mood: m, detail: detail, t: t, eye: eye)
        } else {
            drawBody(ctx, size: s, premium: premium, detail: detail)
            drawFace(ctx, size: s, mood: m, premium: premium, detail: detail, t: t)
        }

        ctx.restoreGState()
    }

    // ═══════════ Habillage métal ═══════════
    //
    //  Une tête autonome : coque ardoise, cadre argenté, écran facial
    //  sombre et yeux carrés lumineux. Le prototype raisonne en « radius » ;
    //  on pose r = s/1,92 pour que la coque ait exactement la largeur du
    //  squircle blanc, et les trois habillages gardent la même empreinte.

    private func metalR(_ s: CGFloat) -> CGFloat { s / 1.92 }

    private func drawMetalBody(_ ctx: CGContext, size s: CGFloat, detail: Bool, t: CGFloat) {
        let r = metalR(s)
        let shellW = r * 1.92, shellH = r * 1.72
        // Canvas : le haut de la coque est à -0,46·h, elle est donc
        // décalée vers le bas. En AppKit, le centre descend de 0,04·h.
        let shellRect = NSRect(x: -shellW / 2, y: -shellH / 2 - shellH * 0.04,
                               width: shellW, height: shellH)
        let shellR = r * 0.52

        let shell = NSBezierPath(roundedRect: shellRect, xRadius: shellR, yRadius: shellR)
        if let g = NSGradient(colors: [BudSkin.shellSlateHi, BudSkin.shellSlate,
                                       BudSkin.shellSlateLo],
                              atLocations: [0, 0.5, 1], colorSpace: .deviceRGB) {
            g.draw(in: shell, angle: -55)
        } else {
            BudSkin.shellSlate.setFill()
            shell.fill()
        }

        // Cadre argenté
        let bezelRect = NSRect(x: shellRect.minX + r * 0.13,
                               y: shellRect.minY + r * 0.14,
                               width: shellRect.width - r * 0.26,
                               height: shellRect.height - r * 0.27)
        let bezelR = shellR * 0.84
        let bezel = NSBezierPath(roundedRect: bezelRect, xRadius: bezelR, yRadius: bezelR)
        if let g = NSGradient(colors: [BudSkin.bezelHi, BudSkin.bezel, BudSkin.bezelLo],
                              atLocations: [0, 0.5, 1], colorSpace: .deviceRGB) {
            g.draw(in: bezel, angle: -55)
        } else {
            BudSkin.bezel.setFill()
            bezel.fill()
        }

        // Écran facial
        let th = r * 0.055
        let screenRect = bezelRect.insetBy(dx: th, dy: th)
        let screenR = max(3, bezelR - th)
        let screen = NSBezierPath(roundedRect: screenRect, xRadius: screenR, yRadius: screenR)
        ctx.saveGState()
        screen.addClip()
        if let g = NSGradient(colors: [BudSkin.screenHi, BudSkin.screen],
                              atLocations: [0, 1], colorSpace: .deviceRGB) {
            g.draw(fromCenter: NSPoint(x: 0, y: r * 0.05), radius: r * 0.08,
                   toCenter: .zero, radius: r * 0.95, options: [])
        } else {
            BudSkin.screen.setFill()
            screen.fill()
        }

        // Balayage lumineux lent, uniquement en grand format
        if detail {
            let phase = (t * 0.2).truncatingRemainder(dividingBy: 1)
            let x = -shellW * 0.85 + (shellW * 1.70) * phase
            if let sheen = NSGradient(colors: [NSColor.white.withAlphaComponent(0),
                                               NSColor.white.withAlphaComponent(0.10),
                                               NSColor.white.withAlphaComponent(0)],
                                      atLocations: [0, 0.5, 1], colorSpace: .deviceRGB) {
                sheen.draw(in: NSRect(x: x - shellW * 0.12, y: -shellH,
                                      width: shellW * 0.24, height: shellH * 2), angle: 0)
            }
        }
        ctx.restoreGState()

        // Capteur discret en haut de l'écran
        let sd = r * 0.072
        BudSkin.sensor.setFill()
        NSBezierPath(ovalIn: NSRect(x: -sd / 2, y: screenRect.maxY - r * 0.085 - sd / 2,
                                    width: sd, height: sd)).fill()
    }

    private func drawMetalFace(_ ctx: CGContext, size s: CGFloat, mood m: BudMood,
                               detail: Bool, t: CGFloat, eye: NSColor) {
        let r = metalR(s)
        let gx = lookX * r * 0.13
        let gy = lookY * r * 0.10

        ctx.saveGState()
        ctx.translateBy(x: gx, y: gy)

        let eyeX = r * 0.31
        let eyeY = r * 0.01            // Canvas : -0,01 → AppKit +0,01
        let eyeS = r * 0.32
        let corner = r * 0.078
        let open = max(0.08, 1 - blink * 0.92)

        switch m {
        case .calm, .sleepy, .thinking, .speaking, .confused, .sad, .working:
            let h = m == .sleepy ? eyeS * 0.18 : eyeS * open
            metalEye(NSPoint(x: -eyeX, y: eyeY), w: eyeS, h: h, r: corner, c: eye, detail: detail)
            metalEye(NSPoint(x: eyeX * 1.04, y: eyeY + r * 0.01),
                     w: eyeS * 1.12, h: eyeS * 1.08 * (m == .sleepy ? 0.17 : open),
                     r: corner * 1.06, c: eye, detail: detail)

        case .happy, .proud:
            // Les yeux deviennent deux arcs relevés
            for (x, w) in [(-eyeX, eyeS), (eyeX * 1.04, eyeS * 1.12)] {
                let a = NSBezierPath()
                a.appendArc(withCenter: NSPoint(x: x, y: eyeY - eyeS * 0.32),
                            radius: w * 0.46, startAngle: 22, endAngle: 158)
                a.lineWidth = max(2, eyeS * 0.24)
                a.lineCapStyle = .round
                eye.setStroke()
                a.stroke()
            }
            metalMouth(arcAt: NSPoint(x: 0, y: -r * 0.34 + r * 0.02 + r * 0.04),
                       radius: r * 0.18, from: 205, to: 335,
                       width: max(2.5, r * 0.058), c: eye)

        case .wink:
            metalEye(NSPoint(x: -eyeX, y: eyeY), w: eyeS, h: eyeS * open,
                     r: corner, c: eye, detail: detail)
            let a = NSBezierPath()
            a.appendArc(withCenter: NSPoint(x: eyeX * 1.04, y: eyeY - r * 0.02 - r * 0.04),
                        radius: eyeS * 0.46, startAngle: 22, endAngle: 158)
            a.lineWidth = max(3.2, r * 0.072)
            a.lineCapStyle = .round
            eye.setStroke()
            a.stroke()
            metalMouth(arcAt: NSPoint(x: r * 0.03, y: -r * 0.34 + r * 0.015 + r * 0.03),
                       radius: r * 0.14, from: 207, to: 328,
                       width: max(2.5, r * 0.052), c: eye)

        case .alert, .angry, .listening:
            // Yeux écrasés et inclinés, sourcils rouges
            for side in [CGFloat(-1), CGFloat(1)] {
                let w = side < 0 ? eyeS : eyeS * 1.12
                let h = (side < 0 ? eyeS : eyeS * 1.08) * 0.74 * open
                let cx = side < 0 ? -eyeX : eyeX * 1.04
                let cy = side < 0 ? eyeY : eyeY + r * 0.01

                // Le Canvas tourne dans le sens horaire, AppKit l'inverse :
                // l'œil gauche (side = −1) doit donc pencher de −0,20.
                ctx.saveGState()
                ctx.translateBy(x: cx, y: cy)
                ctx.rotate(by: side * 0.20)
                metalEye(.zero, w: w, h: h, r: min(corner, h * 0.45), c: eye, detail: detail)
                ctx.restoreGState()

                ctx.saveGState()
                ctx.translateBy(x: cx, y: cy + h * 0.62 + r * 0.03)
                ctx.rotate(by: side * 0.34)
                let b = NSBezierPath()
                b.move(to: NSPoint(x: -w * 0.5, y: 0))
                b.line(to: NSPoint(x: w * 0.5, y: 0))
                b.lineWidth = max(2.5, r * 0.044)
                b.lineCapStyle = .round
                BudSkin.rose.setStroke()
                b.stroke()
                ctx.restoreGState()
            }
            metalMouth(arcAt: NSPoint(x: 0, y: -r * 0.34 - r * 0.03 - r * 0.06),
                       radius: r * 0.15, from: 36, to: 144,
                       width: max(2.5, r * 0.054), c: BudSkin.rose)
            if detail { metalAngerMark(ctx, r: r, t: t) }

        case .dizzy:
            drawSpiralEye(at: NSPoint(x: -eyeX, y: eyeY + sin(t * 7.2) * r * 0.035),
                          r: eyeS * 0.48, angle: spiral, premium: false, size: s, tint: eye)
            drawSpiralEye(at: NSPoint(x: eyeX * 1.04, y: eyeY - cos(t * 6.8) * r * 0.035),
                          r: eyeS * 0.48, angle: -spiral, premium: false, size: s, tint: eye)
            // Bouche ondulée
            let w = r * 0.26, hh = r * 0.055
            let p = NSBezierPath()
            let my = -r * 0.34 - r * 0.01
            p.move(to: NSPoint(x: -w * 0.5, y: my))
            p.curve(to: NSPoint(x: 0, y: my),
                    controlPoint1: NSPoint(x: -w * 0.333, y: my + hh * 0.667),
                    controlPoint2: NSPoint(x: -w * 0.167, y: my + hh * 0.667))
            p.curve(to: NSPoint(x: w * 0.5, y: my),
                    controlPoint1: NSPoint(x: w * 0.167, y: my - hh * 0.667),
                    controlPoint2: NSPoint(x: w * 0.333, y: my - hh * 0.667))
            p.lineWidth = max(2.2, r * 0.048)
            p.lineCapStyle = .round
            BudSkin.indigo.setStroke()
            p.stroke()
            if detail {
                metalQuestionMark(ctx, r: r, t: t)
                metalSweat(r: r)
            }
        }

        ctx.restoreGState()
    }

    private func metalEye(_ c: NSPoint, w: CGFloat, h: CGFloat, r: CGFloat,
                          c col: NSColor, detail: Bool) {
        let hh = max(1.5, h)
        let box = NSRect(x: c.x - w / 2, y: c.y - hh / 2, width: w, height: hh)
        let rad = min(r, hh * 0.45)
        let path = NSBezierPath(roundedRect: box, xRadius: rad, yRadius: rad)

        // Lueur : deux passes élargies plutôt qu'une ombre, moins coûteux
        if detail {
            for (grow, alpha) in [(w * 0.26, CGFloat(0.12)), (w * 0.13, CGFloat(0.18))] {
                let g = NSBezierPath(roundedRect: box.insetBy(dx: -grow, dy: -grow),
                                     xRadius: rad + grow, yRadius: rad + grow)
                col.withAlphaComponent(alpha).setFill()
                g.fill()
            }
        }
        col.setFill()
        path.fill()

        if detail && hh > w * 0.35 {
            NSColor.white.withAlphaComponent(0.45).setFill()
            NSBezierPath(roundedRect: NSRect(x: box.minX + w * 0.18,
                                             y: box.maxY - hh * 0.32 - hh * 0.20,
                                             width: w * 0.24, height: hh * 0.20),
                         xRadius: rad * 0.4, yRadius: rad * 0.4).fill()
        }
    }

    private func metalMouth(arcAt c: NSPoint, radius: CGFloat, from a0: CGFloat,
                            to a1: CGFloat, width: CGFloat, c col: NSColor) {
        let p = NSBezierPath()
        p.appendArc(withCenter: c, radius: radius, startAngle: a0, endAngle: a1)
        p.lineWidth = width
        p.lineCapStyle = .round
        col.setStroke()
        p.stroke()
    }

    private func metalAngerMark(_ ctx: CGContext, r: CGFloat, t: CGFloat) {
        let tx = sin(t * 38) * r * 0.018
        let ty = cos(t * 44) * r * 0.018
        let pop = 1.08 + sin(t * 12) * 0.06

        ctx.saveGState()
        ctx.translateBy(x: r * 0.56 + tx, y: r * 0.34 + ty)
        ctx.scaleBy(x: pop, y: pop)

        let rIn = r * 0.032, rOut = r * 0.095
        BudSkin.rose.setStroke()
        for i in 0..<4 {
            ctx.saveGState()
            ctx.rotate(by: CGFloat(i) * .pi / 2 + .pi / 4)
            let p = NSBezierPath()
            p.move(to: NSPoint(x: -rOut * 0.55, y: rIn))
            p.curve(to: NSPoint(x: rOut * 0.55, y: rIn),
                    controlPoint1: NSPoint(x: -rOut * 0.1833, y: rIn * 0.667),
                    controlPoint2: NSPoint(x: rOut * 0.1833, y: rIn * 0.667))
            p.lineWidth = max(2, r * 0.035)
            p.lineCapStyle = .round
            p.stroke()
            ctx.restoreGState()
        }
        ctx.restoreGState()
    }

    private func metalQuestionMark(_ ctx: CGContext, r: CGFloat, t: CGFloat) {
        let bob = sin(t * 5.2) * r * 0.035
        ctx.saveGState()
        ctx.translateBy(x: r * 0.54, y: r * 0.33 + bob)
        ctx.rotate(by: -sin(t * 3.8) * 0.14)

        let q = r * 0.068
        BudSkin.indigo.setStroke()
        BudSkin.indigo.setFill()
        let p = NSBezierPath()
        // Canvas : arc 0,95π → 0,28π en y descendant ; ici 0,05π → 0,72π
        p.appendArc(withCenter: NSPoint(x: 0, y: q * 0.4), radius: q,
                    startAngle: 189, endAngle: 50, clockwise: true)
        p.curve(to: NSPoint(x: 0, y: -q * 0.72),
                controlPoint1: NSPoint(x: q * 0.9, y: -q * 0.45),
                controlPoint2: NSPoint(x: q * 0.6, y: -q * 0.60))
        p.line(to: NSPoint(x: 0, y: -q * 1.12))
        p.lineWidth = max(2.2, r * 0.038)
        p.lineCapStyle = .round
        p.stroke()

        let d = max(1.8, r * 0.024)
        NSBezierPath(ovalIn: NSRect(x: -d, y: -q * 1.56 - d, width: d * 2, height: d * 2)).fill()
        ctx.restoreGState()
    }

    private func metalSweat(r: CGFloat) {
        let xs: [CGFloat] = [0.26, 0.34, 0.21]
        let ys: [CGFloat] = [0.25, 0.17, 0.17]
        for i in 0..<3 {
            let p0 = drops[i]
            let fade: CGFloat = p0 < 0.2 ? p0 / 0.2 : (p0 > 0.78 ? (1 - p0) / 0.22 : 1)
            let x = xs[i] * r * 1.25
            let y = ys[i] * r * 0.75 - p0 * r * 0.16
            let rr = r * 0.04 * dropSize[i]

            let p = NSBezierPath()
            p.move(to: NSPoint(x: x, y: y + rr * 1.4))
            p.curve(to: NSPoint(x: x, y: y - rr),
                    controlPoint1: NSPoint(x: x + rr, y: y + rr * 0.1),
                    controlPoint2: NSPoint(x: x + rr * 0.9, y: y - rr))
            p.curve(to: NSPoint(x: x, y: y + rr * 1.4),
                    controlPoint1: NSPoint(x: x - rr * 0.9, y: y - rr),
                    controlPoint2: NSPoint(x: x - rr, y: y + rr * 0.1))
            p.close()
            NSColor(calibratedRed: 0.220, green: 0.741, blue: 0.972,
                    alpha: max(0, min(1, fade))).setFill()
            p.fill()
        }
    }

    // ── Le corps ──

    private func drawBody(_ ctx: CGContext, size s: CGFloat, premium: Bool, detail: Bool) {
        let half = s / 2

        if !premium {
            // Style à plat : coque blanche et liseré interne.
            // Le prototype appelle ctx.translate() APRÈS avoir construit le
            // chemin ; en Canvas cela ne déplace rien, le tracé est déjà figé
            // en espace écran. Le liseré est donc centré, pas décalé.
            let body = squirclePath(size: s, radiusRatio: 0.30)
            BudSkin.shell.setFill()
            body.fill()

            ctx.saveGState()
            body.addClip()
            let ring = squirclePath(size: s, radiusRatio: 0.30)
            ring.lineWidth = s * 0.065
            BudSkin.shellEdge.setStroke()
            ring.stroke()
            ctx.restoreGState()

            // Liseré discret : sans lui, le blanc disparaît en thème clair.
            if !TH.dark {
                body.lineWidth = max(0.8, s * 0.010)
                NSColor(calibratedWhite: 0.62, alpha: 0.30).setStroke()
                body.stroke()
            }
            return
        }

        // Style nacré-or : cadre champagne, coque nacrée, reflet, signature.
        let outer = squirclePath(size: s * 1.045, radiusRatio: 0.31)
        if let g = NSGradient(colors: [BudSkin.goldHi, BudSkin.goldMid,
                                       BudSkin.pearlHi, BudSkin.goldLo, BudSkin.goldHi],
                              atLocations: [0, 0.32, 0.55, 0.82, 1], colorSpace: .deviceRGB) {
            g.draw(in: outer, angle: -45)
        } else {
            BudSkin.goldMid.setFill()
            outer.fill()
        }
        outer.lineWidth = 1.5
        NSColor(calibratedRed: 1, green: 0.973, blue: 0.922, alpha: 0.65).setStroke()
        outer.stroke()

        let inner = squirclePath(size: s * 0.94, radiusRatio: 0.295)
        ctx.saveGState()
        inner.addClip()
        if let g = NSGradient(colors: [BudSkin.pearlHi, BudSkin.pearlMid, BudSkin.pearlLo],
                              atLocations: [0, 0.65, 1], colorSpace: .deviceRGB) {
            g.draw(fromCenter: NSPoint(x: -s * 0.14, y: s * 0.18), radius: s * 0.05,
                   toCenter: NSPoint(x: 0, y: 0), radius: s * 0.72, options: [])
        } else {
            BudSkin.pearlMid.setFill()
            inner.fill()
        }

        // Reflet spéculaire en haut de la coque
        if let sheen = NSGradient(colors: [NSColor.white.withAlphaComponent(0.70),
                                           NSColor.white.withAlphaComponent(0)],
                                  atLocations: [0, 1], colorSpace: .deviceRGB) {
            sheen.draw(in: NSRect(x: -half, y: half - half * 0.85,
                                  width: s, height: half * 0.85), angle: -90)
        }
        ctx.restoreGState()

        // Signature discrète, comme sur le modèle
        if detail {
            let f = NSFont(name: "Georgia-Bold", size: s * 0.068)
                ?? NSFont.boldSystemFont(ofSize: s * 0.068)
            let attrs: [NSAttributedString.Key: Any] = [
                .font: f,
                .foregroundColor: NSColor(calibratedRed: 0.749, green: 0.596,
                                          blue: 0.416, alpha: 0.75)
            ]
            let str = NSAttributedString(string: "BUD", attributes: attrs)
            let sz = str.size()
            str.draw(at: NSPoint(x: -sz.width / 2, y: -s * 0.355 - sz.height / 2))
        }
    }

    // ── Le visage ──

    private func drawFace(_ ctx: CGContext, size s: CGFloat, mood m: BudMood,
                          premium: Bool, detail: Bool, t: CGFloat) {
        let ink = premium ? BudSkin.inkWarm : BudSkin.ink
        // Le regard déplace les traits de quelques points seulement.
        let gx = lookX * s * 0.042
        let gy = lookY * s * 0.036

        // Joues, légèrement en retrait du regard
        drawCheeks(size: s, gx: gx, gy: gy, premium: premium, t: t)

        ctx.saveGState()
        ctx.translateBy(x: gx, y: gy)

        let eyeX = s * 0.145
        let eyeY = -s * 0.012          // Canvas : +0,012 vers le bas
        let eyeR = s * 0.044

        switch m {
        case .calm, .thinking, .speaking, .confused, .sad, .working:
            drawRoundEye(at: NSPoint(x: -eyeX, y: eyeY), r: eyeR, premium: premium, detail: detail)
            drawRoundEye(at: NSPoint(x: eyeX, y: eyeY), r: eyeR, premium: premium, detail: detail)
            drawOMouth(size: s, y: -s * 0.125, w: s * 0.042, h: s * 0.056,
                       ink: ink, premium: premium)

        case .happy, .proud:
            drawRoundEye(at: NSPoint(x: -eyeX, y: eyeY), r: eyeR, premium: premium, detail: detail)
            drawRoundEye(at: NSPoint(x: eyeX, y: eyeY), r: eyeR, premium: premium, detail: detail)
            drawBigSmile(size: s, premium: premium, ink: ink)

        case .wink:
            drawRoundEye(at: NSPoint(x: -eyeX, y: eyeY), r: eyeR, premium: premium, detail: detail)
            // Œil droit fermé : arc qui bombe vers le haut
            let lid = NSBezierPath()
            lid.appendArc(withCenter: NSPoint(x: eyeX, y: eyeY - s * 0.008),
                          radius: eyeR * 1.15, startAngle: 20, endAngle: 160)
            lid.lineWidth = s * 0.021
            lid.lineCapStyle = .round
            (premium ? BudSkin.smileGold : ink).setStroke()
            lid.stroke()
            // Petit sourire courbe
            let sm = NSBezierPath()
            sm.appendArc(withCenter: NSPoint(x: 0, y: -s * 0.098),
                         radius: s * 0.055, startAngle: 200, endAngle: 340)
            sm.lineWidth = s * 0.021
            sm.lineCapStyle = .round
            (premium ? BudSkin.smileGold : ink).setStroke()
            sm.stroke()

        case .alert, .angry, .listening:
            drawAngryEyes(size: s, eyeX: eyeX, eyeY: eyeY, r: eyeR,
                          ink: ink, premium: premium)
            // Bouche en moue : arc qui bombe vers le haut
            let mo = NSBezierPath()
            mo.appendArc(withCenter: NSPoint(x: 0, y: -s * 0.138 - s * 0.028),
                         radius: s * 0.052, startAngle: 20, endAngle: 160)
            mo.lineWidth = s * 0.021
            mo.lineCapStyle = .round
            ink.setStroke()
            mo.stroke()
            if detail { drawAngerSymbol(size: s, t: t) }

        case .dizzy:
            drawSpiralEye(at: NSPoint(x: -eyeX, y: eyeY), r: eyeR * 1.25,
                          angle: spiral, premium: premium, size: s)
            drawSpiralEye(at: NSPoint(x: eyeX, y: eyeY), r: eyeR * 1.25,
                          angle: -spiral, premium: premium, size: s)
            drawOMouth(size: s, y: -s * 0.132, w: s * 0.044, h: s * 0.054,
                       ink: ink, premium: premium)
            if detail { drawSweat(size: s, premium: premium) }

        case .sleepy:
            // Paupières tombantes : deux arcs qui bombent vers le bas
            for dx in [-eyeX, eyeX] {
                let p = NSBezierPath()
                p.appendArc(withCenter: NSPoint(x: dx, y: eyeY + s * 0.004),
                            radius: eyeR * 1.05, startAngle: 200, endAngle: 340)
                p.lineWidth = s * 0.020
                p.lineCapStyle = .round
                ink.withAlphaComponent(0.85).setStroke()
                p.stroke()
            }
            let p = NSBezierPath()
            p.move(to: NSPoint(x: -s * 0.030, y: -s * 0.125))
            p.line(to: NSPoint(x: s * 0.030, y: -s * 0.125))
            p.lineWidth = s * 0.020
            p.lineCapStyle = .round
            ink.withAlphaComponent(0.85).setStroke()
            p.stroke()
        }

        ctx.restoreGState()
    }

    // ── Pièces du visage ──

    private func drawCheeks(size s: CGFloat, gx: CGFloat, gy: CGFloat,
                            premium: Bool, t: CGFloat) {
        let pulse = 1 + sin(t * 3.2) * 0.045
        let ox = s * 0.235 + gx * 0.45
        let oy = -s * 0.095 + gy * 0.45
        let rx = s * 0.072 * pulse
        let ry = s * 0.041 * pulse

        for side in [CGFloat(-1), CGFloat(1)] {
            let box = NSRect(x: side * ox - rx, y: oy - ry, width: rx * 2, height: ry * 2)
            if premium {
                let path = NSBezierPath(ovalIn: box.insetBy(dx: -rx * 0.05, dy: -ry * 0.10))
                NSGraphicsContext.current?.saveGraphicsState()
                path.addClip()
                if let g = NSGradient(colors: [NSColor(calibratedRed: 0.973, green: 0.812,
                                                       blue: 0.761, alpha: 1),
                                               BudSkin.blushWarm,
                                               NSColor(calibratedRed: 0.773, green: 0.510,
                                                       blue: 0.447, alpha: 1)],
                                      atLocations: [0, 0.65, 1], colorSpace: .deviceRGB) {
                    g.draw(fromCenter: NSPoint(x: side * ox - rx * 0.25, y: oy + ry * 0.3),
                           radius: rx * 0.1,
                           toCenter: NSPoint(x: side * ox, y: oy), radius: rx * 1.1,
                           options: [])
                }
                NSGraphicsContext.current?.restoreGraphicsState()
            } else {
                BudSkin.blush.setFill()
                NSBezierPath(ovalIn: box).fill()
            }
        }
    }

    private func drawRoundEye(at c: NSPoint, r: CGFloat, premium: Bool, detail: Bool) {
        if blink > 0.85 {
            // Œil fermé : arc doux qui bombe vers le bas
            let p = NSBezierPath()
            p.appendArc(withCenter: c, radius: r * 0.9, startAngle: 200, endAngle: 340)
            p.lineWidth = r * 0.42
            p.lineCapStyle = .round
            (premium ? BudSkin.inkWarm : BudSkin.ink).setStroke()
            p.stroke()
            return
        }

        let open = max(0.12, 1 - blink * 0.9)
        let rr = premium ? r * 1.05 : r
        let box = NSRect(x: c.x - rr, y: c.y - rr * open, width: rr * 2, height: rr * 2 * open)

        if premium {
            NSGraphicsContext.current?.saveGraphicsState()
            NSBezierPath(ovalIn: box).addClip()
            if let g = NSGradient(colors: [NSColor(calibratedRed: 0.349, green: 0.306,
                                                   blue: 0.275, alpha: 1),
                                           NSColor(calibratedRed: 0.141, green: 0.118,
                                                   blue: 0.102, alpha: 1),
                                           NSColor(calibratedRed: 0.071, green: 0.059,
                                                   blue: 0.051, alpha: 1)],
                                  atLocations: [0, 0.45, 1], colorSpace: .deviceRGB) {
                g.draw(fromCenter: NSPoint(x: c.x - rr * 0.3, y: c.y + rr * 0.3 * open),
                       radius: rr * 0.1,
                       toCenter: NSPoint(x: c.x, y: c.y), radius: rr, options: [])
            }
            NSGraphicsContext.current?.restoreGraphicsState()
            if open > 0.5 {
                NSColor(calibratedRed: 1, green: 0.980, blue: 0.941, alpha: 0.85).setFill()
                let g = rr * 0.24
                NSBezierPath(ovalIn: NSRect(x: c.x - rr * 0.32 - g,
                                            y: c.y + (rr * 0.32 - g) * open,
                                            width: g * 2, height: g * 2 * open)).fill()
            }
        } else {
            BudSkin.ink.setFill()
            NSBezierPath(ovalIn: box).fill()
            if open > 0.6 && detail {
                NSColor.white.withAlphaComponent(0.72).setFill()
                let g = rr * 0.26
                NSBezierPath(ovalIn: NSRect(x: c.x - rr * 0.30 - g,
                                            y: c.y + (rr * 0.30 - g) * open,
                                            width: g * 2, height: g * 1.5 * open)).fill()
            }
        }
    }

    /// Bouche en « O » avec la langue rose, le trait du compagnon standard.
    private func drawOMouth(size s: CGFloat, y: CGFloat, w: CGFloat, h: CGFloat,
                            ink: NSColor, premium: Bool) {
        ink.setFill()
        NSBezierPath(ovalIn: NSRect(x: -w, y: y - h, width: w * 2, height: h * 2)).fill()

        NSGraphicsContext.current?.saveGraphicsState()
        NSBezierPath(ovalIn: NSRect(x: -w * 0.78, y: y - h * 0.80,
                                    width: w * 1.56, height: h * 1.60)).addClip()
        (premium ? BudSkin.tongueWarm : BudSkin.tongue).setFill()
        NSBezierPath(ovalIn: NSRect(x: -w * 0.72, y: y - h * 0.38 - h * 0.52,
                                    width: w * 1.44, height: h * 1.04)).fill()
        NSGraphicsContext.current?.restoreGraphicsState()
    }

    /// Grand sourire ouvert en demi-lune.
    private func drawBigSmile(size s: CGFloat, premium: Bool, ink: NSColor) {
        let r = s * 0.072
        let c = NSPoint(x: 0, y: -s * 0.095)
        let p = NSBezierPath()
        p.appendArc(withCenter: c, radius: r, startAngle: 191, endAngle: 349)
        p.close()

        if premium {
            NSGraphicsContext.current?.saveGraphicsState()
            p.addClip()
            if let g = NSGradient(colors: [NSColor(calibratedRed: 0.961, green: 0.839,
                                                   blue: 0.576, alpha: 1),
                                           BudSkin.smileGold,
                                           NSColor(calibratedRed: 0.953, green: 0.808,
                                                   blue: 0.518, alpha: 1)],
                                  atLocations: [0, 0.5, 1], colorSpace: .deviceRGB) {
                g.draw(in: p, angle: -45)
            }
            NSGraphicsContext.current?.restoreGraphicsState()
            p.lineWidth = s * 0.014
            BudSkin.smileEdge.setStroke()
            p.stroke()
        } else {
            NSColor.white.setFill()
            p.fill()
            p.lineWidth = s * 0.018
            p.lineJoinStyle = .round
            ink.setStroke()
            p.stroke()
        }
    }

    private func drawAngryEyes(size s: CGFloat, eyeX: CGFloat, eyeY: CGFloat, r: CGFloat,
                              ink: NSColor, premium: Bool) {
        let lidColor = premium ? BudSkin.pearlMid : NSColor.white
        for side in [CGFloat(-1), CGFloat(1)] {
            let c = NSPoint(x: side * eyeX, y: eyeY - s * 0.008)

            ink.setFill()
            NSBezierPath(ovalIn: NSRect(x: c.x - r * 0.95, y: c.y - r * 0.95,
                                        width: r * 1.9, height: r * 1.9)).fill()

            // Paupière supérieure inclinée, de la couleur de la coque
            let ctxg = NSGraphicsContext.current
            ctxg?.saveGraphicsState()
            let tr = NSAffineTransform()
            tr.translateX(by: c.x, yBy: c.y)
            tr.rotate(byRadians: side * 0.35)
            tr.concat()
            lidColor.setFill()
            NSBezierPath(rect: NSRect(x: -r * 1.3, y: r * 0.50,
                                      width: r * 2.6, height: r * 0.95)).fill()
            ctxg?.restoreGraphicsState()

            // Sourcil froncé
            ctxg?.saveGraphicsState()
            let tb = NSAffineTransform()
            tb.translateX(by: c.x, yBy: eyeY + r * 1.15)
            tb.rotate(byRadians: side * 0.38)
            tb.concat()
            let br = NSBezierPath()
            br.move(to: NSPoint(x: -r * 1.05, y: 0))
            br.line(to: NSPoint(x: r * 1.05, y: 0))
            br.lineWidth = s * 0.021
            br.lineCapStyle = .round
            ink.setStroke()
            br.stroke()
            ctxg?.restoreGraphicsState()
        }
    }

    private func drawAngerSymbol(size s: CGFloat, t: CGFloat) {
        let pulse = 1 + sin(t * 10) * 0.12
        let ctxg = NSGraphicsContext.current
        ctxg?.saveGraphicsState()
        let tr = NSAffineTransform()
        tr.translateX(by: s * 0.25, yBy: s * 0.24)
        tr.scale(by: pulse)
        tr.concat()

        let rIn = s * 0.022, rOut = s * 0.058
        BudSkin.anger.setStroke()
        for i in 0..<4 {
            let inner = NSGraphicsContext.current
            inner?.saveGraphicsState()
            let rot = NSAffineTransform()
            rot.rotate(byRadians: CGFloat(i) * .pi / 2 + .pi / 4)
            rot.concat()
            // Quadratique du prototype convertie en cubique :
            // C1 = P0 + ⅔(Q−P0), C2 = P2 + ⅔(Q−P2).
            let p = NSBezierPath()
            p.move(to: NSPoint(x: -rOut * 0.55, y: rIn))
            p.curve(to: NSPoint(x: rOut * 0.55, y: rIn),
                    controlPoint1: NSPoint(x: -rOut * 0.1833, y: rIn * 0.70),
                    controlPoint2: NSPoint(x: rOut * 0.1833, y: rIn * 0.70))
            p.lineWidth = s * 0.022
            p.lineCapStyle = .round
            p.lineJoinStyle = .round
            p.stroke()
            inner?.restoreGraphicsState()
        }
        ctxg?.restoreGraphicsState()
    }

    private func drawSpiralEye(at c: NSPoint, r: CGFloat, angle: CGFloat,
                               premium: Bool, size s: CGFloat, tint: NSColor? = nil) {
        let ctxg = NSGraphicsContext.current
        ctxg?.saveGraphicsState()
        let tr = NSAffineTransform()
        tr.translateX(by: c.x, yBy: c.y)
        tr.rotate(byRadians: angle)
        tr.concat()

        let p = NSBezierPath()
        let turns: CGFloat = 2.4
        let steps = 48
        for i in 0...steps {
            let prog = CGFloat(i) / CGFloat(steps)
            let theta = prog * turns * .pi * 2
            let rad = prog * r * 1.35
            let pt = NSPoint(x: cos(theta) * rad, y: sin(theta) * rad)
            if i == 0 { p.move(to: pt) } else { p.line(to: pt) }
        }
        p.lineWidth = r * 0.22
        p.lineCapStyle = .round
        (tint ?? (premium ? NSColor(calibratedRed: 0.227, green: 0.196, blue: 0.176, alpha: 1)
                          : BudSkin.ink)).setStroke()
        p.stroke()
        ctxg?.restoreGraphicsState()
    }

    private func drawSweat(size s: CGFloat, premium: Bool) {
        let xs: [CGFloat] = [0.27, 0.34, 0.22]
        let ys: [CGFloat] = [0.28, 0.21, 0.22]
        for i in 0..<3 {
            let cycle = drops[i]
            let alpha: CGFloat = cycle < 0.2 ? cycle / 0.2
                               : (cycle > 0.75 ? (1 - cycle) / 0.25 : 1)
            let dy = cycle * s * 0.09
            let r = s * 0.022 * dropSize[i]
            let px = xs[i] * s
            let py = ys[i] * s - dy        // Canvas : la goutte descend

            let ctxg = NSGraphicsContext.current
            ctxg?.saveGraphicsState()
            let tr = NSAffineTransform()
            tr.translateX(by: px, yBy: py)
            tr.concat()

            let p = NSBezierPath()
            p.move(to: NSPoint(x: 0, y: r * 1.45))
            p.curve(to: NSPoint(x: 0, y: -r * 1.1),
                    controlPoint1: NSPoint(x: r * 1.1, y: r * 0.1),
                    controlPoint2: NSPoint(x: r * 1.0, y: -r * 1.1))
            p.curve(to: NSPoint(x: 0, y: r * 1.45),
                    controlPoint1: NSPoint(x: -r * 1.0, y: -r * 1.1),
                    controlPoint2: NSPoint(x: -r * 1.1, y: r * 0.1))
            p.close()

            let a = max(0, min(1, alpha))
            if premium {
                NSGraphicsContext.current?.saveGraphicsState()
                p.addClip()
                if let g = NSGradient(colors: [NSColor.white.withAlphaComponent(a),
                                               NSColor(calibratedRed: 0.596, green: 0.667,
                                                       blue: 0.722, alpha: a)],
                                      atLocations: [0, 1], colorSpace: .deviceRGB) {
                    g.draw(in: NSRect(x: -r * 1.2, y: -r * 1.5,
                                      width: r * 2.4, height: r * 3), angle: -45)
                }
                NSGraphicsContext.current?.restoreGraphicsState()
            } else {
                BudSkin.sweat.withAlphaComponent(a).setFill()
                p.fill()
                p.lineWidth = s * 0.011
                BudSkin.ink.withAlphaComponent(a).setStroke()
                p.stroke()
            }
            ctxg?.restoreGraphicsState()
        }
    }
}
EOF_BUDFACE_SWIFT

cat << 'EOF_BUDFLOW_SWIFT' > "$SRC_DIR/BudFlow.swift"
import Cocoa

// ═══════════════════════════════════════════════════════════
//  Le Flux — des agents en nœuds, à la manière de n8n
//
//  Ce n'est pas un moteur n8n et cela ne parle à aucun
//  serveur : c'est une façon de montrer et d'organiser ce que
//  font les agents de BUD. Trois colonnes, lues de gauche à
//  droite :
//
//      Sources  ──▶  Agents  ──▶  BUDs
//
//  Une source est ce qu'un agent lit (les téléchargements, le
//  courrier, le ciel). Un agent est un traitement. BUDs est la
//  sortie : son expression dit le résultat, et ses cartes le
//  détaillent.
//
//  Tout passe par un registre. Un nouvel agent est une classe
//  conforme à `BudAgent`, inscrite d'une ligne dans
//  `BudAgentCatalog.registerDefaults()` : la vue le place,
//  trace ses liens, gère son état et ses cartes. Elle n'a pas
//  à être retouchée.
// ═══════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────
//  Les expressions de BUD, dans le vocabulaire des agents
//
//  Les agents parlent en expressions — sept visages et un
//  état de travail — et pas en humeurs internes : un agent
//  écrit dans une future mise à jour n'a pas à connaître les
//  treize humeurs du compagnon, ni leurs postures.
// ─────────────────────────────────────────────────────────

enum BudExpression: String, CaseIterable {
    case neutral, happy, reflection, annoyed, dizzy, cool, sad, working

    /// L'humeur du compagnon qui porte cette expression — visage et
    /// posture compris.
    var mood: BudMood {
        switch self {
        case .neutral:    return .listening
        case .happy:      return .happy
        case .reflection: return .thinking
        case .annoyed:    return .angry
        case .dizzy:      return .dizzy
        case .cool:       return .proud
        case .sad:        return .sad
        case .working:    return .working
        }
    }

    var label: String {
        switch self {
        case .neutral:    return "Attentif"
        case .happy:      return "Content"
        case .reflection: return "Réfléchi"
        case .annoyed:    return "Agacé"
        case .dizzy:      return "Étourdi"
        case .cool:       return "Cool"
        case .sad:        return "Déçu"
        case .working:    return "Au travail"
        }
    }
}

// ─────────────────────────────────────────────────────────
//  États et badges
// ─────────────────────────────────────────────────────────

enum NodeStatus: Equatable {
    case idle, running, success, warning, failure, needsApproval

    var label: String {
        switch self {
        case .idle:          return "Prêt"
        case .running:       return "En cours"
        case .success:       return "OK"
        case .warning:       return "Alerte"
        case .failure:       return "Échec"
        case .needsApproval: return "À valider"
        }
    }

    var color: NSColor {
        switch self {
        case .idle:          return NSColor(calibratedWhite: 0.62, alpha: 1)
        case .running:       return NSColor(calibratedRed: 0.38, green: 0.66, blue: 1.00, alpha: 1)
        case .success:       return NSColor(calibratedRed: 0.30, green: 0.82, blue: 0.55, alpha: 1)
        case .warning:       return NSColor(calibratedRed: 1.00, green: 0.72, blue: 0.25, alpha: 1)
        case .failure:       return NSColor(calibratedRed: 1.00, green: 0.40, blue: 0.42, alpha: 1)
        case .needsApproval: return NSColor(calibratedRed: 0.72, green: 0.52, blue: 1.00, alpha: 1)
        }
    }

    var icon: String {
        switch self {
        case .idle:          return "circle"
        case .running:       return "arrow.triangle.2.circlepath"
        case .success:       return "checkmark"
        case .warning:       return "exclamationmark.triangle.fill"
        case .failure:       return "xmark"
        case .needsApproval: return "hand.raised.fill"
        }
    }
}

/// Une source : ce qu'un agent lit. Deux agents qui déclarent la même
/// source (même `id`) partagent son nœud dans la vue.
struct FlowSource {
    let id: String
    let title: String
    let icon: String
    var tint: NSColor = NSColor(calibratedWhite: 0.8, alpha: 1)
    /// Ce qu'on en lit, et si quelque chose sort du Mac.
    var note: String = ""
}

// ─────────────────────────────────────────────────────────
//  Les cartes — le détail d'un résultat
//
//  Des cartes compactes à la manière des widgets iOS : une
//  pastille, un intitulé en petites capitales, une valeur en
//  gros, une ligne de détail. Trois styles seulement : une
//  carte de statistique, une carte de contrôle (cliquable,
//  pour la maison) et une carte météo, qui dessine son ciel.
// ─────────────────────────────────────────────────────────

struct BudCard {
    enum Style { case stat, control, weather }

    var style: Style = .stat
    var icon: String
    var title: String
    var value: String
    var detail: String = ""
    var tint: NSColor
    /// Pour une carte de contrôle : l'action au clic. Elle reçoit un
    /// rappel à appeler avec le message de fin.
    var action: ((@escaping (Bool, String) -> Void) -> Void)? = nil
    /// Pour une carte météo : le code OMM et le jour ou la nuit.
    var weatherCode: Int = 0
    var isDay: Bool = true
}

// ─────────────────────────────────────────────────────────
//  La fiche d'approbation
//
//  Tout ce qui supprime, désinstalle ou modifie passe par là.
//  Un agent ne reçoit pas le droit d'agir : il propose une
//  liste, et c'est la fiche qui rend la sélection, cochée à la
//  main. Les éléments risqués arrivent décochés.
// ─────────────────────────────────────────────────────────

struct ApprovalItem {
    let id: String
    var label: String
    var detail: String
    var icon: String
    var bytes: Int64 = 0
    var selected: Bool
    var url: URL? = nil
}

struct ApprovalRequest {
    var title: String
    var message: String
    var items: [ApprovalItem]
    var confirmLabel: String
    var destructive: Bool = true
    /// Exécutée avec les seuls éléments cochés, hors du fil principal si
    /// besoin ; le rappel rend le résultat final.
    var perform: ([ApprovalItem], @escaping (AgentResult) -> Void) -> Void
}

// ─────────────────────────────────────────────────────────
//  Le résultat d'un agent
// ─────────────────────────────────────────────────────────

struct AgentResult {
    var status: NodeStatus
    var expression: BudExpression
    var headline: String
    var cards: [BudCard] = []
    var approval: ApprovalRequest? = nil
    /// Combien de temps BUDs garde l'expression.
    var hold: TimeInterval = 4
}

/// Ce qu'un agent reçoit pour travailler.
final class AgentContext {
    let simulated: Bool
    /// Une ligne d'avancement, affichée sous le nœud. Appelable de
    /// n'importe quel fil.
    let progress: (String) -> Void
    private(set) var cancelled = false
    init(simulated: Bool, progress: @escaping (String) -> Void) {
        self.simulated = simulated
        self.progress = progress
    }
    func cancel() { cancelled = true }
}

// ═══════════════════════════════════════════════════════════
//  Le contrat d'un agent
// ═══════════════════════════════════════════════════════════

protocol BudAgent: AnyObject {
    var id: String { get }
    var name: String { get }
    /// Une phrase : ce que fait l'agent.
    var summary: String { get }
    var icon: String { get }
    var tint: NSColor { get }
    var sources: [FlowSource] { get }
    /// Le vrai travail. `done` peut être appelé de n'importe quel fil ;
    /// le gestionnaire le ramène sur le fil principal.
    func run(_ ctx: AgentContext, done: @escaping (AgentResult) -> Void)
    /// Le même parcours sur des données d'exemple, sans rien lire ni
    /// toucher. Sert à la démonstration et aux essais d'interface.
    func simulate(_ ctx: AgentContext, done: @escaping (AgentResult) -> Void)
}

/// Ce que voit la vue d'un agent à un instant donné.
struct AgentState {
    var status: NodeStatus = .idle
    var line = ""
    var lastRun: Date?
    var result: AgentResult?
    var simulated = false
}

// ═══════════════════════════════════════════════════════════
//  Le registre
// ═══════════════════════════════════════════════════════════

final class BudAgentManager {
    static let shared = BudAgentManager()

    private(set) var agents: [BudAgent] = []
    private(set) var states: [String: AgentState] = [:]
    private var contexts: [String: AgentContext] = [:]

    /// Prévenu à chaque changement d'état, avec l'identifiant de l'agent.
    private var observers: [(String) -> Void] = []
    /// Branché par l'application : c'est ainsi que BUDs change de visage.
    var onExpression: ((BudExpression, TimeInterval) -> Void)?
    /// Une ligne pour la barre d'état de BUD.
    var onStatus: ((String) -> Void)?

    func observe(_ f: @escaping (String) -> Void) { observers.append(f) }
    private func changed(_ id: String) { observers.forEach { $0(id) } }

    func register(_ a: BudAgent) {
        guard !agents.contains(where: { $0.id == a.id }) else { return }
        agents.append(a)
        states[a.id] = AgentState()
        changed(a.id)
    }

    func agent(_ id: String) -> BudAgent? { agents.first { $0.id == id } }
    func state(_ id: String) -> AgentState { states[id] ?? AgentState() }

    /// Toutes les sources, dans l'ordre des agents, sans doublon.
    var sources: [FlowSource] {
        var seen = Set<String>(), out: [FlowSource] = []
        for a in agents { for s in a.sources where seen.insert(s.id).inserted { out.append(s) } }
        return out
    }

    var anyRunning: Bool { states.values.contains { $0.status == .running } }

    // ── Exécution ──

    func run(_ id: String, simulated: Bool = false) {
        guard let a = agent(id), state(id).status != .running else { return }
        var st = state(id)
        st.status = .running
        st.line = simulated ? "Simulation…" : "Démarrage…"
        st.simulated = simulated
        states[id] = st
        changed(id)
        // « Au travail » tient tant que l'agent tourne ; on le renouvelle
        // à la fin, par l'expression du résultat.
        onExpression?(.working, 120)
        onStatus?("\(a.name) : au travail…")

        let ctx = AgentContext(simulated: simulated) { [weak self] line in
            DispatchQueue.main.async {
                guard let s = self, var st = s.states[id], st.status == .running else { return }
                st.line = line
                s.states[id] = st
                s.changed(id)
            }
        }
        contexts[id] = ctx
        let finish: (AgentResult) -> Void = { [weak self] r in
            DispatchQueue.main.async { self?.finish(id, r, ctx: ctx) }
        }
        if simulated { a.simulate(ctx, done: finish) } else { a.run(ctx, done: finish) }
    }

    func cancel(_ id: String) {
        contexts[id]?.cancel()
    }

    private func finish(_ id: String, _ r: AgentResult, ctx: AgentContext) {
        guard contexts[id] === ctx else { return }
        contexts[id] = nil
        var st = state(id)
        st.status = ctx.cancelled ? .idle : (r.approval != nil ? .needsApproval : r.status)
        st.line = ctx.cancelled ? "Interrompu." : r.headline
        st.lastRun = Date()
        st.result = r
        states[id] = st
        changed(id)
        let expr: BudExpression = ctx.cancelled ? .neutral : r.expression
        // Si un autre agent tourne encore, BUDs reste au travail.
        onExpression?(anyRunning ? .working : expr, anyRunning ? 120 : r.hold)
        onStatus?(st.line)
    }

    /// Exécute la fiche d'approbation avec les éléments cochés. Une liste
    /// vide revient à refuser.
    func approve(_ id: String, items: [ApprovalItem]) {
        guard var st = states[id], let req = st.result?.approval else { return }
        let chosen = items.filter { $0.selected }
        guard !chosen.isEmpty else { decline(id); return }
        st.status = .running
        st.line = "Application de votre choix…"
        states[id] = st
        changed(id)
        onExpression?(.working, 120)
        req.perform(chosen) { [weak self] r in
            DispatchQueue.main.async {
                guard let s = self else { return }
                var st = s.state(id)
                st.status = r.status
                st.line = r.headline
                st.lastRun = Date()
                // On garde les cartes du relevé si l'exécution n'en rend pas.
                var merged = r
                if merged.cards.isEmpty { merged.cards = st.result?.cards ?? [] }
                merged.approval = nil
                st.result = merged
                s.states[id] = st
                s.changed(id)
                s.onExpression?(s.anyRunning ? .working : r.expression, r.hold)
                s.onStatus?(r.headline)
            }
        }
    }

    func decline(_ id: String) {
        guard var st = states[id] else { return }
        st.result?.approval = nil
        st.status = .success
        st.line = "Rien n'a été touché."
        states[id] = st
        changed(id)
        onExpression?(.neutral, 2.5)
    }

    /// Sélectionner un nœud montre son dernier état sur le visage de BUDs :
    /// le dernier résultat s'il y en a un, l'attention sinon.
    func preview(_ id: String) {
        let st = state(id)
        if st.status == .running { onExpression?(.working, 120); return }
        onExpression?(st.result?.expression ?? .neutral, 2.5)
    }

    /// Les agents un par un, sur les données d'exemple : la démonstration
    /// complète des nœuds et des expressions.
    func demo() {
        for (i, a) in agents.enumerated() {
            DispatchQueue.main.asyncAfter(deadline: .now() + Double(i) * 4.5) { [weak self] in
                self?.run(a.id, simulated: true)
            }
        }
    }
}

// ═══════════════════════════════════════════════════════════
//  Le catalogue
//
//  La seule liste à toucher pour ajouter un agent.
// ═══════════════════════════════════════════════════════════

enum BudAgentCatalog {
    static func registerDefaults(mail: @escaping () -> [MailMessage],
                                 city: @escaping () -> String,
                                 runHome: @escaping (String, @escaping (Bool, String) -> Void) -> Void) {
        let m = BudAgentManager.shared
        m.register(CleanupAgent())
        m.register(SecurityAgent(mail: mail))
        m.register(WeatherHomeAgent(city: city, runHome: runHome))
        // Prochains agents : m.register(MonNouvelAgent())
    }
}
EOF_BUDFLOW_SWIFT

cat << 'EOF_BUDFLOWAGENTS_SWIFT' > "$SRC_DIR/BudFlowAgents.swift"
import Cocoa

// ═══════════════════════════════════════════════════════════
//  Les trois premiers agents du Flux
//
//  Chacun suit la même forme : `run` lit le vrai Mac, hors du
//  fil principal ; `simulate` parcourt le même chemin sur les
//  données de `BudFlowSamples`. Aucun des deux ne supprime
//  quoi que ce soit : ce qui touche au disque est rendu sous
//  forme de fiche d'approbation, et c'est l'utilisateur qui
//  coche.
// ═══════════════════════════════════════════════════════════

private let tintCleanup  = NSColor(calibratedRed: 0.36, green: 0.84, blue: 0.62, alpha: 1)
private let tintSecurity = NSColor(calibratedRed: 1.00, green: 0.46, blue: 0.42, alpha: 1)
private let tintSky      = NSColor(calibratedRed: 0.42, green: 0.70, blue: 1.00, alpha: 1)

// ═══════════════════════════════════════════════════════════
//  1. Nettoyage & Rangement
// ═══════════════════════════════════════════════════════════

/// Une application qui dort, et ce qu'elle a laissé dans la bibliothèque.
struct DormantApp {
    var url: URL
    var name: String
    var bundleID: String
    var lastUsed: Date?
    var bytes: Int64
    var fromAppStore: Bool
    var leftovers: [URL]
}

/// Un fichier des téléchargements qui mérite un regard.
struct ClutterFile {
    var url: URL
    var reason: String
    var bytes: Int64
    /// Coché d'avance dans la fiche : seulement les installeurs anciens,
    /// le cas où l'on ne regrette jamais.
    var preselect: Bool
}

enum CleanupScan {
    static let day: TimeInterval = 86_400

    static func size(_ u: URL) -> Int64 {
        var dir: ObjCBool = false
        guard FileManager.default.fileExists(atPath: u.path, isDirectory: &dir) else { return 0 }
        if dir.boolValue { return Cleaner.sizeOf(u, limit: 20_000).bytes }
        return Int64((try? u.resourceValues(forKeys: [.totalFileAllocatedSizeKey]))?
                        .totalFileAllocatedSize ?? 0)
    }

    static func downloads(limit: Int = 40) -> [ClutterFile] {
        let fm = FileManager.default
        guard let dl = fm.urls(for: .downloadsDirectory, in: .userDomainMask).first,
              let items = try? fm.contentsOfDirectory(
                at: dl, includingPropertiesForKeys: [.contentAccessDateKey, .contentModificationDateKey],
                options: [.skipsHiddenFiles]) else { return [] }
        let now = Date()
        var out: [ClutterFile] = []
        let suspects = Dictionary(MailGuard.scanDownloads().map { ($0.url.path, $0.reason) },
                                  uniquingKeysWith: { a, _ in a })
        for u in items {
            let v = try? u.resourceValues(forKeys: [.contentAccessDateKey, .contentModificationDateKey])
            let touched = max(v?.contentAccessDate ?? .distantPast, v?.contentModificationDate ?? .distantPast)
            let age = now.timeIntervalSince(touched) / day
            let ext = u.pathExtension.lowercased()

            if let why = suspects[u.path] {
                out.append(ClutterFile(url: u, reason: "Suspect : \(why)", bytes: size(u), preselect: false))
            } else if ["dmg", "pkg", "mpkg"].contains(ext), age > 7 {
                out.append(ClutterFile(url: u, reason: "Installeur, ouvert il y a \(Int(age)) j",
                                       bytes: size(u), preselect: true))
            } else if age > 90 {
                let b = size(u)
                // Les petits fichiers anciens ne valent pas une ligne : la
                // fiche serait longue, et le gain nul.
                if b > 50_000_000 {
                    out.append(ClutterFile(url: u, reason: "Pas ouvert depuis \(Int(age)) j",
                                           bytes: b, preselect: false))
                }
            }
            if out.count >= limit { break }
        }
        return out.sorted { $0.bytes > $1.bytes }
    }

    /// Applications non ouvertes depuis `days` jours.
    ///
    /// Exclues d'office : celles d'Apple, celles du système, celles qui
    /// tournent en ce moment, et BUD lui-même. La date d'usage vient de
    /// Spotlight ; sans elle, on prend la date d'accès du paquet, et sans
    /// aucune des deux, on ne propose rien — on ne désinstalle pas sur
    /// une supposition.
    static func dormantApps(excluding running: Set<String>, days: Double = 120) -> [DormantApp] {
        let fm = FileManager.default
        let home = fm.homeDirectoryForCurrentUser
        let roots = [URL(fileURLWithPath: "/Applications"), home.appendingPathComponent("Applications")]
        let lib = home.appendingPathComponent("Library")
        let now = Date()
        var out: [DormantApp] = []

        for root in roots {
            guard let items = try? fm.contentsOfDirectory(at: root, includingPropertiesForKeys: nil,
                                                          options: [.skipsHiddenFiles]) else { continue }
            for u in items where u.pathExtension == "app" {
                let path = u.standardizedFileURL.path
                if running.contains(path) || path.hasPrefix("/System/") { continue }
                guard let b = Bundle(url: u), let id = b.bundleIdentifier,
                      !id.hasPrefix("com.apple.") else { continue }

                var last = NSMetadataItem(url: u)?.value(forAttribute: "kMDItemLastUsedDate") as? Date
                if last == nil {
                    last = (try? u.resourceValues(forKeys: [.contentAccessDateKey]))?.contentAccessDate
                }
                guard let used = last, now.timeIntervalSince(used) / day > days else { continue }

                let name = (b.object(forInfoDictionaryKey: "CFBundleName") as? String)
                    ?? u.deletingPathExtension().lastPathComponent
                let candidates = [
                    lib.appendingPathComponent("Application Support/\(name)"),
                    lib.appendingPathComponent("Application Support/\(id)"),
                    lib.appendingPathComponent("Caches/\(id)"),
                    lib.appendingPathComponent("Preferences/\(id).plist"),
                    lib.appendingPathComponent("Saved Application State/\(id).savedState")
                ]
                let left = candidates.filter { fm.fileExists(atPath: $0.path) }
                let mas = fm.fileExists(atPath: u.appendingPathComponent("Contents/_MASReceipt").path)
                out.append(DormantApp(url: u, name: name, bundleID: id, lastUsed: used,
                                      bytes: size(u), fromAppStore: mas, leftovers: left))
            }
        }
        return out.sorted { $0.bytes > $1.bytes }
    }

    /// Met à la corbeille, jamais à la destruction : une erreur doit rester
    /// réparable depuis le Finder.
    static func trash(_ items: [ApprovalItem]) -> (freed: Int64, ok: Int, failed: Int) {
        var freed: Int64 = 0, ok = 0, failed = 0
        for it in items {
            guard let u = it.url else { continue }
            if (try? FileManager.default.trashItem(at: u, resultingItemURL: nil)) != nil {
                freed += it.bytes; ok += 1
            } else {
                failed += 1
            }
        }
        return (freed, ok, failed)
    }
}

final class CleanupAgent: BudAgent {
    let id = "cleanup"
    let name = "Nettoyage & Rangement"
    let summary = "Téléchargements oubliés, installeurs, applications dormantes. Rien ne part sans votre accord."
    let icon = "sparkles"
    var tint: NSColor { tintCleanup }
    let sources = [
        FlowSource(id: "downloads", title: "Téléchargements", icon: "arrow.down.circle.fill",
                   tint: NSColor(calibratedRed: 0.42, green: 0.66, blue: 1.00, alpha: 1),
                   note: "Noms, tailles et dates du dossier, lus sur place. Le contenu n'est pas ouvert."),
        FlowSource(id: "apps", title: "Applications", icon: "square.grid.2x2.fill",
                   tint: NSColor(calibratedRed: 0.74, green: 0.52, blue: 1.00, alpha: 1),
                   note: "Date de dernier usage selon Spotlight. Apps d'Apple et apps ouvertes exclues.")
    ]

    func run(_ ctx: AgentContext, done: @escaping (AgentResult) -> Void) {
        // Lu sur le fil principal : la liste des applications ouvertes.
        var running = Set(NSWorkspace.shared.runningApplications
                            .compactMap { $0.bundleURL?.standardizedFileURL.path })
        running.insert(Bundle.main.bundleURL.standardizedFileURL.path)
        DispatchQueue.global(qos: .utility).async {
            ctx.progress("Lecture des téléchargements…")
            let files = CleanupScan.downloads()
            if ctx.cancelled { return done(Self.empty) }
            ctx.progress("Applications dormantes…")
            let apps = CleanupScan.dormantApps(excluding: running)
            done(Self.result(files: files, apps: apps, simulated: false))
        }
    }

    func simulate(_ ctx: AgentContext, done: @escaping (AgentResult) -> Void) {
        ctx.progress("Lecture des téléchargements…")
        DispatchQueue.main.asyncAfter(deadline: .now() + 1.2) {
            ctx.progress("Applications dormantes…")
            DispatchQueue.main.asyncAfter(deadline: .now() + 1.2) {
                done(Self.result(files: BudFlowSamples.clutter, apps: BudFlowSamples.dormant, simulated: true))
            }
        }
    }

    private static let empty = AgentResult(status: .idle, expression: .neutral, headline: "Interrompu.")

    static func result(files: [ClutterFile], apps: [DormantApp], simulated: Bool) -> AgentResult {
        let fileBytes = files.reduce(Int64(0)) { $0 + $1.bytes }
        let appBytes = apps.reduce(Int64(0)) { $0 + $1.bytes }
        let suspects = files.filter { $0.reason.hasPrefix("Suspect") }.count

        var cards = [
            BudCard(icon: "arrow.down.circle.fill", title: "TÉLÉCHARGEMENTS",
                    value: files.isEmpty ? "Rangés" : formatBytes(fileBytes),
                    detail: "\(files.count) élément\(files.count > 1 ? "s" : "") à revoir",
                    tint: NSColor(calibratedRed: 0.42, green: 0.66, blue: 1.00, alpha: 1)),
            BudCard(icon: "square.grid.2x2.fill", title: "APPS DORMANTES",
                    value: apps.isEmpty ? "Aucune" : "\(apps.count)",
                    detail: apps.isEmpty ? "Tout sert" : "\(formatBytes(appBytes)) · 120 j sans usage",
                    tint: NSColor(calibratedRed: 0.74, green: 0.52, blue: 1.00, alpha: 1))
        ]
        if suspects > 0 {
            cards.append(BudCard(icon: "exclamationmark.shield.fill", title: "SUSPECTS",
                                 value: "\(suspects)", detail: "Dans les téléchargements",
                                 tint: dangerColor))
        }

        guard !files.isEmpty || !apps.isEmpty else {
            return AgentResult(status: .success, expression: .happy,
                               headline: "Rien à ranger : tout est propre.", cards: cards)
        }

        // La fiche. Les installeurs anciens sont cochés ; tout le reste —
        // fichiers, applications, restes — attend votre coche.
        var items: [ApprovalItem] = files.map {
            ApprovalItem(id: $0.url.path, label: $0.url.lastPathComponent, detail: $0.reason,
                         icon: $0.reason.hasPrefix("Suspect") ? "exclamationmark.shield.fill" : "doc.fill",
                         bytes: $0.bytes, selected: $0.preselect, url: $0.url)
        }
        let df = DateFormatter()
        df.locale = Locale(identifier: "fr_FR")
        df.dateFormat = "d MMM yyyy"
        for a in apps {
            let used = a.lastUsed.map { "ouverte le \(df.string(from: $0))" } ?? "jamais ouverte"
            items.append(ApprovalItem(id: a.url.path, label: a.name,
                                      detail: "Application, \(used)" + (a.fromAppStore ? " · réinstallable depuis l'App Store" : ""),
                                      icon: "app.fill", bytes: a.bytes, selected: false, url: a.url))
            for l in a.leftovers {
                items.append(ApprovalItem(id: l.path, label: "Restes de \(a.name)",
                                          detail: "~/Library/" + l.pathComponents.suffix(2).joined(separator: "/"),
                                          icon: "folder.fill", bytes: simulated ? 0 : CleanupScan.size(l),
                                          selected: false, url: l))
            }
        }

        let total = fileBytes + appBytes
        let req = ApprovalRequest(
            title: "Mettre à la corbeille ?",
            message: simulated
                ? "Simulation : aucun fichier réel n'est concerné. Cochez, validez, et regardez BUDs réagir."
                : "Tout part à la corbeille, d'où vous pouvez le récupérer. Les applications ouvertes et celles d'Apple ne sont jamais proposées.",
            items: items,
            confirmLabel: "Mettre à la corbeille",
            destructive: true,
            perform: { chosen, finish in
                if simulated {
                    let b = chosen.reduce(Int64(0)) { $0 + $1.bytes }
                    DispatchQueue.main.asyncAfter(deadline: .now() + 1.4) {
                        finish(AgentResult(status: .success, expression: .happy,
                                           headline: "Simulation : \(chosen.count) élément\(chosen.count > 1 ? "s" : ""), \(formatBytes(b)) — rien n'a été touché."))
                    }
                    return
                }
                DispatchQueue.global(qos: .userInitiated).async {
                    let r = CleanupScan.trash(chosen)
                    let expr: BudExpression = r.failed == 0 ? .happy : (r.ok == 0 ? .sad : .dizzy)
                    let status: NodeStatus = r.failed == 0 ? .success : (r.ok == 0 ? .failure : .warning)
                    var line = "\(r.ok) à la corbeille, \(formatBytes(r.freed)) libérés."
                    if r.failed > 0 {
                        line += " \(r.failed) refusé\(r.failed > 1 ? "s" : "") par macOS (droits ou app protégée)."
                    }
                    finish(AgentResult(status: status, expression: expr, headline: line))
                }
            })

        // Plus de cinq gigaoctets de désordre : BUDs en a la tête qui tourne.
        let expr: BudExpression = total > 5_000_000_000 ? .dizzy : .reflection
        return AgentResult(status: .needsApproval, expression: expr,
                           headline: "\(items.count) élément\(items.count > 1 ? "s" : "") à examiner, \(formatBytes(total)) récupérables.",
                           cards: cards, approval: req, hold: 5)
    }
}

// ═══════════════════════════════════════════════════════════
//  2. Cybersécurité — liens, domaines, courrier
// ═══════════════════════════════════════════════════════════

/// L'analyse d'un lien, entièrement locale. Les règles complètent celles
/// du courrier (`MailGuard`) et en reprennent le vocabulaire : marques
/// usurpées, raccourcisseurs, écritures mélangées.
enum LinkGuard {
    static let riskyTLDs: Set<String> = [
        "zip", "mov", "xyz", "top", "click", "country", "gq", "tk", "ml", "cf", "ga",
        "work", "support", "rest", "cam", "icu", "sbs", "buzz", "monster", "cfd"
    ]
    static let lureWords = ["login", "signin", "verify", "verif", "secure", "update", "account",
                            "compte", "connexion", "identifiant", "paiement", "facture", "colis",
                            "douane", "remboursement", "banque", "suspendu"]

    static func analyze(_ url: String) -> MailThreat {
        var t = MailThreat()
        let lower = url.lowercased()
        let host = MailGuard.host(ofURL: url)
        guard !host.isEmpty else { return t }

        if lower.hasPrefix("http://") { t.add(15, "connexion non chiffrée (http)") }
        let afterScheme = lower.components(separatedBy: "://").dropFirst().first ?? lower
        let authority = afterScheme.split(separator: "/").first.map(String.init) ?? afterScheme
        if authority.contains("@") { t.add(40, "adresse déguisée par un « @ »") }
        if host.range(of: "^[0-9.]+$", options: .regularExpression) != nil {
            t.add(35, "adresse IP au lieu d'un nom")
        }
        if host.contains("xn--") { t.add(35, "nom de domaine en punycode") }
        if MailGuard.hasMixedScript(host) { t.add(50, "lettres cyrilliques ou grecques mêlées") }
        if MailGuard.shorteners.contains(host) { t.add(20, "lien raccourci : destination cachée") }

        let parts = host.split(separator: ".")
        if let tld = parts.last, riskyTLDs.contains(String(tld)) {
            t.add(20, "extension « .\(tld) » très prisée des fraudeurs")
        }
        if parts.count >= 5 { t.add(15, "nombreux sous-domaines") }
        if host.filter({ $0 == "-" }).count >= 3 { t.add(10, "nom fait de mots accolés") }

        // Les marques : le nom apparaît dans l'adresse, mais l'adresse
        // n'est pas la sienne. On teste aussi la version « déchiffrée » —
        // paypa1 → paypal, micros0ft → microsoft.
        let swaps: [Character: Character] = ["0": "o", "1": "l", "3": "e", "5": "s", "4": "a"]
        let decodedHost = String(host.replacingOccurrences(of: "rn", with: "m").map { swaps[$0] ?? $0 })
        // Un nom court — « ups », « sfr », « free » — n'est cherché que comme
        // mot entier de l'adresse : « groups » n'imite pas UPS.
        func mentions(_ h: String, _ token: String) -> Bool {
            if token.count >= 5 { return h.contains(token) }
            return h.split(whereSeparator: { $0 == "." || $0 == "-" }).contains { String($0) == token }
        }
        for b in MailGuard.brands {
            let token = MailGuard.fold(b.name).replacingOccurrences(of: " ", with: "")
            guard token.count >= 3 else { continue }
            if b.domains.contains(where: { MailGuard.domain(host, isOrSub: $0) }) { break }
            if mentions(host, token) {
                t.add(45, "imite \(b.name.capitalized) sans en être")
                break
            }
            if mentions(decodedHost, token) {
                t.add(55, "sosie de \(b.name.capitalized) (chiffres à la place des lettres)")
                break
            }
        }

        if t.score > 0, lureWords.contains(where: { lower.contains($0) }) {
            t.add(10, "vocabulaire d'identification ou de paiement")
        }
        if url.count > 160 { t.add(5, "adresse anormalement longue") }
        return t
    }
}

/// Le complément en ligne, facultatif : Google Safe Browsing, API
/// Lookup v4, gratuite pour un usage non commercial. Sans clé, rien ne
/// part. Avec une clé — rangée dans le trousseau, jamais sur disque —
/// seules les adresses des liens sont envoyées, pas le courrier.
enum SafeBrowsing {
    static let account = "safebrowsing-key"
    static var key: String? {
        guard let k = BudKeychain.get(account), !k.isEmpty else { return nil }
        return k
    }

    /// Rend l'ensemble des liens signalés, ou `nil` si la question n'a pas
    /// pu être posée — ce qui n'est pas la même chose que « aucun ».
    static func check(_ urls: [String], done: @escaping (Set<String>?) -> Void) {
        guard let k = key, !urls.isEmpty,
              var c = URLComponents(string: "https://safebrowsing.googleapis.com/v4/threatMatches:find")
        else { done(nil); return }
        c.queryItems = [URLQueryItem(name: "key", value: k)]
        guard let url = c.url else { done(nil); return }
        let body: [String: Any] = [
            "client": ["clientId": "bud-premium", "clientVersion": budVersion],
            "threatInfo": [
                "threatTypes": ["MALWARE", "SOCIAL_ENGINEERING", "UNWANTED_SOFTWARE",
                                "POTENTIALLY_HARMFUL_APPLICATION"],
                "platformTypes": ["ANY_PLATFORM"],
                "threatEntryTypes": ["URL"],
                "threatEntries": urls.prefix(100).map { ["url": $0] }
            ]
        ]
        var req = URLRequest(url: url, timeoutInterval: 10)
        req.httpMethod = "POST"
        req.setValue("application/json", forHTTPHeaderField: "Content-Type")
        req.httpBody = try? JSONSerialization.data(withJSONObject: body)
        URLSession.shared.dataTask(with: req) { data, resp, _ in
            guard (resp as? HTTPURLResponse)?.statusCode == 200, let data = data,
                  let o = try? JSONSerialization.jsonObject(with: data) as? [String: Any]
            else { done(nil); return }
            let hits = (o["matches"] as? [[String: Any]] ?? []).compactMap {
                ($0["threat"] as? [String: Any])?["url"] as? String
            }
            done(Set(hits))
        }.resume()
    }
}

final class SecurityAgent: BudAgent {
    let id = "security"
    let name = "Cybersécurité"
    let summary = "Liens, domaines et courrier : hameçonnage, sosies de marques, adresses truquées."
    let icon = "lock.shield.fill"
    var tint: NSColor { tintSecurity }
    let sources = [
        FlowSource(id: "mail", title: "Courrier", icon: "envelope.fill",
                   tint: NSColor(calibratedRed: 0.42, green: 0.66, blue: 1.00, alpha: 1),
                   note: "Les trente derniers messages déjà relevés par BUD. Analyse sur place."),
        FlowSource(id: "clipboard", title: "Presse-papiers", icon: "doc.on.clipboard.fill",
                   tint: NSColor(calibratedRed: 1.00, green: 0.70, blue: 0.30, alpha: 1),
                   note: "Lu seulement au lancement de l'agent, jamais en continu.")
    ]

    private let mail: () -> [MailMessage]
    /// Un lien tapé dans l'inspecteur : analysé en plus, puis oublié.
    var input: String?

    init(mail: @escaping () -> [MailMessage]) { self.mail = mail }

    func run(_ ctx: AgentContext, done: @escaping (AgentResult) -> Void) {
        let clip = NSPasteboard.general.string(forType: .string) ?? ""
        let typed = input ?? ""
        input = nil
        let messages = mail()
        DispatchQueue.global(qos: .userInitiated).async {
            ctx.progress("Analyse locale…")
            var links = MailGuard.urls(in: typed + "\n" + clip)
            // Un domaine nu, tapé sans « https:// », est un lien aussi.
            let bare = typed.trimmingCharacters(in: .whitespacesAndNewlines)
            if links.isEmpty, !bare.isEmpty, !bare.contains(" "), bare.contains(".") {
                links.append("https://" + bare)
            }
            for m in messages.prefix(30) { links += MailGuard.urls(in: m.snippet) }
            var seen = Set<String>()
            links = links.filter { seen.insert($0).inserted }
            let mails = messages.prefix(30).map { ($0, MailGuard.analyze($0)) }
            let base = links.map { ($0, LinkGuard.analyze($0)) }

            guard SafeBrowsing.key != nil, !links.isEmpty else {
                done(Self.result(links: base, mails: Array(mails), online: nil))
                return
            }
            ctx.progress("Vérification Safe Browsing…")
            SafeBrowsing.check(links) { hits in
                let merged = base.map { (u, t) -> (String, MailThreat) in
                    var t = t
                    if hits?.contains(u) == true { t.add(80, "signalé par Google Safe Browsing") }
                    return (u, t)
                }
                done(Self.result(links: merged, mails: Array(mails), online: hits != nil))
            }
        }
    }

    func simulate(_ ctx: AgentContext, done: @escaping (AgentResult) -> Void) {
        ctx.progress("Analyse locale…")
        DispatchQueue.main.asyncAfter(deadline: .now() + 1.6) {
            // Les vraies règles, sur de faux liens : la simulation éprouve
            // l'analyse autant que l'affichage.
            let links = BudFlowSamples.links.map { ($0, LinkGuard.analyze($0)) }
            let mails = BudFlowSamples.mails.map { ($0, MailGuard.analyze($0)) }
            done(Self.result(links: links, mails: mails, online: nil))
        }
    }

    static func result(links: [(String, MailThreat)], mails: [(MailMessage, MailThreat)],
                       online: Bool?) -> AgentResult {
        guard !links.isEmpty || !mails.isEmpty else {
            return AgentResult(status: .idle, expression: .neutral,
                               headline: "Rien à analyser : copiez un lien ou tapez-le ici.",
                               cards: [BudCard(icon: "link", title: "LIENS", value: "0",
                                               detail: "Presse-papiers vide", tint: tintSecurity)])
        }
        let worstLinks = links.sorted { $0.1.score > $1.1.score }
        let dangerous = links.filter { $0.1.level == .dangerous }.count
            + mails.filter { $0.1.level == .dangerous }.count
        let suspect = links.filter { $0.1.level == .suspect }.count
            + mails.filter { $0.1.level == .suspect }.count
        let worst: ThreatLevel = dangerous > 0 ? .dangerous : (suspect > 0 ? .suspect : .clean)

        var cards: [BudCard] = [
            BudCard(icon: worst.icon, title: "NIVEAU DE RISQUE", value: worst.label,
                    detail: "\(links.count) lien\(links.count > 1 ? "s" : ""), \(mails.count) message\(mails.count > 1 ? "s" : "")",
                    tint: worst.color)
        ]
        for (u, t) in worstLinks.prefix(2) where t.level != .clean {
            cards.append(BudCard(icon: t.level.icon, title: MailGuard.host(ofURL: u).uppercased(),
                                 value: "\(min(100, t.score))/100",
                                 detail: t.reasons.first ?? "", tint: t.level.color))
        }
        if let top = mails.sorted(by: { $0.1.score > $1.1.score }).first, top.1.level != .clean {
            cards.append(BudCard(icon: "envelope.badge.fill", title: "COURRIER",
                                 value: top.1.level.label,
                                 detail: top.0.shortSender + " · " + (top.1.reasons.first ?? ""),
                                 tint: top.1.level.color))
        }
        if let o = online {
            cards.append(BudCard(icon: "globe", title: "SAFE BROWSING",
                                 value: o ? "Consulté" : "Injoignable",
                                 detail: o ? "Liens seulement" : "Analyse locale seule",
                                 tint: tintSky))
        }

        switch worst {
        case .dangerous:
            return AgentResult(status: .warning, expression: .annoyed,
                               headline: "\(dangerous) élément\(dangerous > 1 ? "s" : "") dangereux. N'ouvrez pas ces liens.",
                               cards: cards, hold: 6)
        case .suspect:
            return AgentResult(status: .warning, expression: .reflection,
                               headline: "\(suspect) élément\(suspect > 1 ? "s" : "") suspect\(suspect > 1 ? "s" : "") : prudence.",
                               cards: cards, hold: 5)
        case .clean:
            return AgentResult(status: .success, expression: .happy,
                               headline: "Rien de suspect dans \(links.count + mails.count) élément\(links.count + mails.count > 1 ? "s" : "").",
                               cards: cards)
        }
    }
}

// ═══════════════════════════════════════════════════════════
//  3. Météo & Maison
//
//  Il ne refait ni la météo ni la maison : il lit le service
//  météo et les raccourcis déjà chargés, et les rend en cartes.
//  Rien de plus à télécharger, rien de plus à garder en
//  mémoire.
// ═══════════════════════════════════════════════════════════

final class WeatherHomeAgent: BudAgent {
    let id = "weatherhome"
    let name = "Météo & Maison"
    let summary = "Le ciel du moment, et vos commandes de chauffage, de lumières et de caméra."
    let icon = "cloud.sun.fill"
    var tint: NSColor { tintSky }
    let sources = [
        FlowSource(id: "sky", title: "Open-Meteo", icon: "cloud.sun.fill", tint: tintSky,
                   note: "Seules les coordonnées de la ville partent, arrondies au kilomètre."),
        FlowSource(id: "home", title: "Raccourcis", icon: "house.fill",
                   tint: NSColor(calibratedRed: 1.00, green: 0.62, blue: 0.25, alpha: 1),
                   note: "Les raccourcis de votre dossier Maison. BUD ne voit pas vos appareils.")
    ]

    private let city: () -> String
    private let runHome: (String, @escaping (Bool, String) -> Void) -> Void

    init(city: @escaping () -> String, runHome: @escaping (String, @escaping (Bool, String) -> Void) -> Void) {
        self.city = city
        self.runHome = runHome
    }

    func run(_ ctx: AgentContext, done: @escaping (AgentResult) -> Void) {
        let w = WeatherService.shared
        if let r = w.report, Date().timeIntervalSince(r.fetchedAt) < 35 * 60 {
            done(build(r, scenes: HomeShortcuts.shared.scenes.map { $0.name }, simulated: false))
            return
        }
        ctx.progress("Relevé du ciel…")
        let before = w.report?.fetchedAt
        w.refresh(city: city(), force: true)
        var tries = 0
        Timer.scheduledTimer(withTimeInterval: 0.5, repeats: true) { [weak self] tm in
            tries += 1
            guard let s = self else { tm.invalidate(); return }
            if w.report?.fetchedAt != before || !w.trouble.isEmpty || tries > 30 || ctx.cancelled {
                tm.invalidate()
                done(s.build(w.report, scenes: HomeShortcuts.shared.scenes.map { $0.name }, simulated: false))
            }
        }
    }

    func simulate(_ ctx: AgentContext, done: @escaping (AgentResult) -> Void) {
        ctx.progress("Relevé du ciel…")
        DispatchQueue.main.asyncAfter(deadline: .now() + 1.2) { [weak self] in
            guard let s = self else { return }
            done(s.build(BudFlowSamples.weather, scenes: BudFlowSamples.homeScenes, simulated: true))
        }
    }

    /// Les trois familles de commandes et les mots qui les désignent.
    private static let controls: [(title: String, icon: String, keys: [String], tint: NSColor, fallback: String)] = [
        ("CHAUFFAGE", "thermometer", ["chauffage", "thermostat", "radiateur", "clim"],
         NSColor(calibratedRed: 1.00, green: 0.45, blue: 0.30, alpha: 1), "com.apple.shortcuts"),
        ("LUMIÈRES", "lightbulb.fill", ["lumiere", "lampe", "eclairage", "ampoule", "led"],
         NSColor(calibratedRed: 1.00, green: 0.80, blue: 0.26, alpha: 1), "com.apple.shortcuts"),
        ("CAMÉRA", "video.fill", ["camera", "alarme", "securite"],
         NSColor(calibratedRed: 0.95, green: 0.40, blue: 0.45, alpha: 1), "com.apple.Home")
    ]

    private func build(_ r: WeatherReport?, scenes: [String], simulated: Bool) -> AgentResult {
        var cards: [BudCard] = []
        let expr: BudExpression
        let headline: String

        if let r = r {
            let c = r.condition
            var detail = c.label
            if let d = r.days.first { detail += " · \(Int(d.tmin.rounded()))° / \(Int(d.tmax.rounded()))°" }
            cards.append(BudCard(style: .weather, icon: c.symbol, title: r.place.name.uppercased(),
                                 value: "\(Int(r.temp.rounded()))°", detail: detail, tint: tintSky,
                                 weatherCode: r.code, isDay: r.isDay))
            switch c.scene {
            case .clear:                  expr = .cool
            case .partly, .cloudy:        expr = .happy
            case .fog:                    expr = .reflection
            case .drizzle, .rain, .snow:  expr = .sad
            case .storm:                  expr = .dizzy
            }
            headline = "\(r.place.name) : \(Int(r.temp.rounded()))°, \(c.label.lowercased())."
        } else {
            expr = .sad
            headline = WeatherService.shared.trouble.isEmpty ? "Météo indisponible." : WeatherService.shared.trouble
            cards.append(BudCard(icon: "cloud.fill", title: "MÉTÉO", value: "—", detail: headline, tint: tintSky))
        }

        for k in Self.controls {
            let matches = scenes.filter { n in
                let f = MailGuard.fold(n)
                return k.keys.contains { f.contains($0) }
            }
            let runHome = self.runHome
            if let first = matches.first {
                cards.append(BudCard(style: .control, icon: k.icon, title: k.title,
                                     value: matches.count == 1 ? first : "\(matches.count) commandes",
                                     detail: simulated ? "Simulation" : "Toucher : « \(first) »",
                                     tint: k.tint,
                                     action: { finish in
                                        if simulated {
                                            DispatchQueue.main.asyncAfter(deadline: .now() + 0.9) {
                                                finish(true, "Simulation : « \(first) » lancé.")
                                            }
                                        } else {
                                            runHome(first, finish)
                                        }
                                     }))
            } else {
                let bundle = k.fallback
                cards.append(BudCard(style: .control, icon: k.icon, title: k.title, value: "À configurer",
                                     detail: bundle == "com.apple.Home" ? "Ouvrir Maison" : "Ajouter un raccourci",
                                     tint: k.tint.withAlphaComponent(0.55),
                                     action: { finish in
                                        if let u = NSWorkspace.shared.urlForApplication(withBundleIdentifier: bundle) {
                                            NSWorkspace.shared.openApplication(at: u, configuration: NSWorkspace.OpenConfiguration(),
                                                                               completionHandler: nil)
                                            finish(true, "Ouvert.")
                                        } else {
                                            finish(false, "Application introuvable.")
                                        }
                                     }))
            }
        }
        return AgentResult(status: r == nil ? .failure : .success, expression: expr,
                           headline: headline, cards: cards)
    }
}
