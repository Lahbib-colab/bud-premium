cat << 'EOF_BUDFLOWVIEW_SWIFT' > "$SRC_DIR/BudFlowView.swift"
import Cocoa

// ═══════════════════════════════════════════════════════════
//  La vue du Flux
//
//  En haut, le graphe : trois colonnes de nœuds sur une trame
//  de points, comme le plan de travail de n8n. Les liens sont
//  des courbes de Bézier qui partent horizontalement d'un port
//  et arrivent horizontalement sur le suivant ; quand un agent
//  travaille, ses liens s'animent — des tirets qui avancent et
//  une perle qui circule — dans sa couleur.
//
//  En bas, l'inspecteur du nœud choisi : ce qu'il fait, son
//  état, ses boutons, et les cartes de son dernier résultat,
//  compactes, à la manière des widgets iOS.
//
//  Par-dessus, quand il le faut, la fiche d'approbation.
//
//  Le graphe n'a aucune connaissance des agents : il lit le
//  registre. Un quatrième agent y apparaîtra avec ses sources
//  et ses liens sans qu'on touche à ce fichier.
// ═══════════════════════════════════════════════════════════

extension BudExpression {
    /// La teinte du halo du nœud BUDs pour chaque expression.
    var color: NSColor {
        switch self {
        case .neutral:    return NSColor(calibratedWhite: 0.70, alpha: 1)
        case .happy:      return NSColor(calibratedRed: 0.30, green: 0.82, blue: 0.55, alpha: 1)
        case .reflection: return NSColor(calibratedRed: 0.72, green: 0.52, blue: 1.00, alpha: 1)
        case .annoyed:    return NSColor(calibratedRed: 1.00, green: 0.42, blue: 0.40, alpha: 1)
        case .dizzy:      return NSColor(calibratedRed: 1.00, green: 0.66, blue: 0.25, alpha: 1)
        case .cool:       return NSColor(calibratedRed: 0.40, green: 0.78, blue: 1.00, alpha: 1)
        case .sad:        return NSColor(calibratedRed: 0.55, green: 0.62, blue: 0.80, alpha: 1)
        case .working:    return NSColor(calibratedRed: 0.38, green: 0.66, blue: 1.00, alpha: 1)
        }
    }
}

// ═══════════════════════════════════════════════════════════
//  Le graphe
// ═══════════════════════════════════════════════════════════

final class FlowCanvasView: NSView {

    enum Selection: Equatable { case agent(String), source(String), bud }

    var selection: Selection? { didSet { needsDisplay = true } }
    var onSelect: ((Selection) -> Void)?
    var onRun: ((String) -> Void)?

    /// Un BUDs à part entière, en miniature, dans le nœud de sortie.
    let sprite = BudSprite()
    var expression: BudExpression = .neutral { didSet { needsDisplay = true } }

    private var timer: Timer?
    private var t: CGFloat = 0
    private var hover: Selection?

    private var sourceRects: [(FlowSource, NSRect)] = []
    private var agentRects: [(BudAgent, NSRect)] = []
    private var budRect: NSRect = .zero

    // Les mesures du graphe. Les colonnes extrêmes sont fixes, celle des
    // agents prend le reste.
    private let pad: CGFloat = 14, gap: CGFloat = 54
    private let srcW: CGFloat = 140, budW: CGFloat = 138
    private let srcH: CGFloat = 30, srcGap: CGFloat = 8
    private let agentH: CGFloat = 64, agentGap: CGFloat = 14

    override init(frame: NSRect) {
        super.init(frame: frame)
        wantsLayer = true
    }
    required init?(coder: NSCoder) { fatalError() }

    /// La hauteur qu'il faut pour tout montrer : la vue grandit dans son
    /// défilement quand les agents se multiplient.
    func neededHeight() -> CGFloat {
        let m = BudAgentManager.shared
        let s = CGFloat(m.sources.count) * (srcH + srcGap)
        let a = CGFloat(m.agents.count) * (agentH + agentGap)
        return max(s, a, 190) + pad * 2
    }

    private func layoutNodes() {
        let m = BudAgentManager.shared
        let b = bounds
        let agentW = b.width - pad * 2 - srcW - budW - gap * 2
        let srcX = pad, agentX = pad + srcW + gap, budX = agentX + agentW + gap

        let srcs = m.sources
        let sTotal = CGFloat(srcs.count) * srcH + CGFloat(max(0, srcs.count - 1)) * srcGap
        var y = b.midY + sTotal / 2 - srcH
        sourceRects = srcs.map { s in
            defer { y -= srcH + srcGap }
            return (s, NSRect(x: srcX, y: y, width: srcW, height: srcH))
        }

        let ags = m.agents
        let aTotal = CGFloat(ags.count) * agentH + CGFloat(max(0, ags.count - 1)) * agentGap
        y = b.midY + aTotal / 2 - agentH
        agentRects = ags.map { a in
            defer { y -= agentH + agentGap }
            return (a, NSRect(x: agentX, y: y, width: agentW, height: agentH))
        }

        let bh = min(b.height - pad * 2, 176)
        budRect = NSRect(x: budX, y: b.midY - bh / 2, width: budW, height: bh)
    }

    // ── L'horloge : seulement quand on regarde ──

    override func viewDidMoveToWindow() { super.viewDidMoveToWindow(); updateClock() }
    override func viewDidHide() { super.viewDidHide(); updateClock() }
    override func viewDidUnhide() { super.viewDidUnhide(); updateClock() }

    func updateClock() {
        let visible = window != nil && !isHiddenOrHasHiddenAncestor
        if visible && timer == nil {
            let tm = Timer(timeInterval: 1.0 / 30.0, repeats: true) { [weak self] _ in self?.tick() }
            RunLoop.main.add(tm, forMode: .common)
            timer = tm
        } else if !visible {
            timer?.invalidate()
            timer = nil
        }
    }

    private func tick() {
        guard !isHiddenOrHasHiddenAncestor else { updateClock(); return }
        guard window?.isVisible == true, window?.occlusionState.contains(.visible) == true else { return }
        t += 1.0 / 30.0
        _ = sprite.step(follow: false, in: self, anchor: NSPoint(x: budRect.midX, y: budRect.midY))
        needsDisplay = true
    }

    // ── Souris ──

    override func updateTrackingAreas() {
        super.updateTrackingAreas()
        trackingAreas.forEach { removeTrackingArea($0) }
        addTrackingArea(NSTrackingArea(rect: bounds,
                                       options: [.mouseMoved, .mouseEnteredAndExited, .activeAlways, .inVisibleRect],
                                       owner: self, userInfo: nil))
    }

    private func hit(_ p: NSPoint) -> Selection? {
        if let a = agentRects.first(where: { $0.1.contains(p) }) { return .agent(a.0.id) }
        if let s = sourceRects.first(where: { $0.1.contains(p) }) { return .source(s.0.id) }
        if budRect.contains(p) { return .bud }
        return nil
    }

    override func mouseMoved(with e: NSEvent) {
        let h = hit(convert(e.locationInWindow, from: nil))
        if h != hover { hover = h; needsDisplay = true }
        if h != nil { NSCursor.pointingHand.set() } else { NSCursor.arrow.set() }
    }
    override func mouseExited(with e: NSEvent) { hover = nil; NSCursor.arrow.set(); needsDisplay = true }

    override func mouseDown(with e: NSEvent) {
        guard let h = hit(convert(e.locationInWindow, from: nil)) else { return }
        selection = h
        onSelect?(h)
        // Un double clic sur un agent le lance, comme « Execute node ».
        if e.clickCount == 2, case .agent(let id) = h { onRun?(id) }
    }

    // ═════════════ Le dessin ═════════════

    override func draw(_ dirty: NSRect) {
        layoutNodes()
        drawGrid()
        let m = BudAgentManager.shared

        // Les liens d'abord : les nœuds se posent dessus.
        for (a, ar) in agentRects {
            let st = m.state(a.id)
            let running = st.status == .running
            for s in a.sources {
                guard let sr = sourceRects.first(where: { $0.0.id == s.id })?.1 else { continue }
                edge(from: NSPoint(x: sr.maxX, y: sr.midY), to: NSPoint(x: ar.minX, y: ar.midY),
                     color: running ? a.tint : s.tint, active: running,
                     lit: isSelected(.agent(a.id)) || isSelected(.source(s.id)))
            }
            let outColor = st.status == .idle ? TH.fill(0.5) : st.status.color
            edge(from: NSPoint(x: ar.maxX, y: ar.midY), to: NSPoint(x: budRect.minX, y: budRect.midY),
                 color: running ? a.tint : outColor, active: running,
                 lit: isSelected(.agent(a.id)) || isSelected(.bud))
        }

        for (s, r) in sourceRects { drawSource(s, r) }
        for (a, r) in agentRects { drawAgent(a, r, m.state(a.id)) }
        drawBud(budRect)
    }

    private func isSelected(_ s: Selection) -> Bool { selection == s }

    /// La trame de points du plan de travail.
    private func drawGrid() {
        TH.fill(0.07).setFill()
        let step: CGFloat = 18
        var x = bounds.minX + 9
        while x < bounds.maxX {
            var y = bounds.minY + 9
            while y < bounds.maxY {
                NSRect(x: x, y: y, width: 1.4, height: 1.4).fill()
                y += step
            }
            x += step
        }
    }

    private func edge(from a: NSPoint, to b: NSPoint, color: NSColor, active: Bool, lit: Bool) {
        let dx = max(26, (b.x - a.x) * 0.5)
        let c1 = NSPoint(x: a.x + dx, y: a.y), c2 = NSPoint(x: b.x - dx, y: b.y)
        let p = NSBezierPath()
        p.move(to: a)
        p.curve(to: b, controlPoint1: c1, controlPoint2: c2)
        p.lineWidth = active || lit ? 2 : 1.4
        p.lineCapStyle = .round
        if active {
            // Des tirets qui avancent : le sens du flux se lit sans flèche.
            let pattern: [CGFloat] = [6, 5]
            p.setLineDash(pattern, count: 2, phase: -t * 26)
            color.withAlphaComponent(0.95).setStroke()
            p.stroke()
            // Et une perle qui circule, avec son halo.
            for k in 0..<2 {
                let u = (t * 0.7 + CGFloat(k) * 0.5).truncatingRemainder(dividingBy: 1)
                let q = bezier(a, c1, c2, b, u)
                color.withAlphaComponent(0.25).setFill()
                NSBezierPath(ovalIn: NSRect(x: q.x - 6, y: q.y - 6, width: 12, height: 12)).fill()
                color.setFill()
                NSBezierPath(ovalIn: NSRect(x: q.x - 3, y: q.y - 3, width: 6, height: 6)).fill()
            }
        } else {
            color.withAlphaComponent(lit ? 0.85 : 0.38).setStroke()
            p.stroke()
        }
    }

    private func bezier(_ a: NSPoint, _ c1: NSPoint, _ c2: NSPoint, _ b: NSPoint, _ u: CGFloat) -> NSPoint {
        let v = 1 - u
        let x = v * v * v * a.x + 3 * v * v * u * c1.x + 3 * v * u * u * c2.x + u * u * u * b.x
        let y = v * v * v * a.y + 3 * v * v * u * c1.y + 3 * v * u * u * c2.y + u * u * u * b.y
        return NSPoint(x: x, y: y)
    }

    private func port(_ c: NSPoint, _ tint: NSColor, on: Bool) {
        let r: CGFloat = on ? 4.5 : 3.8
        (TH.dark ? NSColor(calibratedWhite: 0.10, alpha: 1) : NSColor.white).setFill()
        let o = NSBezierPath(ovalIn: NSRect(x: c.x - r, y: c.y - r, width: r * 2, height: r * 2))
        o.fill()
        tint.withAlphaComponent(on ? 1 : 0.7).setStroke()
        o.lineWidth = 1.6
        o.stroke()
    }

    /// Le fond commun des nœuds : verre, liseré, et l'anneau de sélection.
    private func nodeShell(_ r: NSRect, radius: CGFloat, tint: NSColor, selected: Bool, hovered: Bool) {
        let p = NSBezierPath(roundedRect: r, xRadius: radius, yRadius: radius)
        if selected {
            NSGraphicsContext.current?.saveGraphicsState()
            let sh = NSShadow()
            sh.shadowColor = tint.withAlphaComponent(0.55)
            sh.shadowBlurRadius = 12
            sh.shadowOffset = .zero
            sh.set()
            (TH.dark ? NSColor(calibratedWhite: 0.13, alpha: 0.96) : NSColor(calibratedWhite: 0.99, alpha: 0.96)).setFill()
            p.fill()
            NSGraphicsContext.current?.restoreGraphicsState()
        } else {
            (TH.dark ? NSColor(calibratedWhite: 0.11, alpha: 0.92) : NSColor(calibratedWhite: 0.98, alpha: 0.92)).setFill()
            p.fill()
        }
        TH.fill(hovered ? 0.10 : 0.04).setFill()
        p.fill()
        (selected ? tint : TH.fill(0.16)).setStroke()
        p.lineWidth = selected ? 1.6 : 0.8
        p.stroke()
    }

    private func drawSource(_ s: FlowSource, _ r: NSRect) {
        let m = BudAgentManager.shared
        let live = m.agents.contains { a in
            m.state(a.id).status == .running && a.sources.contains { $0.id == s.id }
        }
        nodeShell(r, radius: 9, tint: s.tint, selected: isSelected(.source(s.id)),
                  hovered: hover == .source(s.id))
        let disc = NSRect(x: r.minX + 6, y: r.midY - 10, width: 20, height: 20)
        s.tint.withAlphaComponent(live ? 1 : 0.85).setFill()
        NSBezierPath(roundedRect: disc, xRadius: 6, yRadius: 6).fill()
        drawSymbol(s.icon, center: NSPoint(x: disc.midX, y: disc.midY), size: 10, weight: .semibold, color: .white)
        drawString(s.title, in: NSRect(x: r.minX + 32, y: r.midY - 8, width: r.width - 40, height: 16),
                   size: 11, weight: .semibold, color: TH.text)
        port(NSPoint(x: r.maxX, y: r.midY), s.tint, on: live)
    }

    private func drawAgent(_ a: BudAgent, _ r: NSRect, _ st: AgentState) {
        let sel = isSelected(.agent(a.id))
        nodeShell(r, radius: 14, tint: a.tint, selected: sel, hovered: hover == .agent(a.id))

        // La bande de couleur à gauche, comme l'en-tête d'un nœud n8n.
        NSGraphicsContext.current?.saveGraphicsState()
        NSBezierPath(roundedRect: r, xRadius: 14, yRadius: 14).addClip()
        a.tint.setFill()
        NSRect(x: r.minX, y: r.minY, width: 4, height: r.height).fill()
        NSGraphicsContext.current?.restoreGraphicsState()

        let tile = NSRect(x: r.minX + 14, y: r.maxY - 40, width: 28, height: 28)
        NSGradient(colors: [a.tint, a.tint.blended(withFraction: 0.35, of: .black) ?? a.tint])?
            .draw(in: NSBezierPath(roundedRect: tile, xRadius: 8, yRadius: 8), angle: -90)
        drawSymbol(a.icon, center: NSPoint(x: tile.midX, y: tile.midY), size: 13, weight: .semibold, color: .white)

        drawString(a.name, in: NSRect(x: tile.maxX + 9, y: r.maxY - 33, width: r.maxX - tile.maxX - 20, height: 17),
                   size: 12.5, weight: .bold, color: TH.text)

        // En bas : la dernière ligne à gauche, le badge d'état à droite.
        var label = st.status.label
        if st.status == .needsApproval, let n = st.result?.approval?.items.count { label += " · \(n)" }
        if st.simulated && st.status != .idle { label += " · démo" }
        let bw = textWidth(label, size: 9.5, weight: .bold) + 24
        let badge = NSRect(x: r.maxX - bw - 8, y: r.minY + 7, width: bw, height: 16)
        st.status.color.withAlphaComponent(0.18).setFill()
        capsule(badge).fill()
        if st.status == .running {
            let c = NSPoint(x: badge.minX + 9, y: badge.midY)
            let arc = NSBezierPath()
            arc.appendArc(withCenter: c, radius: 4, startAngle: t * 400, endAngle: t * 400 + 250)
            arc.lineWidth = 1.6
            st.status.color.setStroke()
            arc.stroke()
        } else {
            drawSymbol(st.status.icon, center: NSPoint(x: badge.minX + 9, y: badge.midY),
                       size: 7.5, weight: .bold, color: st.status.color)
        }
        drawString(label, in: NSRect(x: badge.minX + 16, y: badge.minY + 1.5, width: bw - 18, height: 13),
                   size: 9.5, weight: .bold, color: st.status.color)

        let line = st.line.isEmpty ? a.summary : st.line
        drawString(line, in: NSRect(x: r.minX + 14, y: r.minY + 8, width: badge.minX - r.minX - 20, height: 14),
                   size: 10.5, weight: .medium, color: TH.dim(0.6))

        // Pendant le travail, un trait qui parcourt le bas du nœud : la
        // durée est inconnue, on montre seulement que ça avance.
        if st.status == .running {
            NSGraphicsContext.current?.saveGraphicsState()
            NSBezierPath(roundedRect: r, xRadius: 14, yRadius: 14).addClip()
            let w = r.width * 0.3
            let x = r.minX - w + (t * 0.6).truncatingRemainder(dividingBy: 1) * (r.width + w)
            NSGradient(colors: [a.tint.withAlphaComponent(0), a.tint, a.tint.withAlphaComponent(0)])?
                .draw(in: NSRect(x: x, y: r.minY, width: w, height: 2.5), angle: 0)
            NSGraphicsContext.current?.restoreGraphicsState()
        }

        port(NSPoint(x: r.minX, y: r.midY), a.tint, on: st.status == .running)
        port(NSPoint(x: r.maxX, y: r.midY), a.tint, on: st.status == .running)
    }

    private func drawBud(_ r: NSRect) {
        let c = expression.color
        nodeShell(r, radius: 18, tint: c, selected: isSelected(.bud), hovered: hover == .bud)
        // Un halo de la couleur de l'expression, derrière le personnage.
        let halo = NSRect(x: r.midX - 52, y: r.maxY - 116, width: 104, height: 104)
        NSGradient(colors: [c.withAlphaComponent(0.28), c.withAlphaComponent(0)])?
            .draw(in: halo, relativeCenterPosition: .zero)
        let face = NSRect(x: r.midX - 46, y: r.maxY - 108, width: 92, height: 92)
        sprite.render(in: face, detail: true, glowColor: c)

        drawString("BUDs", in: NSRect(x: r.minX, y: r.minY + 28, width: r.width, height: 17),
                   size: 13, weight: .bold, color: TH.text, align: .center)
        let lw = textWidth(expression.label, size: 10, weight: .bold) + 18
        let pill = NSRect(x: r.midX - lw / 2, y: r.minY + 10, width: lw, height: 16)
        c.withAlphaComponent(0.2).setFill()
        capsule(pill).fill()
        drawString(expression.label, in: NSRect(x: pill.minX, y: pill.minY + 1.5, width: lw, height: 13),
                   size: 10, weight: .bold, color: c, align: .center)
        port(NSPoint(x: r.minX, y: r.midY), c, on: expression == .working)
    }
}

// ═══════════════════════════════════════════════════════════
//  Les cartes, à la manière des widgets iOS
// ═══════════════════════════════════════════════════════════

final class BudCardView: NSView {
    let card: BudCard
    private var hovering = false
    private var busy = false
    private var spin: CGFloat = 0
    private var note: (Bool, String)?
    private var timer: Timer?
    private var sky: WeatherSceneView?

    init(frame: NSRect, card: BudCard) {
        self.card = card
        super.init(frame: frame)
        wantsLayer = true
        layer?.cornerRadius = 16
        layer?.masksToBounds = true
        if card.style == .weather {
            // Le vrai ciel animé, en petit : le même que le panneau Météo.
            let s = WeatherSceneView(frame: bounds)
            s.condition = WeatherCondition(code: card.weatherCode, isDay: card.isDay)
            s.autoresizingMask = [.width, .height]
            addSubview(s)
            let o = WeatherCardText(frame: bounds, card: card)
            o.autoresizingMask = [.width, .height]
            addSubview(o)
            sky = s
        }
        toolTip = card.detail
    }
    required init?(coder: NSCoder) { fatalError() }

    override func updateTrackingAreas() {
        super.updateTrackingAreas()
        guard card.style == .control else { return }
        trackingAreas.forEach { removeTrackingArea($0) }
        addTrackingArea(NSTrackingArea(rect: bounds, options: [.mouseEnteredAndExited, .activeAlways, .inVisibleRect],
                                       owner: self, userInfo: nil))
    }
    override func mouseEntered(with e: NSEvent) { hovering = true; needsDisplay = true }
    override func mouseExited(with e: NSEvent) { hovering = false; needsDisplay = true }

    override func mouseUp(with e: NSEvent) {
        guard card.style == .control, !busy, let act = card.action,
              bounds.contains(convert(e.locationInWindow, from: nil)) else { return }
        busy = true
        note = nil
        let tm = Timer(timeInterval: 1.0 / 30.0, repeats: true) { [weak self] _ in
            self?.spin += 0.25; self?.needsDisplay = true
        }
        RunLoop.main.add(tm, forMode: .common)
        timer = tm
        BudAgentManager.shared.onExpression?(.working, 30)
        act { [weak self] ok, msg in
            DispatchQueue.main.async {
                guard let s = self else { return }
                s.busy = false
                s.timer?.invalidate(); s.timer = nil
                s.note = (ok, msg)
                s.needsDisplay = true
                BudAgentManager.shared.onExpression?(ok ? .happy : .sad, 2.5)
                DispatchQueue.main.asyncAfter(deadline: .now() + 2.6) { [weak s] in
                    s?.note = nil; s?.needsDisplay = true
                }
            }
        }
    }

    override func draw(_ dirty: NSRect) {
        guard card.style != .weather else { return }
        let b = bounds
        let p = NSBezierPath(roundedRect: b, xRadius: 16, yRadius: 16)
        let on = busy || note?.0 == true
        if card.style == .control && on && TH.dark {
            // Comme un accessoire allumé dans Maison : la carte s'éclaire.
            NSColor(calibratedWhite: 0.95, alpha: 0.95).setFill()
        } else {
            TH.fill(hovering ? 0.12 : 0.07).setFill()
        }
        p.fill()
        TH.fill(0.10).setStroke()
        p.lineWidth = 0.8
        p.stroke()

        let ink: NSColor = (card.style == .control && on && TH.dark) ? NSColor(calibratedWhite: 0.1, alpha: 1) : TH.text
        let disc = NSRect(x: 12, y: b.maxY - 34, width: 22, height: 22)
        card.tint.setFill()
        NSBezierPath(ovalIn: disc).fill()
        let dc = NSPoint(x: disc.midX, y: disc.midY)
        if busy {
            let a = NSBezierPath()
            a.appendArc(withCenter: dc, radius: 6, startAngle: spin * 57.3, endAngle: spin * 57.3 + 260)
            a.lineWidth = 1.8
            NSColor.white.setStroke()
            a.stroke()
        } else if let n = note {
            drawSymbol(n.0 ? "checkmark" : "exclamationmark", center: dc, size: 10, weight: .bold, color: .white)
        } else {
            drawSymbol(card.icon, center: dc, size: 10.5, weight: .semibold, color: .white)
        }
        drawString(card.title, in: NSRect(x: 40, y: b.maxY - 29, width: b.width - 48, height: 13),
                   size: 9, weight: .bold, color: ink.withAlphaComponent(0.55))

        let big: CGFloat = card.style == .control ? 14 : 20
        drawString(card.value, in: NSRect(x: 12, y: b.minY + 28, width: b.width - 22, height: big + 6),
                   size: big, weight: .bold, color: ink)
        let detail = note?.1 ?? card.detail
        drawString(detail, in: NSRect(x: 12, y: b.minY + 10, width: b.width - 22, height: 14),
                   size: 10, weight: .medium,
                   color: note?.0 == false ? dangerColor : ink.withAlphaComponent(0.6))
    }
}

/// Le texte de la carte météo, posé sur son ciel animé.
private final class WeatherCardText: NSView {
    let card: BudCard
    init(frame: NSRect, card: BudCard) { self.card = card; super.init(frame: frame) }
    required init?(coder: NSCoder) { fatalError() }
    override func hitTest(_ p: NSPoint) -> NSView? { nil }

    override func draw(_ dirty: NSRect) {
        let b = bounds
        NSGraphicsContext.current?.saveGraphicsState()
        let sh = NSShadow()
        sh.shadowColor = NSColor.black.withAlphaComponent(0.3)
        sh.shadowBlurRadius = 4
        sh.set()
        drawString(card.title, in: NSRect(x: 12, y: b.maxY - 24, width: b.width - 40, height: 13),
                   size: 9.5, weight: .bold, color: NSColor.white.withAlphaComponent(0.9))
        drawString(card.value, in: NSRect(x: 12, y: b.minY + 26, width: b.width - 20, height: 34),
                   size: 28, weight: .light, color: .white)
        drawString(card.detail, in: NSRect(x: 12, y: b.minY + 9, width: b.width - 20, height: 14),
                   size: 10, weight: .semibold, color: NSColor.white.withAlphaComponent(0.85))
        NSGraphicsContext.current?.restoreGraphicsState()
        drawWeatherSymbol(card.icon, center: NSPoint(x: b.maxX - 22, y: b.maxY - 20), size: 15)
    }
}

/// La tuile d'icône d'un agent ou d'une source, dans l'inspecteur.
private final class FlowIconView: NSView {
    let icon: String, tint: NSColor
    init(frame: NSRect, icon: String, tint: NSColor) {
        self.icon = icon; self.tint = tint
        super.init(frame: frame)
    }
    required init?(coder: NSCoder) { fatalError() }
    override func draw(_ dirty: NSRect) {
        let r = bounds.insetBy(dx: 1, dy: 1)
        NSGradient(colors: [tint, tint.blended(withFraction: 0.35, of: .black) ?? tint])?
            .draw(in: NSBezierPath(roundedRect: r, xRadius: 10, yRadius: 10), angle: -90)
        drawSymbol(icon, center: NSPoint(x: r.midX, y: r.midY), size: 16, weight: .semibold, color: .white)
    }
}

/// Le badge d'état, réutilisé hors du graphe.
private final class StatusPillView: NSView {
    var status: NodeStatus = .idle { didSet { needsDisplay = true } }
    var extra = ""
    override func draw(_ dirty: NSRect) {
        let label = status.label + extra
        let w = min(bounds.width, textWidth(label, size: 10, weight: .bold) + 26)
        let r = NSRect(x: 0, y: bounds.midY - 9, width: w, height: 18)
        status.color.withAlphaComponent(0.18).setFill()
        capsule(r).fill()
        drawSymbol(status.icon, center: NSPoint(x: r.minX + 10, y: r.midY), size: 8, weight: .bold, color: status.color)
        drawString(label, in: NSRect(x: r.minX + 18, y: r.minY + 2, width: w - 20, height: 14),
                   size: 10, weight: .bold, color: status.color)
    }
}

// ═══════════════════════════════════════════════════════════
//  La fiche d'approbation
//
//  Elle couvre le panneau : tant qu'elle est ouverte, rien
//  d'autre ne se clique. Chaque élément a sa case, son
//  icône, sa raison et sa taille ; le total suit les coches ;
//  le bouton d'action dit ce qu'il va faire et sur combien
//  d'éléments, et il est éteint quand rien n'est coché.
// ═══════════════════════════════════════════════════════════

final class ApprovalSheetView: NSView {
    private var items: [ApprovalItem]
    private let request: ApprovalRequest
    private let agentID: String
    private var total: NSTextField!
    private var confirm: GlassButton!
    private var boxes: [NSButton] = []
    var onClose: (() -> Void)?

    init(frame: NSRect, agentID: String, request: ApprovalRequest) {
        self.items = request.items
        self.request = request
        self.agentID = agentID
        super.init(frame: frame)
        wantsLayer = true
        build()
    }
    required init?(coder: NSCoder) { fatalError() }

    // Le voile avale les clics : rien ne passe à travers la fiche.
    override func mouseDown(with e: NSEvent) {}
    override func scrollWheel(with e: NSEvent) {}

    override func draw(_ dirty: NSRect) {
        NSColor.black.withAlphaComponent(TH.dark ? 0.55 : 0.30).setFill()
        bounds.fill()
    }

    private func build() {
        let W: CGFloat = min(500, bounds.width - 40), H: CGFloat = min(430, bounds.height - 40)
        let sheet = NSView(frame: NSRect(x: (bounds.width - W) / 2, y: (bounds.height - H) / 2, width: W, height: H))
        sheet.wantsLayer = true
        sheet.layer?.cornerRadius = 20
        sheet.layer?.backgroundColor = (TH.dark ? NSColor(calibratedWhite: 0.10, alpha: 0.98)
                                                : NSColor(calibratedWhite: 0.98, alpha: 0.98)).cgColor
        sheet.layer?.borderWidth = 0.8
        sheet.layer?.borderColor = TH.fill(0.18).cgColor
        sheet.shadow = NSShadow()
        sheet.layer?.shadowOpacity = 0.4
        sheet.layer?.shadowRadius = 24
        addSubview(sheet)

        let purple = NodeStatus.needsApproval.color
        sheet.addSubview(FlowIconView(frame: NSRect(x: 20, y: H - 56, width: 36, height: 36),
                                      icon: "hand.raised.fill", tint: purple))
        sheet.addSubview(mkLabel(request.title, NSRect(x: 66, y: H - 40, width: W - 86, height: 22), 16, .bold))
        let msg = mkLabel(request.message, NSRect(x: 66, y: H - 84, width: W - 86, height: 44), 11.5, .medium, alpha: 0.65)
        msg.cell?.usesSingleLineMode = false
        msg.cell?.wraps = true
        msg.lineBreakMode = .byWordWrapping
        msg.maximumNumberOfLines = 3
        sheet.addSubview(msg)

        let all = GlassButton(frame: NSRect(x: 20, y: H - 120, width: 110, height: 26),
                              title: "Tout cocher", icon: "checkmark.circle", compact: true)
        all.onClick = { [weak self] _ in self?.setAll(true) }
        sheet.addSubview(all)
        let none = GlassButton(frame: NSRect(x: 138, y: H - 120, width: 120, height: 26),
                               title: "Tout décocher", icon: "circle", compact: true)
        none.onClick = { [weak self] _ in self?.setAll(false) }
        sheet.addSubview(none)

        // La liste.
        let listH = H - 128 - 70
        let scroll = NSScrollView(frame: NSRect(x: 12, y: 66, width: W - 24, height: listH))
        scroll.drawsBackground = false
        scroll.hasVerticalScroller = true
        scroll.autohidesScrollers = true
        let rowH: CGFloat = 46
        let doc = FlippedView(frame: NSRect(x: 0, y: 0, width: W - 38, height: max(listH, CGFloat(items.count) * rowH)))
        for (i, it) in items.enumerated() {
            let y = CGFloat(i) * rowH
            if i > 0 {
                let sep = NSView(frame: NSRect(x: 44, y: y, width: doc.frame.width - 52, height: 0.5))
                sep.wantsLayer = true
                sep.layer?.backgroundColor = TH.fill(0.10).cgColor
                doc.addSubview(sep)
            }
            let box = NSButton(checkboxWithTitle: "", target: self, action: #selector(toggled(_:)))
            box.frame = NSRect(x: 10, y: y + 13, width: 22, height: 20)
            box.state = it.selected ? .on : .off
            box.tag = i
            box.setAccessibilityLabel(it.label)
            doc.addSubview(box)
            boxes.append(box)
            let iv = NSImageView(frame: NSRect(x: 36, y: y + 13, width: 20, height: 20))
            iv.image = NSImage(systemSymbolName: it.icon, accessibilityDescription: nil)
            iv.contentTintColor = it.icon.contains("shield") ? dangerColor : TH.dim(0.7)
            doc.addSubview(iv)
            let sizeText = it.bytes > 0 ? formatBytes(it.bytes) : ""
            doc.addSubview(mkLabel(it.label, NSRect(x: 64, y: y + 6, width: doc.frame.width - 160, height: 17), 12.5, .semibold))
            doc.addSubview(mkLabel(it.detail, NSRect(x: 64, y: y + 24, width: doc.frame.width - 160, height: 15), 10.5, .medium, alpha: 0.55))
            doc.addSubview(mkLabel(sizeText, NSRect(x: doc.frame.width - 92, y: y + 14, width: 84, height: 16),
                                   11.5, .semibold, alpha: 0.75, .right, mono: true))
        }
        scroll.documentView = doc
        sheet.addSubview(scroll)

        total = mkLabel("", NSRect(x: 22, y: 24, width: W - 300, height: 18), 12, .semibold, alpha: 0.75)
        sheet.addSubview(total)
        let cancel = GlassButton(frame: NSRect(x: W - 276, y: 18, width: 96, height: 30), title: "Annuler")
        cancel.onClick = { [weak self] _ in
            guard let s = self else { return }
            BudAgentManager.shared.decline(s.agentID)
            s.close()
        }
        sheet.addSubview(cancel)
        confirm = GlassButton(frame: NSRect(x: W - 172, y: 18, width: 152, height: 30),
                              title: request.confirmLabel, icon: request.destructive ? "trash.fill" : "checkmark",
                              prominent: true)
        confirm.destructive = request.destructive
        confirm.onClick = { [weak self] _ in
            guard let s = self else { return }
            BudAgentManager.shared.approve(s.agentID, items: s.items)
            s.close()
        }
        sheet.addSubview(confirm)
        refreshTotal()
        ThemeRegistry.shared.prune()
    }

    @objc private func toggled(_ b: NSButton) {
        guard b.tag >= 0, b.tag < items.count else { return }
        items[b.tag].selected = b.state == .on
        refreshTotal()
    }

    private func setAll(_ on: Bool) {
        for i in items.indices { items[i].selected = on }
        for b in boxes { b.state = on ? .on : .off }
        refreshTotal()
    }

    private func refreshTotal() {
        let chosen = items.filter { $0.selected }
        let bytes = chosen.reduce(Int64(0)) { $0 + $1.bytes }
        total.stringValue = chosen.isEmpty
            ? "Rien de coché."
            : "\(chosen.count) élément\(chosen.count > 1 ? "s" : "") · \(formatBytes(bytes))"
        confirm.enabledFlag = !chosen.isEmpty
    }

    private func close() {
        NSAnimationContext.runAnimationGroup({ ctx in
            ctx.duration = 0.18
            self.animator().alphaValue = 0
        }, completionHandler: { [weak self] in
            self?.removeFromSuperview()
            self?.onClose?()
        })
    }
}

// ═══════════════════════════════════════════════════════════
//  Le panneau
// ═══════════════════════════════════════════════════════════

final class FlowPanelView: NSView {
    private let canvasScroll: NSScrollView
    let canvas: FlowCanvasView
    private let inspector = NSView()
    private var selection: FlowCanvasView.Selection = .bud
    private var linkField: NSTextField?
    private var sheet: ApprovalSheetView?

    override init(frame: NSRect) {
        let W = frame.width, H = frame.height
        let canvasH: CGFloat = 262
        canvasScroll = NSScrollView(frame: NSRect(x: 0, y: H - 46 - canvasH, width: W, height: canvasH))
        canvas = FlowCanvasView(frame: NSRect(x: 0, y: 0, width: W, height: canvasH))
        super.init(frame: frame)

        addSubview(mkLabel("Flux", NSRect(x: 0, y: H - 34, width: 120, height: 28), 22, .bold))
        addSubview(mkLabel("Sources  →  Agents  →  BUDs", NSRect(x: 70, y: H - 30, width: 220, height: 18),
                           12, .medium, alpha: 0.5))

        let faces = GlassButton(frame: NSRect(x: W - 300, y: H - 36, width: 90, height: 28),
                                title: "Visages", icon: "face.smiling", compact: true)
        faces.onClick = { [weak self] _ in self?.expressionTour() }
        addSubview(faces)
        let demo = GlassButton(frame: NSRect(x: W - 204, y: H - 36, width: 84, height: 28),
                               title: "Démo", icon: "play.circle", compact: true)
        demo.onClick = { _ in BudAgentManager.shared.demo() }
        addSubview(demo)
        let all = GlassButton(frame: NSRect(x: W - 114, y: H - 36, width: 114, height: 28),
                              title: "Tout lancer", icon: "play.fill", prominent: true, compact: true)
        all.onClick = { _ in
            for a in BudAgentManager.shared.agents { BudAgentManager.shared.run(a.id) }
        }
        addSubview(all)

        // Le plan de travail, dans son cadre de verre.
        _ = mkCard(self, canvasScroll.frame, radius: Radius.l, alpha: 0.04)
        canvasScroll.drawsBackground = false
        canvasScroll.hasVerticalScroller = true
        canvasScroll.autohidesScrollers = true
        canvasScroll.documentView = canvas
        addSubview(canvasScroll)

        inspector.frame = NSRect(x: 0, y: 0, width: W, height: canvasScroll.frame.minY - 10)
        _ = mkCard(self, inspector.frame, radius: Radius.l, alpha: 0.06)
        addSubview(inspector)

        canvas.onSelect = { [weak self] s in
            self?.selection = s
            self?.rebuildInspector()
            if case .agent(let id) = s { BudAgentManager.shared.preview(id) }
        }
        canvas.onRun = { id in BudAgentManager.shared.run(id) }
        canvas.selection = .bud

        BudAgentManager.shared.observe { [weak self] id in
            guard let s = self else { return }
            s.resizeCanvas()
            s.canvas.needsDisplay = true
            if s.selection == .agent(id) { s.rebuildInspector() }
        }
        resizeCanvas()
        rebuildInspector()
    }
    required init?(coder: NSCoder) { fatalError() }

    func refresh() {
        resizeCanvas()
        canvas.updateClock()
        rebuildInspector()
    }

    /// Appelée par l'application à chaque changement d'expression, pour
    /// que le BUDs du graphe suive celui du bureau.
    func show(_ e: BudExpression, hold: TimeInterval) {
        canvas.expression = e
        canvas.sprite.flash(e.mood, for: hold)
        // Revenir à « attentif » quand l'expression s'éteint.
        DispatchQueue.main.asyncAfter(deadline: .now() + hold) { [weak self] in
            guard let s = self, s.canvas.expression == e, e != .working || !BudAgentManager.shared.anyRunning
            else { return }
            s.canvas.expression = .neutral
        }
        if selection == .bud { rebuildInspector() }
    }

    private func resizeCanvas() {
        let h = max(canvasScroll.contentSize.height, canvas.neededHeight())
        if abs(canvas.frame.height - h) > 0.5 {
            canvas.frame = NSRect(x: 0, y: 0, width: canvasScroll.contentSize.width, height: h)
        }
    }

    /// Les huit expressions à la suite, une seconde et demie chacune.
    private func expressionTour() {
        for (i, e) in BudFlowSamples.expressionTour.enumerated() {
            DispatchQueue.main.asyncAfter(deadline: .now() + Double(i) * 1.5) {
                BudAgentManager.shared.onExpression?(e, 1.6)
                BudAgentManager.shared.onStatus?("Expression : \(e.label)")
            }
        }
    }

    // ═════════════ L'inspecteur ═════════════

    private func rebuildInspector() {
        inspector.subviews.forEach { $0.removeFromSuperview() }
        linkField = nil
        switch selection {
        case .agent(let id):
            if let a = BudAgentManager.shared.agent(id) { inspectAgent(a) }
        case .source(let id):
            if let s = BudAgentManager.shared.sources.first(where: { $0.id == id }) { inspectSource(s) }
        case .bud:
            inspectBud()
        }
        ThemeRegistry.shared.prune()
    }

    private func header(icon: String, tint: NSColor, title: String, subtitle: String, rightInset: CGFloat) {
        let W = inspector.bounds.width, H = inspector.bounds.height
        inspector.addSubview(FlowIconView(frame: NSRect(x: 16, y: H - 54, width: 38, height: 38), icon: icon, tint: tint))
        inspector.addSubview(mkLabel(title, NSRect(x: 64, y: H - 35, width: W - 64 - rightInset, height: 20), 15, .bold))
        inspector.addSubview(mkLabel(subtitle, NSRect(x: 64, y: H - 54, width: W - 64 - rightInset, height: 16),
                                     11, .medium, alpha: 0.6))
    }

    private func inspectAgent(_ a: BudAgent) {
        let m = BudAgentManager.shared
        let st = m.state(a.id)
        let W = inspector.bounds.width, H = inspector.bounds.height
        header(icon: a.icon, tint: a.tint, title: a.name, subtitle: a.summary, rightInset: 216)

        let running = st.status == .running
        let sim = GlassButton(frame: NSRect(x: W - 206, y: H - 50, width: 92, height: 28),
                              title: "Simuler", icon: "wand.and.stars", compact: true)
        sim.enabledFlag = !running
        sim.onClick = { _ in m.run(a.id, simulated: true) }
        inspector.addSubview(sim)
        let go = GlassButton(frame: NSRect(x: W - 108, y: H - 50, width: 94, height: 28),
                             title: running ? "Arrêter" : "Exécuter",
                             icon: running ? "stop.fill" : "play.fill", prominent: !running, compact: true)
        go.onClick = { _ in
            if running { m.cancel(a.id) } else { m.run(a.id) }
        }
        inspector.addSubview(go)

        // L'état, et quand.
        let pill = StatusPillView(frame: NSRect(x: 16, y: H - 86, width: 130, height: 22))
        pill.status = st.status
        if st.simulated && st.status != .idle { pill.extra = " · démo" }
        inspector.addSubview(pill)
        var line = st.line.isEmpty ? "Jamais exécuté. Double-cliquez sur le nœud, ou « Exécuter »." : st.line
        if let d = st.lastRun {
            let f = RelativeDateTimeFormatter()
            f.locale = Locale(identifier: "fr_FR")
            line += "  ·  " + f.localizedString(for: d, relativeTo: Date())
        }
        let lw = textWidth(st.status.label + (pill.extra), size: 10, weight: .bold) + 34
        inspector.addSubview(mkLabel(line, NSRect(x: 16 + lw, y: H - 85, width: W - 32 - lw, height: 17), 11.5, .medium, alpha: 0.75))

        // La rangée d'action propre à l'agent.
        let rowY = H - 122
        if let req = st.result?.approval, st.status == .needsApproval {
            let n = req.items.count
            let review = GlassButton(frame: NSRect(x: 16, y: rowY, width: 270, height: 28),
                                     title: "Examiner et approuver · \(n) élément\(n > 1 ? "s" : "")",
                                     icon: "hand.raised.fill", prominent: true, compact: true)
            review.accentTint = NodeStatus.needsApproval.color
            review.onClick = { [weak self] _ in self?.openApproval(a.id, req) }
            inspector.addSubview(review)
            let skip = GlassButton(frame: NSRect(x: 294, y: rowY, width: 96, height: 28),
                                   title: "Ignorer", icon: "xmark", compact: true)
            skip.onClick = { _ in m.decline(a.id) }
            inspector.addSubview(skip)
        } else if let sec = a as? SecurityAgent {
            let f = NSTextField(frame: NSRect(x: 16, y: rowY + 2, width: W - 290, height: 24))
            f.placeholderString = "Coller un lien ou un domaine à vérifier…"
            f.bezelStyle = .roundedBezel
            f.font = NSFont.systemFont(ofSize: 12)
            f.target = self
            f.action = #selector(analyzeLink)
            inspector.addSubview(f)
            linkField = f
            let check = GlassButton(frame: NSRect(x: W - 266, y: rowY, width: 110, height: 28),
                                    title: "Analyser", icon: "magnifyingglass", compact: true)
            check.onClick = { [weak self] _ in self?.analyzeLink() }
            inspector.addSubview(check)
            let key = GlassButton(frame: NSRect(x: W - 148, y: rowY, width: 134, height: 28),
                                  title: SafeBrowsing.key == nil ? "Safe Browsing…" : "Safe Browsing ✓",
                                  icon: "key.fill", compact: true)
            key.onClick = { [weak self] _ in self?.askSafeBrowsingKey() }
            inspector.addSubview(key)
            _ = sec
        } else {
            let srcs = a.sources.map { $0.title }.joined(separator: " · ")
            inspector.addSubview(mkLabel("Lit : " + srcs, NSRect(x: 16, y: rowY + 6, width: W - 32, height: 16),
                                         11, .medium, alpha: 0.5))
        }

        addCards(st.result?.cards ?? [], placeholder: running ? "Au travail…" : "Les cartes du résultat s'afficheront ici.")
    }

    private func inspectSource(_ s: FlowSource) {
        let W = inspector.bounds.width, H = inspector.bounds.height
        let users = BudAgentManager.shared.agents.filter { a in a.sources.contains { $0.id == s.id } }
        header(icon: s.icon, tint: s.tint, title: s.title,
               subtitle: "Source · lue par " + users.map { $0.name }.joined(separator: ", "), rightInset: 20)
        let note = mkLabel(s.note, NSRect(x: 16, y: H - 100, width: W - 32, height: 34), 12, .medium, alpha: 0.75)
        note.cell?.usesSingleLineMode = false
        note.cell?.wraps = true
        note.maximumNumberOfLines = 2
        inspector.addSubview(note)
        var x: CGFloat = 16
        for a in users {
            let b = GlassButton(frame: NSRect(x: x, y: H - 140, width: 200, height: 28),
                                title: "Ouvrir « \(a.name) »", icon: a.icon, compact: true)
            b.frame.size.width = b.idealWidth()
            b.onClick = { [weak self] _ in self?.select(.agent(a.id)) }
            inspector.addSubview(b)
            x += b.frame.width + 8
        }
    }

    private func inspectBud() {
        let W = inspector.bounds.width, H = inspector.bounds.height
        let e = canvas.expression
        header(icon: "face.smiling", tint: e.color, title: "BUDs · \(e.label)",
               subtitle: "La sortie de tous les agents : l'expression dit le résultat, les cartes le détaillent.",
               rightInset: 20)
        inspector.addSubview(mkLabel("APERÇU DES EXPRESSIONS", NSRect(x: 16, y: H - 84, width: 300, height: 14),
                                     10, .bold, alpha: 0.5))
        var x: CGFloat = 16, y = H - 120
        for ex in BudExpression.allCases {
            let b = GlassButton(frame: NSRect(x: x, y: y, width: 100, height: 28), title: ex.label, compact: true)
            b.frame.size.width = b.idealWidth()
            if x + b.frame.width > W - 16 { x = 16; y -= 36; b.frame.origin = NSPoint(x: x, y: y) }
            b.accentTint = ex.color
            b.selected = ex == e
            b.onClick = { _ in BudAgentManager.shared.onExpression?(ex, 3) }
            inspector.addSubview(b)
            x += b.frame.width + 8
        }
        // Le dernier mot de chaque agent, en cartes.
        let cards = BudAgentManager.shared.agents.map { a -> BudCard in
            let st = BudAgentManager.shared.state(a.id)
            return BudCard(icon: a.icon, title: a.name.uppercased(), value: st.status.label,
                           detail: st.line.isEmpty ? "Pas encore lancé" : st.line, tint: a.tint)
        }
        addCards(cards, placeholder: "")
    }

    private func addCards(_ cards: [BudCard], placeholder: String) {
        let W = inspector.bounds.width
        let cw: CGFloat = 150, ch: CGFloat = 96, gapX: CGFloat = 10
        guard !cards.isEmpty else {
            if !placeholder.isEmpty {
                inspector.addSubview(mkLabel(placeholder, NSRect(x: 16, y: 52, width: W - 32, height: 18),
                                             12, .medium, alpha: 0.4, .center))
            }
            return
        }
        let scroll = NSScrollView(frame: NSRect(x: 12, y: 10, width: W - 24, height: ch + 4))
        scroll.drawsBackground = false
        scroll.hasHorizontalScroller = true
        scroll.autohidesScrollers = true
        let docW = max(W - 24, CGFloat(cards.count) * (cw + gapX) + 4)
        let doc = NSView(frame: NSRect(x: 0, y: 0, width: docW, height: ch + 4))
        for (i, c) in cards.enumerated() {
            doc.addSubview(BudCardView(frame: NSRect(x: 4 + CGFloat(i) * (cw + gapX), y: 2, width: cw, height: ch), card: c))
        }
        scroll.documentView = doc
        inspector.addSubview(scroll)
    }

    private func select(_ s: FlowCanvasView.Selection) {
        selection = s
        canvas.selection = s
        rebuildInspector()
    }

    // ═════════════ Actions ═════════════

    @objc private func analyzeLink() {
        guard let f = linkField, let sec = BudAgentManager.shared.agent("security") as? SecurityAgent else { return }
        let text = f.stringValue.trimmingCharacters(in: .whitespacesAndNewlines)
        guard !text.isEmpty else { return }
        sec.input = text
        BudAgentManager.shared.run(sec.id)
    }

    /// La clé Safe Browsing se tape ici et file au trousseau. Elle n'est
    /// jamais affichée en clair, jamais écrite sur disque.
    private func askSafeBrowsingKey() {
        let alert = NSAlert()
        alert.messageText = "Clé Google Safe Browsing (facultative)"
        alert.informativeText = "Avec une clé, les adresses des liens — et seulement elles — sont aussi vérifiées auprès de Google. Sans clé, l'analyse reste entièrement locale. Laissez vide pour retirer la clé."
        let field = NSSecureTextField(frame: NSRect(x: 0, y: 0, width: 300, height: 24))
        field.placeholderString = SafeBrowsing.key == nil ? "Clé d'API" : "•••••••• (enregistrée)"
        alert.accessoryView = field
        alert.addButton(withTitle: "Enregistrer")
        alert.addButton(withTitle: "Annuler")
        guard let w = window else { return }
        alert.beginSheetModal(for: w) { [weak self] r in
            guard r == .alertFirstButtonReturn else { return }
            let k = field.stringValue.trimmingCharacters(in: .whitespacesAndNewlines)
            if k.isEmpty { BudKeychain.delete(SafeBrowsing.account) }
            else { BudKeychain.set(k, account: SafeBrowsing.account) }
            self?.rebuildInspector()
        }
    }

    private func openApproval(_ id: String, _ req: ApprovalRequest) {
        guard sheet == nil else { return }
        let s = ApprovalSheetView(frame: bounds, agentID: id, request: req)
        s.alphaValue = 0
        s.onClose = { [weak self] in self?.sheet = nil; self?.rebuildInspector() }
        addSubview(s)
        sheet = s
        NSAnimationContext.runAnimationGroup { ctx in
            ctx.duration = 0.2
            s.animator().alphaValue = 1
        }
        BudAgentManager.shared.onExpression?(.reflection, 6)
    }
}
EOF_BUDFLOWVIEW_SWIFT

cat << 'EOF_BUDGMAIL_SWIFT' > "$SRC_DIR/BudGmail.swift"
import Foundation
import Network
import Security

private typealias NWPort = NWEndpoint.Port

// ═══════════════════════════════════════════════════════════
//  Connexion directe à Gmail — IMAP pour lire, SMTP pour écrire
//
//  Google n'autorise plus le mot de passe du compte : il faut un
//  « mot de passe d'application » (compte protégé par validation en
//  deux étapes, puis myaccount.google.com/apppasswords).
//  Ce mot de passe est rangé dans le trousseau macOS, jamais sur disque.
// ═══════════════════════════════════════════════════════════

enum BudKeychain {
    static let service = "fr.lahbib.bud.gmail"

    @discardableResult
    static func set(_ value: String, account: String) -> Bool {
        delete(account)
        let q: [String: Any] = [
            kSecClass as String: kSecClassGenericPassword,
            kSecAttrService as String: service,
            kSecAttrAccount as String: account,
            kSecValueData as String: Data(value.utf8)
        ]
        return SecItemAdd(q as CFDictionary, nil) == errSecSuccess
    }

    static func get(_ account: String) -> String? {
        let q: [String: Any] = [
            kSecClass as String: kSecClassGenericPassword,
            kSecAttrService as String: service,
            kSecAttrAccount as String: account,
            kSecReturnData as String: true,
            kSecMatchLimit as String: kSecMatchLimitOne
        ]
        var out: CFTypeRef?
        guard SecItemCopyMatching(q as CFDictionary, &out) == errSecSuccess,
              let d = out as? Data else { return nil }
        return String(data: d, encoding: .utf8)
    }

    static func delete(_ account: String) {
        let q: [String: Any] = [
            kSecClass as String: kSecClassGenericPassword,
            kSecAttrService as String: service,
            kSecAttrAccount as String: account
        ]
        SecItemDelete(q as CFDictionary)
    }
}

/// Connexion TLS ligne à ligne, synchrone, pensée pour IMAP et SMTP.
final class TLSLineSocket {
    private let conn: NWConnection
    private let queue = DispatchQueue(label: "fr.lahbib.bud.net")
    private var buffer = Data()
    private(set) var failure: String?

    init?(host: String, port: UInt16, timeout: TimeInterval = 15) {
        guard let p = NWPort(rawValue: port) else { return nil }
        let params = NWParameters(tls: NWProtocolTLS.Options())
        conn = NWConnection(host: NWEndpoint.Host(host), port: p, using: params)

        let sem = DispatchSemaphore(value: 0)
        var ready = false
        var err: String?
        conn.stateUpdateHandler = { st in
            switch st {
            case .ready: ready = true; sem.signal()
            case .failed(let e): err = e.localizedDescription; sem.signal()
            case .waiting(let e): err = e.localizedDescription
            case .cancelled: sem.signal()
            default: break
            }
        }
        conn.start(queue: queue)
        _ = sem.wait(timeout: .now() + timeout)
        guard ready else {
            conn.cancel()
            failure = err ?? "connexion impossible à \(host)"
            return nil
        }
    }

    private func fill(timeout: TimeInterval) -> Bool {
        let sem = DispatchSemaphore(value: 0)
        var chunk: Data?
        conn.receive(minimumIncompleteLength: 1, maximumLength: 65_536) { d, _, _, _ in
            chunk = d
            sem.signal()
        }
        guard sem.wait(timeout: .now() + timeout) == .success,
              let d = chunk, !d.isEmpty else { return false }
        buffer.append(d)
        return true
    }

    func readLine(timeout: TimeInterval = 20) -> String? {
        while true {
            if let r = buffer.range(of: Data([13, 10])) {
                let raw = buffer.subdata(in: buffer.startIndex..<r.lowerBound)
                buffer.removeSubrange(buffer.startIndex..<r.upperBound)
                return String(data: raw, encoding: .utf8) ?? String(decoding: raw, as: UTF8.self)
            }
            if !fill(timeout: timeout) { return nil }
        }
    }

    @discardableResult
    func write(_ s: String, newline: Bool = true) -> Bool {
        let sem = DispatchSemaphore(value: 0)
        var ok = true
        conn.send(content: Data((s + (newline ? "\r\n" : "")).utf8),
                  completion: .contentProcessed { e in
                      if e != nil { ok = false }
                      sem.signal()
                  })
        _ = sem.wait(timeout: .now() + 20)
        return ok
    }

    func close() { conn.cancel() }
}


// ── Décodage des en-têtes encodés (=?UTF-8?B?…?=) ──

func decodeMimeHeader(_ s: String) -> String {
    var out = s
    let pattern = "=\\?([^?]+)\\?([BbQq])\\?([^?]*)\\?="
    guard let re = try? NSRegularExpression(pattern: pattern) else { return s }
    let matches = re.matches(in: s, range: NSRange(s.startIndex..., in: s)).reversed()
    for m in matches {
        guard let whole = Range(m.range, in: s),
              let encR = Range(m.range(at: 2), in: s),
              let txtR = Range(m.range(at: 3), in: s) else { continue }
        let enc = s[encR].uppercased()
        let txt = String(s[txtR])
        var decoded = txt
        if enc == "B" {
            if let d = Data(base64Encoded: txt), let t = String(data: d, encoding: .utf8) { decoded = t }
        } else {
            var t = txt.replacingOccurrences(of: "_", with: " ")
            while let r = t.range(of: "=[0-9A-Fa-f]{2}", options: .regularExpression) {
                let hex = String(t[r]).dropFirst()
                if let v = UInt8(hex, radix: 16) {
                    t.replaceSubrange(r, with: String(UnicodeScalar(v)))
                } else { break }
            }
            decoded = t
        }
        if let wr = Range(NSRange(whole, in: s), in: out) ?? out.range(of: String(s[whole])) {
            out.replaceSubrange(wr, with: decoded)
        }
    }
    return out
}

// ═══════════════════════════════════════════════════════════
//  Client Gmail
// ═══════════════════════════════════════════════════════════

struct GmailSnapshot {
    var unread = 0
    var messages: [MailMessage] = []
    var error: String?
    /// Le prochain identifiant que le serveur attribuera. C'est ce qui
    /// permet de savoir qu'il n'y a rien de neuf sans rapatrier un seul
    /// message : si UIDNEXT n'a pas bougé, aucun message n'est arrivé.
    var uidNext: String = ""
    var ok: Bool { error == nil }
}

enum GmailAuthMode {
    case appPassword(String)
    case oauth(String)        // chaîne XOAUTH2 déjà encodée
}

enum GmailClient {

    static let imapHost = "imap.gmail.com"
    static let smtpHost = "smtp.gmail.com"

    static func normalizedPassword(_ p: String) -> String {
        p.replacingOccurrences(of: " ", with: "")
    }

    static func fetchInbox(user: String, password: String, limit: Int = 5,
                           snippetLimit: Int = 12) -> GmailSnapshot {
        fetchInbox(user: user, auth: .appPassword(password), limit: limit,
                   snippetLimit: snippetLimit)
    }

    /// Vérifie le couple adresse / mot de passe d'application.
    static func testLogin(user: String, password: String) -> String? {
        guard let s = TLSLineSocket(host: imapHost, port: 993) else {
            return "Connexion IMAP impossible (réseau ou pare-feu)."
        }
        defer { s.close() }
        _ = s.readLine()
        s.write("a1 LOGIN \"\(user)\" \"\(normalizedPassword(password))\"")
        while let l = s.readLine() {
            if l.hasPrefix("a1 OK") { s.write("a9 LOGOUT"); return nil }
            if l.hasPrefix("a1 NO") || l.hasPrefix("a1 BAD") {
                return "Gmail refuse ces identifiants. Utilisez un mot de passe d'application."
            }
        }
        return "Gmail n'a pas répondu."
    }

    /// Non-lus et derniers messages de la boîte de réception.
    static func fetchInbox(user: String, auth: GmailAuthMode, limit: Int = 5,
                           snippetLimit: Int = 12) -> GmailSnapshot {
        var snap = GmailSnapshot()
        guard let s = TLSLineSocket(host: imapHost, port: 993) else {
            snap.error = "IMAP injoignable."
            return snap
        }
        defer { s.close() }
        _ = s.readLine()

        switch auth {
        case .appPassword(let p):
            s.write("a1 LOGIN \"\(user)\" \"\(normalizedPassword(p))\"")
        case .oauth(let token):
            s.write("a1 AUTHENTICATE XOAUTH2 \(token)")
        }
        var logged = false
        while let l = s.readLine() {
            if l.hasPrefix("a1 OK") { logged = true; break }
            if l.hasPrefix("a1 NO") || l.hasPrefix("a1 BAD") { break }
            if l.hasPrefix("+ ") { s.write("") }   // Gmail attend une ligne vide après un refus XOAUTH2
        }
        guard logged else {
            snap.error = "Identifiants refusés."
            return snap
        }

        s.write("a2 SELECT INBOX")
        while let l = s.readLine() { if l.hasPrefix("a2 ") { break } }

        // Les non-lus, pour le compteur et pour marquer la liste.
        s.write("a3 UID SEARCH UNSEEN")
        var unseen: Set<String> = []
        while let l = s.readLine() {
            if l.uppercased().hasPrefix("* SEARCH") {
                unseen = Set(l.split(separator: " ").dropFirst(2).map(String.init))
            }
            if l.hasPrefix("a3 ") { break }
        }
        snap.unread = unseen.count

        // Les derniers messages, lus ou non : on répond aussi à un message lu.
        s.write("a4 UID SEARCH ALL")
        var all: [String] = []
        while let l = s.readLine() {
            if l.uppercased().hasPrefix("* SEARCH") {
                all = l.split(separator: " ").dropFirst(2).map(String.init)
            }
            if l.hasPrefix("a4 ") { break }
        }
        if all.isEmpty { all = Array(unseen) }

        // Le prochain identifiant se déduit du plus grand rencontré. On
        // l'enregistre pour que le sondage de fond puisse comparer sans
        // refaire ce travail.
        if let maxUID = all.compactMap({ Int($0) }).max() {
            snap.uidNext = String(maxUID + 1)
        }

        for (i, uid) in all.suffix(limit).reversed().enumerated() {
            let tag = "f\(i)"
            // LIST-UNSUBSCRIBE, LIST-ID et PRECEDENCE servent au classement
            // par type. Un message portant un lien de désabonnement est un
            // envoi en masse — signal bien plus sûr qu'un mot-clé dans
            // l'objet, puisque c'est l'expéditeur lui-même qui le déclare.
            s.write("\(tag) UID FETCH \(uid) (BODY.PEEK[HEADER.FIELDS (FROM SUBJECT DATE "
                    + "REPLY-TO RETURN-PATH MESSAGE-ID AUTHENTICATION-RESULTS RECEIVED-SPF "
                    + "LIST-UNSUBSCRIBE LIST-ID PRECEDENCE)] "
                    + "BODYSTRUCTURE)")
            var subject = "", from = "", date = "", replyTo = ""
            var ret = "", mid = "", authRes = "", spf = "", bulk = ""
            var structure = ""
            var lastKey = ""
            while let l = s.readLine() {
                if l.hasPrefix("\(tag) ") { break }
                // Un en-tête replié commence par une espace : il prolonge le précédent.
                if l.hasPrefix(" ") || l.hasPrefix("\t") {
                    let cont = l.trimmingCharacters(in: .whitespaces)
                    switch lastKey {
                    case "authentication-results": authRes += " " + cont
                    case "received-spf": spf += " " + cont
                    case "subject": subject += " " + cont
                    case "from": from += " " + cont
                    default: break
                    }
                    continue
                }
                if l.uppercased().contains("BODYSTRUCTURE") { structure += l }
                guard let colon = l.firstIndex(of: ":") else { continue }
                let key = l[l.startIndex..<colon].lowercased()
                let value = String(l[l.index(after: colon)...]).trimmingCharacters(in: .whitespaces)
                lastKey = key
                switch key {
                case "subject": subject = value
                case "from": from = value
                case "date": date = value
                case "reply-to": replyTo = value
                case "return-path": ret = value
                case "message-id": mid = value
                case "authentication-results": authRes = value
                case "received-spf": spf = value
                case "list-unsubscribe", "list-id", "precedence":
                    // Les trois disent la même chose — « envoi en masse ».
                    // Un seul suffit, et les réunir évite trois champs.
                    bulk += " " + value
                default: lastKey = ""
                }
            }

            var m = MailMessage(subject: decodeMimeHeader(subject),
                                sender: decodeMimeHeader(from),
                                date: date)
            m.uid = uid
            m.messageID = mid
            m.replyTo = decodeMimeHeader(replyTo)
            m.returnPath = ret
            m.authResults = authRes
            m.spf = spf
            m.unread = unseen.contains(uid)
            m.parts = parts(in: structure)
            // Les noms restent renseignés : l'analyse de hameçonnage les
            // lit encore, et une passerelle sans BODYSTRUCTURE n'aurait
            // pas de parties.
            m.attachments = m.parts.filter { $0.isAttachment }.map { $0.name }
            if m.attachments.isEmpty { m.attachments = attachmentNames(in: structure) }
            m.bulkHeaders = bulk.trimmingCharacters(in: .whitespaces)
            // Le corps n'est rapatrié que pour les premiers messages : à
            // soixante, un aller-retour de 8 Ko chacun ferait attendre une
            // minute avant le premier affichage. Les suivants le chargent
            // à l'ouverture, et l'aperçu de leur ligne reste vide d'ici là.
            if i < snippetLimit {
                m.snippet = fetchSnippet(s, uid: uid, tag: "b\(i)")
            }
            m.category = MailSorter.categorize(m)
            m.threat = MailGuard.analyze(m)
            snap.messages.append(m)
        }
        s.write("a9 LOGOUT")
        return snap
    }

    /// Noms de pièces jointes extraits de BODYSTRUCTURE. Le format est
    /// une liste Lisp imbriquée pénible à analyser ; les noms y figurent
    /// toujours après NAME ou FILENAME, ce qui suffit ici.
    // ─────────────────────────────────────────────────────────
    //  BODYSTRUCTURE
    //
    //  Une liste imbriquée à la Lisp, que le serveur rend sur une
    //  ligne. On l'analyse pour de bon plutôt que d'y pêcher des noms
    //  de fichiers à l'expression régulière : sans les **numéros de
    //  section**, on sait qu'une pièce jointe existe mais pas où elle
    //  est, donc on ne peut ni l'ouvrir ni dire son poids.
    //
    //  La numérotation suit la RFC 3501 : les enfants d'une partie
    //  multiple portent son préfixe suivi de leur rang — 1, 2, puis
    //  1.1, 1.2 pour un multiple imbriqué dans le premier.
    // ─────────────────────────────────────────────────────────

    /// Un nœud de la structure : une chaîne, ou une liste de nœuds.
    private indirect enum SNode {
        case atom(String)
        case list([SNode])

        var text: String { if case .atom(let s) = self { return s }; return "" }
        var children: [SNode] { if case .list(let l) = self { return l }; return [] }
        var isList: Bool { if case .list = self { return true }; return false }
    }

    private static func tokenize(_ s: String) -> SNode {
        let chars = Array(s)
        var i = 0

        func parseList() -> SNode {
            var out: [SNode] = []
            i += 1                                  // la parenthèse ouvrante
            while i < chars.count {
                let c = chars[i]
                if c == ")" { i += 1; return .list(out) }
                if c == " " { i += 1; continue }
                if c == "(" { out.append(parseList()); continue }
                if c == "\"" {
                    var buf = ""
                    i += 1
                    while i < chars.count && chars[i] != "\"" {
                        if chars[i] == "\\" && i + 1 < chars.count {
                            buf.append(chars[i + 1]); i += 2; continue
                        }
                        buf.append(chars[i]); i += 1
                    }
                    i += 1
                    out.append(.atom(buf)); continue
                }
                var j = i
                while j < chars.count && chars[j] != " " && chars[j] != "(" && chars[j] != ")" {
                    j += 1
                }
                out.append(.atom(String(chars[i..<j])))
                i = j
            }
            return .list(out)
        }

        while i < chars.count && chars[i] != "(" { i += 1 }
        return i < chars.count ? parseList() : .list([])
    }

    /// Les parties d'un message, numérotées.
    static func parts(in structure: String) -> [MailPart] {
        guard !structure.isEmpty else { return [] }
        var out: [MailPart] = []
        walk(tokenize(structure), prefix: "", into: &out)
        return out
    }

    private static func walk(_ node: SNode, prefix: String, into out: inout [MailPart]) {
        let kids = node.children
        // Une partie multiple commence par ses enfants, qui sont des listes.
        if let first = kids.first, first.isList {
            var rank = 0
            for child in kids {
                guard child.isList else { break }
                rank += 1
                let p = prefix.isEmpty ? "\(rank)" : "\(prefix).\(rank)"
                walk(child, prefix: p, into: &out)
            }
            return
        }

        var part = MailPart()
        part.section = prefix.isEmpty ? "1" : prefix
        part.type = kids.count > 0 ? kids[0].text.uppercased() : ""
        part.subtype = kids.count > 1 ? kids[1].text.uppercased() : ""
        part.encoding = kids.count > 5 ? kids[5].text.uppercased() : ""
        part.size = kids.count > 6 ? (Int(kids[6].text) ?? 0) : 0

        // Le nom se trouve dans les paramètres, ou dans la disposition.
        // Les deux existent, et l'un sans l'autre est courant.
        if kids.count > 2, case .list(let params) = kids[2] {
            part.name = value(of: "NAME", in: params)
        }
        for el in kids where el.isList {
            let l = el.children
            guard let head = l.first, case .atom(let word) = head,
                  ["ATTACHMENT", "INLINE"].contains(word.uppercased()),
                  l.count > 1, case .list(let d) = l[1] else { continue }
            let f = value(of: "FILENAME", in: d)
            if !f.isEmpty { part.name = f }
        }
        part.name = decodeMimeHeader(part.name)
        out.append(part)
    }

    private static func value(of key: String, in pairs: [SNode]) -> String {
        var i = 0
        while i + 1 < pairs.count {
            if pairs[i].text.uppercased() == key { return pairs[i + 1].text }
            i += 2
        }
        return ""
    }

    /// Rapatrie une partie précise et la décode.
    static func fetchPart(user: String, auth: GmailAuthMode,
                          uid: String, part: MailPart) -> Data? {
        guard !uid.isEmpty, !part.section.isEmpty,
              part.section.range(of: "^[0-9]+(\\.[0-9]+)*$",
                                 options: .regularExpression) != nil,
              let s = TLSLineSocket(host: imapHost, port: 993) else { return nil }
        defer { s.close() }
        _ = s.readLine()
        switch auth {
        case .appPassword(let p): s.write("p1 LOGIN \"\(user)\" \"\(normalizedPassword(p))\"")
        case .oauth(let token):   s.write("p1 AUTHENTICATE XOAUTH2 \(token)")
        }
        var logged = false
        while let l = s.readLine() {
            if l.hasPrefix("p1 OK") { logged = true; break }
            if l.hasPrefix("p1 NO") || l.hasPrefix("p1 BAD") { break }
            if l.hasPrefix("+ ") { s.write("") }
        }
        guard logged else { return nil }
        // EXAMINE : ouvrir une pièce jointe ne doit pas marquer le message
        // comme lu dans votre boîte.
        s.write("p2 EXAMINE INBOX")
        while let l = s.readLine() { if l.hasPrefix("p2 ") { break } }

        s.write("p3 UID FETCH \(uid) (BODY.PEEK[\(part.section)])")
        var lines: [String] = []
        var first = true
        while let l = s.readLine() {
            if l.hasPrefix("p3 ") { break }
            if first {
                first = false
                if l.hasPrefix("*") && l.uppercased().contains("FETCH") { continue }
            }
            if l.trimmingCharacters(in: .whitespaces) == ")" { continue }
            lines.append(l)
        }
        s.write("p9 LOGOUT")

        let raw = lines.joined(separator: "\n")
        guard !raw.isEmpty else { return nil }
        if part.encoding == "BASE64" {
            let compact = raw.filter { !" \n\r\t".contains($0) }
            return Data(base64Encoded: compact, options: .ignoreUnknownCharacters)
        }
        return raw.data(using: .utf8)
    }

    static func attachmentNames(in structure: String) -> [String] {
        guard !structure.isEmpty,
              let re = try? NSRegularExpression(
                pattern: "\"(?:NAME|FILENAME)\"\\s+\"([^\"]{1,180})\"",
                options: [.caseInsensitive]) else { return [] }
        let r = NSRange(structure.startIndex..., in: structure)
        var out: [String] = []
        for m in re.matches(in: structure, range: r) {
            guard let rr = Range(m.range(at: 1), in: structure) else { continue }
            let name = decodeMimeHeader(String(structure[rr]))
            if !out.contains(name) { out.append(name) }
        }
        return out
    }

    /// Début du corps, pour l'analyse des liens et du vocabulaire.
    /// On ne lit que la première partie et on s'arrête vite : il ne s'agit
    /// pas d'afficher le message, seulement de le jauger.
    /// `bySequence` relève par numéro de séquence plutôt que par UID.
    /// Les messages envoyés se désignent ainsi : on veut « les quarante
    /// derniers », et le numéro de séquence donne ce rang directement,
    /// là où les UID sont des identités sans ordre garanti contigu.
    static func fetchSnippet(_ s: TLSLineSocket, uid: String, tag: String,
                             maxChars: Int = 8000, bySequence: Bool = false) -> String {
        s.write("\(tag) \(bySequence ? "FETCH" : "UID FETCH") \(uid) (BODY.PEEK[1]<0.8192>)")
        var lines: [String] = []
        var total = 0
        var first = true
        while let l = s.readLine() {
            if l.hasPrefix("\(tag) ") { break }

            // La réponse d'un FETCH n'est pas que le corps. Elle s'ouvre sur
            // une ligne non étiquetée — « * 9284 FETCH (UID 9284 BODY[1]<0>
            // {2048} » — et se referme sur une parenthèse seule. Les garder
            // revenait à afficher la commande IMAP en tête du message, ce
            // qu'on voyait dans le lecteur, et à la donner à l'analyse de
            // hameçonnage comme si c'était du texte de l'expéditeur.
            if first {
                first = false
                if l.hasPrefix("*") && l.uppercased().contains("FETCH") {
                    // Corps court : certains serveurs le renvoient entre
                    // guillemets sur cette même ligne plutôt qu'en littéral.
                    if let q = l.range(of: "BODY[", options: .caseInsensitive),
                       let open = l.range(of: "\"", range: q.upperBound..<l.endIndex),
                       let close = l.range(of: "\"", options: .backwards),
                       open.upperBound <= close.lowerBound {
                        lines.append(String(l[open.upperBound..<close.lowerBound]))
                    }
                    continue
                }
            }
            // La parenthèse de fermeture, seule sur sa ligne.
            if l.trimmingCharacters(in: .whitespaces) == ")" { continue }

            if total < maxChars {
                lines.append(l)
                total += l.count
            }
        }
        var body = lines.joined(separator: "\n")

        // Quoted-printable : les coupures « = » en fin de ligne et les =XX.
        if body.contains("=\n") || body.range(of: "=[0-9A-Fa-f]{2}", options: .regularExpression) != nil {
            body = body.replacingOccurrences(of: "=\n", with: "")
            while let r = body.range(of: "=[0-9A-Fa-f]{2}", options: .regularExpression) {
                let hex = String(body[r]).dropFirst()
                guard let v = UInt8(hex, radix: 16) else { break }
                body.replaceSubrange(r, with: String(UnicodeScalar(v)))
            }
        }

        // Partie encodée en base64 : sans décodage, l'analyse ne verrait rien.
        let compact = body.filter { !" \n\r\t".contains($0) }
        if compact.count > 80,
           compact.range(of: "^[A-Za-z0-9+/=]+$", options: .regularExpression) != nil,
           let d = Data(base64Encoded: compact, options: .ignoreUnknownCharacters),
           let decoded = String(data: d, encoding: .utf8) {
            body = decoded
        }
        return String(body.prefix(maxChars))
    }

    /// Déplace des messages vers le dossier indésirable du compte.
    /// Renvoie nil si tout s'est bien passé.
    /// L'état de la boîte en une commande, sans rapatrier un seul message :
    /// le prochain identifiant et le nombre de non-lus.
    ///
    /// C'est la clé du sondage de fond. Un relevé complet ouvre une session
    /// TLS, s'authentifie, cherche, puis rapatrie soixante en-têtes et douze
    /// corps : plusieurs secondes. Un STATUS, lui, coûte un aller-retour.
    /// On sonde donc souvent avec STATUS, et on ne paie le relevé complet
    /// que lorsqu'il a vraiment changé quelque chose.
    ///
    /// Ce que cela ne voit pas : une suppression faite ailleurs ne change ni
    /// UIDNEXT ni le nombre de non-lus si le message était déjà lu. Le
    /// bouton Actualiser reste donc utile, et il force le relevé complet.
    static func status(user: String, auth: GmailAuthMode) -> (uidNext: String, unseen: Int)? {
        guard let s = TLSLineSocket(host: imapHost, port: 993) else { return nil }
        defer { s.close() }
        _ = s.readLine()
        switch auth {
        case .appPassword(let p): s.write("s1 LOGIN \"\(user)\" \"\(normalizedPassword(p))\"")
        case .oauth(let token):   s.write("s1 AUTHENTICATE XOAUTH2 \(token)")
        }
        var logged = false
        while let l = s.readLine() {
            if l.hasPrefix("s1 OK") { logged = true; break }
            if l.hasPrefix("s1 NO") || l.hasPrefix("s1 BAD") { break }
            if l.hasPrefix("+ ") { s.write("") }
        }
        guard logged else { return nil }

        s.write("s2 STATUS INBOX (UIDNEXT UNSEEN)")
        var next = "", unseen = -1
        while let l = s.readLine() {
            if l.hasPrefix("s2 ") { break }
            if l.hasPrefix("*") && l.uppercased().contains("STATUS") {
                if let r = l.range(of: "UIDNEXT ([0-9]+)", options: .regularExpression) {
                    next = String(l[r]).components(separatedBy: " ").last ?? ""
                }
                if let r = l.range(of: "UNSEEN ([0-9]+)", options: .regularExpression) {
                    unseen = Int(String(l[r]).components(separatedBy: " ").last ?? "") ?? -1
                }
            }
        }
        s.write("s9 LOGOUT")
        return next.isEmpty ? nil : (next, unseen)
    }

    /// Rapatrie le corps d'un seul message, pour ceux que le relevé n'a
    /// pas chargés. Une connexion pour un message : c'est le prix de ne
    /// pas faire attendre une minute à l'ouverture de la boîte.
    static func body(user: String, auth: GmailAuthMode, uid: String) -> String? {
        guard !uid.isEmpty, let s = TLSLineSocket(host: imapHost, port: 993) else { return nil }
        defer { s.close() }
        _ = s.readLine()
        switch auth {
        case .appPassword(let p): s.write("c1 LOGIN \"\(user)\" \"\(normalizedPassword(p))\"")
        case .oauth(let token):   s.write("c1 AUTHENTICATE XOAUTH2 \(token)")
        }
        var logged = false
        while let l = s.readLine() {
            if l.hasPrefix("c1 OK") { logged = true; break }
            if l.hasPrefix("c1 NO") || l.hasPrefix("c1 BAD") { break }
            if l.hasPrefix("+ ") { s.write("") }
        }
        guard logged else { return nil }
        // EXAMINE et non SELECT : la boîte est ouverte en lecture seule,
        // pour qu'ouvrir un message ne le marque pas comme lu à l'insu
        // de l'utilisateur.
        s.write("c2 EXAMINE INBOX")
        while let l = s.readLine() { if l.hasPrefix("c2 ") { break } }
        let body = fetchSnippet(s, uid: uid, tag: "c3")
        s.write("c9 LOGOUT")
        return body.isEmpty ? nil : body
    }

    /// Déplace des messages vers l'indésirable.
    /// Les corps de vos derniers messages envoyés, pour apprendre vos
    /// tournures.
    ///
    /// Le dossier des envois n'a pas de nom fixe : « Sent », « Messages
    /// envoyés », « [Gmail]/Messages envoyés » selon la langue du compte.
    /// On le demande donc au serveur par son rôle `\\Sent`, comme pour les
    /// indésirables, plutôt que de deviner une traduction.
    ///
    /// `EXAMINE` et non `SELECT` : lire ses propres messages envoyés pour
    /// en apprendre le style ne doit rien modifier sur le serveur.
    static func sentBodies(user: String, auth: GmailAuthMode, limit: Int = 40) -> [String] {
        guard let s = TLSLineSocket(host: imapHost, port: 993) else { return [] }
        defer { s.close() }
        _ = s.readLine()
        switch auth {
        case .appPassword(let p): s.write("s1 LOGIN \"\(user)\" \"\(normalizedPassword(p))\"")
        case .oauth(let token):   s.write("s1 AUTHENTICATE XOAUTH2 \(token)")
        }
        var logged = false
        while let l = s.readLine() {
            if l.hasPrefix("s1 OK") { logged = true; break }
            if l.hasPrefix("s1 NO") || l.hasPrefix("s1 BAD") { break }
            if l.hasPrefix("+ ") { s.write("") }
        }
        guard logged else { return [] }

        var box = ""
        s.write("s2 LIST (SPECIAL-USE) \"\" \"*\"")
        while let l = s.readLine() {
            if l.hasPrefix("s2 ") { break }
            if l.contains("\\Sent"), let last = l.range(of: "\"", options: .backwards) {
                let head = l[l.startIndex..<last.lowerBound]
                if let open = head.range(of: "\"", options: .backwards) {
                    box = String(head[open.upperBound...])
                }
            }
        }
        if box.isEmpty { box = "[Gmail]/Sent Mail" }

        var count = 0
        s.write("s3 EXAMINE \"\(box)\"")
        while let l = s.readLine() {
            if l.hasPrefix("s3 ") { break }
            // « * 128 EXISTS » : le nombre de messages du dossier.
            if l.hasSuffix("EXISTS") {
                let parts = l.split(separator: " ")
                if parts.count >= 2 { count = Int(parts[1]) ?? 0 }
            }
        }
        guard count > 0 else { s.write("s9 LOGOUT"); return [] }

        // Les plus récents, par numéro de séquence : c'est le style
        // d'aujourd'hui qu'on veut apprendre, pas celui d'il y a cinq ans.
        let from = max(1, count - limit + 1)
        var bodies: [String] = []
        for n in stride(from: count, through: from, by: -1) {
            // Une étiquette par commande, jamais réutilisée : deux
            // commandes de même étiquette dans une session se confondent
            // à la lecture des réponses.
            let b = fetchSnippet(s, uid: String(n), tag: "sf\(n)", bySequence: true)
            if !b.isEmpty { bodies.append(b) }
            if bodies.count >= limit { break }
        }
        s.write("s9 LOGOUT")
        return bodies
    }

    static func quarantine(user: String, auth: GmailAuthMode, uids: [String]) -> String? {
        move(user: user, auth: auth, uids: uids, role: "\\Junk", fallback: "[Gmail]/Spam")
    }

    /// Déplace des messages vers la corbeille du compte. Un courriel n'est
    /// jamais effacé : il va dans la corbeille, où le serveur le gardera le
    /// temps qu'il voudra, et d'où l'utilisateur peut le reprendre.
    static func trash(user: String, auth: GmailAuthMode, uids: [String]) -> String? {
        move(user: user, auth: auth, uids: uids, role: "\\Trash", fallback: "[Gmail]/Trash")
    }

    /// Le déplacement, commun aux deux. Le dossier est demandé au serveur
    /// par son rôle : son nom est localisé, et le deviner marcherait chez
    /// Gmail en anglais et nulle part ailleurs.
    private static func move(user: String, auth: GmailAuthMode, uids: [String],
                             role: String, fallback: String) -> String? {
        guard !uids.isEmpty else { return nil }
        guard let s = TLSLineSocket(host: imapHost, port: 993) else { return "IMAP injoignable." }
        defer { s.close() }
        _ = s.readLine()

        switch auth {
        case .appPassword(let p): s.write("q1 LOGIN \"\(user)\" \"\(normalizedPassword(p))\"")
        case .oauth(let token):   s.write("q1 AUTHENTICATE XOAUTH2 \(token)")
        }
        var logged = false
        while let l = s.readLine() {
            if l.hasPrefix("q1 OK") { logged = true; break }
            if l.hasPrefix("q1 NO") || l.hasPrefix("q1 BAD") { break }
            if l.hasPrefix("+ ") { s.write("") }
        }
        guard logged else { return "Identifiants refusés." }

        var junk = ""
        s.write("q2 LIST (SPECIAL-USE) \"\" \"*\"")
        while let l = s.readLine() {
            if l.hasPrefix("q2 ") { break }
            if l.contains(role), let last = l.range(of: "\"", options: .backwards) {
                let head = l[l.startIndex..<last.lowerBound]
                if let open = head.range(of: "\"", options: .backwards) {
                    junk = String(head[open.upperBound...])
                }
            }
        }
        if junk.isEmpty { junk = fallback }

        s.write("q3 SELECT INBOX")
        while let l = s.readLine() { if l.hasPrefix("q3 ") { break } }

        let set = uids.joined(separator: ",")
        var moved = false
        s.write("q4 UID MOVE \(set) \"\(junk)\"")
        while let l = s.readLine() {
            if l.hasPrefix("q4 OK") { moved = true; break }
            if l.hasPrefix("q4 NO") || l.hasPrefix("q4 BAD") { break }
        }
        if !moved {
            // Serveur sans UID MOVE : copie, marquage, purge.
            s.write("q5 UID COPY \(set) \"\(junk)\"")
            var copied = false
            while let l = s.readLine() {
                if l.hasPrefix("q5 OK") { copied = true; break }
                if l.hasPrefix("q5 NO") || l.hasPrefix("q5 BAD") { break }
            }
            guard copied else { s.write("q9 LOGOUT"); return "Le dossier « \(junk) » a refusé la copie." }
            s.write("q6 UID STORE \(set) +FLAGS (\\Deleted)")
            while let l = s.readLine() { if l.hasPrefix("q6 ") { break } }
            s.write("q7 EXPUNGE")
            while let l = s.readLine() { if l.hasPrefix("q7 ") { break } }
        }
        s.write("q9 LOGOUT")
        return nil
    }

    private static func b64(_ s: String) -> String { Data(s.utf8).base64EncodedString() }

    private static func expect(_ s: TLSLineSocket, _ code: String) -> (Bool, String) {
        while let l = s.readLine() {
            guard l.count >= 4 else { continue }
            let idx = l.index(l.startIndex, offsetBy: 3)
            if l[idx] == "-" { continue }          // réponse multiligne, on poursuit
            return (l.hasPrefix(code), l)
        }
        return (false, "pas de réponse du serveur")
    }

    static func send(user: String, password: String, to: String,
                     subject: String, body: String) -> String {
        send(user: user, auth: .appPassword(password), to: to, subject: subject, body: body)
    }

    /// Envoi direct par SMTP sur TLS implicite (port 465).
    /// `inReplyTo` porte le Message-ID du message d'origine : sans lui,
    /// une réponse s'affiche comme un message isolé au lieu de se ranger
    /// dans le fil de discussion.
    static func send(user: String, auth: GmailAuthMode, to: String,
                     subject: String, body: String,
                     inReplyTo: String = "") -> String {
        guard let s = TLSLineSocket(host: smtpHost, port: 465) else {
            return "Connexion SMTP impossible."
        }
        defer { s.close() }

        guard expect(s, "220").0 else { return "Gmail n'a pas ouvert la session." }
        s.write("EHLO bud.local")
        guard expect(s, "250").0 else { return "EHLO refusé." }

        switch auth {
        case .oauth(let token):
            s.write("AUTH XOAUTH2 \(token)")
            let r = expect(s, "235")
            guard r.0 else { return "Jeton Google refusé par SMTP." }
        case .appPassword(let p):
            s.write("AUTH LOGIN")
            guard expect(s, "334").0 else { return "Authentification non proposée." }
            s.write(b64(user))
            guard expect(s, "334").0 else { return "Adresse refusée." }
            s.write(b64(normalizedPassword(p)))
            guard expect(s, "235").0 else { return "Mot de passe d'application refusé." }
        }

        s.write("MAIL FROM:<\(user)>")
        guard expect(s, "250").0 else { return "Expéditeur refusé." }
        s.write("RCPT TO:<\(to)>")
        let rcpt = expect(s, "250")
        guard rcpt.0 else { return "Destinataire refusé : \(rcpt.1)" }

        s.write("DATA")
        guard expect(s, "354").0 else { return "Corps du message refusé." }

        let df = DateFormatter()
        df.locale = Locale(identifier: "en_US_POSIX")
        df.dateFormat = "EEE, d MMM yyyy HH:mm:ss Z"
        let encodedSubject = "=?UTF-8?B?\(b64(subject))?="
        // Un point en début de ligne doit être doublé (RFC 5321)
        let safeBody = body.replacingOccurrences(of: "\r\n", with: "\n")
            .split(separator: "\n", omittingEmptySubsequences: false)
            .map { $0.hasPrefix(".") ? "." + $0 : String($0) }
            .joined(separator: "\r\n")

        var headerLines = [
            "From: \(user)",
            "To: \(to)",
            "Subject: \(encodedSubject)",
            "Date: \(df.string(from: Date()))",
            "MIME-Version: 1.0",
            "Content-Type: text/plain; charset=UTF-8",
            "Content-Transfer-Encoding: 8bit",
            "X-Mailer: BUD Premium"
        ]
        let ref = inReplyTo.trimmingCharacters(in: .whitespaces)
        if !ref.isEmpty {
            headerLines.append("In-Reply-To: \(ref)")
            headerLines.append("References: \(ref)")
        }
        let headers = headerLines.joined(separator: "\r\n")

        s.write(headers + "\r\n\r\n" + safeBody + "\r\n.", newline: true)
        let sent = expect(s, "250")
        s.write("QUIT")
        return sent.0 ? "Message envoyé à \(to)." : "Envoi refusé : \(sent.1)"
    }
}
EOF_BUDGMAIL_SWIFT

cat << 'EOF_BUDGUARD_SWIFT' > "$SRC_DIR/BudGuard.swift"
import Foundation
import AppKit

// ═══════════════════════════════════════════════════════════
//  Analyse de courrier indésirable, de hameçonnage et de
//  pièces jointes dangereuses.
//
//  Tout est local : aucun message, aucune adresse, aucun lien
//  n'est envoyé où que ce soit. BUD lit les en-têtes que le
//  serveur a déjà écrits (SPF, DKIM, DMARC) et applique des
//  règles de bon sens au reste.
//
//  Ce n'est pas un antivirus : BUD ne télécharge pas les pièces
//  jointes et n'inspecte pas leur contenu. Il reconnaît les
//  formes d'attaque, pas les signatures de logiciels malveillants.
// ═══════════════════════════════════════════════════════════

enum ThreatLevel: Int {
    case clean = 0, suspect = 1, dangerous = 2

    var label: String {
        switch self {
        case .clean: return "Sain"
        case .suspect: return "Suspect"
        case .dangerous: return "Dangereux"
        }
    }
    var color: NSColor {
        switch self {
        case .clean: return NSColor(calibratedRed: 0.35, green: 0.78, blue: 0.55, alpha: 1)
        case .suspect: return NSColor(calibratedRed: 0.95, green: 0.72, blue: 0.25, alpha: 1)
        case .dangerous: return NSColor(calibratedRed: 0.95, green: 0.36, blue: 0.40, alpha: 1)
        }
    }
    var icon: String {
        switch self {
        case .clean: return "checkmark.shield.fill"
        case .suspect: return "exclamationmark.triangle.fill"
        case .dangerous: return "xmark.shield.fill"
        }
    }
}

struct MailThreat: Codable {
    var score: Int = 0
    var reasons: [String] = []

    var level: ThreatLevel {
        if score >= 60 { return .dangerous }
        if score >= 25 { return .suspect }
        return .clean
    }

    mutating func add(_ points: Int, _ why: String) {
        score += points
        if !reasons.contains(why) { reasons.append(why) }
    }

    var summary: String {
        reasons.isEmpty ? "Rien de suspect." : reasons.joined(separator: " · ")
    }
}

/// Un fichier douteux trouvé dans les téléchargements.
struct SuspectFile {
    var url: URL
    var reason: String
    var fromWeb: Bool
}

enum MailGuard {

    // ── Vocabulaire des règles ──

    /// Extensions exécutables : aucune raison légitime de les recevoir.
    static let lethalExtensions: Set<String> = [
        "exe", "scr", "bat", "cmd", "com", "pif", "cpl", "msi", "msp",
        "vbs", "vbe", "js", "jse", "wsf", "wsh", "hta", "ps1", "psm1",
        "jar", "lnk", "inf", "reg", "scpt", "app", "pkg", "apk", "sh", "command"
    ]

    /// Bureautique à macros : vecteur classique.
    static let macroExtensions: Set<String> = [
        "docm", "xlsm", "xlsb", "pptm", "dotm", "xltm", "potm"
    ]

    /// Archives : BUD ne peut pas regarder dedans, d'où la prudence.
    static let archiveExtensions: Set<String> = [
        "zip", "rar", "7z", "iso", "img", "ace", "cab", "gz", "tgz"
    ]

    /// Marques usurpées en France, avec leurs domaines légitimes.
    static let brands: [(name: String, domains: [String])] = [
        ("paypal", ["paypal.com", "paypal.fr"]),
        ("apple", ["apple.com", "icloud.com"]),
        ("icloud", ["apple.com", "icloud.com"]),
        ("microsoft", ["microsoft.com", "outlook.com", "live.com", "office.com"]),
        ("netflix", ["netflix.com"]),
        ("amazon", ["amazon.fr", "amazon.com"]),
        ("google", ["google.com", "gmail.com", "google.fr"]),
        ("impots", ["dgfip.finances.gouv.fr", "impots.gouv.fr", "finances.gouv.fr"]),
        ("ameli", ["ameli.fr", "assurance-maladie.fr"]),
        ("chronopost", ["chronopost.fr"]),
        ("colissimo", ["colissimo.fr", "laposte.fr"]),
        ("la poste", ["laposte.fr", "laposte.net"]),
        ("dhl", ["dhl.com", "dhl.fr"]),
        ("fedex", ["fedex.com"]),
        ("ups", ["ups.com"]),
        ("orange", ["orange.fr", "orange.com"]),
        ("sfr", ["sfr.fr"]),
        ("bouygues", ["bouyguestelecom.fr"]),
        ("free", ["free.fr", "freemobile.fr"]),
        ("netflix", ["netflix.com"]),
        ("crédit agricole", ["credit-agricole.fr", "ca-", "credit-agricole.com"]),
        ("société générale", ["societegenerale.fr", "sg.fr"]),
        ("bnp", ["bnpparibas.net", "bnpparibas.com"]),
        ("boursorama", ["boursorama.com", "boursobank.com"]),
        ("revolut", ["revolut.com"]),
        ("n26", ["n26.com"]),
        ("edf", ["edf.fr"]),
        ("engie", ["engie.fr"])
    ]

    /// Tournures d'urgence ou de soutirage d'identifiants.
    static let pressurePhrases: [String] = [
        "votre compte sera suspendu", "compte suspendu", "compte bloque",
        "verifiez votre compte", "verifier votre compte", "confirmez votre identite",
        "mot de passe expire", "mettre a jour vos informations",
        "cliquez immediatement", "action requise", "derniere relance",
        "sous 24 heures", "sous 48 heures", "delai depasse",
        "remboursement", "vous avez gagne", "colis en attente",
        "frais de douane", "paiement refuse", "facture impayee",
        "regularisez", "suspension definitive",
        "verify your account", "confirm your password", "unusual activity",
        "your account has been", "click here immediately", "payment failed",
        "update your billing", "suspended", "act now"
    ]

    static let shorteners: Set<String> = [
        "bit.ly", "tinyurl.com", "cutt.ly", "is.gd", "t.co", "goo.gl",
        "ow.ly", "rb.gy", "shorturl.at", "rebrand.ly", "s.id", "lnkd.in"
    ]

    // ── Utilitaires d'adresse ──

    /// « Nom <a@b.com> » → « a@b.com »
    static func address(in s: String) -> String {
        if let o = s.range(of: "<"), let c = s.range(of: ">", range: o.upperBound..<s.endIndex) {
            return String(s[o.upperBound..<c.lowerBound])
                .trimmingCharacters(in: .whitespaces).lowercased()
        }
        // Pas de chevrons : on prend le premier jeton qui ressemble à une adresse.
        for token in s.split(whereSeparator: { " \t\"<>,;".contains($0) }) {
            if token.contains("@") { return String(token).lowercased() }
        }
        return s.trimmingCharacters(in: .whitespaces).lowercased()
    }

    /// « Nom <a@b.com> » → « Nom »
    static func displayName(in s: String) -> String {
        guard let o = s.range(of: "<") else { return "" }
        return String(s[s.startIndex..<o.lowerBound])
            .trimmingCharacters(in: CharacterSet(charactersIn: " \"'\t"))
    }

    static func domain(of address: String) -> String {
        guard let at = address.lastIndex(of: "@") else { return "" }
        return String(address[address.index(after: at)...])
            .trimmingCharacters(in: CharacterSet(charactersIn: " >\t")).lowercased()
    }

    /// Un domaine appartient-il vraiment à `base` ? « notpaypal.com » ne
    /// doit pas passer pour « paypal.com » : on exige la frontière du point.
    static func domain(_ d: String, isOrSub base: String) -> Bool {
        d == base || d.hasSuffix("." + base)
    }

    /// Minuscules sans accents, pour comparer du texte français.
    static func fold(_ s: String) -> String {
        s.folding(options: [.diacriticInsensitive, .caseInsensitive], locale: Locale(identifier: "fr_FR"))
    }

    /// Un mot mélangeant alphabet latin et cyrillique ou grec est un leurre.
    static func hasMixedScript(_ s: String) -> Bool {
        for word in s.split(whereSeparator: { $0 == " " || $0 == "\n" || $0 == "\t" }) {
            var latin = false, other = false
            for u in word.unicodeScalars {
                if (u.value >= 0x41 && u.value <= 0x5A) || (u.value >= 0x61 && u.value <= 0x7A) {
                    latin = true
                } else if (u.value >= 0x0400 && u.value <= 0x04FF)      // cyrillique
                            || (u.value >= 0x0370 && u.value <= 0x03FF) { // grec
                    other = true
                }
            }
            if latin && other { return true }
        }
        return false
    }

    /// Caractères de réécriture bidirectionnelle, utilisés pour déguiser
    /// « facture\u{202E}cod.exe » en « facture exe.doc ».
    static func hasBidiTrick(_ s: String) -> Bool {
        s.unicodeScalars.contains {
            (0x202A...0x202E).contains($0.value) || (0x2066...0x2069).contains($0.value)
        }
    }

    static func urls(in body: String) -> [String] {
        guard let re = try? NSRegularExpression(pattern: "https?://[^\\s\"'<>)\\]]+",
                                                options: [.caseInsensitive]) else { return [] }
        let r = NSRange(body.startIndex..., in: body)
        return re.matches(in: body, range: r).compactMap {
            Range($0.range, in: body).map { String(body[$0]) }
        }
    }

    static func host(ofURL u: String) -> String {
        var s = u
        for p in ["https://", "http://"] where s.lowercased().hasPrefix(p) {
            s = String(s.dropFirst(p.count))
        }
        if let slash = s.firstIndex(where: { $0 == "/" || $0 == "?" || $0 == "#" }) {
            s = String(s[s.startIndex..<slash])
        }
        if let at = s.lastIndex(of: "@") { s = String(s[s.index(after: at)...]) }
        if let colon = s.firstIndex(of: ":") { s = String(s[s.startIndex..<colon]) }
        return s.lowercased()
    }

    // ── L'analyse ──

    static func analyze(_ m: MailMessage) -> MailThreat {
        var t = MailThreat()

        let fromAddr = address(in: m.sender)
        let fromDom = domain(of: fromAddr)
        let name = displayName(in: m.sender)
        let foldedName = fold(name)
        let foldedSubject = fold(m.subject)
        let foldedBody = fold(m.snippet)
        let haystack = foldedSubject + " " + foldedBody

        // 1. Verdicts d'authentification écrits par le serveur receveur.
        let auth = m.authResults.lowercased()
        if auth.contains("dmarc=fail") {
            t.add(45, "DMARC en échec : l'expéditeur n'est pas autorisé par ce domaine")
        }
        if auth.contains("dkim=fail") {
            t.add(25, "signature DKIM invalide")
        }
        if auth.contains("spf=fail") || m.spf.lowercased().hasPrefix("fail") {
            t.add(30, "SPF en échec : serveur d'envoi non déclaré")
        } else if auth.contains("spf=softfail") || m.spf.lowercased().hasPrefix("softfail") {
            t.add(12, "SPF incertain")
        }

        // 2. Nom affiché qui contient une autre adresse que la vraie.
        if name.contains("@") {
            let shown = address(in: name)
            if !shown.isEmpty && shown != fromAddr && shown.contains("@") {
                t.add(32, "le nom affiché annonce \(shown) mais le message vient de \(fromAddr)")
            }
        }

        // 3. Marque usurpée : le nom cite une marque, le domaine ne suit pas.
        if !fromDom.isEmpty {
            for b in brands where foldedName.contains(b.name) {
                let legit = b.domains.contains { domain(fromDom, isOrSub: $0) || fromDom.hasPrefix($0) }
                if !legit {
                    t.add(30, "se présente comme « \(name) » depuis \(fromDom)")
                    break
                }
            }
        }

        // 4. Réponse détournée vers un autre domaine.
        if !m.replyTo.isEmpty {
            let rd = domain(of: address(in: m.replyTo))
            if !rd.isEmpty && !fromDom.isEmpty && rd != fromDom
                && !domain(rd, isOrSub: fromDom) && !domain(fromDom, isOrSub: rd) {
                t.add(22, "la réponse partirait vers \(rd), pas vers \(fromDom)")
            }
        }
        if !m.returnPath.isEmpty {
            let rp = domain(of: address(in: m.returnPath))
            if !rp.isEmpty && !fromDom.isEmpty && rp != fromDom
                && !domain(rp, isOrSub: fromDom) && !domain(fromDom, isOrSub: rp) {
                t.add(10, "chemin de retour vers \(rp)")
            }
        }

        // 5. Domaine d'expéditeur en punycode ou en écritures mélangées.
        if fromDom.contains("xn--") {
            t.add(35, "domaine en punycode, souvent un sosie typographique")
        }
        if hasMixedScript(name) || hasMixedScript(m.subject) {
            t.add(30, "caractères d'alphabets mélangés : imitation probable")
        }
        if hasBidiTrick(m.subject) {
            t.add(45, "l'objet contient des caractères d'inversion d'écriture")
        }

        // 6. Les liens.
        var sawIP = false, sawShort = false, sawPuny = false
        for u in urls(in: m.snippet) {
            let h = host(ofURL: u)
            if h.range(of: "^\\d{1,3}(\\.\\d{1,3}){3}$", options: .regularExpression) != nil {
                sawIP = true
            }
            if shorteners.contains(h) { sawShort = true }
            if h.contains("xn--") { sawPuny = true }
        }
        if sawIP { t.add(28, "lien pointant vers une adresse IP brute") }
        if sawShort { t.add(12, "lien raccourci masquant la destination") }
        if sawPuny { t.add(30, "lien vers un domaine en punycode") }

        // Texte du lien ≠ destination réelle.
        if let re = try? NSRegularExpression(
            pattern: "<a[^>]+href\\s*=\\s*[\"']([^\"']+)[\"'][^>]*>(.*?)</a>",
            options: [.caseInsensitive, .dotMatchesLineSeparators]) {
            let body = m.snippet
            let r = NSRange(body.startIndex..., in: body)
            for match in re.matches(in: body, range: r).prefix(40) {
                guard let hr = Range(match.range(at: 1), in: body),
                      let tr = Range(match.range(at: 2), in: body) else { continue }
                let realHost = host(ofURL: String(body[hr]))
                let shown = String(body[tr])
                    .replacingOccurrences(of: "<[^>]+>", with: "", options: .regularExpression)
                    .trimmingCharacters(in: .whitespacesAndNewlines)
                guard shown.contains("."), !shown.contains(" "), shown.count > 4 else { continue }
                let shownHost = host(ofURL: shown)
                if !shownHost.isEmpty && !realHost.isEmpty && shownHost != realHost
                    && !domain(realHost, isOrSub: shownHost) && !domain(shownHost, isOrSub: realHost) {
                    t.add(38, "un lien affiche \(shownHost) mais mène à \(realHost)")
                    break
                }
            }
        }

        // 7. Pièces jointes.
        for file in m.attachments {
            let lower = file.lowercased()
            let ext = (lower as NSString).pathExtension
            let stem = (lower as NSString).deletingPathExtension
            let innerExt = (stem as NSString).pathExtension

            if hasBidiTrick(file) {
                t.add(60, "nom de pièce jointe truqué par inversion d'écriture : \(file)")
            }
            if lethalExtensions.contains(ext) {
                t.add(65, "pièce jointe exécutable : \(file)")
            } else if macroExtensions.contains(ext) {
                t.add(45, "document à macros : \(file)")
            } else if archiveExtensions.contains(ext) {
                t.add(15, "archive dont BUD ne peut pas voir le contenu : \(file)")
            }
            if !innerExt.isEmpty && lethalExtensions.contains(ext) == false
                && ["pdf", "doc", "docx", "jpg", "jpeg", "png", "xls", "xlsx", "txt"].contains(innerExt)
                && !["pdf", "doc", "docx", "jpg", "jpeg", "png", "xls", "xlsx", "txt"].contains(ext) {
                t.add(50, "double extension : \(file)")
            }
        }

        // 8. Pression et soutirage.
        var pressure = 0
        for p in pressurePhrases where haystack.contains(p) { pressure += 1 }
        if pressure > 0 {
            t.add(min(30, 10 * pressure), "formulation d'urgence (\(pressure) marqueur\(pressure > 1 ? "s" : ""))")
        }
        let asksSecret = haystack.contains("mot de passe") || haystack.contains("code secret")
            || haystack.contains("identifiant") || haystack.contains("carte bancaire")
            || haystack.contains("numero de carte") || haystack.contains("password")
            || haystack.contains("iban")
        if asksSecret && !urls(in: m.snippet).isEmpty {
            t.add(25, "demande des informations confidentielles avec un lien")
        }

        return t
    }

    // ── Volet local : les fichiers déjà téléchargés ──

    /// Passe les téléchargements en revue. BUD ne lit pas le contenu des
    /// fichiers : il repère les formes dangereuses et interroge Gatekeeper,
    /// qui, lui, connaît les signatures connues d'Apple.
    static func scanDownloads(limit: Int = 400) -> [SuspectFile] {
        let fm = FileManager.default
        guard let dl = fm.urls(for: .downloadsDirectory, in: .userDomainMask).first else { return [] }
        guard let items = try? fm.contentsOfDirectory(at: dl,
                                                      includingPropertiesForKeys: [.isDirectoryKey],
                                                      options: [.skipsHiddenFiles]) else { return [] }
        var out: [SuspectFile] = []
        for url in items.prefix(limit) {
            let name = url.lastPathComponent
            let ext = url.pathExtension.lowercased()
            let stem = (name.lowercased() as NSString).deletingPathExtension
            let innerExt = (stem as NSString).pathExtension

            // Provenance : l'attribut de quarantaine signe un fichier venu du web.
            let quarantined = !shell("/usr/bin/xattr",
                                     ["-p", "com.apple.quarantine", url.path]).isEmpty

            var reason: String?
            if hasBidiTrick(name) {
                reason = "nom truqué par inversion d'écriture"
            } else if lethalExtensions.contains(ext) && quarantined && ext != "app" && ext != "pkg" {
                reason = "exécutable téléchargé depuis le web"
            } else if !innerExt.isEmpty
                        && ["pdf", "doc", "docx", "jpg", "jpeg", "png", "txt"].contains(innerExt)
                        && lethalExtensions.contains(ext) {
                reason = "double extension : se fait passer pour un \(innerExt.uppercased())"
            } else if macroExtensions.contains(ext) && quarantined {
                reason = "document à macros téléchargé"
            } else if (ext == "app" || ext == "pkg" || ext == "dmg") && quarantined {
                // Gatekeeper tranche mieux que n'importe quelle heuristique.
                let verdict = shell("/usr/sbin/spctl",
                                    ["--assess", "--type", ext == "app" ? "execute" : "install",
                                     url.path])
                if verdict.lowercased().contains("rejected") {
                    reason = "rejeté par Gatekeeper : ni signé ni notarié"
                }
            }

            if let r = reason {
                out.append(SuspectFile(url: url, reason: r, fromWeb: quarantined))
            }
        }
        return out
    }

    /// Exécute un outil système et renvoie sa sortie, erreurs comprises.
    static func shell(_ launch: String, _ args: [String]) -> String {
        guard FileManager.default.isExecutableFile(atPath: launch) else { return "" }
        let p = Process()
        p.executableURL = URL(fileURLWithPath: launch)
        p.arguments = args
        let pipe = Pipe()
        p.standardOutput = pipe
        p.standardError = pipe
        do { try p.run() } catch { return "" }
        let d = pipe.fileHandleForReading.readDataToEndOfFile()
        p.waitUntilExit()
        return String(data: d, encoding: .utf8) ?? ""
    }

    /// Met des fichiers à la corbeille plutôt que de les détruire :
    /// une fausse alerte doit rester réparable.
    @discardableResult
    static func trash(_ files: [URL]) -> Int {
        var n = 0
        for f in files {
            if (try? FileManager.default.trashItem(at: f, resultingItemURL: nil)) != nil { n += 1 }
        }
        return n
    }
}
EOF_BUDGUARD_SWIFT

cat << 'EOF_BUDHOME_SWIFT' > "$SRC_DIR/BudHome.swift"
import Cocoa

// ═══════════════════════════════════════════════════════════
//  La maison
//
//  Pourquoi Raccourcis et pas HomeKit directement : le cadre
//  HomeKit n'est pas ouvert aux applications AppKit. Apple
//  ne le permet sur Mac qu'aux applications Catalyst, avec
//  un droit spécial délivré à un compte développeur payant.
//  BUD n'a ni l'un ni l'autre.
//
//  Raccourcis, lui, a l'action « Contrôler la maison », et
//  macOS fournit `/usr/bin/shortcuts` pour lancer un
//  raccourci depuis n'importe quel programme. Donc : on crée
//  dans Raccourcis un dossier « BUD Maison », un raccourci
//  par commande (« Lumière salon », « Bonne nuit »…), et BUD
//  les présente en tuiles, comme l'application Maison.
//
//  L'avantage caché : chaque commande a été construite par
//  vous, dans l'application d'Apple. BUD ne voit jamais vos
//  appareils, ne reçoit aucun accès à HomeKit, et ne peut
//  faire que ce que vous avez mis dans le dossier.
// ═══════════════════════════════════════════════════════════

struct HomeScene {
    let name: String
    var symbol: String { HomeShortcuts.symbol(for: name) }
    var tint: NSColor { HomeShortcuts.tint(for: name) }
}

final class HomeShortcuts {
    static let shared = HomeShortcuts()
    static let tool = "/usr/bin/shortcuts"

    private(set) var scenes: [HomeScene] = []
    /// Vrai quand le dossier n'existe pas encore dans Raccourcis.
    private(set) var folderMissing = false
    private(set) var loaded = false
    private(set) var trouble = ""
    var onChange: (() -> Void)?

    private let q = DispatchQueue(label: "fr.lahbib.bud.home")

    static var available: Bool { FileManager.default.isExecutableFile(atPath: tool) }

    /// Relit le dossier. La commande prend une demi-seconde : jamais sur
    /// le fil principal.
    func reload(folder: String) {
        let f = folder.trimmingCharacters(in: .whitespacesAndNewlines)
        guard HomeShortcuts.available else {
            DispatchQueue.main.async {
                self.loaded = true
                self.trouble = "Raccourcis n'est pas disponible sur ce Mac."
                self.onChange?()
            }
            return
        }
        q.async {
            let folders = runShellDetailed(HomeShortcuts.tool, ["list", "--folders"])
            let names = folders.out.split(separator: "\n").map {
                $0.trimmingCharacters(in: .whitespaces)
            }
            let missing = !names.contains { $0.lowercased() == f.lowercased() }
            var scenes: [HomeScene] = []
            var trouble = ""
            if !missing {
                // Le nom exact du dossier, tel que Raccourcis l'écrit.
                let exact = names.first { $0.lowercased() == f.lowercased() } ?? f
                let r = runShellDetailed(HomeShortcuts.tool, ["list", "--folder-name", exact])
                if r.status != 0 { trouble = "Lecture du dossier impossible." }
                scenes = r.out.split(separator: "\n")
                    .map { $0.trimmingCharacters(in: .whitespaces) }
                    .filter { !$0.isEmpty }
                    .map { HomeScene(name: $0) }
            } else if folders.status != 0 {
                trouble = "Raccourcis ne répond pas."
            }
            DispatchQueue.main.async {
                self.scenes = scenes
                self.folderMissing = missing && trouble.isEmpty
                self.trouble = trouble
                self.loaded = true
                self.onChange?()
            }
        }
    }

    /// Lance un raccourci. `done` reçoit, sur le fil principal, vrai si
    /// tout s'est bien passé et la sortie éventuelle du raccourci — un
    /// raccourci qui se termine par « Afficher le résultat » peut ainsi
    /// répondre « Salon allumé ».
    ///
    /// Un raccourci peut attendre une réponse qu'on ne lui donnera jamais :
    /// au bout de vingt secondes, on l'arrête.
    func run(_ name: String, done: @escaping (Bool, String) -> Void) {
        q.async {
            let p = Process()
            p.executableURL = URL(fileURLWithPath: HomeShortcuts.tool)
            p.arguments = ["run", name, "--output-path", "-"]
            let out = Pipe(), err = Pipe()
            p.standardOutput = out
            p.standardError = err
            do { try p.run() } catch {
                DispatchQueue.main.async { done(false, "Lancement impossible.") }
                return
            }
            let killer = DispatchWorkItem { if p.isRunning { p.terminate() } }
            DispatchQueue.global().asyncAfter(deadline: .now() + 20, execute: killer)
            let o = out.fileHandleForReading.readDataToEndOfFile()
            let e = err.fileHandleForReading.readDataToEndOfFile()
            p.waitUntilExit()
            killer.cancel()
            let text = (String(data: o, encoding: .utf8) ?? "")
                .trimmingCharacters(in: .whitespacesAndNewlines)
            let errText = (String(data: e, encoding: .utf8) ?? "")
                .trimmingCharacters(in: .whitespacesAndNewlines)
            let ok = p.terminationStatus == 0
            DispatchQueue.main.async {
                done(ok, ok ? String(text.prefix(140))
                            : (p.terminationReason == .uncaughtSignal ? "Délai dépassé."
                                                                       : HomeShortcuts.clean(errText)))
            }
        }
    }

    /// Les messages de `shortcuts` sont en anglais et techniques ; on en
    /// garde l'idée.
    private static func clean(_ e: String) -> String {
        let l = e.lowercased()
        if l.contains("couldn’t find") || l.contains("couldn't find") || l.contains("not found") {
            return "Raccourci introuvable."
        }
        if l.contains("permission") || l.contains("not allowed") { return "Autorisation refusée." }
        return "Le raccourci a échoué."
    }

    // ─────────────────────────────────────────────────────────
    //  Retrouver une commande dite à voix haute
    //
    //  « Allume le salon » doit trouver « Lumière salon ». On ne
    //  compare pas des phrases mais des mots : celui qui
    //  partage le plus de mots significatifs gagne, et il faut
    //  au moins tous les mots du nom ou deux mots communs. Un
    //  seul mot vague comme « lumière » ne suffit pas quand
    //  trois raccourcis le contiennent.
    // ─────────────────────────────────────────────────────────

    private static let filler: Set<String> = [
        "le", "la", "les", "l", "de", "du", "des", "d", "un", "une", "et", "a", "au", "aux",
        "mets", "met", "lance", "active", "allume", "eteins", "ferme", "ouvre", "baisse",
        "monte", "en", "mode", "scene", "stp", "s", "il", "te", "plait", "bud", "hey", "dans"
    ]

    private static func words(_ s: String) -> [String] {
        s.folding(options: [.diacriticInsensitive, .caseInsensitive], locale: Locale(identifier: "fr_FR"))
            .components(separatedBy: CharacterSet.alphanumerics.inverted)
            .filter { !$0.isEmpty }
    }

    func match(_ phrase: String) -> HomeScene? {
        let said = Set(HomeShortcuts.words(phrase))
        let saidKey = said.subtracting(HomeShortcuts.filler)
        var best: (HomeScene, Int)? = nil
        var tie = false
        for s in scenes {
            let all = HomeShortcuts.words(s.name)
            let key = Set(all).subtracting(HomeShortcuts.filler)
            // Le nom en entier, verbe compris : « Allume salon » dit tel quel.
            if !all.isEmpty && Set(all).isSubset(of: said) {
                let score = 100 + all.count
                if best == nil || score > best!.1 { best = (s, score); tie = false }
                continue
            }
            let common = key.intersection(saidKey).count
            guard common > 0, common == key.count || common >= 2 else { continue }
            if best == nil || common > best!.1 { best = (s, common); tie = false }
            else if common == best!.1 { tie = true }
        }
        return tie ? nil : best?.0
    }

    // ─────────────────────────────────────────────────────────
    //  L'apparence d'une tuile, d'après son nom
    //
    //  Raccourcis ne dit pas ce que fait un raccourci ; son nom,
    //  si. Symboles présents depuis macOS 12.
    // ─────────────────────────────────────────────────────────

    private static let kinds: [([String], String, NSColor)] = [
        (["bonne nuit", "coucher", "nuit", "dodo"], "moon.fill",
         NSColor(srgbRed: 0.48, green: 0.45, blue: 0.98, alpha: 1)),
        (["bonjour", "reveil", "matin"], "sun.max.fill",
         NSColor(srgbRed: 1.00, green: 0.72, blue: 0.20, alpha: 1)),
        (["depart", "je pars", "absent", "quitte"], "figure.walk",
         NSColor(srgbRed: 0.30, green: 0.70, blue: 1.00, alpha: 1)),
        (["arrivee", "rentre", "maison", "retour"], "house.fill",
         NSColor(srgbRed: 1.00, green: 0.60, blue: 0.22, alpha: 1)),
        (["film", "cinema", "tele", "tv"], "tv.fill",
         NSColor(srgbRed: 0.56, green: 0.40, blue: 1.00, alpha: 1)),
        (["chauffage", "thermostat", "temperature", "radiateur", "clim"], "thermometer",
         NSColor(srgbRed: 1.00, green: 0.45, blue: 0.30, alpha: 1)),
        (["ventilateur", "ventilo", "air"], "fan.fill",
         NSColor(srgbRed: 0.30, green: 0.80, blue: 0.85, alpha: 1)),
        (["serrure", "porte", "verrou", "garage"], "lock.fill",
         NSColor(srgbRed: 0.35, green: 0.75, blue: 1.00, alpha: 1)),
        (["volet", "store", "rideau"], "arrow.up.and.down.square.fill",
         NSColor(srgbRed: 0.55, green: 0.70, blue: 0.85, alpha: 1)),
        (["prise", "multiprise"], "powerplug.fill",
         NSColor(srgbRed: 0.35, green: 0.85, blue: 0.55, alpha: 1)),
        (["camera", "alarme", "securite"], "video.fill",
         NSColor(srgbRed: 1.00, green: 0.40, blue: 0.40, alpha: 1)),
        (["musique", "enceinte", "homepod"], "hifispeaker.fill",
         NSColor(srgbRed: 0.98, green: 0.40, blue: 0.62, alpha: 1)),
        (["lumiere", "lampe", "eclairage", "ampoule", "allume", "eteins", "led"], "lightbulb.fill",
         NSColor(srgbRed: 1.00, green: 0.80, blue: 0.26, alpha: 1))
    ]

    private static func kind(for name: String) -> (String, NSColor)? {
        let n = words(name).joined(separator: " ")
        for (keys, sym, col) in kinds where keys.contains(where: { n.contains($0) }) {
            return (sym, col)
        }
        return nil
    }
    static func symbol(for name: String) -> String { kind(for: name)?.0 ?? "house.fill" }
    static func tint(for name: String) -> NSColor { kind(for: name)?.1 ?? TH.accent }
}

// ═══════════════════════════════════════════════════════════
//  Le panneau Maison
//
//  Des tuiles carrées arrondies, comme l'application Maison :
//  une pastille de couleur avec le symbole, le nom dessous.
//  Un clic lance la commande ; la tuile tourne pendant
//  l'exécution, puis montre une coche ou une croix deux
//  secondes, avec le message rendu par le raccourci.
// ═══════════════════════════════════════════════════════════

final class HomeTile: NSView {
    enum State { case idle, running, done, failed }
    let scene: HomeScene
    var state: State = .idle { didSet { needsDisplay = true; animate() } }
    var note = "" { didSet { needsDisplay = true } }
    var onClick: ((HomeTile) -> Void)?

    private var hover = false
    private var spin: CGFloat = 0
    private var timer: Timer?

    init(frame: NSRect, scene: HomeScene) {
        self.scene = scene
        super.init(frame: frame)
        wantsLayer = true
        toolTip = scene.name
    }
    required init?(coder: NSCoder) { fatalError() }

    override func updateTrackingAreas() {
        super.updateTrackingAreas()
        trackingAreas.forEach { removeTrackingArea($0) }
        addTrackingArea(NSTrackingArea(rect: bounds, options: [.mouseEnteredAndExited, .activeAlways, .inVisibleRect],
                                       owner: self, userInfo: nil))
    }
    override func mouseEntered(with e: NSEvent) { hover = true; needsDisplay = true }
    override func mouseExited(with e: NSEvent) { hover = false; needsDisplay = true }
    override func mouseUp(with e: NSEvent) {
        guard state != .running, bounds.contains(convert(e.locationInWindow, from: nil)) else { return }
        onClick?(self)
    }

    private func animate() {
        if state == .running, timer == nil {
            let t = Timer(timeInterval: 1.0 / 30.0, repeats: true) { [weak self] _ in
                self?.spin += 0.22; self?.needsDisplay = true
            }
            RunLoop.main.add(t, forMode: .common)
            timer = t
        } else if state != .running {
            timer?.invalidate(); timer = nil
        }
    }

    override func draw(_ dirty: NSRect) {
        let b = bounds.insetBy(dx: 1, dy: 1)
        let active = state == .running || state == .done
        let shape = NSBezierPath(roundedRect: b, xRadius: 18, yRadius: 18)
        // Une tuile active s'éclaire, comme un accessoire allumé dans
        // l'application Maison : fond presque blanc, texte sombre.
        if active && TH.dark {
            NSColor(white: 0.96, alpha: 0.95).setFill()
        } else {
            TH.fill(hover ? 0.13 : 0.08).setFill()
        }
        shape.fill()
        TH.fill(0.10).setStroke()
        shape.lineWidth = 0.8
        shape.stroke()

        let ink: NSColor = (active && TH.dark) ? NSColor(white: 0.1, alpha: 1) : TH.text
        let c = NSPoint(x: b.minX + 30, y: b.maxY - 30)
        let disc = NSRect(x: c.x - 17, y: c.y - 17, width: 34, height: 34)
        scene.tint.withAlphaComponent(active ? 1 : 0.9).setFill()
        NSBezierPath(ovalIn: disc).fill()

        switch state {
        case .running:
            let p = NSBezierPath()
            p.appendArc(withCenter: c, radius: 10, startAngle: spin * 57.3, endAngle: spin * 57.3 + 260)
            p.lineWidth = 2.4
            p.lineCapStyle = .round
            NSColor.white.setStroke()
            p.stroke()
        case .done:
            drawSymbol("checkmark", center: c, size: 15, weight: .bold, color: .white)
        case .failed:
            drawSymbol("exclamationmark", center: c, size: 15, weight: .bold, color: .white)
        case .idle:
            drawSymbol(scene.symbol, center: c, size: 15, weight: .semibold, color: .white)
        }

        drawString(scene.name, in: NSRect(x: b.minX + 14, y: b.minY + 28, width: b.width - 24, height: 17),
                   size: 13, weight: .semibold, color: ink)
        let sub: String
        switch state {
        case .idle: sub = "Toucher pour lancer"
        case .running: sub = "En cours…"
        case .done: sub = note.isEmpty ? "Fait" : note
        case .failed: sub = note.isEmpty ? "Échec" : note
        }
        drawString(sub, in: NSRect(x: b.minX + 14, y: b.minY + 12, width: b.width - 24, height: 15),
                   size: 11, weight: .medium,
                   color: state == .failed ? dangerColor : ink.withAlphaComponent(0.55))
    }
}

final class HomePanelView: NSView {
    private let scroll: NSScrollView
    private let grid = FlippedView()
    private var tiles: [HomeTile] = []
    private var info: NSTextField!
    private var folderField: NSTextField!
    private var emptyView: NSView?

    var folder: () -> String = { "BUD Maison" }
    var onFolder: ((String) -> Void)?
    /// Prévient l'application qu'une commande a tourné, pour BUDs.
    var onRan: ((String, Bool) -> Void)?

    override init(frame: NSRect) {
        scroll = NSScrollView(frame: NSRect(x: 0, y: 0, width: frame.width, height: frame.height - 92))
        super.init(frame: frame)
        let W = frame.width, H = frame.height

        addSubview(mkLabel("Maison", NSRect(x: 0, y: H - 34, width: 300, height: 28), 22, .bold))
        info = mkLabel("Vos commandes HomeKit, lancées par Raccourcis.",
                       NSRect(x: 0, y: H - 58, width: W - 20, height: 18), 12, .medium, alpha: 0.55)
        addSubview(info)

        addSubview(mkLabel("Dossier", NSRect(x: 0, y: H - 86, width: 60, height: 18), 11.5, .semibold, alpha: 0.6))
        folderField = NSTextField(frame: NSRect(x: 58, y: H - 89, width: 170, height: 24))
        folderField.bezelStyle = .roundedBezel
        folderField.font = NSFont.systemFont(ofSize: 12)
        folderField.target = self
        folderField.action = #selector(folderEntered)
        addSubview(folderField)

        let reload = GlassButton(frame: NSRect(x: 238, y: H - 91, width: 100, height: 28),
                                 title: "Recharger", icon: "arrow.clockwise", compact: true)
        reload.onClick = { [weak self] _ in self?.reload() }
        addSubview(reload)
        let open = GlassButton(frame: NSRect(x: 346, y: H - 91, width: 150, height: 28),
                               title: "Ouvrir Raccourcis", icon: "square.on.square", compact: true)
        open.onClick = { _ in HomePanelView.openShortcuts() }
        addSubview(open)

        scroll.drawsBackground = false
        scroll.hasVerticalScroller = true
        scroll.autohidesScrollers = true
        scroll.documentView = grid
        addSubview(scroll)

        HomeShortcuts.shared.onChange = { [weak self] in self?.rebuild() }
    }
    required init?(coder: NSCoder) { fatalError() }

    static func openShortcuts() {
        if let u = NSWorkspace.shared.urlForApplication(withBundleIdentifier: "com.apple.shortcuts") {
            NSWorkspace.shared.openApplication(at: u, configuration: NSWorkspace.OpenConfiguration(),
                                               completionHandler: nil)
        }
    }

    @objc private func folderEntered() {
        let f = folderField.stringValue.trimmingCharacters(in: .whitespaces)
        guard !f.isEmpty else { return }
        onFolder?(f)
        reload()
    }

    func reload() {
        if folderField.currentEditor() == nil { folderField.stringValue = folder() }
        HomeShortcuts.shared.reload(folder: folder())
    }

    private func rebuild() {
        tiles.forEach { $0.removeFromSuperview() }
        tiles = []
        emptyView?.removeFromSuperview()
        emptyView = nil
        let h = HomeShortcuts.shared
        let W = scroll.frame.width - 14

        if !h.trouble.isEmpty || h.folderMissing || h.scenes.isEmpty {
            showEmpty(h)
            grid.frame = NSRect(x: 0, y: 0, width: W, height: scroll.frame.height)
            return
        }
        info.stringValue = "\(h.scenes.count) commande\(h.scenes.count > 1 ? "s" : "") dans « \(folder()) »."

        let cols = max(2, Int((W + 12) / 168))
        let tw = (W - CGFloat(cols - 1) * 12) / CGFloat(cols)
        let th: CGFloat = 112
        for (i, s) in h.scenes.enumerated() {
            let r = i / cols, c = i % cols
            let t = HomeTile(frame: NSRect(x: CGFloat(c) * (tw + 12), y: CGFloat(r) * (th + 12),
                                           width: tw, height: th), scene: s)
            t.onClick = { [weak self] tile in self?.launch(tile) }
            grid.addSubview(t)
            tiles.append(t)
        }
        let rows = (h.scenes.count + cols - 1) / cols
        grid.frame = NSRect(x: 0, y: 0, width: W,
                            height: max(scroll.frame.height, CGFloat(rows) * (th + 12)))
    }

    /// Lance par son nom : depuis le chat, la voix ou une tuile, le même
    /// chemin, et la tuile montre ce qui se passe.
    func launch(named name: String, done: ((Bool, String) -> Void)? = nil) {
        if let t = tiles.first(where: { $0.scene.name == name }) {
            launch(t, done: done)
        } else {
            HomeShortcuts.shared.run(name) { [weak self] ok, msg in
                self?.onRan?(name, ok); done?(ok, msg)
            }
        }
    }

    private func launch(_ t: HomeTile, done: ((Bool, String) -> Void)? = nil) {
        t.state = .running
        HomeShortcuts.shared.run(t.scene.name) { [weak self, weak t] ok, msg in
            t?.note = msg
            t?.state = ok ? .done : .failed
            self?.onRan?(t?.scene.name ?? "", ok)
            done?(ok, msg)
            DispatchQueue.main.asyncAfter(deadline: .now() + (ok ? 2.2 : 4)) {
                if t?.state != .running { t?.note = ""; t?.state = .idle }
            }
        }
    }

    /// Quand il n'y a rien à montrer, on explique comment faire — en
    /// quatre étapes, dans les mots de Raccourcis.
    private func showEmpty(_ h: HomeShortcuts) {
        let v = FlippedView(frame: NSRect(x: 0, y: 0, width: scroll.frame.width - 14, height: 260))
        let card = mkCard(v, NSRect(x: 0, y: 0, width: v.frame.width, height: 236), radius: Radius.l)
        _ = card
        let title: String
        if !h.loaded { title = "Lecture de Raccourcis…" }
        else if !h.trouble.isEmpty { title = h.trouble }
        else if h.folderMissing { title = "Le dossier « \(folder()) » n'existe pas encore dans Raccourcis." }
        else { title = "Le dossier « \(folder()) » est vide." }
        info.stringValue = "Vos commandes HomeKit, lancées par Raccourcis."

        let steps = [
            "1. Ouvrez Raccourcis et créez un dossier nommé « \(folder()) ».",
            "2. Dans ce dossier, créez un raccourci par commande : « Lumière salon », « Bonne nuit »…",
            "3. Ajoutez-y l'action « Contrôler la maison » et choisissez la scène ou l'accessoire.",
            "4. Revenez ici et cliquez sur Recharger. Dites ensuite « Hey Bud, lumière salon »."
        ]
        let lbl = mkLabel(title, NSRect(x: 20, y: 22, width: v.frame.width - 40, height: 20), 14, .semibold)
        v.addSubview(lbl)
        for (i, s) in steps.enumerated() {
            let l = mkLabel(s, NSRect(x: 20, y: 60 + CGFloat(i) * 30, width: v.frame.width - 40, height: 18),
                            12.5, .medium, alpha: 0.75)
            v.addSubview(l)
        }
        let note = mkLabel("BUD ne voit jamais vos appareils : il ne lance que ce dossier.",
                           NSRect(x: 20, y: 190, width: v.frame.width - 40, height: 16), 11, .medium, alpha: 0.45)
        v.addSubview(note)
        grid.addSubview(v)
        emptyView = v
    }
}

/// Une vue dont l'origine est en haut : la grille se remplit de haut en
/// bas, comme on la lit.
final class FlippedView: NSView {
    override var isFlipped: Bool { true }
}
EOF_BUDHOME_SWIFT

cat << 'EOF_BUDMAIL_SWIFT' > "$SRC_DIR/BudMail.swift"
import Cocoa

// ═══════════════════════════════════════════════════════════
//  Courrier
//  BUD s'appuie sur Mail.app, déjà configuré avec votre compte
//  Gmail : aucun mot de passe ne transite par BUD, aucune clé
//  d'API, aucune connexion sortante de notre fait.
// ═══════════════════════════════════════════════════════════

/// Une partie d'un message, telle que `BODYSTRUCTURE` la décrit.
struct MailPart: Codable {
    /// Le numéro de section IMAP : « 2 », « 1.2 »… C'est ce qu'il faut
    /// pour aller chercher cette partie précise, et rien d'autre.
    var section = "1"
    var type = ""          // TEXT, IMAGE, APPLICATION…
    var subtype = ""       // PLAIN, PNG, PDF…
    var name = ""          // nom de fichier, vide pour le corps
    var encoding = ""      // BASE64, QUOTED-PRINTABLE…
    var size = 0

    /// Une pièce jointe est une partie qui porte un nom de fichier. Le
    /// corps du message n'en a pas, et c'est exactement ce qui les sépare.
    var isAttachment: Bool { !name.isEmpty }

    /// Le symbole qui va avec le type de fichier.
    var icon: String {
        switch type.uppercased() {
        case "IMAGE": return "photo"
        case "AUDIO": return "waveform"
        case "VIDEO": return "film"
        case "TEXT":  return "doc.text"
        default:
            switch subtype.uppercased() {
            case "PDF":  return "doc.richtext"
            case "ZIP", "X-ZIP-COMPRESSED", "GZIP": return "doc.zipper"
            default:     return "paperclip"
            }
        }
    }

    var readableSize: String {
        guard size > 0 else { return "" }
        return formatBytes(Int64(size))
    }
}

struct MailMessage: Codable {
    let subject: String
    let sender: String
    let date: String

    // Enrichissements IMAP. Valeurs par défaut : la passerelle Mail.app
    // ne les fournit pas, et l'initialiseur à trois champs reste valable.
    var uid: String = ""
    var messageID: String = ""
    var replyTo: String = ""
    var returnPath: String = ""
    var authResults: String = ""
    var spf: String = ""
    var snippet: String = ""
    var attachments: [String] = []
    var unread: Bool = true
    var threat = MailThreat()

    /// Adresse seule, sans le nom affiché.
    var address: String { MailGuard.address(in: sender) }

    /// Ce qu'on montre dans la liste : le nom s'il existe, sinon l'adresse.
    var shortSender: String {
        let n = MailGuard.displayName(in: sender)
        return n.isEmpty ? address : n
    }

    /// La date telle qu'une liste la montre.
    var shortDate: String { MailDate.short(header: date) }

    /// Première ligne du corps, pour l'aperçu : les retours à la ligne, les
    /// tabulations et les espaces insécables d'un courriel HTML converti
    /// deviennent un seul espace, sinon l'aperçu affiche des trous.
    var preview: String {
        let flat = snippet
            .replacingOccurrences(of: "<[^>]+>", with: " ", options: .regularExpression)
            .replacingOccurrences(of: "&nbsp;", with: " ")
            // L'espace insécable est écrit en échappement Swift, et non en
            // « \u » d'expression régulière, qu'ICU n'accepte pas entre
            // accolades : la classe reçoit donc le caractère lui-même.
            .replacingOccurrences(of: "[\\s\u{00A0}]+", with: " ", options: .regularExpression)
            .trimmingCharacters(in: .whitespacesAndNewlines)
        return String(flat.prefix(200))
    }

    /// Les en-têtes d'envoi en masse réunis : List-Unsubscribe, List-Id,
    /// Precedence. Trois façons de dire la même chose.
    var bulkHeaders: String = ""
    /// Les parties du message, telles que le serveur les décrit. Permet
    /// d'afficher une pièce jointe avec son type et son poids, et d'aller
    /// la chercher par son numéro de section.
    var parts: [MailPart] = []
    /// Le type auquel BUD rattache ce message.
    var category: MailCategory = .principal

    /// Les deux lettres de la pastille : initiales du nom si on en a un,
    /// sinon les deux premières de l'adresse.
    var initials: String {
        let src = MailGuard.displayName(in: sender)
        let words = src.split(whereSeparator: { $0 == " " || $0 == "." || $0 == "-" || $0 == "_" })
            .filter { $0.first?.isLetter == true }
        if words.count >= 2, let a = words[0].first, let b = words[1].first {
            return String(a).uppercased() + String(b).uppercased()
        }
        let base = words.first.map(String.init) ?? address
        let letters = base.filter { $0.isLetter }
        return letters.isEmpty ? "?" : String(letters.prefix(2)).uppercased()
    }

    /// La teinte de la pastille, tirée de l'adresse : le même correspondant
    /// garde sa couleur d'une session à l'autre, ce qui est tout l'intérêt —
    /// on reconnaît l'expéditeur avant d'avoir lu son nom.
    ///
    /// Les teintes sont prises dans une roue de douze, et non en continu :
    /// deux adresses voisines sur le cercle donneraient deux couleurs
    /// qu'on ne distingue pas.
    var tint: NSColor {
        let key = address.isEmpty ? sender : address
        var h: UInt64 = 5381
        for b in key.lowercased().utf8 { h = (h << 5) &+ h &+ UInt64(b) }
        let hue = CGFloat(h % 12) / 12.0
        return NSColor(calibratedHue: hue, saturation: 0.52, brightness: 0.92, alpha: 1)
    }

    /// Le corps, prêt à lire. Beaucoup de courriels n'ont qu'une version
    /// HTML : affiché tel quel, on lirait des balises. On ne rend pas le
    /// HTML — on en extrait le texte, en gardant les sauts de paragraphe.
    var readableBody: String {
        var s = snippet
        if s.range(of: "<(br|p|div|table|html|body)\\b", options: [.regularExpression, .caseInsensitive]) != nil {
            // Les balises de bloc deviennent des sauts de ligne avant que
            // tout le reste ne disparaisse, sinon le texte se recollerait
            // en un seul paragraphe illisible.
            s = s.replacingOccurrences(of: "<(br|/p|/div|/tr|/h[1-6])\\s*/?>", with: "\n",
                                       options: [.regularExpression, .caseInsensitive])
            s = s.replacingOccurrences(of: "<(script|style)\\b[^>]*>[\\s\\S]*?</\\1>", with: "",
                                       options: [.regularExpression, .caseInsensitive])
            s = s.replacingOccurrences(of: "<[^>]+>", with: "", options: .regularExpression)
        }
        for (e, c) in [("&nbsp;", " "), ("&amp;", "&"), ("&lt;", "<"), ("&gt;", ">"),
                       ("&quot;", "\""), ("&#39;", "'"), ("&apos;", "'"), ("&eacute;", "é"),
                       ("&egrave;", "è"), ("&agrave;", "à"), ("&ccedil;", "ç"), ("&euro;", "€")] {
            s = s.replacingOccurrences(of: e, with: c, options: .caseInsensitive)
        }
        // Les espaces en fin de ligne et les lignes vides en rafale : un
        // courriel HTML converti en produit des dizaines.
        s = s.replacingOccurrences(of: "[ \\t\u{00A0}]+\n", with: "\n", options: .regularExpression)
        s = s.replacingOccurrences(of: "\n{3,}", with: "\n\n", options: .regularExpression)
        return s.trimmingCharacters(in: .whitespacesAndNewlines)
    }
}

// ═══════════════════════════════════════════════════════════
//  Le classement par type
//
//  Quatre casiers, comme dans Mail : ce qu'on vous écrit, ce
//  qui concerne un achat, ce qui vous informe, ce qui vous
//  vend quelque chose.
//
//  Le signal décisif n'est pas dans l'objet mais dans les
//  en-têtes : un message portant un lien de désabonnement est
//  un envoi en masse, point. C'est une information que
//  l'expéditeur fournit lui-même, et qu'il n'a aucun intérêt à
//  falsifier — contrairement à un objet, qu'on écrit pour
//  attirer l'œil. Les mots-clés ne servent qu'à départager les
//  envois en masse entre eux, et à rattraper le cas d'une
//  facture envoyée sans en-tête de liste.
//
//  Le classement ne cache rien et ne supprime rien : il range.
//  Un message mal rangé reste visible dans « Tous ».
// ═══════════════════════════════════════════════════════════

enum MailCategory: Int, CaseIterable, Codable {
    case principal, transactions, updates, promotions

    var label: String {
        switch self {
        case .principal:    return "Principal"
        case .transactions: return "Transactions"
        case .updates:      return "Mises à jour"
        case .promotions:   return "Promotions"
        }
    }
    var icon: String {
        switch self {
        case .principal:    return "person.crop.circle"
        case .transactions: return "creditcard"
        case .updates:      return "bell"
        case .promotions:   return "tag"
        }
    }
    var color: NSColor {
        switch self {
        case .principal:    return NSColor(calibratedRed: 0.42, green: 0.66, blue: 1.00, alpha: 1)
        case .transactions: return NSColor(calibratedRed: 0.40, green: 0.82, blue: 0.56, alpha: 1)
        case .updates:      return NSColor(calibratedRed: 0.74, green: 0.47, blue: 1.00, alpha: 1)
        case .promotions:   return NSColor(calibratedRed: 0.96, green: 0.69, blue: 0.27, alpha: 1)
        }
    }
}

enum MailSorter {

    private static func norm(_ s: String) -> String {
        s.lowercased().folding(options: [.diacriticInsensitive],
                               locale: Locale(identifier: "fr_FR"))
    }

    private static func any(_ t: String, _ words: [String]) -> Bool {
        words.contains { t.contains($0) }
    }

    /// Un achat, une facture, un virement, une livraison : ce qu'on garde
    /// parce qu'on en aura besoin. Reconnu même sans en-tête de liste,
    /// car beaucoup de confirmations partent d'un vrai serveur de gestion.
    private static let moneyWords = [
        "facture", "recu de", "votre recu", "votre commande", "commande n",
        "paiement", "virement", "prelevement", "remboursement", "devis",
        "renouvellement", "echeance", "votre abonnement",
        "votre colis", "livraison", "expedie", "suivi de commande",
        "reservation", "billet", "confirmation de", "numero de commande",
        "order", "invoice", "receipt", "payment", "shipped", "delivery"
    ]

    /// Ce qui pousse à acheter. Le point d'exclamation et les pourcentages
    /// sont caractéristiques, mais ne suffisent jamais seuls.
    private static let saleWords = [
        "promo", "promotion", "solde", "reduction", "-50%", "-30%", "-20%",
        "offre", "exclusif", "vente privee", "code promo", "bon plan",
        "derniere chance", "jusqu a -", "gratuit", "cadeau", "deal",
        "black friday", "sale", "discount", "offer"
    ]

    /// Ce qui informe sans rien vendre.
    private static let newsWords = [
        "newsletter", "actualite", "infolettre", "recapitulatif", "resume de",
        "nouveautes", "votre semaine", "digest", "notification", "alerte",
        "mise a jour", "rapport", "a la une"
    ]

    static func categorize(_ m: MailMessage) -> MailCategory {
        let subject = norm(m.subject)
        let from = norm(m.sender + " " + m.address)
        let bulk = !m.bulkHeaders.isEmpty

        // Une transaction prime sur tout le reste, en masse ou non : une
        // confirmation de commande part souvent d'une plateforme qui
        // ajoute un lien de désabonnement, et la ranger en promotions
        // ferait perdre la seule trace d'un achat.
        if any(subject, moneyWords) { return .transactions }
        if any(from, ["facture", "billing", "invoice", "commande", "order",
                      "payment", "paiement", "no-reply@paypal", "service-client"]) {
            return .transactions
        }

        // Sans en-tête d'envoi en masse, c'est quelqu'un qui écrit.
        guard bulk else { return .principal }

        if any(subject, saleWords) { return .promotions }
        if any(subject, newsWords) { return .updates }

        // Reste les envois en masse indécidables. Une adresse d'expédition
        // commerciale penche vers la promotion ; sinon on informe.
        if any(from, ["promo", "offres", "marketing", "deals", "shop",
                      "boutique", "news@", "newsletter"]) {
            return any(from, ["news@", "newsletter"]) ? .updates : .promotions
        }
        return .updates
    }
}

// ═══════════════════════════════════════════════════════════
//  Les dates d'en-tête
//
//  « Sun, 22 Nov 2026 09:41:00 +0100 » tronqué à 17 caractères
//  donnait « Sun, 22 Nov 2026 », coupé au milieu d'un mot dès
//  que le fuseau s'écrivait autrement. On analyse donc la date
//  pour de bon, puis on l'écrit comme une liste de courrier :
//  l'heure aujourd'hui, le jour et le mois cette année.
//
//  L'analyse se fait en locale POSIX, jamais celle du système :
//  un Mac en français ne reconnaîtrait ni « Sun » ni « Nov ».
//  L'affichage, lui, suit la langue de l'utilisateur.
// ═══════════════════════════════════════════════════════════

enum MailDate {
    private static let parsers: [DateFormatter] = {
        [
            "EEE, d MMM yyyy HH:mm:ss Z",
            "EEE, d MMM yyyy HH:mm Z",
            "d MMM yyyy HH:mm:ss Z",
            "d MMM yyyy HH:mm Z",
            "EEE, d MMM yyyy HH:mm:ss",
            "d MMM yyyy HH:mm:ss",
            "yyyy-MM-dd HH:mm:ss Z",
            "yyyy-MM-dd'T'HH:mm:ssZ",
            "yyyy-MM-dd HH:mm:ss"
        ].map { f -> DateFormatter in
            let d = DateFormatter()
            d.locale = Locale(identifier: "en_US_POSIX")
            d.dateFormat = f
            return d
        }
    }()

    private static func display(_ format: String) -> DateFormatter {
        let d = DateFormatter()
        d.setLocalizedDateFormatFromTemplate(format)
        return d
    }
    private static let hhmm = display("Hm")
    private static let dayMonth = display("dMMM")
    private static let full = display("dMMMyy")

    static func parse(_ s: String) -> Date? {
        var t = s.trimmingCharacters(in: .whitespacesAndNewlines)
        // La RFC 5322 autorise un commentaire en queue : « +0100 (CET) ».
        if let i = t.firstIndex(of: "(") {
            t = String(t[t.startIndex..<i]).trimmingCharacters(in: .whitespaces)
        }
        for p in parsers {
            if let d = p.date(from: t) { return d }
        }
        return nil
    }

    static func short(header s: String) -> String {
        guard let d = parse(s) else {
            // Analyse impossible : on garde les mots entiers du jour et du
            // mois plutôt que de couper la chaîne au hasard.
            let w = s.split(separator: " ")
            return w.count >= 3 ? w[1...2].joined(separator: " ") : String(s.prefix(12))
        }
        let cal = Calendar.current
        if cal.isDateInToday(d) { return hhmm.string(from: d) }
        if cal.isDateInYesterday(d) { return "hier" }
        if cal.component(.year, from: d) == cal.component(.year, from: Date()) {
            return dayMonth.string(from: d)
        }
        return full.string(from: d)
    }
}

enum MailBridge {

    @discardableResult
    static func osa(_ script: String) -> String {
        runShell("/usr/bin/osascript", ["-e", script])
    }

    static func mailAppInstalled() -> Bool {
        FileManager.default.fileExists(atPath: "/System/Applications/Mail.app")
            || FileManager.default.fileExists(atPath: "/Applications/Mail.app")
    }

    static func mailRunning() -> Bool {
        NSWorkspace.shared.runningApplications.contains {
            $0.bundleIdentifier == "com.apple.mail"
        }
    }

    /// Nombre de messages non lus, toutes boîtes de réception confondues.
    /// Renvoie -1 si Mail n'est pas joignable (fermé, ou autorisation refusée).
    static func unreadCount() -> Int {
        guard mailRunning() else { return -1 }
        let out = osa("""
        tell application "Mail"
            try
                set n to 0
                repeat with acc in every account
                    try
                        set n to n + (count of (messages of mailbox "INBOX" of acc whose read status is false))
                    end try
                end repeat
                if n = 0 then set n to (count of (messages of inbox whose read status is false))
                return n
            on error
                return -1
            end try
        end tell
        """)
        return Int(out.trimmingCharacters(in: .whitespacesAndNewlines)) ?? -1
    }

    /// Les derniers messages non lus de la boîte de réception.
    static func latestUnread(_ limit: Int = 5) -> [MailMessage] {
        guard mailRunning() else { return [] }
        let out = osa("""
        tell application "Mail"
            try
                set res to ""
                set msgs to (messages of inbox whose read status is false)
                set n to count of msgs
                if n > \(limit) then set n to \(limit)
                repeat with i from 1 to n
                    set m to item i of msgs
                    -- Le corps est coupé à 200 caractères du côté
                    -- d'AppleScript : un message de plusieurs mégaoctets
                    -- ne doit pas traverser la sortie d'osascript pour
                    -- qu'on n'en garde qu'une ligne d'aperçu.
                    set c to ""
                    try
                        set c to (content of m)
                        if (count of c) > 200 then set c to (text 1 thru 200 of c)
                    end try
                    set res to res & (subject of m) & "|~|" & (sender of m) & "|~|" & ((date received of m) as string) & "|~|" & c & "|#|"
                end repeat
                return res
            on error
                return ""
            end try
        end tell
        """)
        return out.components(separatedBy: "|#|").compactMap { block in
            let p = block.components(separatedBy: "|~|")
            guard p.count >= 3 else { return nil }
            var m = MailMessage(subject: p[0].trimmingCharacters(in: .whitespacesAndNewlines),
                                sender: p[1].trimmingCharacters(in: .whitespacesAndNewlines),
                                date: p[2].trimmingCharacters(in: .whitespacesAndNewlines))
            if p.count >= 4 { m.snippet = p[3] }
            // Sans en-tête de liste — AppleScript ne les donne pas — le
            // classement ne repose que sur l'objet et l'expéditeur : il
            // reconnaîtra une facture, et rangera le reste en principal.
            m.category = MailSorter.categorize(m)
            return m
        }
    }

    private static func esc(_ s: String) -> String {
        s.replacingOccurrences(of: "\\", with: "\\\\")
         .replacingOccurrences(of: "\"", with: "\\\"")
    }

    /// Envoie par Mail.app. `from` vide : le compte par défaut est utilisé.
    static func send(to: String, subject: String, body: String, from: String) -> String {
        guard mailAppInstalled() else { return "Mail.app est introuvable sur ce Mac." }
        var props = "{subject:\"\(esc(subject))\", content:\"\(esc(body))\", visible:false"
        if !from.isEmpty { props += ", sender:\"\(esc(from))\"" }
        props += "}"
        let out = osa("""
        tell application "Mail"
            try
                set m to make new outgoing message with properties \(props)
                tell m
                    make new to recipient at end of to recipients with properties {address:"\(esc(to))"}
                    send
                end tell
                return "ok"
            on error errMsg
                return errMsg
            end try
        end tell
        """)
        if out.hasPrefix("ok") { return "Message envoyé à \(to)." }
        if out.isEmpty { return "Mail n'a pas répondu. Autorisez BUD dans Confidentialité → Automatisation." }
        return "Envoi refusé : \(out)"
    }

    /// Ouvre une fenêtre de rédaction pré-remplie, sans rien envoyer.
    static func compose(to: String, subject: String, body: String) {
        var c = URLComponents()
        c.scheme = "mailto"
        c.path = to
        c.queryItems = [URLQueryItem(name: "subject", value: subject),
                        URLQueryItem(name: "body", value: body)]
        if let u = c.url { NSWorkspace.shared.open(u) }
    }

    static func openInbox() {
        if mailAppInstalled() { runShell("/usr/bin/open", ["-a", "Mail"]) }
        else if let u = URL(string: "https://mail.google.com/") { NSWorkspace.shared.open(u) }
    }

    static func openGmailWeb() {
        if let u = URL(string: "https://mail.google.com/mail/u/0/#inbox") { NSWorkspace.shared.open(u) }
    }
}

/// Choisit la bonne voie : Gmail en direct quand un compte est enregistré,
/// Mail.app sinon.
enum MailRouter {
    /// Adresse du compte « mot de passe d'application », vide si aucun.
    static var account: String = ""
    static var appPassword: String? { account.isEmpty ? nil : BudKeychain.get(account) }

    static var oauthReady: Bool { GmailAuth.shared.isConnected }
    static var gmailReady: Bool { oauthReady || appPassword != nil }

    static var activeAddress: String {
        oauthReady ? GmailAuth.shared.email : account
    }
    static var sourceLabel: String {
        if oauthReady { return "Google" }
        if appPassword != nil { return "Gmail" }
        return "Mail.app"
    }

    private static func mode() -> (String, GmailAuthMode)? {
        if oauthReady, let x = GmailAuth.shared.xoauth2() {
            return (GmailAuth.shared.email, .oauth(x))
        }
        if let p = appPassword { return (account, .appPassword(p)) }
        return nil
    }

    static func snapshot(_ limit: Int = 5)
        -> (unread: Int, msgs: [MailMessage], source: String, error: String?, uidNext: String) {
        if let (user, auth) = mode() {
            let s = GmailClient.fetchInbox(user: user, auth: auth, limit: limit)
            return (s.unread, s.messages, sourceLabel, s.error, s.uidNext)
        }
        guard MailBridge.mailRunning() else { return (-1, [], "Mail.app", "Mail est fermé.", "") }
        // La passerelle AppleScript n'a pas de chargement différé : chaque
        // message coûte son corps dans la même réponse. Au-delà d'une
        // vingtaine, l'attente devient sensible, donc on plafonne ici
        // plutôt que de laisser la boîte se figer.
        // La passerelle n'a pas d'identifiants : pas de sondage possible,
        // donc pas de uidNext. Le relevé complet aura toujours lieu.
        return (MailBridge.unreadCount(), MailBridge.latestUnread(min(limit, 20)), "Mail.app", nil, "")
    }

    /// Vos derniers messages envoyés, pour l'apprentissage du style.
    /// Possible en IMAP seulement : la passerelle Mail.app n'expose pas
    /// le dossier des envois.
    static func sentBodies(limit: Int = 40) -> [String] {
        guard let (user, auth) = mode() else { return [] }
        return GmailClient.sentBodies(user: user, auth: auth, limit: limit)
    }

    static func send(to: String, subject: String, body: String, mailFrom: String,
                     inReplyTo: String = "") -> String {
        if let (user, auth) = mode() {
            return GmailClient.send(user: user, auth: auth, to: to,
                                    subject: subject, body: body, inReplyTo: inReplyTo)
        }
        return MailBridge.send(to: to, subject: subject, body: body, from: mailFrom)
    }

    /// Déplace des messages vers le dossier indésirable. Possible
    /// uniquement en IMAP : la passerelle Mail.app ne l'expose pas.
    static func quarantine(_ uids: [String]) -> String? {
        guard let (user, auth) = mode() else {
            return "Reliez un compte Gmail pour isoler des messages."
        }
        return GmailClient.quarantine(user: user, auth: auth, uids: uids)
    }

    /// L'état de la boîte en un aller-retour, pour le sondage de fond.
    /// `nil` quand le compte n'est pas relié ou que le serveur n'a pas
    /// répondu : l'appelant fait alors le relevé complet.
    static func status() -> (uidNext: String, unseen: Int)? {
        guard let (user, auth) = mode() else { return nil }
        return GmailClient.status(user: user, auth: auth)
    }

    /// Rapatrie une pièce jointe et la rend décodée.
    static func attachment(uid: String, part: MailPart) -> Data? {
        guard let (user, auth) = mode() else { return nil }
        return GmailClient.fetchPart(user: user, auth: auth, uid: uid, part: part)
    }

    /// Le corps d'un message que le relevé n'a pas chargé.
    static func body(uid: String) -> String? {
        guard let (user, auth) = mode() else { return nil }
        return GmailClient.body(user: user, auth: auth, uid: uid)
    }

    /// Met des messages à la corbeille du compte. Rien n'est effacé :
    /// le serveur les garde, et ils se reprennent depuis la corbeille.
    static func trash(_ uids: [String]) -> String? {
        guard let (user, auth) = mode() else {
            return "Reliez un compte Gmail pour supprimer des messages."
        }
        return GmailClient.trash(user: user, auth: auth, uids: uids)
    }
}

/// La pastille d'initiales de l'expéditeur, en grand pour le lecteur.
final class InitialsDisc: NSView {
    var message: MailMessage? { didSet { needsDisplay = true } }

    override init(frame: NSRect) { super.init(frame: frame) }
    required init?(coder: NSCoder) { fatalError() }

    override func draw(_ dirty: NSRect) {
        let b = bounds
        guard let m = message else { return }
        let t = m.tint
        t.withAlphaComponent(0.24).setFill()
        NSBezierPath(ovalIn: b).fill()
        t.withAlphaComponent(0.55).setStroke()
        let ring = NSBezierPath(ovalIn: b.insetBy(dx: 0.5, dy: 0.5))
        ring.lineWidth = 1
        ring.stroke()
        drawString(m.initials, in: NSRect(x: b.minX, y: b.midY - 9, width: b.width, height: 19),
                   size: 15.5, weight: .bold, color: t, align: .center)
    }
}

/// Une ligne de la boîte de réception : expéditeur, objet, date et
/// verdict d'analyse. Dessinée à la main pour tenir en 46 pt sans
/// rien tronquer et pour réagir au survol.
final class MailRow: NSView {
    let message: MailMessage
    var selected = false { didSet { needsDisplay = true } }
    var onSelect: ((MailMessage) -> Void)?
    var onSwipeDelete: ((MailMessage) -> Void)?
    var onSwipeReply: ((MailMessage) -> Void)?
    /// Mode sélection : la pastille d'initiales cède la place à une case.
    var picking = false { didSet { needsDisplay = true } }
    var checked = false { didSet { needsDisplay = true } }
    private var hover = false
    private var track: NSTrackingArea?

    /// Décalage horizontal de la carte pendant un balayage, en points.
    /// Négatif vers la gauche, ce qui découvre « Supprimer » à droite.
    private var dragX: CGFloat = 0
    private var swiping = false
    private var springT: Timer?
    /// Au-delà de ce décalage, le geste déclenche son action au relâchement.
    private let trigger: CGFloat = 78

    init(frame: NSRect, message: MailMessage) {
        self.message = message
        super.init(frame: frame)
        wantsLayer = true
    }
    required init?(coder: NSCoder) { fatalError() }

    deinit { springT?.invalidate() }

    // ═══════════ Balayage ═══════════
    //
    //  Un trackpad n'envoie pas de « geste de balayage » : il envoie des
    //  événements de défilement avec une phase. On lit donc scrollWheel,
    //  et toute la difficulté est de ne pas voler le défilement vertical
    //  de la liste qui nous contient.
    //
    //  La direction est décidée une fois, au début du geste, et tenue
    //  jusqu'au relâchement : arbitrer à chaque événement ferait sauter
    //  la carte entre défilement et balayage au moindre tremblement.

    override func scrollWheel(with e: NSEvent) {
        // Une molette de souris n'a pas de phase et ne doit pas balayer.
        guard e.hasPreciseScrollingDeltas else { super.scrollWheel(with: e); return }

        switch e.phase {
        case .began:
            swiping = abs(e.scrollingDeltaX) > abs(e.scrollingDeltaY) * 1.4
            if !swiping { super.scrollWheel(with: e) }
        case .changed:
            guard swiping else { super.scrollWheel(with: e); return }
            springT?.invalidate()
            dragX += e.scrollingDeltaX * swipeSign
            // Au-delà du seuil, le geste résiste : on sent qu'on est allé
            // au bout, sans pouvoir tirer la carte hors du panneau.
            let limit: CGFloat = 132
            if abs(dragX) > limit { dragX = dragX < 0 ? -limit : limit }
            needsDisplay = true
        case .ended, .cancelled:
            guard swiping else { super.scrollWheel(with: e); return }
            swiping = false
            let d = dragX
            if d <= -trigger { onSwipeDelete?(message) }
            else if d >= trigger { onSwipeReply?(message) }
            springBack()
        default:
            if !swiping { super.scrollWheel(with: e) }
        }
    }

    /// Retour élastique à zéro. La carte revient toujours en place, même
    /// quand l'action part : la liste se recharge derrière, et une carte
    /// restée ouverte sur une rangée qui n'existe plus serait un fantôme.
    private func springBack() {
        springT?.invalidate()
        guard dragX != 0 else { return }
        springT = Timer.scheduledTimer(withTimeInterval: 1.0 / 60, repeats: true) { [weak self] t in
            guard let s = self else { t.invalidate(); return }
            s.dragX *= 0.76
            if abs(s.dragX) < 0.6 { s.dragX = 0; t.invalidate(); s.springT = nil }
            s.needsDisplay = true
        }
    }

    override func updateTrackingAreas() {
        super.updateTrackingAreas()
        if let t = track { removeTrackingArea(t) }
        let t = NSTrackingArea(rect: bounds, options: [.mouseEnteredAndExited, .activeInKeyWindow],
                               owner: self, userInfo: nil)
        addTrackingArea(t)
        track = t
    }
    override func mouseEntered(with e: NSEvent) { hover = true; needsDisplay = true }
    override func mouseExited(with e: NSEvent) { hover = false; needsDisplay = true }
    override func mouseDown(with e: NSEvent) { onSelect?(message) }

    override func draw(_ dirty: NSRect) {
        let r = bounds
        if dragX != 0 { drawSwipeBackdrop(r) }

        let ctx = NSGraphicsContext.current
        ctx?.saveGraphicsState()
        // La carte glisse, le fond d'action reste : c'est ce décalage du
        // repère qui donne l'impression de tirer la carte de côté.
        if dragX != 0 { ctx?.cgContext.translateBy(x: dragX, y: 0) }
        drawCard(r)
        ctx?.restoreGraphicsState()
    }

    /// Ce qu'on découvre sous la carte pendant le balayage : rouge et
    /// « Supprimer » à droite quand on tire vers la gauche, bleu et
    /// « Répondre » à gauche quand on tire vers la droite. La couleur
    /// s'affirme au passage du seuil, pour qu'on sache que ça va partir.
    private func drawSwipeBackdrop(_ r: NSRect) {
        let left = dragX > 0
        let armed = abs(dragX) >= trigger
        let col = left ? TH.accent : dangerColor
        let strip = left ? NSRect(x: r.minX, y: r.minY, width: dragX, height: r.height)
                         : NSRect(x: r.maxX + dragX, y: r.minY, width: -dragX, height: r.height)

        let p = NSBezierPath(roundedRect: r, xRadius: 11, yRadius: 11)
        NSGraphicsContext.current?.saveGraphicsState()
        p.addClip()
        col.withAlphaComponent(armed ? 0.92 : 0.45).setFill()
        strip.fill()

        // L'étiquette reste au milieu de la bande découverte, mais jamais
        // collée au bord : sans cette marge elle serait coupée au départ
        // du geste, quand la bande ne fait que quelques points.
        let cx = left ? min(strip.midX, r.minX + 54) : max(strip.midX, r.maxX - 54)
        if abs(dragX) > 26 {
            drawSymbol(left ? "arrowshape.turn.up.left.fill" : "trash.fill",
                       center: NSPoint(x: cx, y: r.midY + 7), size: 15, weight: .semibold,
                       color: .white)
            drawString(left ? "Répondre" : "Supprimer",
                       in: NSRect(x: cx - 48, y: r.midY - 20, width: 96, height: 13),
                       size: 9.5, weight: .bold, color: .white, align: .center)
        }
        NSGraphicsContext.current?.restoreGraphicsState()
    }

    private func drawCard(_ r: NSRect) {
        let card = NSBezierPath(roundedRect: r, xRadius: 11, yRadius: 11)
        TH.fill(selected ? 0.16 : (hover ? 0.10 : 0.055)).setFill()
        card.fill()
        if selected {
            TH.accent.withAlphaComponent(0.55).setStroke()
            card.lineWidth = 1.5
            card.stroke()
        }

        let lvl = message.threat.level
        // Liseré de verdict à gauche : vert, ambre ou rouge.
        let bar = NSBezierPath(roundedRect: NSRect(x: 5, y: 10, width: 3, height: r.height - 20),
                               xRadius: 1.5, yRadius: 1.5)
        lvl.color.withAlphaComponent(lvl == .clean ? 0.45 : 0.95).setFill()
        bar.fill()

        // Pastille d'initiales, teinte tirée de l'adresse : le même
        // correspondant garde sa couleur, et on le reconnaît avant
        // d'avoir lu son nom.
        let av = NSRect(x: 14, y: r.midY - 17, width: 34, height: 34)
        let tint = message.tint
        if picking {
            // La case prend exactement la place de la pastille : la colonne
            // de texte ne bouge pas quand on entre en sélection.
            let box = av.insetBy(dx: 5, dy: 5)
            let p = NSBezierPath(roundedRect: box, xRadius: 7, yRadius: 7)
            if checked {
                TH.accent.setFill(); p.fill()
                drawSymbol("checkmark", center: NSPoint(x: box.midX, y: box.midY),
                           size: 12, weight: .bold, color: TH.onAccent)
            } else {
                TH.fill(0.10).setFill(); p.fill()
                TH.fill(0.22).setStroke(); p.lineWidth = 1.4; p.stroke()
            }
        } else {
            tint.withAlphaComponent(0.26).setFill()
            NSBezierPath(ovalIn: av).fill()
            tint.withAlphaComponent(0.55).setStroke()
            let ring = NSBezierPath(ovalIn: av.insetBy(dx: 0.5, dy: 0.5))
            ring.lineWidth = 1
            ring.stroke()
            drawString(message.initials,
                       in: NSRect(x: av.minX, y: av.midY - 7.5, width: av.width, height: 15),
                       size: 12.5, weight: .bold, color: tint, align: .center)
        }

        // Trois lignes : expéditeur, objet, aperçu. Les ordonnées descendent
        // d'un pas régulier depuis le haut, ce qui garde le même interligne
        // quelle que soit la hauteur de la ligne.
        let top = r.height
        let line1 = NSRect(x: 0, y: top - 23, width: 0, height: 17)   // expéditeur
        let line2 = NSRect(x: 0, y: top - 41, width: 0, height: 16)   // objet
        let line3 = NSRect(x: 0, y: top - 58, width: 0, height: 14)   // aperçu

        // Le texte commence après la pastille, toujours à la même abscisse :
        // le non-lu se marque sur la pastille, pas en décalant la colonne,
        // qui ondulait d'une ligne à l'autre quand la puce prenait sa place.
        let x: CGFloat = av.maxX + 10
        if message.unread {
            let d = NSRect(x: av.minX - 1, y: av.maxY - 9, width: 10, height: 10)
            // Un liseré sombre détache la puce du disque coloré, sinon les
            // deux teintes se touchent et la puce disparaît.
            TH.base.setFill()
            NSBezierPath(ovalIn: d.insetBy(dx: -1.5, dy: -1.5)).fill()
            TH.accent.setFill()
            NSBezierPath(ovalIn: d).fill()
        }

        // Date et verdict à droite de la première ligne.
        var rightEdge = r.width - 14
        if lvl != .clean {
            let txt = lvl.label
            let w = textWidth(txt, size: 9.5, weight: .bold) + 18
            let box = NSRect(x: rightEdge - w, y: line1.midY - 9, width: w, height: 18)
            lvl.color.withAlphaComponent(0.20).setFill()
            capsule(box).fill()
            lvl.color.withAlphaComponent(0.75).setStroke()
            let c = capsule(box); c.lineWidth = 1; c.stroke()
            drawString(txt, in: NSRect(x: box.minX, y: box.midY - 6.5, width: box.width, height: 13),
                       size: 9.5, weight: .bold, color: lvl.color, align: .center)
            rightEdge -= w + 8
        }
        let when = message.shortDate
        if !when.isEmpty {
            // Même rectangle que l'expéditeur : le texte étant dessiné
            // depuis le haut, les deux lignes partent du même bord.
            let dw = min(textWidth(when, size: 10, weight: .medium) + 4, 96)
            drawString(when,
                       in: NSRect(x: rightEdge - dw, y: line1.minY, width: dw, height: line1.height),
                       size: 10, weight: .medium, color: TH.dim(0.40), align: .right)
            rightEdge -= dw + 10
        }

        drawString(message.shortSender.isEmpty ? "(inconnu)" : message.shortSender,
                   in: NSRect(x: x, y: line1.minY, width: max(60, rightEdge - x), height: line1.height),
                   size: 12.5, weight: message.unread ? .bold : .semibold, color: TH.text)

        // L'objet et l'aperçu courent sur toute la largeur : la réserve de
        // la date ne vaut que pour la première ligne, et l'objet héritait
        // d'une largeur amputée pour rien.
        var wide = r.width - 14 - x
        if !message.attachments.isEmpty {
            drawSymbol("paperclip", center: NSPoint(x: r.width - 20, y: line2.midY),
                       size: 10.5, weight: .semibold, color: TH.dim(0.45))
            wide -= 20
        }
        drawString(message.subject.isEmpty ? "(sans objet)" : message.subject,
                   in: NSRect(x: x, y: line2.minY, width: max(60, wide), height: line2.height),
                   size: 11.5, weight: message.unread ? .semibold : .regular,
                   color: TH.dim(message.unread ? 0.78 : 0.62))

        // Le type, en petit à droite de l'aperçu : discret, mais il dit
        // pourquoi un message se trouve dans tel onglet.
        let catW = textWidth(message.category.label, size: 9, weight: .semibold) + 16
        let catBox = NSRect(x: r.width - 14 - catW, y: line3.minY, width: catW, height: 14)
        message.category.color.withAlphaComponent(0.16).setFill()
        capsule(catBox).fill()
        drawString(message.category.label,
                   in: NSRect(x: catBox.minX, y: catBox.minY + 1, width: catBox.width, height: 12),
                   size: 9, weight: .semibold,
                   color: message.category.color.withAlphaComponent(0.85), align: .center)

        let preview = message.preview
        if !preview.isEmpty {
            drawString(preview,
                       in: NSRect(x: x, y: line3.minY, width: max(60, catBox.minX - 10 - x),
                                  height: line3.height),
                       size: 10.5, weight: .regular, color: TH.dim(0.34))
        }
    }
}

final class MailPanelView: NSView {
    private let hero: HeroHeader
    private var unreadTile: StatTile!
    private var riskTile: StatTile!
    private var stateTile: StatTile!
    private var threatCard: NSView!
    private var threatTitle: NSTextField!
    private var threatBody: NSTextField!
    private var isolateBtn: GlassButton!
    private var replyBtn: GlassButton!
    private var modeSeg: SegmentedBar!
    private var bodyScrollView: NSScrollView!
    private var mode = 0                  // 0 boîte · 1 lecture · 2 rédaction
    /// Le lecteur, dans son propre panneau. Créé à la première ouverture.
    private var reader: MailReaderWindow?
    private var deleteBtn: GlassButton!
    // ── Tri et sélection ──
    private var catSeg: SegmentedBar!
    private var selectBtn: GlassButton!
    /// 0 = tous, sinon `MailCategory(rawValue: filter - 1)`.
    private var filter = 0
    private var selecting = false
    /// Posé par le bouton « Actualiser » : saute le sondage et impose le
    /// relevé complet, car il doit aussi voir ce que le sondage ne détecte
    /// pas — une suppression faite depuis un autre appareil, par exemple.
    private var forceFullSync = false
    /// Les UID cochés. Un ensemble, parce que la liste se reconstruit à
    /// chaque filtre et que les coches doivent survivre au tri.
    private var checked: Set<String> = []
    private var selected: MailMessage?
    private var lastMessages: [MailMessage] = []
    /// Les derniers messages lus, pour l'agent de cybersécurité.
    var recentMessages: [MailMessage] { lastMessages }
    private var replyRef: String = ""
    private var listHost = NSView(frame: .zero)
    private let scroll = NSScrollView(frame: .zero)
    private var rows: [NSView] = []
    private var toField: NSTextField!
    private var subjectField: NSTextField!
    private var bodyView: NSTextView!
    private var statusLabel: NSTextField!
    private var accountLabel: NSTextField!

    var onStatus: ((String) -> Void)?
    /// Un ou plusieurs messages dangereux viennent d'arriver.
    var onDanger: ((Int) -> Void)?
    var fromAddress: () -> String = { "" }
    var onAccountChange: ((String) -> Void)?

    /// Branche le panneau sur la synchronisation de fond : quand du
    /// courrier arrive pendant qu'on fait autre chose, la liste se met à
    /// jour toute seule au lieu d'attendre un clic sur « Actualiser ».
    func followBackgroundSync() {
        MailSync.shared.onUpdate = { [weak self] c in
            guard let s = self, !s.selecting else { return }   // pas pendant un tri
            s.apply(c, pending: false)
        }
    }

    override init(frame: NSRect) {
        hero = HeroHeader(frame: NSRect(x: 0, y: frame.height - 92, width: frame.width, height: 92),
                          title: "Courrier", subtitle: "Vos messages non lus et un envoi rapide.")
        super.init(frame: frame)
        build()
    }
    required init?(coder: NSCoder) { fatalError() }

    private func build() {
        let W = bounds.width, H = bounds.height

        // Trois compteurs : à lire, à surveiller, et la voie utilisée.
        unreadTile = StatTile(frame: NSRect(x: W - 384, y: H - 86, width: 118, height: 78),
                              caption: "Non lus", hint: "réception")
        riskTile = StatTile(frame: NSRect(x: W - 256, y: H - 86, width: 118, height: 78),
                            caption: "Suspects", hint: "analyse locale")
        stateTile = StatTile(frame: NSRect(x: W - 128, y: H - 86, width: 118, height: 78),
                             caption: "Voie", hint: "—")
        [unreadTile, riskTile, stateTile].forEach { addSubview($0) }

        // Deux modes plutôt qu'un empilement : la liste et le formulaire
        // se disputaient 570 pt et se retrouvaient tous deux à l'étroit.
        // Chacun occupe maintenant toute la hauteur disponible.
        modeSeg = SegmentedBar(frame: NSRect(x: 0, y: 436, width: W, height: 36),
                               items: [SegmentedBar.Item(title: "Boîte", icon: "tray.full.fill"),
                                       SegmentedBar.Item(title: "Rédiger", icon: "square.and.pencil")],
                               selected: 0)
        modeSeg.onSelect = { [weak self] i in self?.setMode(i) }
        addSubview(modeSeg)

        // ── Barre de types, façon Mail ──
        //
        //  « Tous » en premier et sélectionné par défaut : un classement
        //  qui cache du courrier dès l'ouverture serait un piège. On range,
        //  on ne masque pas.
        catSeg = SegmentedBar(frame: NSRect(x: 0, y: 396, width: W - 112, height: 32),
                              items: [SegmentedBar.Item(title: "Tous", icon: nil),
                                      SegmentedBar.Item(title: "Principal", icon: nil),
                                      SegmentedBar.Item(title: "Transactions", icon: nil),
                                      SegmentedBar.Item(title: "Mises à jour", icon: nil),
                                      SegmentedBar.Item(title: "Promotions", icon: nil)],
                              selected: 0)
        catSeg.onSelect = { [weak self] i in
            self?.filter = i
            self?.rebuildList()
        }
        addSubview(catSeg)

        selectBtn = GlassButton(frame: NSRect(x: W - 104, y: 396, width: 104, height: 32),
                                title: "Sélection", icon: "checklist", compact: true)
        selectBtn.onClick = { [weak self] _ in self?.toggleSelecting() }
        addSubview(selectBtn)

        // Les trois modes partagent le même cadre bas, à 66, pour que la
        // bascule ne décale rien à l'écran.
        scroll.frame = NSRect(x: 0, y: 134, width: W, height: 252)
        scroll.hasVerticalScroller = true
        scroll.scrollerStyle = .overlay
        scroll.drawsBackground = false
        scroll.borderType = .noBorder
        scroll.autohidesScrollers = true
        scroll.documentView = listHost
        addSubview(scroll)

        // Carte de verdict du message sélectionné.
        threatCard = mkCard(self, NSRect(x: 0, y: 66, width: W, height: 60), radius: 13, alpha: 0.07)
        threatTitle = mkLabel("Sélectionnez un message pour voir son analyse.",
                              NSRect(x: 14, y: 36, width: W - 130, height: 16), 11.5, .semibold, alpha: 0.72)
        threatCard.addSubview(threatTitle)
        threatBody = NSTextField(frame: NSRect(x: 14, y: 8, width: W - 130, height: 28))
        threatBody.isBezeled = false
        threatBody.drawsBackground = false
        threatBody.isEditable = false
        threatBody.isSelectable = true
        threatBody.font = NSFont.systemFont(ofSize: 10.5)
        threatBody.textColor = TH.dim(0.50)
        threatBody.lineBreakMode = .byWordWrapping
        threatBody.cell?.usesSingleLineMode = false
        threatBody.cell?.wraps = true
        threatBody.maximumNumberOfLines = 2
        ThemeRegistry.shared.register(threatBody, alpha: 0.50)
        threatCard.addSubview(threatBody)

        isolateBtn = GlassButton(frame: NSRect(x: W - 110, y: 12, width: 96, height: 34),
                                 title: "Isoler", icon: "tray.and.arrow.down.fill")
        isolateBtn.destructive = true
        isolateBtn.enabledFlag = false
        isolateBtn.onClick = { [weak self] _ in self?.quarantineSelected() }
        threatCard.addSubview(isolateBtn)

        toField = NSTextField(frame: NSRect(x: 0, y: 394, width: W * 0.48, height: 30))
        toField.placeholderString = "Destinataire"
        toField.font = NSFont.systemFont(ofSize: 12.5)
        subjectField = NSTextField(frame: NSRect(x: W * 0.48 + 10, y: 394, width: W * 0.52 - 10, height: 30))
        subjectField.placeholderString = "Objet"
        subjectField.font = NSFont.systemFont(ofSize: 12.5)
        [toField, subjectField].forEach { addSubview($0) }

        accountLabel = mkLabel("", NSRect(x: 2, y: 374, width: W - 4, height: 14), 10, .regular, alpha: 0.38)
        addSubview(accountLabel)

        let bodyScroll = NSScrollView(frame: NSRect(x: 0, y: 66, width: W, height: 300))
        bodyScrollView = bodyScroll
        bodyScroll.hasVerticalScroller = true
        bodyScroll.scrollerStyle = .overlay
        bodyScroll.drawsBackground = false
        bodyScroll.borderType = .noBorder
        bodyScroll.wantsLayer = true
        bodyScroll.layer?.cornerRadius = 12
        bodyScroll.layer?.masksToBounds = true
        let big: CGFloat = 1_000_000
        let tv = NSTextView(frame: NSRect(x: 0, y: 0, width: W, height: 300))
        tv.minSize = NSSize(width: 0, height: 300)
        tv.maxSize = NSSize(width: big, height: big)
        tv.isVerticallyResizable = true
        tv.autoresizingMask = [.width]
        tv.textContainer?.containerSize = NSSize(width: W, height: big)
        tv.textContainer?.widthTracksTextView = true
        tv.drawsBackground = true
        tv.backgroundColor = TH.fill(0.06)
        tv.textColor = TH.text
        tv.insertionPointColor = TH.text
        tv.font = NSFont.systemFont(ofSize: 12.5)
        tv.isRichText = false
        tv.textContainerInset = NSSize(width: 10, height: 10)
        bodyScroll.documentView = tv
        bodyView = tv
        addSubview(bodyScroll)


        statusLabel = mkLabel("", NSRect(x: 0, y: 46, width: W, height: 16), 10.5, .regular, alpha: 0.45, .center)
        addSubview(statusLabel)

        let bw = (W - 60) / 6
        let specs: [(String, String, Bool, () -> Void)] = [
            ("Envoyer", "paperplane.fill", true, { [weak self] in self?.send() }),
            ("Répondre", "arrowshape.turn.up.left.fill", false, { [weak self] in self?.reply() }),
            ("Supprimer", "trash.fill", false, { [weak self] in self?.deleteSelected() }),
            ("Analyser", "shield.lefthalf.filled", false, { [weak self] in self?.analyzeAll() }),
            ("Compte", "person.crop.circle", false, { [weak self] in self?.accountDialog() }),
            ("Actualiser", "arrow.clockwise", false, { [weak self] in
                self?.forceFullSync = true
                self?.statusLabel.stringValue = "Relevé complet…"
                self?.refresh()
            })
        ]
        var made: [GlassButton] = []
        for (i, sp) in specs.enumerated() {
            let b = GlassButton(frame: NSRect(x: CGFloat(i) * (bw + 12), y: 0, width: bw, height: 42),
                                title: sp.0, icon: sp.1, prominent: sp.2)
            b.onClick = { _ in sp.3() }
            addSubview(b)
            made.append(b)
        }
        replyBtn = made[1]
        replyBtn.enabledFlag = false
        deleteBtn = made[2]
        deleteBtn.enabledFlag = false
        deleteBtn.destructive = true
        setMode(0)
    }

    /// Bascule entre consulter et rédiger. Les deux jeux de vues occupent
    /// la même bande d'écran, on les montre à tour de rôle.
    /// Deux modes : la boîte, ou la rédaction. La lecture a quitté les
    /// onglets pour son propre panneau.
    ///
    /// Les vues de chaque mode sont **listées**, et l'on montre les unes en
    /// cachant les autres à partir de ces listes. L'ancienne version
    /// masquait vue par vue, à la main — et en avait oublié deux, la barre
    /// des types et le bouton de sélection, qui restaient affichés
    /// par-dessus l'en-tête du lecteur. Un mode qui cache des vues une à
    /// une est un mode qui en oubliera une.
    private func setMode(_ i: Int) {
        mode = i
        modeSeg.selected = i
        let box = (i == 0)

        let boxViews: [NSView?] = [scroll, threatCard, catSeg, selectBtn]
        let writeViews: [NSView?] = [toField, subjectField, bodyScrollView, accountLabel]
        boxViews.forEach { $0?.isHidden = !box }
        writeViews.forEach { $0?.isHidden = box }

        if !box { window?.makeFirstResponder(toField.stringValue.isEmpty ? toField : bodyView) }
    }

    /// Ouvre un message en lecture. Appelé au clic sur une ligne : lire
    /// est ce qu'on veut faire d'un courriel, et il serait étrange de
    /// devoir viser un onglet pour y arriver.
    /// Ouvre un message dans son panneau. La liste reste derrière, et
    /// l'on peut lire sans perdre sa place.
    private func open(_ m: MailMessage) {
        select(m)
        let r = readerWindow()
        r.show(m)

        // Le corps des messages au-delà des premiers n'est pas encore là :
        // on le demande maintenant et on remplit le panneau à l'arrivée.
        guard m.snippet.isEmpty, !m.uid.isEmpty, MailRouter.gmailReady else { return }
        r.setBody("Chargement du message…")
        let uid = m.uid
        DispatchQueue.global(qos: .userInitiated).async {
            let fetched = MailRouter.body(uid: uid)
            DispatchQueue.main.async { [weak self] in
                guard let s = self, let win = s.reader,
                      win.message?.uid == uid else { return }
                guard let fetched = fetched, !fetched.isEmpty else {
                    win.setBody("Le corps de ce message n'a pas pu être rapatrié. "
                        + "Ouvrez-le dans Mail pour le lire en entier.")
                    return
                }
                var filled = m
                filled.snippet = fetched
                if let i = s.lastMessages.firstIndex(where: { $0.uid == uid }) {
                    s.lastMessages[i].snippet = fetched
                }
                s.selected = filled
                win.show(filled)
            }
        }
    }

    /// Le panneau de lecture, créé à la première ouverture et réutilisé
    /// ensuite : en ouvrir un par message laisserait l'écran couvert.
    private func readerWindow() -> MailReaderWindow {
        if let r = reader { return r }
        let r = MailReaderWindow()
        r.onReply = { [weak self] m in
            self?.select(m)
            self?.reply()
        }
        r.onDelete = { [weak self] m in
            self?.select(m)
            self?.confirmSwipeDelete(m)
        }
        r.onQuarantine = { [weak self] m in
            self?.select(m)
            self?.quarantineSelected()
        }
        r.onSend = { [weak self] m, subject, body in
            self?.sendReply(to: m, subject: subject, body: body)
        }
        reader = r
        return r
    }

    // ═══════════════════════════════════════════════════════════
    //  Répondre à la voix
    //
    //  « Hey Bud, réponds au mail de Free. » Trois choses
    //  séparées : retrouver le message, en rapatrier le corps,
    //  et proposer une réponse. Rien ne part tout seul — le
    //  tiroir s'ouvre, et il faut valider puis envoyer.
    // ═══════════════════════════════════════════════════════════

    /// Le message auquel « le mail de X » fait référence.
    ///
    /// Le plus récent dont l'expéditeur, le domaine ou l'objet contient le
    /// nom dit. Trois rangs de priorité, parce que « Free » peut être un
    /// nom affiché, un domaine, ou un mot de l'objet — et dans cet ordre
    /// de certitude décroissante.
    func findBySpokenName(_ spoken: String) -> MailMessage? {
        let want = MailReader.fold(spoken)
        guard want.count >= 2 else { return nil }
        let pool = lastMessages

        if let m = pool.first(where: { MailReader.fold($0.shortSender).contains(want) }) {
            return m
        }
        if let m = pool.first(where: { MailReader.fold($0.address).contains(want) }) {
            return m
        }
        return pool.first { MailReader.fold($0.subject).contains(want) }
    }

    /// Ouvre le tiroir de réponse pré-rempli pour ce message.
    func composeReply(to m: MailMessage, status: ((String) -> Void)? = nil) {
        // Les mêmes gardes qu'au clic. Une phrase dite à voix haute ne doit
        // pas ouvrir une porte que la souris n'ouvre pas : répondre confirme
        // à l'expéditeur que l'adresse est active, et c'est précisément ce
        // qu'un message de hameçonnage cherche.
        if m.threat.level == .dangerous {
            let a = NSAlert()
            a.messageText = "Répondre à un message dangereux ?"
            a.informativeText = "BUD a relevé : \(m.threat.summary)\n\n"
                + "Répondre confirme à l'expéditeur que votre adresse est active."
            a.addButton(withTitle: "Annuler")
            a.addButton(withTitle: "Répondre quand même")
            NSApp.activate(ignoringOtherApps: true)
            guard a.runModal() == .alertSecondButtonReturn else {
                status?("Réponse annulée.")
                return
            }
        }
        select(m)
        let r = readerWindow()
        r.show(m)
        let style = StyleLearner.load()

        if !m.readableBody.isEmpty {
            r.compose(m, body: m.readableBody, style: style)
            status?("Réponse proposée. Validez, puis envoyez.")
            return
        }
        // Sans le corps, la proposition serait aveugle : on le rapatrie
        // d'abord, hors du fil principal.
        guard !m.uid.isEmpty, MailRouter.gmailReady else {
            r.compose(m, body: m.subject, style: style)
            status?("Réponse proposée depuis l'objet seul : le corps n'est pas disponible.")
            return
        }
        r.setBody("Chargement du message…")
        let uid = m.uid
        DispatchQueue.global(qos: .userInitiated).async {
            let fetched = MailRouter.body(uid: uid) ?? ""
            DispatchQueue.main.async { [weak self] in
                guard let s = self, let win = s.reader, win.message?.uid == uid else { return }
                var filled = m
                if !fetched.isEmpty {
                    filled.snippet = fetched
                    if let i = s.lastMessages.firstIndex(where: { $0.uid == uid }) {
                        s.lastMessages[i].snippet = fetched
                    }
                    s.selected = filled
                    win.show(filled)
                }
                win.compose(filled, body: filled.readableBody.isEmpty ? filled.subject
                                                                      : filled.readableBody,
                            style: style)
                status?("Réponse proposée. Validez, puis envoyez.")
            }
        }
    }

    private func sendReply(to m: MailMessage, subject: String, body: String) {
        let from = MailRouter.account
        onStatus?("Envoi en cours…")
        var dest = m.address
        if !m.replyTo.isEmpty && m.threat.level == .clean {
            let r = MailGuard.address(in: m.replyTo)
            if r.contains("@") { dest = r }
        }
        DispatchQueue.global(qos: .userInitiated).async {
            let result = MailRouter.send(to: dest, subject: subject, body: body,
                                         mailFrom: from, inReplyTo: m.messageID)
            DispatchQueue.main.async { [weak self] in
                self?.onStatus?(result)
                // Une réponse envoyée est un exemple de plus de votre
                // façon d'écrire : on la verse au profil sans attendre le
                // prochain relevé du dossier des envois.
                if result.lowercased().contains("envoyé") {
                    StyleLearner.absorbOne(body)
                }
            }
        }
    }

    /// Met le message sélectionné à la corbeille du compte. Rien n'est
    /// effacé : le serveur le garde, et il se reprend depuis la corbeille.
    private func deleteSelected() {
        // En mode sélection, le bouton agit sur tout ce qui est coché.
        if selecting && !checked.isEmpty { deleteChecked(); return }
        guard let m = selected else {
            statusLabel.stringValue = "Choisissez d'abord un message."
            return
        }
        guard !m.uid.isEmpty, MailRouter.gmailReady else {
            statusLabel.stringValue = "La suppression demande un compte relié — "
                + "par Mail.app, BUD ne fait que lire."
            return
        }
        statusLabel.stringValue = "Mise à la corbeille…"
        let uid = m.uid
        DispatchQueue.global(qos: .userInitiated).async {
            let err = MailRouter.trash([uid])
            DispatchQueue.main.async { [weak self] in
                guard let s = self else { return }
                if let err = err {
                    s.statusLabel.stringValue = err
                } else {
                    s.statusLabel.stringValue = "Message mis à la corbeille."
                    s.selected = nil
                    s.replyBtn.enabledFlag = false
                    s.deleteBtn.enabledFlag = false
                    // Le message supprimé était peut-être celui qu'on
                    // lisait : le panneau se referme plutôt que d'afficher
                    // un message qui n'est plus là.
                    s.reader?.window?.close()
                    s.refresh()
                }
            }
        }
    }

    // ── Sélection d'un message ──

    // ═══════════ Sélection multiple ═══════════

    private func toggleSelecting() {
        selecting.toggle()
        if !selecting { checked.removeAll() }
        selectBtn.selected = selecting
        selectBtn.title = selecting ? "Terminer" : "Sélection"
        updateSelectionStatus()
        rebuildList()
    }

    private func toggleCheck(_ m: MailMessage) {
        guard !m.uid.isEmpty else {
            statusLabel.stringValue = "Ce message n'a pas d'identifiant — "
                + "la sélection demande un compte relié."
            return
        }
        if checked.contains(m.uid) { checked.remove(m.uid) } else { checked.insert(m.uid) }
        for r in rows {
            guard let row = r as? MailRow, row.message.uid == m.uid else { continue }
            row.checked = checked.contains(m.uid)
        }
        updateSelectionStatus()
    }

    private func updateSelectionStatus() {
        guard selecting else {
            deleteBtn?.enabledFlag = selected != nil
            statusLabel?.stringValue = ""
            return
        }
        let n = checked.count
        deleteBtn?.enabledFlag = n > 0
        statusLabel?.stringValue = n == 0
            ? "Cochez les messages à supprimer."
            : (n == 1 ? "1 message sélectionné." : "\(n) messages sélectionnés.")
    }

    /// Supprime tout ce qui est coché, en une seule commande IMAP.
    private func deleteChecked() {
        let uids = Array(checked)
        guard !uids.isEmpty else { return }
        let a = NSAlert()
        a.messageText = uids.count == 1
            ? "Mettre ce message à la corbeille ?"
            : "Mettre \(uids.count) messages à la corbeille ?"
        a.informativeText = "Ils partent dans la corbeille du compte, d'où vous pouvez les reprendre."
        a.addButton(withTitle: "Mettre à la corbeille")
        a.addButton(withTitle: "Annuler")
        a.alertStyle = .warning
        guard a.runModal() == .alertFirstButtonReturn else { return }

        statusLabel.stringValue = "Mise à la corbeille de \(uids.count) message(s)…"
        DispatchQueue.global(qos: .userInitiated).async {
            let err = MailRouter.trash(uids)
            DispatchQueue.main.async { [weak self] in
                guard let s = self else { return }
                if let err = err {
                    s.statusLabel.stringValue = err
                } else {
                    s.checked.removeAll()
                    s.selecting = false
                    s.selectBtn.selected = false
                    s.selectBtn.title = "Sélection"
                    s.statusLabel.stringValue = "\(uids.count) message(s) à la corbeille."
                    s.refresh()
                }
            }
        }
    }

    /// Un balayage est vite fait, et parfois fait sans le vouloir : la
    /// suppression demande donc confirmation, alors que « Répondre » part
    /// directement — répondre ne détruit rien.
    private func confirmSwipeDelete(_ m: MailMessage) {
        let a = NSAlert()
        a.messageText = "Mettre ce message à la corbeille ?"
        a.informativeText = "\(m.shortSender) — \(m.subject.isEmpty ? "(sans objet)" : m.subject)\n\n"
            + "Il part dans la corbeille du compte, d'où vous pouvez le reprendre."
        a.addButton(withTitle: "Mettre à la corbeille")
        a.addButton(withTitle: "Annuler")
        a.alertStyle = .warning
        if a.runModal() == .alertFirstButtonReturn { deleteSelected() }
    }

    private func select(_ m: MailMessage) {
        selected = m
        replyBtn.enabledFlag = true
        deleteBtn.enabledFlag = !m.uid.isEmpty && MailRouter.gmailReady
        isolateBtn.enabledFlag = !m.uid.isEmpty && MailRouter.gmailReady
        for r in rows { (r as? MailRow)?.selected = (r as? MailRow)?.message.uid == m.uid }

        if mode == 0 { threatCard.isHidden = false }
        let lvl = m.threat.level
        threatTitle.stringValue = "\(lvl.label) · \(m.shortSender) · \(m.address)"
        threatTitle.textColor = lvl == .clean ? TH.dim(0.72) : lvl.color
        var detail = m.threat.summary
        if !m.attachments.isEmpty {
            detail += "  —  pièces jointes : " + m.attachments.joined(separator: ", ")
        }
        threatBody.stringValue = detail
    }

    /// Prépare une réponse : objet préfixé, corps cité, et le Message-ID
    /// d'origine conservé pour que le fil reste groupé chez le destinataire.
    private func reply() {
        guard let m = selected else {
            statusLabel.stringValue = "Choisissez d'abord un message dans la liste."
            return
        }
        if m.threat.level == .dangerous {
            let a = NSAlert()
            a.messageText = "Répondre à un message dangereux ?"
            a.informativeText = "BUD a relevé : \(m.threat.summary)\n\n"
                + "Répondre confirme à l'expéditeur que votre adresse est active."
            a.addButton(withTitle: "Annuler")
            a.addButton(withTitle: "Répondre quand même")
            NSApp.activate(ignoringOtherApps: true)
            guard a.runModal() == .alertSecondButtonReturn else { return }
        }

        // Le Reply-To prime sur le From quand il est légitime ; s'il
        // pointe ailleurs, l'analyse l'a déjà signalé et on garde le From.
        var dest = m.address
        if !m.replyTo.isEmpty && m.threat.level == .clean {
            let r = MailGuard.address(in: m.replyTo)
            if r.contains("@") { dest = r }
        }
        toField.stringValue = dest
        let subj = m.subject.trimmingCharacters(in: .whitespaces)
        subjectField.stringValue = subj.lowercased().hasPrefix("re:") ? subj : "Re: \(subj)"

        let quoted = m.snippet
            .replacingOccurrences(of: "<[^>]+>", with: "", options: .regularExpression)
            .split(separator: "\n", omittingEmptySubsequences: false)
            .prefix(18)
            .map { "> " + $0.trimmingCharacters(in: .whitespaces) }
            .joined(separator: "\n")
        bodyView.string = "\n\nLe \(m.date), \(m.shortSender) a écrit :\n" + quoted
        bodyView.setSelectedRange(NSRange(location: 0, length: 0))
        replyRef = m.messageID
        setMode(1)
        window?.makeFirstResponder(bodyView)
        statusLabel.stringValue = "Réponse préparée pour \(dest)."
    }

    private func quarantineSelected() {
        guard let m = selected, !m.uid.isEmpty else { return }
        let a = NSAlert()
        a.messageText = "Isoler ce message ?"
        a.informativeText = "« \(m.subject) » de \(m.address) sera déplacé vers le dossier "
            + "des indésirables de votre compte. Rien n'est supprimé : vous pourrez l'y retrouver.\n\n"
            + m.threat.summary
        a.addButton(withTitle: "Isoler")
        a.addButton(withTitle: "Annuler")
        NSApp.activate(ignoringOtherApps: true)
        guard a.runModal() == .alertFirstButtonReturn else { return }

        statusLabel.stringValue = "Déplacement en cours…"
        let uid = m.uid
        DispatchQueue.global(qos: .userInitiated).async {
            let err = MailRouter.quarantine([uid])
            DispatchQueue.main.async { [weak self] in
                guard let s = self else { return }
                if let e = err {
                    s.statusLabel.stringValue = e
                } else {
                    s.statusLabel.stringValue = "Message isolé dans les indésirables."
                    s.onStatus?("Message isolé")
                    s.selected = nil
                    s.refresh()
                }
            }
        }
    }

    /// Analyse complète : la boîte de réception, puis les fichiers déjà
    /// téléchargés. Le second volet interroge Gatekeeper, qui connaît les
    /// signatures qu'une heuristique ignore.
    private func analyzeAll() {
        statusLabel.stringValue = "Analyse en cours…"
        let msgs = lastMessages
        DispatchQueue.global(qos: .userInitiated).async {
            let files = MailGuard.scanDownloads()
            DispatchQueue.main.async { [weak self] in
                guard let s = self else { return }
                let danger = msgs.filter { $0.threat.level == .dangerous }
                let suspect = msgs.filter { $0.threat.level == .suspect }

                var report = "Messages analysés : \(msgs.count)\n"
                report += "Dangereux : \(danger.count) · Suspects : \(suspect.count)\n"
                for m in (danger + suspect).prefix(6) {
                    report += "\n• \(m.threat.level.label) — \(m.shortSender)\n   \(m.threat.summary)"
                }
                if !files.isEmpty {
                    report += "\n\nTéléchargements douteux : \(files.count)"
                    for f in files.prefix(6) {
                        report += "\n• \(f.url.lastPathComponent) — \(f.reason)"
                    }
                }
                if danger.isEmpty && suspect.isEmpty && files.isEmpty {
                    report += "\nRien à signaler."
                }

                let a = NSAlert()
                a.messageText = "Analyse de sécurité"
                a.informativeText = report
                    + "\n\nBUD juge la forme des messages, pas le contenu des fichiers : "
                    + "ce n'est pas un antivirus."
                if !danger.isEmpty { a.addButton(withTitle: "Isoler les \(danger.count) dangereux") }
                if !files.isEmpty { a.addButton(withTitle: "Mettre \(files.count) fichier(s) à la corbeille") }
                a.addButton(withTitle: "Fermer")
                NSApp.activate(ignoringOtherApps: true)
                let r = a.runModal()

                var idx = NSApplication.ModalResponse.alertFirstButtonReturn.rawValue
                if !danger.isEmpty {
                    if r.rawValue == idx { s.isolate(danger.map { $0.uid }); return }
                    idx += 1
                }
                if !files.isEmpty, r.rawValue == idx {
                    let n = MailGuard.trash(files.map { $0.url })
                    s.statusLabel.stringValue = "\(n) fichier(s) mis à la corbeille."
                    s.onStatus?("\(n) fichier(s) douteux à la corbeille")
                }
            }
        }
    }

    private func isolate(_ uids: [String]) {
        let clean = uids.filter { !$0.isEmpty }
        guard !clean.isEmpty else { return }
        statusLabel.stringValue = "Isolement de \(clean.count) message(s)…"
        DispatchQueue.global(qos: .userInitiated).async {
            let err = MailRouter.quarantine(clean)
            DispatchQueue.main.async { [weak self] in
                guard let s = self else { return }
                s.statusLabel.stringValue = err ?? "\(clean.count) message(s) isolés."
                if err == nil { s.onStatus?("\(clean.count) message(s) isolés"); s.refresh() }
            }
        }
    }

    /// Fenêtre unique pour relier un compte : Google en un clic, ou
    /// mot de passe d'application si vous préférez.
    private func accountDialog() {
        let auth = GmailAuth.shared
        let a = NSAlert()
        a.messageText = "Compte de messagerie"
        a.informativeText = auth.isConnected
            ? "Connecté à \(auth.email) par Google OAuth."
            : (MailRouter.appPassword != nil
               ? "Connecté à \(MailRouter.account) par mot de passe d'application."
               : "Reliez votre compte Google, ou utilisez un mot de passe d'application. "
                 + "Pour tout faire depuis votre téléphone, passez par l'onglet Téléphone (⌘⌥P).")

        let v = NSView(frame: NSRect(x: 0, y: 0, width: 420, height: 176))
        func label(_ t: String, _ y: CGFloat) {
            let l = NSTextField(labelWithString: t)
            l.frame = NSRect(x: 0, y: y, width: 420, height: 14)
            l.font = NSFont.systemFont(ofSize: 10.5, weight: .semibold)
            l.textColor = .secondaryLabelColor
            v.addSubview(l)
        }
        label("IDENTIFIANT CLIENT GOOGLE (application de bureau)", 162)
        let idField = NSTextField(frame: NSRect(x: 0, y: 132, width: 420, height: 24))
        idField.placeholderString = "xxxxx.apps.googleusercontent.com"
        idField.stringValue = auth.clientID
        v.addSubview(idField)

        label("CODE SECRET CLIENT — facultatif avec PKCE", 110)
        let secretField = NSSecureTextField(frame: NSRect(x: 0, y: 80, width: 420, height: 24))
        secretField.placeholderString = "GOCSPX-… (laissez vide si non requis)"
        secretField.stringValue = auth.clientSecret
        v.addSubview(secretField)

        label("OU MOT DE PASSE D'APPLICATION", 58)
        let mailField = NSTextField(frame: NSRect(x: 0, y: 28, width: 210, height: 24))
        mailField.placeholderString = "adresse@gmail.com"
        mailField.stringValue = MailRouter.account
        let passField = NSSecureTextField(frame: NSRect(x: 218, y: 28, width: 202, height: 24))
        passField.placeholderString = "16 caractères"
        [mailField, passField].forEach { v.addSubview($0) }

        let note = NSTextField(labelWithString: "Les identifiants sont rangés dans le trousseau macOS, jamais sur disque.")
        note.frame = NSRect(x: 0, y: 4, width: 420, height: 16)
        note.font = NSFont.systemFont(ofSize: 10)
        note.textColor = .tertiaryLabelColor
        v.addSubview(note)
        a.accessoryView = v

        a.addButton(withTitle: "Connexion Google")
        a.addButton(withTitle: "Mot de passe d'app")
        a.addButton(withTitle: auth.isConnected || MailRouter.appPassword != nil ? "Déconnecter" : "Fermer")
        a.addButton(withTitle: "Annuler")

        NSApp.activate(ignoringOtherApps: true)
        let choice = a.runModal()

        switch choice {
        case .alertFirstButtonReturn:
            let id = idField.stringValue.trimmingCharacters(in: .whitespacesAndNewlines)
            guard id.contains("apps.googleusercontent.com") else {
                statusLabel.stringValue = "Collez l'identifiant client Google (…apps.googleusercontent.com)."
                return
            }
            auth.clientID = id
            auth.clientSecret = secretField.stringValue.trimmingCharacters(in: .whitespacesAndNewlines)
            startGoogleFlow()
        case .alertSecondButtonReturn:
            connectAppPassword(mail: mailField.stringValue.trimmingCharacters(in: .whitespacesAndNewlines),
                               pass: passField.stringValue.trimmingCharacters(in: .whitespacesAndNewlines))
        case .alertThirdButtonReturn:
            if auth.isConnected || MailRouter.appPassword != nil { disconnectAll() }
        default:
            break
        }
    }

    private func startGoogleFlow() {
        statusLabel.stringValue = "Votre navigateur s'ouvre pour le consentement Google…"
        onStatus?("Autorisation Google en cours")
        GoogleOAuth.authorize(clientID: GmailAuth.shared.clientID,
                              clientSecret: GmailAuth.shared.clientSecret) { [weak self] tokens, err in
            guard let s = self else { return }
            guard let t = tokens, !t.email.isEmpty else {
                s.statusLabel.stringValue = "Connexion Google échouée : \(err ?? "inconnu")"
                s.onStatus?("Google refusé")
                return
            }
            GmailAuth.shared.store(t)
            s.onAccountChange?(t.email)
            s.statusLabel.stringValue = "Connecté à \(t.email) — lecture et envoi directs."
            s.onStatus?("Gmail connecté")
            s.refresh()
        }
    }

    private func connectAppPassword(mail: String, pass: String) {
        guard mail.contains("@") else {
            statusLabel.stringValue = "Indiquez votre adresse Gmail complète."
            return
        }
        guard pass.count >= 12 else {
            statusLabel.stringValue = "Le mot de passe d'application fait 16 caractères."
            return
        }
        statusLabel.stringValue = "Vérification auprès de Gmail…"
        DispatchQueue.global(qos: .userInitiated).async {
            let err = GmailClient.testLogin(user: mail, password: pass)
            DispatchQueue.main.async { [weak self] in
                guard let s = self else { return }
                if let e = err {
                    s.statusLabel.stringValue = e
                    s.onStatus?(e)
                    return
                }
                BudKeychain.set(GmailClient.normalizedPassword(pass), account: mail)
                MailRouter.account = mail
                s.onAccountChange?(mail)
                s.statusLabel.stringValue = "Compte connecté, mot de passe dans le trousseau."
                s.onStatus?("Gmail connecté")
                s.refresh()
            }
        }
    }

    private func disconnectAll() {
        GmailAuth.shared.disconnect()
        if !MailRouter.account.isEmpty {
            BudKeychain.delete(MailRouter.account)
            MailRouter.account = ""
        }
        onAccountChange?("")
        statusLabel.stringValue = "Compte déconnecté. BUD repasse par Mail.app."
        refresh()
    }

    func refresh() {
        let installed = MailBridge.mailAppInstalled()
        let running = MailBridge.mailRunning()
        let gmail = MailRouter.gmailReady

        accountLabel.stringValue = MailRouter.oauthReady
            ? "Google OAuth · \(GmailAuth.shared.email) · jetons dans le trousseau"
            : (gmail ? "Mot de passe d'application · \(MailRouter.account)"
                     : "Aucun compte relié — bouton Compte pour connecter Google.")

        stateTile.set(MailRouter.sourceLabel == "Mail.app"
                        ? (running ? "Mail.app" : (installed ? "Fermé" : "Absent"))
                        : MailRouter.sourceLabel,
                      hint: MailRouter.oauthReady ? "OAuth 2.0"
                          : (gmail ? "IMAP/SMTP" : (running ? "via Mail" : "ouvrez Mail")))

        guard gmail || running else {
            unreadTile.set("—", hint: "aucune source")
            riskTile.set("—", hint: "analyse locale")
            hero.set(subtitle: "Connectez votre compte Gmail, ou ouvrez Mail.", trailing: "")
            rebuildList([])
            return
        }

        // D'abord ce qu'on sait déjà. La boîte s'affiche instantanément
        // avec le dernier état connu, au lieu d'une liste vide pendant que
        // le serveur répond. C'est le changement qui se remarque le plus.
        let known = MailSync.shared.warmUp()
        if !known.messages.isEmpty {
            apply(known, pending: true)
        } else {
            unreadTile.set("…", hint: "lecture en cours")
            riskTile.set("…", hint: "analyse")
        }

        // Puis la mise à jour, hors du fil principal. Le sondage décide
        // s'il faut un relevé complet ; si rien n'a bougé, rien n'est
        // redessiné et l'affichage ne scintille pas.
        MailSync.shared.sync(force: forceFullSync) { [weak self] c, err in
            guard let s = self else { return }
            s.forceFullSync = false
            if let e = err { s.statusLabel.stringValue = e }
            s.apply(c, pending: false)
        }
    }

    /// Peint la boîte à partir d'un état connu.
    ///
    /// `pending` dit que cet état vient du cache et qu'une vérification est
    /// en cours : les tuiles le signalent, sans faire disparaître la liste.
    private func apply(_ c: MailSync.Cached, pending: Bool) {
        let n = c.unread
        unreadTile.set("\(n)", hint: pending ? "vérification…"
                                            : (n == 0 ? "boîte à jour" : "à lire"))
        hero.set(subtitle: n <= 0 ? "Rien à lire pour l'instant · \(c.source)"
                                  : "\(n) message(s) non lus · \(c.source)",
                 trailing: n > 0 ? "\(n) non lus" : "")
        let danger = c.messages.filter { $0.threat.level == .dangerous }.count
        let suspect = c.messages.filter { $0.threat.level == .suspect }.count
        riskTile.set(danger > 0 ? "\(danger)" : "\(suspect)",
                     hint: danger > 0 ? "dangereux" : (suspect > 0 ? "suspects" : "rien à signaler"))
        // On ne reconstruit la liste que si elle a changé : redessiner
        // soixante cartes identiques ferait sauter le défilement et
        // perdrait la sélection pour rien.
        let sameSet = c.messages.count == lastMessages.count
            && zip(c.messages, lastMessages).allSatisfy { $0.uid == $1.uid && $0.unread == $1.unread }
        if !sameSet || lastMessages.isEmpty { rebuildList(c.messages) }
    }

    /// Reconstruit avec les messages déjà en mémoire — pour un changement
    /// de filtre ou l'entrée en mode sélection, qui ne demandent pas de
    /// retourner interroger le serveur.
    private func rebuildList() { rebuildList(lastMessages) }

    private func rebuildList(_ msgs: [MailMessage]) {
        rows.forEach { $0.removeFromSuperview() }
        rows.removeAll()
        ThemeRegistry.shared.prune()

        // Un message dangereux qui n'était pas là au relevé précédent :
        // c'est un fait nouveau, et c'est ce qui fâche BUD. On compare aux
        // UID connus plutôt qu'au nombre, sinon supprimer un message
        // dangereux et en recevoir un autre passerait inaperçu.
        let hadDanger = Set(lastMessages.filter { $0.threat.level == .dangerous }.map { $0.uid })
        let newDanger = msgs.filter { $0.threat.level == .dangerous && !hadDanger.contains($0.uid) }
        lastMessages = msgs
        if !newDanger.isEmpty { onDanger?(newDanger.count) }

        // Le filtre ne change que ce qu'on voit : `lastMessages` garde tout,
        // sans quoi passer sur « Promotions » puis « Tous » aurait perdu le
        // reste de la boîte jusqu'au prochain relevé.
        let shown: [MailMessage] = filter == 0
            ? msgs
            : msgs.filter { $0.category.rawValue == filter - 1 }

        let W = scroll.bounds.width - 6
        // 68 pt, dont 6 d'écart entre les cartes : il faut trois lignes —
        // expéditeur, objet, aperçu — là où 52 n'en tenaient que deux, et
        // encore collées l'une à l'autre.
        let rowH: CGFloat = 68
        let totalH = max(scroll.bounds.height, CGFloat(shown.count) * rowH)
        listHost.frame = NSRect(x: 0, y: 0, width: W, height: totalH)

        if shown.isEmpty {
            let why: String
            if !(MailRouter.gmailReady || MailBridge.mailRunning()) {
                why = "Aucune source de courrier."
            } else if filter != 0 && !msgs.isEmpty {
                why = "Rien dans « \(MailCategory(rawValue: filter - 1)?.label ?? "") »."
            } else {
                why = "Boîte vide."
            }
            let l = mkLabel(why, NSRect(x: 0, y: totalH / 2 - 10, width: W, height: 20),
                            12, .medium, alpha: 0.35, .center)
            listHost.addSubview(l)
            rows.append(l)
            return
        }
        for (i, m) in shown.enumerated() {
            let y = totalH - CGFloat(i + 1) * rowH + 6
            let row = MailRow(frame: NSRect(x: 0, y: y, width: W, height: rowH - 6), message: m)
            row.picking = selecting
            row.checked = checked.contains(m.uid) && !m.uid.isEmpty
            row.onSelect = { [weak self] msg in
                guard let s = self else { return }
                // En mode sélection, un clic coche au lieu d'ouvrir : on
                // est venu trier, pas lire.
                if s.selecting { s.toggleCheck(msg) } else { s.open(msg) }
            }
            row.onSwipeDelete = { [weak self] msg in
                self?.select(msg)
                self?.confirmSwipeDelete(msg)
            }
            row.onSwipeReply = { [weak self] msg in
                self?.select(msg)
                self?.reply()
            }
            listHost.addSubview(row)
            rows.append(row)
        }
        // On garde la sélection après un rafraîchissement.
        if let sel = selected, let again = msgs.first(where: { $0.uid == sel.uid && !sel.uid.isEmpty }) {
            select(again)
        } else {
            selected = nil
            replyBtn?.enabledFlag = false
            isolateBtn?.enabledFlag = false
            threatTitle?.stringValue = "Sélectionnez un message pour voir son analyse."
            threatTitle?.textColor = TH.dim(0.72)
            threatBody?.stringValue = ""
            threatCard?.isHidden = (mode != 0)
        }
    }

    private func send() {
        let to = toField.stringValue.trimmingCharacters(in: .whitespacesAndNewlines)
        guard to.contains("@") else {
            statusLabel.stringValue = "Indiquez une adresse de destinataire valide."
            return
        }
        let subject = subjectField.stringValue
        let body = bodyView.string
        let a = NSAlert()
        a.messageText = "Envoyer ce message ?"
        a.informativeText = "À : \(to)\nObjet : \(subject.isEmpty ? "(aucun)" : subject)"
            + "\nVoie : " + (MailRouter.gmailReady
                               ? "\(MailRouter.sourceLabel) (\(MailRouter.activeAddress))"
                               : "Mail.app")
        a.addButton(withTitle: "Envoyer")
        a.addButton(withTitle: "Annuler")
        NSApp.activate(ignoringOtherApps: true)
        guard a.runModal() == .alertFirstButtonReturn else { return }

        statusLabel.stringValue = "Envoi en cours…"
        let from = fromAddress()
        let ref = replyRef
        DispatchQueue.global(qos: .userInitiated).async {
            let res = MailRouter.send(to: to, subject: subject, body: body,
                                      mailFrom: from, inReplyTo: ref)
            DispatchQueue.main.async { [weak self] in
                self?.statusLabel.stringValue = res
                self?.onStatus?(res)
                if res.hasPrefix("Message envoyé") {
                    self?.toField.stringValue = ""
                    self?.subjectField.stringValue = ""
                    self?.bodyView.string = ""
                    self?.replyRef = ""
                    self?.setMode(0)
                }
            }
        }
    }

    private func composeExternally() {
        MailBridge.compose(to: toField.stringValue, subject: subjectField.stringValue, body: bodyView.string)
        statusLabel.stringValue = "Brouillon ouvert dans votre client de messagerie."
    }

    /// Pré-remplit la fenêtre depuis le chat.
    func prefill(to: String, subject: String, body: String) {
        toField.stringValue = to
        subjectField.stringValue = subject
        bodyView.string = body
    }
}
EOF_BUDMAIL_SWIFT

cat << 'EOF_BUDMAILREADER_SWIFT' > "$SRC_DIR/BudMailReader.swift"
import Cocoa

// ═══════════════════════════════════════════════════════════
//  Le lecteur de courrier, en panneau
//
//  Il était un troisième onglet, « Lecture », et c'était une
//  mauvaise idée pour deux raisons.
//
//  La première est visible : trois jeux de vues se partageaient
//  la même bande d'écran, montrés à tour de rôle. Il suffisait
//  d'en oublier un à la bascule pour que la barre des types se
//  retrouve par-dessus l'en-tête du message — ce qui est
//  arrivé. Un mode qui cache des vues est un mode qui en
//  oubliera une.
//
//  La seconde est d'usage : lire un message et garder la liste
//  sous les yeux sont deux choses qu'on veut faire ensemble, et
//  un onglet force à choisir.
//
//  Le panneau règle les deux. Il vit au-dessus du panneau de
//  BUD, se rétracte sur son en-tête d'un clic, et se referme
//  sur Échap. La liste reste derrière, intacte.
// ═══════════════════════════════════════════════════════════

final class MailReaderWindow: NSWindowController {

    /// Hauteurs des deux états. Rétracté, il ne reste que l'en-tête :
    /// de quoi savoir quel message est ouvert sans qu'il occupe l'écran.
    private static let fullHeight: CGFloat = 560
    private static let retractedHeight: CGFloat = 132
    private static let width: CGFloat = 620

    private var body: NSTextView!
    private var bodyScroll: NSScrollView!
    private var disc: InitialsDisc!
    private var fromLabel: NSTextField!
    private var addressLabel: NSTextField!
    private var subjectLabel: NSTextField!
    private var metaLabel: NSTextField!
    private var attachHost: NSView!
    private var retractBtn: GlassButton!
    private var actionRow: NSView!
    private var statusLabel: NSTextField!

    private var retracted = false
    private(set) var message: MailMessage?

    var onReply: ((MailMessage) -> Void)?
    var onDelete: ((MailMessage) -> Void)?
    var onQuarantine: ((MailMessage) -> Void)?
    /// Envoi demandé : le destinataire, l'objet et le corps approuvé.
    var onSend: ((MailMessage, String, String) -> Void)?

    // ─────────────────────────────────────────────────────────
    //  Le tiroir de réponse
    // ─────────────────────────────────────────────────────────

    private static let drawerHeight: CGFloat = 286

    private var drawer: NSView!
    private var draftText: NSTextView!
    private var draftScroll: NSScrollView!
    private var variantBtns: [GlassButton] = []
    private var phraseHost: NSView!
    private var approveBtn: GlassButton!
    private var editBtn: GlassButton!
    private var sendBtn: GlassButton!
    private var drawerOpen = false
    private var drafts: [ReplyWriter.Draft] = []
    private var chosen = 0
    /// Rien ne part sans deux gestes. Une réponse née d'une phrase dite à
    /// voix haute mérite une confirmation de plus qu'un texte tapé : un
    /// « Réponds au mail de Free » mal entendu ne doit jamais pouvoir
    /// atteindre un destinataire.
    private var approved = false

    init() {
        let w = NSPanel(contentRect: NSRect(x: 0, y: 0,
                                            width: MailReaderWindow.width,
                                            height: MailReaderWindow.fullHeight),
                        styleMask: [.titled, .closable, .utilityWindow, .resizable],
                        backing: .buffered, defer: false)
        w.title = "Message"
        w.isReleasedWhenClosed = false
        w.isFloatingPanel = true
        w.hidesOnDeactivate = false
        w.becomesKeyOnlyIfNeeded = false
        // Au-dessus du panneau de BUD, qui vit au niveau `.statusBar` :
        // sans cela le lecteur passerait dessous dès qu'on rouvre BUD.
        w.level = NSWindow.Level(rawValue: NSWindow.Level.statusBar.rawValue + 1)
        w.minSize = NSSize(width: 460, height: MailReaderWindow.retractedHeight)
        super.init(window: w)
        build()
    }
    required init?(coder: NSCoder) { fatalError() }

    // ─────────────────────────────────────────────────────────
    //  Construction
    // ─────────────────────────────────────────────────────────

    private func build() {
        guard let content = window?.contentView else { return }
        let W = MailReaderWindow.width, H = MailReaderWindow.fullHeight
        content.autoresizesSubviews = true

        disc = InitialsDisc(frame: NSRect(x: 18, y: H - 66, width: 46, height: 46))
        disc.autoresizingMask = [.minYMargin]
        content.addSubview(disc)

        fromLabel = mkLabel("", NSRect(x: 76, y: H - 44, width: W - 200, height: 22),
                            Typo.heading.size, Typo.heading.weight)
        addressLabel = mkLabel("", NSRect(x: 76, y: H - 64, width: W - 200, height: 16),
                               Typo.caption.size, .regular, alpha: Typo.Ink.faint)
        subjectLabel = mkLabel("", NSRect(x: 18, y: H - 92, width: W - 36, height: 20),
                               Typo.body.size, .semibold, alpha: Typo.Ink.normal)
        metaLabel = mkLabel("", NSRect(x: 18, y: H - 112, width: W - 36, height: 16),
                            10.5, .medium, alpha: Typo.Ink.muted)
        for l in [fromLabel, addressLabel, subjectLabel, metaLabel] {
            l?.autoresizingMask = [.minYMargin, .width]
            content.addSubview(l!)
        }

        retractBtn = GlassButton(frame: NSRect(x: W - 118, y: H - 50, width: 100, height: 30),
                                 title: "Rétracter", icon: "chevron.up", compact: true)
        retractBtn.autoresizingMask = [.minXMargin, .minYMargin]
        retractBtn.onClick = { [weak self] _ in self?.toggleRetract() }
        content.addSubview(retractBtn)

        // Les pièces jointes vivent dans leur propre vue : elle se vide et
        // se remplit à chaque message, sans toucher au reste.
        attachHost = NSView(frame: NSRect(x: 18, y: H - 152, width: W - 36, height: 34))
        attachHost.autoresizingMask = [.minYMargin, .width]
        content.addSubview(attachHost)

        bodyScroll = NSScrollView(frame: NSRect(x: 12, y: 58, width: W - 24, height: H - 220))
        bodyScroll.autoresizingMask = [.width, .height]
        bodyScroll.hasVerticalScroller = true
        bodyScroll.scrollerStyle = .overlay
        bodyScroll.drawsBackground = false
        body = NSTextView(frame: NSRect(x: 0, y: 0, width: W - 24, height: H - 220))
        body.isEditable = false
        body.isSelectable = true
        body.drawsBackground = false
        body.isRichText = false
        body.textContainerInset = NSSize(width: 16, height: 14)
        body.isVerticallyResizable = true
        body.isHorizontallyResizable = false
        body.autoresizingMask = [.width]
        body.textContainer?.widthTracksTextView = true
        let para = NSMutableParagraphStyle()
        para.lineHeightMultiple = 1.40
        para.paragraphSpacing = 8
        body.defaultParagraphStyle = para
        bodyScroll.documentView = body
        content.addSubview(bodyScroll)

        statusLabel = mkLabel("", NSRect(x: 18, y: 40, width: W - 36, height: 15),
                              10.5, .regular, alpha: Typo.Ink.muted)
        statusLabel.autoresizingMask = [.width, .maxYMargin]
        statusLabel.isSelectable = false
        content.addSubview(statusLabel)

        actionRow = NSView(frame: NSRect(x: 12, y: 8, width: W - 24, height: 30))
        actionRow.autoresizingMask = [.width, .maxYMargin]
        content.addSubview(actionRow)

        buildDrawer(content, W)
    }

    // ─────────────────────────────────────────────────────────
    //  Le tiroir de réponse
    //
    //  Il ne remplace pas le message : il s'ouvre dessous, et
    //  le message reste visible au-dessus. Répondre sans
    //  pouvoir relire ce à quoi on répond est une mauvaise
    //  façon de répondre.
    // ─────────────────────────────────────────────────────────

    private func buildDrawer(_ content: NSView, _ W: CGFloat) {
        let D = MailReaderWindow.drawerHeight
        drawer = NSView(frame: NSRect(x: 12, y: 58, width: W - 24, height: D))
        drawer.autoresizingMask = [.width, .maxYMargin]
        drawer.wantsLayer = true
        drawer.isHidden = true
        content.addSubview(drawer)

        let w = W - 24

        // Les trois propositions. On ne devine pas laquelle vous voulez :
        // l'accusé de réception, la réponse sur le fond et la demande de
        // délai répondent à trois intentions différentes.
        let labels = ["Accusé de réception", "Réponse sur le fond", "Demande de délai"]
        let bw = (w - 16) / 3
        for (i, t) in labels.enumerated() {
            let b = GlassButton(frame: NSRect(x: CGFloat(i) * (bw + 8), y: D - 32,
                                              width: bw, height: 30),
                                title: t, icon: nil, compact: true)
            b.onClick = { [weak self] _ in self?.choose(i) }
            drawer.addSubview(b)
            variantBtns.append(b)
        }

        draftScroll = NSScrollView(frame: NSRect(x: 0, y: 84, width: w, height: D - 124))
        draftScroll.hasVerticalScroller = true
        draftScroll.scrollerStyle = .overlay
        draftScroll.drawsBackground = false
        draftScroll.autoresizingMask = [.width, .height]
        draftText = NSTextView(frame: NSRect(x: 0, y: 0, width: w, height: D - 124))
        draftText.isEditable = true
        draftText.isSelectable = true
        draftText.isRichText = false
        draftText.drawsBackground = false
        draftText.font = NSFont.systemFont(ofSize: 13)
        draftText.textContainerInset = NSSize(width: 12, height: 10)
        draftText.isVerticallyResizable = true
        draftText.isHorizontallyResizable = false
        draftText.autoresizingMask = [.width]
        draftText.textContainer?.widthTracksTextView = true
        draftScroll.documentView = draftText
        drawer.addSubview(draftScroll)

        // Vos propres tournures, relevées dans vos messages envoyés. Un
        // clic les insère au curseur. Elles ne sont pas placées d'office :
        // une phrase de vous au mauvais endroit reste au mauvais endroit.
        phraseHost = NSView(frame: NSRect(x: 0, y: 44, width: w, height: 30))
        phraseHost.autoresizingMask = [.width, .maxYMargin]
        drawer.addSubview(phraseHost)

        let aw = (w - 16) / 3
        editBtn = GlassButton(frame: NSRect(x: 0, y: 4, width: aw, height: 34),
                              title: "Modifier", icon: "pencil")
        editBtn.onClick = { [weak self] _ in self?.beginEditing() }
        approveBtn = GlassButton(frame: NSRect(x: aw + 8, y: 4, width: aw, height: 34),
                                 title: "Valider", icon: "checkmark")
        approveBtn.onClick = { [weak self] _ in self?.approve() }
        sendBtn = GlassButton(frame: NSRect(x: 2 * (aw + 8), y: 4, width: aw, height: 34),
                              title: "Envoyer", icon: "paperplane.fill", prominent: true)
        sendBtn.onClick = { [weak self] _ in self?.sendDraft() }
        [editBtn, approveBtn, sendBtn].forEach { drawer.addSubview($0) }
    }

    /// Ouvre le tiroir sur un message, avec les trois propositions prêtes.
    func compose(_ m: MailMessage, body: String, style: ReplyStyle) {
        if message?.uid != m.uid { show(m) }
        drafts = ReplyWriter.drafts(for: m, body: body, style: style)
        chosen = 0
        buildPhraseChips(style)
        choose(0)
        setDrawer(open: true)
    }

    private func choose(_ i: Int) {
        guard drafts.indices.contains(i) else { return }
        chosen = i
        for (j, b) in variantBtns.enumerated() { b.prominent = (j == i) }
        draftText.string = drafts[i].text
        // Le texte n'est plus celui qu'on a approuvé : l'envoi se referme.
        approved = false
        refreshSendState()
        selectPlaceholder()
    }

    /// Place le curseur là où BUD ne peut pas écrire à votre place, et
    /// sélectionne le marqueur : il suffit de taper par-dessus.
    private func selectPlaceholder() {
        guard let r = draftText.string.range(of: ReplyWriter.placeholder) else {
            draftText.setSelectedRange(NSRange(location: 0, length: 0))
            return
        }
        let ns = NSRange(r, in: draftText.string)
        draftText.setSelectedRange(ns)
        draftText.scrollRangeToVisible(ns)
    }

    private func buildPhraseChips(_ style: ReplyStyle) {
        phraseHost.subviews.forEach { $0.removeFromSuperview() }
        let mine = style.phrases
            .filter { $0.role == .ask || $0.role == .thanks || $0.role == .close }
            .sorted { $0.count > $1.count }
            .prefix(3)
        guard !mine.isEmpty else { return }
        var x: CGFloat = 0
        for p in mine {
            let short = p.text.count > 34 ? String(p.text.prefix(32)) + "…" : p.text
            let w = min(phraseHost.bounds.width - x - 4,
                        CGFloat(short.count) * 6.2 + 26)
            guard w > 60 else { break }
            let chip = GlassButton(frame: NSRect(x: x, y: 2, width: w, height: 26),
                                   title: short, icon: nil, compact: true)
            chip.onClick = { [weak self] _ in self?.insert(p.text) }
            phraseHost.addSubview(chip)
            x += w + 6
        }
    }

    private func insert(_ phrase: String) {
        let sel = draftText.selectedRange()
        if draftText.shouldChangeText(in: sel, replacementString: phrase) {
            draftText.replaceCharacters(in: sel, with: phrase)
            draftText.didChangeText()
        }
        approved = false
        refreshSendState()
    }

    private func beginEditing() {
        window?.makeFirstResponder(draftText)
        selectPlaceholder()
        approved = false
        refreshSendState()
        setStatus("Modifiez librement le texte, puis validez.")
    }

    private func approve() {
        let text = draftText.string.trimmingCharacters(in: .whitespacesAndNewlines)
        guard !text.isEmpty else {
            setStatus("Le message est vide.")
            return
        }
        // Le marqueur laissé en place partirait tel quel au destinataire.
        if text.contains(ReplyWriter.placeholder) {
            setStatus("Il reste « \(ReplyWriter.placeholder) » dans le texte : remplacez-le avant de valider.")
            selectPlaceholder()
            return
        }
        approved = true
        refreshSendState()
        setStatus("Validé. « Envoyer » est maintenant actif.")
    }

    private func refreshSendState() {
        sendBtn.enabledFlag = approved
        approveBtn.prominent = !approved
    }

    private func sendDraft() {
        guard approved, let m = message else {
            setStatus("Validez d'abord le texte.")
            return
        }
        let subject = m.subject.lowercased().hasPrefix("re")
            ? m.subject : "Re: \(m.subject)"
        onSend?(m, subject, draftText.string)
        setDrawer(open: false)
    }

    /// Ouvre ou ferme le tiroir, en agrandissant la fenêtre plutôt qu'en
    /// écrasant le message : le corps garde sa place.
    private func setDrawer(open: Bool) {
        guard drawerOpen != open, let w = window else { return }
        drawerOpen = open
        drawer.isHidden = !open

        var f = w.frame
        let top = f.maxY
        let base = retracted ? MailReaderWindow.retractedHeight : MailReaderWindow.fullHeight
        let target = open ? base + MailReaderWindow.drawerHeight : base
        f.size.height = target
        f.origin.y = top - target
        NSAnimationContext.runAnimationGroup { ctx in
            ctx.duration = Motion.base
            ctx.timingFunction = Motion.enter
            w.animator().setFrame(f, display: true)
        }
        relayout()
        if open { window?.makeFirstResponder(draftText) }
    }

    /// Replace le corps et le tiroir dans la hauteur disponible.
    private func relayout() {
        guard let content = window?.contentView else { return }
        let H = content.bounds.height, W = content.bounds.width
        let D = drawerOpen ? MailReaderWindow.drawerHeight : 0
        drawer.frame = NSRect(x: 12, y: 58, width: W - 24,
                              height: MailReaderWindow.drawerHeight)
        let bodyTop = H - 152
        let bodyBottom = 66 + D
        bodyScroll.frame = NSRect(x: 12, y: bodyBottom, width: W - 24,
                                  height: max(60, bodyTop - bodyBottom))
    }

    // ─────────────────────────────────────────────────────────
    //  Afficher un message
    // ─────────────────────────────────────────────────────────

    func show(_ m: MailMessage) {
        message = m
        disc.message = m
        fromLabel.stringValue = m.shortSender.isEmpty ? "(expéditeur inconnu)" : m.shortSender
        addressLabel.stringValue = m.address
        subjectLabel.stringValue = m.subject.isEmpty ? "(sans objet)" : m.subject
        window?.title = m.subject.isEmpty ? "Message" : String(m.subject.prefix(60))

        var meta = MailDate.parse(m.date).map { d -> String in
            let f = DateFormatter()
            f.setLocalizedDateFormatFromTemplate("EEEEdMMMMyHm")
            return f.string(from: d)
        } ?? m.date
        meta += "  ·  " + m.category.label
        let lvl = m.threat.level
        if lvl != .clean { meta += "  ·  " + lvl.label }
        metaLabel.stringValue = meta
        metaLabel.textColor = lvl == .clean ? TH.dim(Typo.Ink.muted) : lvl.color

        buildAttachments(m)
        buildActions(m)
        setBody(m.readableBody.isEmpty
                ? "Le corps de ce message n'a pas encore été rapatrié."
                : m.readableBody)

        if retracted { toggleRetract() }
        showWindow(nil)
        window?.makeKeyAndOrderFront(nil)
        NSApp.activate(ignoringOtherApps: true)
    }

    func setBody(_ text: String) {
        body.string = text
        if let para = body.defaultParagraphStyle {
            let all = NSRange(location: 0, length: body.string.utf16.count)
            body.textStorage?.addAttributes([.paragraphStyle: para,
                                             .font: NSFont.systemFont(ofSize: 13),
                                             .foregroundColor: TH.dim(0.88)], range: all)
        }
        body.scroll(NSPoint(x: 0, y: 0))
    }

    func setStatus(_ s: String) { statusLabel.stringValue = s }

    // ─────────────────────────────────────────────────────────
    //  Pièces jointes
    // ─────────────────────────────────────────────────────────

    private func buildAttachments(_ m: MailMessage) {
        attachHost.subviews.forEach { $0.removeFromSuperview() }
        let joined = m.parts.filter { $0.isAttachment }
        guard !joined.isEmpty else {
            attachHost.isHidden = true
            return
        }
        attachHost.isHidden = false

        var x: CGFloat = 0
        for p in joined.prefix(6) {
            let label = p.readableSize.isEmpty ? p.name : "\(p.name)  ·  \(p.readableSize)"
            let w = min(240, textWidth(label, size: 11, weight: .medium) + 46)
            guard x + w < attachHost.bounds.width else { break }
            let b = GlassButton(frame: NSRect(x: x, y: 0, width: w, height: 30),
                                title: label, icon: p.icon, compact: true)
            let part = p
            let uid = m.uid
            b.onClick = { [weak self] _ in self?.open(part, uid: uid) }
            attachHost.addSubview(b)
            x += w + 8
        }
    }

    /// Rapatrie la pièce jointe et l'ouvre avec l'application du système.
    ///
    /// Elle est écrite dans un dossier temporaire à nous, et non dans les
    /// Téléchargements : une pièce jointe ouverte n'est pas un fichier
    /// qu'on a choisi de garder.
    private func open(_ part: MailPart, uid: String) {
        guard MailRouter.gmailReady else {
            setStatus("L'ouverture des pièces jointes demande un compte relié.")
            return
        }
        setStatus("Téléchargement de « \(part.name) »…")
        DispatchQueue.global(qos: .userInitiated).async {
            let data = MailRouter.attachment(uid: uid, part: part)
            DispatchQueue.main.async { [weak self] in
                guard let s = self else { return }
                guard let d = data, !d.isEmpty else {
                    s.setStatus("« \(part.name) » n'a pas pu être rapatriée.")
                    return
                }
                let dir = FileManager.default.temporaryDirectory
                    .appendingPathComponent("BUD-pieces-jointes", isDirectory: true)
                try? FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
                // Le nom vient du message : on n'en garde que le dernier
                // composant, pour qu'il ne puisse pas désigner un chemin.
                let safe = (part.name as NSString).lastPathComponent
                let url = dir.appendingPathComponent(safe.isEmpty ? "piece-jointe" : safe)
                do {
                    try d.write(to: url, options: .atomic)
                    s.setStatus("\(formatBytes(Int64(d.count))) · ouverte dans l'application du système.")
                    NSWorkspace.shared.open(url)
                } catch {
                    s.setStatus("Écriture impossible : \(error.localizedDescription)")
                }
            }
        }
    }

    // ─────────────────────────────────────────────────────────
    //  Actions
    // ─────────────────────────────────────────────────────────

    private func buildActions(_ m: MailMessage) {
        actionRow.subviews.forEach { $0.removeFromSuperview() }
        var specs: [(String, String, Bool, () -> Void)] = [
            ("Répondre", "arrowshape.turn.up.left.fill", false, { [weak self] in
                guard let s = self, let msg = s.message else { return }
                s.onReply?(msg)
            }),
            ("Supprimer", "trash.fill", true, { [weak self] in
                guard let s = self, let msg = s.message else { return }
                s.onDelete?(msg)
            }),
            ("Isoler", "shield.lefthalf.filled", false, { [weak self] in
                guard let s = self, let msg = s.message else { return }
                s.onQuarantine?(msg)
            })
        ]

        // Le désabonnement n'apparaît que si l'expéditeur l'a déclaré, et
        // jamais pour un message signalé : cliquer un lien de
        // désabonnement dans un courriel dangereux confirme à l'expéditeur
        // que l'adresse est lue. C'est le contraire du service rendu.
        if let link = unsubscribeLink(m), m.threat.level == .clean {
            specs.append(("Se désabonner", "bell.slash", false, { [weak self] in
                NSWorkspace.shared.open(link)
                self?.setStatus("Page de désabonnement ouverte dans le navigateur.")
            }))
        }

        let w = (actionRow.bounds.width - CGFloat(specs.count - 1) * 8) / CGFloat(specs.count)
        for (i, sp) in specs.enumerated() {
            let b = GlassButton(frame: NSRect(x: CGFloat(i) * (w + 8), y: 0, width: w, height: 30),
                                title: sp.0, icon: sp.1, compact: true)
            b.destructive = sp.2
            b.onClick = { _ in sp.3() }
            actionRow.addSubview(b)
        }
    }

    /// L'adresse de désabonnement, si l'expéditeur en a déclaré une.
    /// On ne retient que `https` : un `mailto:` ferait écrire au nom de
    /// l'utilisateur, ce qui ne se fait pas sans le lui demander.
    private func unsubscribeLink(_ m: MailMessage) -> URL? {
        guard !m.bulkHeaders.isEmpty else { return nil }
        guard let re = try? NSRegularExpression(pattern: "<(https://[^>]+)>") else { return nil }
        let r = NSRange(m.bulkHeaders.startIndex..., in: m.bulkHeaders)
        guard let match = re.firstMatch(in: m.bulkHeaders, range: r),
              let rr = Range(match.range(at: 1), in: m.bulkHeaders) else { return nil }
        return URL(string: String(m.bulkHeaders[rr]))
    }

    // ─────────────────────────────────────────────────────────
    //  Rétraction
    // ─────────────────────────────────────────────────────────

    /// Replie le panneau sur son en-tête, ou le rouvre. Le bord **haut**
    /// reste en place : c'est ce qui donne l'impression d'un store qu'on
    /// baisse, et non d'une fenêtre qui saute.
    private func toggleRetract() {
        guard let w = window else { return }
        retracted.toggle()
        let base = retracted ? MailReaderWindow.retractedHeight : MailReaderWindow.fullHeight
        let target = base + (drawerOpen ? MailReaderWindow.drawerHeight : 0)
        var f = w.frame
        let top = f.maxY
        f.size.height = target
        f.origin.y = top - target

        bodyScroll.isHidden = retracted
        statusLabel.isHidden = retracted
        actionRow.isHidden = retracted
        attachHost.isHidden = retracted || attachHost.subviews.isEmpty
        drawer.isHidden = retracted || !drawerOpen
        retractBtn.title = retracted ? "Déplier" : "Rétracter"
        retractBtn.iconName = retracted ? "chevron.down" : "chevron.up"

        NSAnimationContext.runAnimationGroup { ctx in
            ctx.duration = Motion.base
            ctx.timingFunction = Motion.enter
            w.animator().setFrame(f, display: true)
        }
    }

    override func keyDown(with event: NSEvent) {
        if event.keyCode == 53 { window?.close(); return }   // Échap
        super.keyDown(with: event)
    }
}
EOF_BUDMAILREADER_SWIFT

cat << 'EOF_BUDMAILSYNC_SWIFT' > "$SRC_DIR/BudMailSync.swift"
import Cocoa

// ═══════════════════════════════════════════════════════════
//  Synchronisation du courrier
//
//  Le défaut auquel ce fichier répond : ouvrir l'onglet Courrier
//  lançait un relevé complet et affichait une liste vide en
//  attendant. Session TLS, authentification, recherche, soixante
//  en-têtes, douze corps — plusieurs secondes de page blanche, à
//  chaque ouverture, pour des messages qui n'avaient pas changé
//  depuis la précédente.
//
//  Trois mesures, dans cet ordre d'importance :
//
//  1. Un cache sur disque. La boîte s'affiche instantanément avec
//     ce qu'on savait d'elle, puis se met à jour si besoin. On ne
//     regarde plus jamais une liste vide.
//
//  2. Un sondage qui coûte un aller-retour. `STATUS INBOX
//     (UIDNEXT UNSEEN)` dit si quelque chose a bougé sans
//     rapatrier un seul message. Le relevé complet n'a lieu que
//     si la réponse a changé.
//
//  3. Un relevé de fond, à intervalle régulier et hors du fil
//     principal. L'utilisateur n'a plus à cliquer « Actualiser »
//     pour voir arriver son courrier.
//
//  Ce que ce fichier ne prétend pas être : du push. IMAP IDLE
//  demanderait de tenir une connexion ouverte en permanence, de
//  la rouvrir à chaque réveil de veille et de gérer son
//  expiration toutes les vingt-neuf minutes. C'est faisable, ce
//  n'est pas fait ici, et le sondage intelligent en donne
//  l'essentiel pour une fraction du risque.
// ═══════════════════════════════════════════════════════════

final class MailSync {

    static let shared = MailSync()

    /// Ce qu'on garde d'un relevé, sur disque entre deux lancements.
    struct Cached: Codable {
        var savedAt: TimeInterval = 0
        /// L'adresse du compte au moment de l'enregistrement. Changer de
        /// compte doit vider la boîte affichée : montrer le courrier du
        /// compte précédent serait une fuite, pas un cache.
        var account: String = ""
        var unread: Int = 0
        var source: String = ""
        var uidNext: String = ""
        var messages: [MailMessage] = []
    }

    private(set) var cached = Cached()
    private var loaded = false
    private var syncing = false
    private var timer: Timer?

    /// Appelé sur le fil principal quand la boîte a changé.
    var onUpdate: ((Cached) -> Void)?

    private var url: URL { budSupportDir.appendingPathComponent("inbox-cache.json") }

    private init() {}

    // ─────────────────────────────────────────────────────────
    //  Le cache
    // ─────────────────────────────────────────────────────────

    /// Rend ce qu'on sait de la boîte, tout de suite. Le fichier n'est lu
    /// qu'une fois par session : les ouvertures suivantes sont servies
    /// depuis la mémoire.
    @discardableResult
    func warmUp() -> Cached {
        guard !loaded else { return cached }
        loaded = true
        if let d = try? Data(contentsOf: url),
           let c = try? JSONDecoder().decode(Cached.self, from: d) {
            // Un cache qui n'est pas celui du compte relié ne vaut rien.
            if c.account == MailRouter.activeAddress { cached = c }
        }
        return cached
    }

    private func persist() {
        let e = JSONEncoder()
        guard let d = try? e.encode(cached) else { return }
        try? d.write(to: url, options: .atomic)
    }

    /// Efface le cache. À appeler quand on change de compte.
    func forget() {
        cached = Cached()
        loaded = true
        try? FileManager.default.removeItem(at: url)
    }

    // ─────────────────────────────────────────────────────────
    //  La synchronisation
    // ─────────────────────────────────────────────────────────

    /// Met la boîte à jour hors du fil principal.
    ///
    /// `force` saute le sondage et fait le relevé complet : c'est ce que
    /// demande le bouton « Actualiser », qui doit aussi voir ce que le
    /// sondage ne détecte pas — une suppression faite ailleurs, par exemple.
    func sync(force: Bool = false, done: ((Cached, String?) -> Void)? = nil) {
        guard !syncing else { done?(cached, nil); return }
        syncing = true
        let account = MailRouter.activeAddress

        DispatchQueue.global(qos: .utility).async { [weak self] in
            guard let s = self else { return }

            // Étape 1 : sonder, sauf si l'on nous demande de ne pas le faire.
            if !force, !s.cached.messages.isEmpty, s.cached.account == account,
               let (next, unseen) = MailRouter.status(),
               next == s.cached.uidNext, unseen == s.cached.unread {
                DispatchQueue.main.async {
                    s.syncing = false
                    done?(s.cached, nil)          // rien de neuf, rien à redessiner
                }
                return
            }

            // Étape 2 : le relevé complet, puisqu'il a lieu d'être.
            let snap = MailRouter.snapshot(60)
            DispatchQueue.main.async {
                s.syncing = false
                guard snap.error == nil, snap.unread >= 0 || !snap.msgs.isEmpty else {
                    done?(s.cached, snap.error)
                    return
                }
                var c = Cached()
                c.savedAt = Date().timeIntervalSince1970
                c.account = account
                c.unread = max(0, snap.unread)
                c.source = snap.source
                c.uidNext = snap.uidNext
                c.messages = snap.msgs
                s.cached = c
                s.loaded = true
                s.persist()
                done?(c, nil)
                s.onUpdate?(c)
            }
        }
    }

    /// Démarre le sondage de fond.
    ///
    /// Quatre-vingt-dix secondes : assez rapproché pour qu'un message
    /// arrive de lui-même pendant qu'on travaille, assez espacé pour que
    /// le coût reste un aller-retour par minute et demie. Le minuteur
    /// tolère un décalage, pour se grouper avec les autres réveils du
    /// système plutôt que d'en provoquer un pour lui seul.
    func startPolling() {
        timer?.invalidate()
        let t = Timer(timeInterval: 90, repeats: true) { [weak self] _ in
            guard MailRouter.gmailReady else { return }
            self?.sync()
        }
        t.tolerance = 20
        RunLoop.main.add(t, forMode: .common)
        timer = t
    }

    func stopPolling() {
        timer?.invalidate()
        timer = nil
    }
}
EOF_BUDMAILSYNC_SWIFT

cat << 'EOF_BUDMUSIC_SWIFT' > "$SRC_DIR/BudMusic.swift"
import Cocoa
import Foundation

// ═══════════════════════════════════════════════════════════
//  Musique — Apple Music seule
//
//  Spotify et Alexa ont été retirés. Alexa surtout : Amazon
//  n'expose aucune interface locale sur macOS, et le piloter
//  par les touches média d'un lecteur web était un bricolage
//  qui réclamait l'autorisation Accessibilité pour un résultat
//  imprévisible. Mieux vaut une seule source bien tenue.
//
//  Tout passe par AppleScript, l'interface que Music.app
//  publie officiellement. Un seul aller-retour rapporte l'état
//  complet : titre, artiste, album, position, durée, volume,
//  lecture aléatoire et répétition.
// ═══════════════════════════════════════════════════════════
struct NowPlaying {
    var available = false          // Music.app est lancée
    var playing = false
    var title = ""
    var artist = ""
    var album = ""
    var position: Double = 0
    var duration: Double = 0
    var volume: Int = 50
    var shuffle = false
    var repeatMode = "off"         // off · one · all

    /// Identité du morceau, pour savoir quand la pochette a changé.
    /// L'identifiant persistant de Music quand il existe ; sinon le
    /// couple titre/artiste, qui suffit pour une radio ou un flux.
    var trackKey = ""
    /// Pourquoi Musique n'a rien dit, quand elle n'a rien dit. Une phrase
    /// en clair, jamais un code : une liste vide sans explication laissait
    /// croire à une panne, mais « erreur de syntaxe (-2741) » n'explique
    /// rien à qui n'écrit pas d'AppleScript.
    var trouble = ""
    /// L'autorisation Automatisation manque : le panneau propose alors
    /// d'ouvrir le bon volet des réglages.
    var needsAuth = false

    /// Ce que BUD a vraiment pu lire. Ce qu'il ne sait pas, il ne
    /// l'affiche pas comme valant zéro : un curseur de volume à 50 quand
    /// la valeur est inconnue est un mensonge, et on cherche longtemps
    /// pourquoi le son ne suit pas.
    var volumeKnown = false
    var modesKnown = false         // aléatoire et répétition
    var positionKnown = false

    enum Source { case none, script, core, feed }
    var source: Source = .none

    var hasTrack: Bool { !title.isEmpty }

    /// « 1:42 / 3:58 ». Vide si la position n'est pas connue : mieux vaut
    /// pas de minuterie qu'une minuterie fausse.
    var timeText: String {
        guard duration > 0, positionKnown else { return "" }
        return "\(mmss(position)) / \(mmss(duration))"
    }
    var progress: Double {
        guard duration > 0, positionKnown else { return 0 }
        return max(0, min(1, position / duration))
    }
    private func mmss(_ t: Double) -> String {
        let s = max(0, Int(t.rounded()))
        return String(format: "%d:%02d", s / 60, s % 60)
    }

    /// Ce que le notch affiche : « Titre — Artiste », tronqué par l'appelant.
    var oneLine: String {
        if title.isEmpty { return "" }
        return artist.isEmpty ? title : "\(title) — \(artist)"
    }

    /// Complète par ce que Musique a annoncé d'elle-même.
    ///
    /// Deux cas, et la différence compte. Quand le script a parlé, il fait
    /// foi : s'il dit « rien en lecture », c'est qu'il n'y a rien, et une
    /// annonce ancienne ne doit pas ressusciter le morceau précédent.
    /// Quand le script n'a rien pu dire, l'annonce devient la seule source.
    mutating func fill(from a: MusicAnnounce?, scriptSpoke: Bool, estimate: Double?) {
        guard let a = a, a.hasTrack else { return }
        if scriptSpoke {
            if duration <= 0 { duration = a.duration }
            if album.isEmpty { album = a.album }
            return
        }
        source = .feed
        title = a.title
        artist = a.artist
        album = a.album
        playing = a.playing
        duration = a.duration
        trackKey = a.trackKey
        if let p = estimate {
            position = p
            positionKnown = true
        }
    }
}

// ═══════════════════════════════════════════════════════════
//  Ce qui peut mal tourner
//
//  Trois familles, et elles ne se disent pas pareil.
//
//  L'autorisation manquante est l'affaire de l'utilisateur :
//  on dit où cliquer. Musique fermée est un fait : on le dit.
//
//  Une erreur de syntaxe, en revanche, est une faute de BUD —
//  il a mal formé sa demande. L'afficher revient à montrer la
//  trace d'une pile à quelqu'un qui voulait écouter un disque.
//  Elle part donc dans un journal, et l'interface se contente
//  de dire ce qu'elle sait faire malgré tout.
// ═══════════════════════════════════════════════════════════

enum MusicFault {
    case none
    case notAuthorized
    case notRunning
    case malformed(String)
    case other(String)

    /// La phrase montrée. Vide quand il n'y a rien d'utile à dire.
    var userText: String {
        switch self {
        case .none, .malformed:
            return ""
        case .notAuthorized:
            return "Musique est ouverte mais BUD n'a pas le droit de la piloter. "
                + "Réglages Système → Confidentialité et sécurité → Automatisation → BUD, "
                + "puis cochez Musique. Une mise à jour de BUD peut retirer cette coche."
        case .notRunning:
            return "Musique s'est fermée."
        case .other:
            return "Musique n'a pas répondu."
        }
    }

    var needsAuth: Bool { if case .notAuthorized = self { return true }; return false }

    static func classify(_ err: String) -> MusicFault {
        if err.isEmpty { return .none }
        let low = err.lowercased()
        if err.contains("-1743") || low.contains("not authorized") { return .notAuthorized }
        if err.contains("-600") || err.contains("-609") || low.contains("isn't running") {
            return .notRunning
        }
        // -2741 et -2740 : le script n'a pas compilé. -1708 : un terme que
        // l'application ne connaît pas. Dans les deux cas BUD a tort.
        if low.contains("syntax error") || err.contains("-2741")
            || err.contains("-2740") || err.contains("-1708") {
            return .malformed(err)
        }
        return .other(err)
    }
}

enum MusicBridge {
    static let appName = "Music"
    static let bundleID = "com.apple.Music"

    /// Toute demande à Musique passe par là. Une file série, pour deux
    /// raisons : jamais deux osascript en vol en même temps — l'export de
    /// pochette et la lecture d'état se chevauchaient et se volaient leurs
    /// messages d'erreur — et jamais rien sur le fil principal.
    private static let q = DispatchQueue(label: "fr.lahbib.bud.music.script",
                                         qos: .userInitiated)

    /// Sans lancer de processus : la liste des applications actives
    /// suffit, et un sondage toutes les quatre secondes doit rester gratuit
    /// quand Music est fermée.
    static func running() -> Bool {
        NSWorkspace.shared.runningApplications.contains { $0.bundleIdentifier == bundleID }
    }

    // ─────────────────────────────────────────────────────────
    //  AppleScript
    //
    //  Les variables portent toutes un préfixe « bud ». Ce n'est
    //  pas de la coquetterie : `st` est un mot réservé
    //  d'AppleScript — un suffixe ordinal, comme dans « 1st
    //  item » — et `set st to "stopped"` empêchait le script
    //  **entier** de compiler. Les blocs `try` n'y pouvaient
    //  rien : ils attrapent les erreurs d'exécution, et une
    //  erreur de compilation arrive avant que la première ligne
    //  ne s'exécute. Un seul mot de deux lettres rendait donc
    //  muets à la fois l'état de lecture et la pochette.
    //
    //  Un identifiant préfixé ne peut collisionner ni avec un
    //  mot du langage ni avec un terme du dictionnaire de
    //  Musique, aujourd'hui ni dans la version d'après.
    // ─────────────────────────────────────────────────────────

    private struct Reply {
        let out: String
        let fault: MusicFault
        var ok: Bool { if case .none = fault { return true }; return false }
    }

    private static func osa(_ script: String) -> Reply {
        let r = runShellDetailed("/usr/bin/osascript", ["-e", script])
        let fault = r.status == 0 ? MusicFault.none : MusicFault.classify(r.err)
        if case .malformed(let detail) = fault { logFault(detail) }
        return Reply(out: r.out, fault: fault)
    }

    /// Un script mal formé est un défaut à corriger, pas un message à
    /// afficher. Il est donc écrit là où on peut le retrouver, et le
    /// journal est borné pour ne pas grossir sans fin.
    private static func logFault(_ detail: String) {
        let url = budSupportDir.appendingPathComponent("music.log")
        let line = "\(shortDateString()) \(detail.prefix(400))\n"
        var text = (try? String(contentsOf: url, encoding: .utf8)) ?? ""
        text += line
        if text.count > 32_768 { text = String(text.suffix(24_576)) }
        try? text.write(to: url, atomically: true, encoding: .utf8)
    }

    /// AppleScript peut rendre « 12,345 » selon la langue du système.
    private static func num(_ s: String) -> Double {
        Double(s.replacingOccurrences(of: ",", with: ".").trimmingCharacters(in: .whitespaces)) ?? 0
    }

    private static let sep = "|~|"

    /// Le relevé complet. Chaque propriété dans son propre `try` : si une
    /// version de Musique n'expose plus la répétition, on perd cette seule
    /// information — mais seulement si le script compile, d'où le palier
    /// suivant.
    private static let fullScript = """
    tell application "Music"
        set budState to "stopped"
        set budName to ""
        set budArtist to ""
        set budAlbum to ""
        set budPos to -1
        set budDur to 0
        set budVol to -1
        set budShuffle to "unknown"
        set budRepeat to "unknown"
        set budIdent to ""
        try
            set budState to (player state as text)
        end try
        try
            set budVol to (sound volume as integer)
        end try
        try
            set budShuffle to (shuffle enabled as text)
        end try
        try
            set budRepeat to (song repeat as text)
        end try
        try
            set budItem to current track
            set budName to (name of budItem as text)
            set budArtist to (artist of budItem as text)
            set budAlbum to (album of budItem as text)
            set budDur to (duration of budItem)
            try
                set budPos to (player position)
                if budPos is missing value then set budPos to -1
            end try
            try
                set budIdent to (persistent ID of budItem as text)
            end try
        end try
        set budOut to budState & "|~|" & budName & "|~|" & budArtist & "|~|" & budAlbum
        set budOut to budOut & "|~|" & (budPos as text) & "|~|" & (budDur as text)
        set budOut to budOut & "|~|" & (budVol as text) & "|~|" & budShuffle & "|~|" & budRepeat
        set budOut to budOut & "|~|" & budIdent
        return budOut
    end tell
    """

    /// Le noyau sûr : quatre termes, inchangés depuis iTunes. Il sert quand
    /// le relevé complet ne compile pas, pour qu'un terme disparu du
    /// dictionnaire coûte le volume et les modes, pas le titre du morceau.
    private static let coreScript = """
    tell application "Music"
        set budState to "stopped"
        set budName to ""
        set budArtist to ""
        set budAlbum to ""
        try
            set budState to (player state as text)
        end try
        try
            set budItem to current track
            set budName to (name of budItem as text)
            set budArtist to (artist of budItem as text)
            set budAlbum to (album of budItem as text)
        end try
        return budState & "|~|" & budName & "|~|" & budArtist & "|~|" & budAlbum
    end tell
    """

    /// Vrai tant que le relevé complet compile. Mis à faux au premier
    /// script mal formé pour ne pas relancer un processus condamné toutes
    /// les quatre secondes.
    private static var fullUsable = true

    /// L'état, lu sur la file `q`. L'annonce et l'estimation arrivent en
    /// paramètres : elles sont écrites sur le fil principal, et deux files
    /// qui touchent la même variable, c'est une course.
    private static func readState(feed: MusicAnnounce?, estimate: Double?) -> NowPlaying {
        var n = NowPlaying()
        guard running() else {
            DispatchQueue.main.async { MusicFeed.forget() }
            return n
        }
        n.available = true

        if fullUsable {
            let r = osa(fullScript)
            let p = r.out.components(separatedBy: sep)
            if r.ok && p.count >= 10 {
                n.source = .script
                n.playing = p[0].lowercased().contains("playing")
                n.title = clean(p[1])
                n.artist = clean(p[2])
                n.album = clean(p[3])
                let pos = num(p[4])
                n.position = max(0, pos)
                n.positionKnown = pos >= 0
                n.duration = num(p[5])
                let vol = Int(num(p[6]))
                n.volume = vol < 0 ? 50 : min(100, vol)
                n.volumeKnown = vol >= 0
                let sh = clean(p[7]).lowercased()
                let rp = clean(p[8]).lowercased()
                n.modesKnown = sh != "unknown" && rp != "unknown"
                n.shuffle = sh.contains("true")
                n.repeatMode = n.modesKnown ? rp : "off"
                let ident = clean(p[9])
                n.trackKey = ident.isEmpty
                    ? (n.title.isEmpty ? "" : "\(n.title)|\(n.artist)|\(n.album)")
                    : ident
                n.fill(from: feed, scriptSpoke: true, estimate: estimate)
                return n
            }
            if case .malformed = r.fault { fullUsable = false }
            else {
                // Autorisation refusée, Musique partie : inutile d'essayer
                // le noyau, il échouerait de la même façon.
                n.trouble = r.fault.userText
                n.needsAuth = r.fault.needsAuth
                n.fill(from: feed, scriptSpoke: false, estimate: estimate)
                return n
            }
        }

        let r = osa(coreScript)
        let p = r.out.components(separatedBy: sep)
        if r.ok && p.count >= 4 {
            n.source = .core
            n.playing = p[0].lowercased().contains("playing")
            n.title = clean(p[1])
            n.artist = clean(p[2])
            n.album = clean(p[3])
            n.trackKey = n.title.isEmpty ? "" : "\(n.title)|\(n.artist)|\(n.album)"
            n.fill(from: feed, scriptSpoke: true, estimate: estimate)
            return n
        }

        // Plus rien du côté des scripts : il reste ce que Musique annonce
        // d'elle-même. On le dit sans jargon, et sans prétendre que la
        // liste est vide alors qu'on n'en sait rien.
        n.trouble = r.fault.userText
        n.needsAuth = r.fault.needsAuth
        n.fill(from: feed, scriptSpoke: false, estimate: estimate)
        if n.trouble.isEmpty && !n.hasTrack {
            n.trouble = "BUD attend le prochain changement de morceau pour connaître le titre."
        }
        return n
    }

    private static func clean(_ s: String) -> String {
        s.trimmingCharacters(in: .whitespacesAndNewlines)
    }

    /// Lit l'état hors du fil principal et rend le résultat sur le fil
    /// principal. C'est la seule entrée publique : il n'existe plus de
    /// version bloquante, donc plus de façon d'attendre osascript sous
    /// l'animation.
    static func read(_ done: @escaping (NowPlaying) -> Void) {
        let snapshot = {
            let feed = MusicFeed.last
            let estimate = MusicFeed.estimatedPosition()
            q.async {
                let n = readState(feed: feed, estimate: estimate)
                DispatchQueue.main.async { done(n) }
            }
        }
        if Thread.isMainThread { snapshot() }
        else { DispatchQueue.main.async(execute: snapshot) }
    }

    /// Exporte la pochette du morceau courant et la rend décodée, avec la
    /// clé du morceau qu'elle représente vraiment.
    ///
    /// Deux précautions. L'écriture du fichier se fait **hors** du bloc
    /// `tell application "Music"` : `open for access` appartient aux
    /// Standard Additions, et Music publie son propre verbe `open` — à
    /// l'intérieur du bloc, c'est le sien qui gagnerait.
    ///
    /// Et le script renvoie la piste qu'il a lue, pas celle qu'on croyait
    /// lire : si le morceau change pendant l'export, la pochette doit être
    /// rangée sous la bonne clé, sinon elle resterait collée au suivant.
    static func exportArtwork(_ done: @escaping ((key: String, image: NSImage?)?) -> Void) {
        guard running() else { done(nil); return }
        q.async {
            let r = artworkNow()
            DispatchQueue.main.async { done(r) }
        }
    }

    private static func artworkNow() -> (key: String, image: NSImage?)? {
        let path = budSupportDir.appendingPathComponent("cover.dat").path

        let r = osa("""
        set budKey to ""
        set budStatus to "none"
        set budData to missing value
        tell application "Music"
            try
                set budItem to current track
                try
                    set budKey to (persistent ID of budItem as text)
                end try
                if budKey is "" then
                    set budKey to ((name of budItem as text) & "|" & (artist of budItem as text) & "|" & (album of budItem as text))
                end if
                if (count of artworks of budItem) > 0 then
                    set budData to (raw data of artwork 1 of budItem)
                end if
            end try
        end tell
        if budData is not missing value then
            try
                set budFile to open for access (POSIX file "\(path)") with write permission
                set eof budFile to 0
                write budData to budFile
                close access budFile
                set budStatus to "ok"
            on error
                try
                    close access (POSIX file "\(path)")
                end try
                set budStatus to "err"
            end try
        end if
        return budKey & "|~|" & budStatus
        """)

        let p = r.out.components(separatedBy: sep)
        guard p.count >= 2 else { return nil }
        let key = clean(p[0])
        let status = clean(p[1])
        guard status == "ok" else { return (key, nil) }

        // On relit les octets plutôt que de passer le chemin à NSImage :
        // le fichier porte toujours le même nom, et une image construite
        // depuis un chemin peut rendre la précédente.
        guard let data = try? Data(contentsOf: URL(fileURLWithPath: path)),
              !data.isEmpty, let img = NSImage(data: data) else { return (key, nil) }
        return (key, img)
    }

    static func launch() {
        runShell("/usr/bin/open", ["-a", appName])
    }

    // ─────────────────────────────────────────────────────────
    //  Les commandes
    //
    //  Toutes rendent la main tout de suite. Le panneau n'attend
    //  donc plus la réponse de Musique pour bouger : il change
    //  son bouton au clic et la confirmation vient après. C'est
    //  ce qui fait la différence entre un bouton vif et un
    //  bouton qu'on reclique parce qu'on doute.
    // ─────────────────────────────────────────────────────────

    private static func tell(_ cmd: String) {
        guard running() else { launch(); return }
        q.async { _ = osa("tell application \"\(appName)\" to \(cmd)") }
    }

    static func playPause() { tell("playpause") }
    static func play()      { tell("play") }
    static func pause()     { tell("pause") }
    static func next()      { tell("next track") }
    static func previous()  { tell("previous track") }

    /// Arrêt, et non pause : Musique revient au début du morceau. Les deux
    /// ne font pas la même chose, et un lecteur qui n'offre que « pause »
    /// oblige à rouvrir Musique pour l'autre.
    static func stop() { tell("stop") }

    /// Recule ou avance dans le morceau. Music accepte l'écriture
    /// directe de la position, sans passer par les touches média.
    static func seek(by delta: Double) {
        guard running() else { return }
        q.async {
            _ = osa("""
            tell application "Music"
                try
                    set budPos to (player position)
                    set budDur to (duration of current track)
                    set budTarget to budPos + (\(delta))
                    if budTarget < 0 then set budTarget to 0
                    if budTarget > (budDur - 1) then set budTarget to (budDur - 1)
                    set player position to budTarget
                end try
            end tell
            """)
        }
    }

    // ─────────────────────────────────────────────────────────
    //  Volume du Mac
    //
    //  À ne pas confondre avec celui de Musique. `sound volume`
    //  règle le niveau de l'application dans le mélangeur ;
    //  `output volume` règle la sortie de la machine, celle des
    //  touches du clavier. Baisser l'un n'agit pas sur l'autre,
    //  et chercher pourquoi « le volume ne fait rien » quand
    //  c'est l'autre qui est à zéro peut durer longtemps. BUD
    //  montre donc les deux, nommés.
    // ─────────────────────────────────────────────────────────

    /// Volume de sortie du Mac, 0 à 100, et son état de coupure.
    ///
    /// CoreAudio seul : c'est un appel direct au pilote, qui revient en
    /// quelques microsecondes. Il n'y a donc rien à sortir du fil
    /// principal ici, et surtout plus d'osascript de secours — lancer un
    /// processus pour lire un volume était la latence que vous sentiez.
    static func systemVolume() -> (level: Int, muted: Bool, settable: Bool) {
        guard let v = SystemAudio.volume() else { return (50, false, false) }
        return (Int((v * 100).rounded()), SystemAudio.muted() ?? false, true)
    }

    /// CoreAudio d'abord. Le filet AppleScript ne sert plus qu'aux rares
    /// sorties dont CoreAudio n'expose pas le volume, et il part sur la
    /// file série : écrire un volume ne doit pas retenir le fil principal.
    static func setSystemVolume(_ v: Int) {
        let n = max(0, min(100, v))
        if SystemAudio.setVolume(Float(n) / 100) { return }
        q.async { _ = osa("set volume output volume \(n)") }
    }

    static func setSystemMuted(_ m: Bool) {
        if SystemAudio.setMuted(m) { return }
        q.async { _ = osa("set volume output muted \(m)") }
    }

    // ─────────────────────────────────────────────────────────
    //  Volume de Musique
    //
    //  Le curseur est continu : un glissement produit des
    //  dizaines de valeurs. Lancer un osascript par valeur
    //  saturait la file et le son suivait le doigt avec une
    //  seconde de retard. On n'en garde donc qu'une en attente,
    //  la dernière, et une seule écriture en vol.
    // ─────────────────────────────────────────────────────────

    private static var pendingVolume: Int?
    private static var volumeWriting = false

    static func setVolume(_ v: Int) {
        let n = max(0, min(100, v))
        if Thread.isMainThread { pendingVolume = n; pumpVolume() }
        else { DispatchQueue.main.async { pendingVolume = n; pumpVolume() } }
    }

    /// Sur le fil principal, qui sérialise l'accès aux deux variables.
    private static func pumpVolume() {
        guard !volumeWriting, let n = pendingVolume else { return }
        pendingVolume = nil
        volumeWriting = true
        q.async {
            _ = osa("tell application \"Music\" to set sound volume to \(n)")
            DispatchQueue.main.async {
                volumeWriting = false
                pumpVolume()
            }
        }
    }

    /// Monte ou baisse le volume de Musique d'un cran. La lecture et
    /// l'écriture restent sur la même file série : sans cela, deux « monte
    /// le son » rapprochés lisaient tous deux l'ancienne valeur et le
    /// second annulait le premier.
    static func changeVolume(by delta: Int) {
        guard running() else { return }
        q.async {
            let r = osa("tell application \"Music\" to get sound volume")
            guard r.ok else { return }
            let target = max(0, min(100, Int(num(r.out)) + delta))
            _ = osa("tell application \"Music\" to set sound volume to \(target)")
        }
    }

    static func toggleShuffle() {
        guard running() else { return }
        q.async {
            _ = osa("""
            tell application "Music"
                try
                    set shuffle enabled to not (shuffle enabled)
                end try
            end tell
            """)
        }
    }

    /// off → all → one → off
    static func cycleRepeat() {
        guard running() else { return }
        q.async {
            _ = osa("""
            tell application "Music"
                try
                    set budMode to (song repeat as text)
                    if budMode is "off" then
                        set song repeat to all
                    else if budMode is "all" then
                        set song repeat to one
                    else
                        set song repeat to off
                    end if
                end try
            end tell
            """)
        }
    }
}

// ═══════════════════════════════════════════════════════════
//  La pochette
//
//  Un export coûte un aller-retour AppleScript et quelques
//  centaines de kilo-octets : on ne la redemande donc qu'au
//  changement de morceau. Les deux endroits qui l'affichent —
//  le notch et le panneau — passent par ce cache commun, et
//  tous les appelants en attente sont servis par le même
//  export plutôt que d'en déclencher un chacun.
//
//  État mutable partagé, donc : tout s'y fait sur le fil
//  principal, l'export seul part en arrière-plan.
// ═══════════════════════════════════════════════════════════

enum ArtworkStore {
    private static var key = ""
    private static var image: NSImage?
    private static var loading = false
    private static var waiting: [(NSImage?) -> Void] = []

    static func clear() { key = ""; image = nil }

    /// Rend la pochette si elle est déjà là. Sinon lance l'export et
    /// appelle `onLoad` dès qu'elle arrive — y compris pour un morceau
    /// sans pochette, où elle vaut `nil` et où la clé est tout de même
    /// retenue, afin de ne pas réessayer à chaque sondage.
    @discardableResult
    static func request(_ k: String, onLoad: @escaping (NSImage?) -> Void) -> NSImage? {
        guard !k.isEmpty else { clear(); return nil }
        if k == key { return image }

        waiting.append(onLoad)
        guard !loading else { return nil }
        loading = true

        // L'export part sur la file série de la passerelle, celle qui porte
        // déjà la lecture d'état : deux osascript en vol se gênaient, et le
        // retour arrive sur le fil principal, où vit ce cache.
        MusicBridge.exportArtwork { r in
            loading = false
            // La clé rendue par le script prime : c'est le morceau
            // réellement exporté, qui n'est pas forcément celui demandé.
            if let got = r, !got.key.isEmpty { key = got.key } else { key = k }
            image = r?.image
            let served = waiting
            waiting = []
            served.forEach { $0(image) }
        }
        return nil
    }
}

/// La pochette, coins arrondis, recadrée sans déformation. Sans image,
/// une note de musique tient la place au lieu d'un carré vide.
final class CoverPlate: NSView {
    var image: NSImage? { didSet { needsDisplay = true } }
    var dim = false { didSet { needsDisplay = true } }
    var radius: CGFloat = 12

    override init(frame: NSRect) { super.init(frame: frame) }
    required init?(coder: NSCoder) { fatalError() }

    override func draw(_ dirty: NSRect) {
        let b = bounds
        let p = NSBezierPath(roundedRect: b, xRadius: radius, yRadius: radius)
        TH.fill(0.10).setFill()
        p.fill()

        if let img = image, img.size.width > 0, img.size.height > 0 {
            NSGraphicsContext.current?.saveGraphicsState()
            p.addClip()
            let s = img.size
            let k = max(b.width / s.width, b.height / s.height)
            let w = s.width * k, h = s.height * k
            img.draw(in: NSRect(x: b.midX - w / 2, y: b.midY - h / 2, width: w, height: h))
            NSGraphicsContext.current?.restoreGraphicsState()
            if dim {
                NSColor.black.withAlphaComponent(0.34).setFill()
                p.fill()
            }
        } else {
            drawSymbol("music.note", center: NSPoint(x: b.midX, y: b.midY),
                       size: max(10, b.width * 0.40), weight: .semibold,
                       color: TH.dim(dim ? 0.30 : 0.46))
        }

        TH.fill(0.08).setStroke()
        p.lineWidth = 1
        p.stroke()
    }
}

// ═══════════════════════════════════════════════════════════
//  Le panneau
// ═══════════════════════════════════════════════════════════

final class MusicPanelView: NSView {
    private let hero: HeroHeader
    private var titleLabel: NSTextField!
    private var artistLabel: NSTextField!
    private var albumLabel: NSTextField!
    private var timeLabel: NSTextField!
    private var bar: ProgressBar!
    private var playBtn: GlassButton!
    private var shuffleBtn: GlassButton!
    private var repeatBtn: GlassButton!
    private var volLabel: NSTextField!
    private var volSlider: NSSlider!
    private var sysLabel: NSTextField!
    private var sysSlider: NSSlider!
    private var muteBtn: GlassButton!
    private var authBtn: GlassButton!
    private var stopBtn: GlassButton!
    private var sysHeld = false
    private var sysMuted = false
    private var eq: EqualizerView!
    private var hint: NSTextField!
    private var cover: CoverPlate!
    private var last = NowPlaying()
    private var volumeHeld = false

    var onStatus: ((String) -> Void)?
    /// Prévient l'application que l'état de lecture a changé, pour que
    /// le notch et l'animation de BUD suivent sans attendre le sondage.
    var onNowPlaying: ((NowPlaying) -> Void)?

    // « override » : en retirant le paramètre source, cette signature est
    // devenue celle de NSView.init(frame:), qu'il faut donc redéclarer.
    override init(frame: NSRect) {
        hero = HeroHeader(frame: NSRect(x: 0, y: frame.height - 92, width: frame.width, height: 92),
                          title: "Musique", subtitle: "Apple Music, piloté sans quitter votre travail.")
        super.init(frame: frame)
        build()
    }
    required init?(coder: NSCoder) { fatalError() }

    private func build() {
        let W = bounds.width, H = bounds.height
        addSubview(hero)

        // ── Carte « en lecture » avec l'égaliseur ──
        let card = mkCard(self, NSRect(x: 0, y: H - 258, width: W, height: 152), radius: 18, alpha: 0.07)
        // La pochette prend la place de l'ancienne note : 68 pt, assez
        // grands pour reconnaître un album d'un coup d'œil.
        cover = CoverPlate(frame: NSRect(x: 24, y: 66, width: 68, height: 68))
        card.addSubview(cover)

        let tx: CGFloat = 108
        let tw2 = W - tx - 132          // 132 : la largeur réservée à l'égaliseur
        titleLabel = mkLabel("—", NSRect(x: tx, y: 110, width: tw2, height: 26), 17, .bold)
        artistLabel = mkLabel("", NSRect(x: tx, y: 88, width: tw2, height: 18), 12.5, .medium, alpha: 0.6)
        albumLabel = mkLabel("", NSRect(x: tx, y: 68, width: tw2, height: 16), 11, .regular, alpha: 0.4)
        [titleLabel, artistLabel, albumLabel].forEach { card.addSubview($0) }

        eq = EqualizerView(frame: NSRect(x: W - 118, y: 74, width: 94, height: 58))
        card.addSubview(eq)

        bar = ProgressBar(frame: NSRect(x: 24, y: 38, width: W - 48, height: 10))
        card.addSubview(bar)
        timeLabel = mkLabel("", NSRect(x: 24, y: 14, width: W - 48, height: 16),
                            11, .medium, alpha: 0.45, .center)
        timeLabel.font = NSFont.monospacedDigitSystemFont(ofSize: 11, weight: .medium)
        card.addSubview(timeLabel)

        // ── Transport : reculer · précédent · lecture · suivant · avancer ──
        let ty = H - 326
        let tw = (W - 60) / 6
        // Chaque bouton dit d'abord ce qu'il attend, puis le demande. Le
        // saut de quinze secondes bouge la barre tout de suite ; la lecture
        // retourne l'icône tout de suite ; l'arrêt éteint l'égaliseur tout
        // de suite. Musique confirme quatre dixièmes plus tard, et corrige
        // si elle a refusé.
        let specs: [(String, () -> Void)] = [
            ("gobackward.15", { [weak self] in
                self?.act({ $0.position = max(0, $0.position - 15) }) { MusicBridge.seek(by: -15) } }),
            ("backward.fill", { [weak self] in
                self?.act({ _ in }) { MusicBridge.previous() } }),
            ("play.fill", { [weak self] in
                self?.act({ $0.playing.toggle() }) { MusicBridge.playPause() } }),
            ("stop.fill", { [weak self] in
                self?.act({ $0.playing = false; $0.position = 0 }) { MusicBridge.stop() } }),
            ("forward.fill", { [weak self] in
                self?.act({ _ in }) { MusicBridge.next() } }),
            ("goforward.15", { [weak self] in
                self?.act({ $0.position = min($0.duration, $0.position + 15) }) { MusicBridge.seek(by: 15) } })
        ]
        var made: [GlassButton] = []
        for (i, sp) in specs.enumerated() {
            let b = GlassButton(frame: NSRect(x: CGFloat(i) * (tw + 12), y: ty, width: tw, height: 56),
                                title: "", icon: sp.0, prominent: i == 2)
            b.onClick = { _ in sp.1() }
            addSubview(b)
            made.append(b)
        }
        playBtn = made[2]
        stopBtn = made[3]

        // ── Aléatoire et répétition ──
        let my = ty - 60
        let mw = (W - 12) / 2
        shuffleBtn = GlassButton(frame: NSRect(x: 0, y: my, width: mw, height: 46),
                                 title: "Aléatoire", icon: "shuffle")
        shuffleBtn.onClick = { [weak self] _ in
            self?.act({ $0.shuffle.toggle() }) { MusicBridge.toggleShuffle() }
        }
        repeatBtn = GlassButton(frame: NSRect(x: mw + 12, y: my, width: mw, height: 46),
                                title: "Répétition", icon: "repeat")
        repeatBtn.onClick = { [weak self] _ in
            self?.act({ n in
                n.repeatMode = n.repeatMode == "off" ? "all"
                             : (n.repeatMode == "all" ? "one" : "off")
            }) { MusicBridge.cycleRepeat() }
        }
        [shuffleBtn, repeatBtn].forEach { addSubview($0) }

        // ── Les deux volumes ──
        //
        //  Celui du Mac d'abord : c'est celui des touches du clavier, et
        //  celui qu'on cherche neuf fois sur dix. Celui de Musique ensuite,
        //  qui n'est que le niveau de l'application dans le mélangeur.
        //  Les confondre, c'est passer un quart d'heure à monter l'un
        //  pendant que l'autre est à zéro.
        mkSection(self, my - 26, W, "Volume du Mac")
        muteBtn = GlassButton(frame: NSRect(x: 0, y: my - 58, width: 44, height: 28),
                              title: "", icon: "speaker.slash.fill")
        muteBtn.onClick = { [weak self] _ in self?.toggleMute() }
        addSubview(muteBtn)
        sysSlider = NSSlider(frame: NSRect(x: 54, y: my - 56, width: W - 118, height: 24))
        sysSlider.minValue = 0
        sysSlider.maxValue = 100
        sysSlider.doubleValue = 50
        sysSlider.isContinuous = true
        sysSlider.target = self
        sysSlider.action = #selector(systemVolumeChanged(_:))
        addSubview(sysSlider)
        sysLabel = mkLabel("50", NSRect(x: W - 58, y: my - 56, width: 58, height: 20),
                           13, .semibold, alpha: 0.7, .right)
        sysLabel.font = NSFont.monospacedDigitSystemFont(ofSize: 13, weight: .semibold)
        addSubview(sysLabel)

        mkSection(self, my - 84, W, "Volume de Musique")
        volSlider = NSSlider(frame: NSRect(x: 0, y: my - 116, width: W - 64, height: 24))
        volSlider.minValue = 0
        volSlider.maxValue = 100
        volSlider.doubleValue = 50
        volSlider.isContinuous = true
        volSlider.target = self
        volSlider.action = #selector(volumeChanged(_:))
        addSubview(volSlider)
        volLabel = mkLabel("50", NSRect(x: W - 58, y: my - 116, width: 58, height: 20),
                           13, .semibold, alpha: 0.7, .right)
        volLabel.font = NSFont.monospacedDigitSystemFont(ofSize: 13, weight: .semibold)
        addSubview(volLabel)

        hint = NSTextField(frame: NSRect(x: 0, y: 8, width: W, height: 40))
        hint.isBezeled = false
        hint.drawsBackground = false
        hint.isEditable = false
        hint.isSelectable = false
        hint.font = NSFont.systemFont(ofSize: 11)
        hint.textColor = TH.dim(0.42)
        hint.alignment = .center
        hint.lineBreakMode = .byWordWrapping
        hint.cell?.usesSingleLineMode = false
        hint.cell?.wraps = true
        hint.maximumNumberOfLines = 2
        ThemeRegistry.shared.register(hint, alpha: 0.42)
        addSubview(hint)

        authBtn = GlassButton(frame: NSRect(x: (W - 230) / 2, y: 54, width: 230, height: 30),
                              title: "Ouvrir les réglages d'automatisation",
                              icon: "lock.open", compact: true)
        authBtn.onClick = { [weak self] _ in self?.openAutomationSettings() }
        authBtn.isHidden = true
        addSubview(authBtn)

        followSystemVolume()

        let bw = (W - 12) / 2
        let openBtn = GlassButton(frame: NSRect(x: 0, y: 0, width: bw, height: 44),
                                  title: "Ouvrir Musique", icon: "arrow.up.forward.app.fill")
        openBtn.onClick = { [weak self] _ in
            MusicBridge.launch()
            self?.onStatus?("Ouverture de Musique")
        }
        let refreshBtn = GlassButton(frame: NSRect(x: bw + 12, y: 0, width: bw, height: 44),
                                     title: "Actualiser", icon: "arrow.clockwise")
        refreshBtn.onClick = { [weak self] _ in self?.refresh() }
        [openBtn, refreshBtn].forEach { addSubview($0) }
    }

    /// Le volume du Mac, écrit pendant le glissement et relu seulement
    /// après : relire en même temps ferait sauter le curseur sous le doigt.
    @objc private func systemVolumeChanged(_ s: NSSlider) {
        let v = Int(s.doubleValue.rounded())
        sysLabel.stringValue = "\(v)"
        sysHeld = true
        MusicBridge.setSystemVolume(v)   // appel direct : aucune attente
        // Monter le son d'un Mac coupé doit le rallumer : autrement le
        // curseur bouge et rien ne sort.
        if sysMuted && v > 0 {
            MusicBridge.setSystemMuted(false)
            sysMuted = false
            muteBtn.selected = false
        }
        NSObject.cancelPreviousPerformRequests(withTarget: self,
                                               selector: #selector(releaseSystemVolume), object: nil)
        // Court délai : il ne sert plus qu'à ignorer l'écho de notre propre
        // écriture, pas à attendre une relecture. Huit dixièmes étaient
        // calés sur AppleScript ; un cinquième suffit à CoreAudio.
        perform(#selector(releaseSystemVolume), with: nil, afterDelay: 0.2)
    }

    @objc private func releaseSystemVolume() { sysHeld = false }

    private func toggleMute() {
        sysMuted.toggle()
        MusicBridge.setSystemMuted(sysMuted)
        muteBtn.selected = sysMuted
        hint.stringValue = sysMuted ? "Son du Mac coupé." : "Son du Mac rétabli."
    }

    /// Relit le volume du Mac.
    ///
    /// Appelé par l'écouteur CoreAudio, qui prévient dès que le volume
    /// change — touches du clavier, centre de contrôle, autre application.
    /// Plus de sondage : il n'y a rien à interroger, le système parle.
    private func refreshSystemVolume() {
        guard !sysHeld else { return }
        let v = MusicBridge.systemVolume()
        sysSlider.doubleValue = Double(v.level)
        sysSlider.isEnabled = v.settable
        muteBtn.enabledFlag = v.settable
        sysLabel.stringValue = !v.settable ? "n/d" : (v.muted ? "coupé" : "\(v.level)")
        sysMuted = v.muted
        muteBtn.selected = v.muted
    }

    /// Branche le panneau sur les changements de volume du système.
    private func followSystemVolume() {
        SystemAudio.onChange = { [weak self] in
            guard let s = self else { return }
            // Pendant un glissement, c'est le doigt qui commande : on
            // ignore l'écho du système, sans quoi le curseur sauterait
            // entre la valeur tenue et celle qui revient.
            guard !s.sysHeld else { return }
            s.refreshSystemVolume()
        }
        SystemAudio.startObserving()
        refreshSystemVolume()
    }

    @objc private func volumeChanged(_ s: NSSlider) {
        let v = Int(s.doubleValue.rounded())
        volLabel.stringValue = "\(v)"
        // On écrit tout de suite, mais sans relire : un sondage pendant
        // le glissement ferait sauter le curseur sous le doigt.
        volumeHeld = true
        MusicBridge.setVolume(v)
        NSObject.cancelPreviousPerformRequests(withTarget: self, selector: #selector(releaseVolume), object: nil)
        perform(#selector(releaseVolume), with: nil, afterDelay: 0.8)
    }

    @objc private func releaseVolume() { volumeHeld = false }

    /// Exécute une commande, et montre tout de suite ce qu'elle va faire.
    ///
    /// L'ordre compte. Avant, le bouton attendait la réponse de Musique
    /// pour changer d'aspect : trois dixièmes de seconde pendant lesquels
    /// rien ne bougeait, assez pour qu'on reclique. Maintenant l'affichage
    /// part devant — `expect` applique l'effet attendu localement — et la
    /// relecture ne sert plus qu'à corriger si Musique a refusé.
    private func act(_ expect: (inout NowPlaying) -> Void, _ body: @escaping () -> Void) {
        var guess = last
        expect(&guess)
        apply(guess, confirmed: false)
        body()
        DispatchQueue.main.asyncAfter(deadline: .now() + 0.4) { [weak self] in
            self?.refresh()
        }
    }

    func refresh() {
        MusicBridge.read { [weak self] n in self?.apply(n) }
    }

    // ─────────────────────────────────────────────────────────
    //  L'horloge de lecture
    //
    //  L'état est relu toutes les quatre secondes. Avec ça
    //  seul, le compteur avançait par bonds de quatre et la
    //  barre sautait. Le temps, lui, passe tout seul : il
    //  suffit de l'ajouter entre deux relectures, et de se
    //  recaler sur la vérité quand elle arrive.
    // ─────────────────────────────────────────────────────────

    private var clockTimer: Timer?
    private var clockBase: Double = 0
    private var clockAt = Date()

    private func startClock() {
        guard clockTimer == nil else { return }
        let t = Timer(timeInterval: 0.5, repeats: true) { [weak self] _ in self?.tickClock() }
        RunLoop.main.add(t, forMode: .common)
        clockTimer = t
    }

    private func stopClock() {
        clockTimer?.invalidate()
        clockTimer = nil
    }

    private func tickClock() {
        guard last.playing, last.positionKnown, last.duration > 0 else { return }
        guard window != nil, !isHiddenOrHasHiddenAncestor else { return }
        let p = min(last.duration, clockBase + Date().timeIntervalSince(clockAt))
        last.position = p
        timeLabel.stringValue = last.timeText
        bar.value = CGFloat(last.progress)
    }

    func apply(_ n: NowPlaying) { apply(n, confirmed: true) }

    /// `confirmed` distingue l'état relu de l'état supposé. Un état supposé
    /// bouge les boutons mais ne touche ni la pochette ni l'horloge : on
    /// n'a pas de raison de croire que le morceau a changé parce qu'on
    /// vient d'appuyer sur « aléatoire ».
    func apply(_ n: NowPlaying, confirmed: Bool) {
        let trackChanged = n.trackKey != last.trackKey
        let positionMoved = abs(n.position - last.position) > 1.5
        last = n
        onNowPlaying?(n)

        if confirmed && (trackChanged || positionMoved || !n.playing) {
            clockBase = n.position
            clockAt = Date()
        }
        if n.playing && n.positionKnown { startClock() } else { stopClock() }

        if !n.available {
            titleLabel.stringValue = "Musique est fermée"
            artistLabel.stringValue = ""
            albumLabel.stringValue = ""
            timeLabel.stringValue = ""
            bar.value = 0
            eq.playing = false
            hint.stringValue = "Ouvrez Musique pour que BUD prenne la main. "
                + "Le pilotage demande l'autorisation Automatisation au premier usage."
            cover.image = nil
            cover.dim = true
            ArtworkStore.clear()
            // Le volume du Mac ne dépend pas de Musique : il reste réglable
            // même l'application fermée, et c'est souvent là qu'on le cherche.
            return
        }

        // En pause, la pochette reste affichée mais s'assombrit : l'album
        // ne change pas parce que la lecture s'arrête.
        cover.dim = !n.playing
        cover.image = ArtworkStore.request(n.trackKey) { [weak self] img in
            self?.cover.image = img
        }
        titleLabel.stringValue = n.hasTrack ? n.title : "Rien en lecture"
        artistLabel.stringValue = n.artist
        albumLabel.stringValue = n.album
        timeLabel.stringValue = n.timeText
        bar.value = CGFloat(n.progress)
        eq.playing = n.playing

        // Un volume inconnu n'est pas un volume à 50 : le curseur se
        // désactive au lieu de montrer un chiffre inventé, et c'est le
        // volume du Mac juste au-dessus qui reste la vraie poignée.
        if !volumeHeld {
            volSlider.isEnabled = n.volumeKnown
            volSlider.doubleValue = Double(n.volume)
            volLabel.stringValue = n.volumeKnown ? "\(n.volume)" : "n/d"
        }
        // L'icône dit l'action à venir, pas l'état présent : pendant la
        // lecture on offre la pause, à l'arrêt on offre la lecture.
        playBtn.iconName = n.playing ? "pause.fill" : "play.fill"
        stopBtn.enabledFlag = n.playing || n.hasTrack

        shuffleBtn.enabledFlag = n.modesKnown
        repeatBtn.enabledFlag = n.modesKnown
        shuffleBtn.prominent = n.shuffle
        repeatBtn.prominent = n.repeatMode != "off"
        repeatBtn.title = n.repeatMode == "one" ? "Répéter ce titre"
                        : (n.repeatMode == "all" ? "Répéter tout" : "Répétition")
        repeatBtn.iconName = n.repeatMode == "one" ? "repeat.1" : "repeat"

        // Un obstacle l'emporte sur tout le reste : tant qu'on ne dit pas
        // pourquoi rien ne s'affiche, l'utilisateur croit à une panne.
        // Mais la phrase est toujours en clair, et le bouton d'autorisation
        // n'apparaît que si c'est bien l'autorisation qui manque — le
        // proposer pour n'importe quel ennui envoyait cocher une case déjà
        // cochée.
        if !n.trouble.isEmpty {
            hint.stringValue = n.trouble
            hint.textColor = warnColor
            authBtn.isHidden = !n.needsAuth
        } else {
            hint.textColor = TH.dim(0.42)
            authBtn.isHidden = true
            hint.stringValue = n.playing
                ? "BUD s'animera dans le notch pendant la lecture."
                : (n.hasTrack ? "En pause." : "Lancez un morceau dans Musique.")
        }
    }

    /// Ouvre directement le volet d'automatisation des réglages système.
    /// Quand l'autorisation a été retirée, la redemander par un événement
    /// Apple ne provoque plus de dialogue : macOS refuse en silence. Il
    /// faut y retourner à la main, et autant y conduire.
    @objc private func openAutomationSettings() {
        let u = "x-apple.systempreferences:com.apple.preference.security?Privacy_Automation"
        if let url = URL(string: u) { NSWorkspace.shared.open(url) }
    }

    /// Intentions du chat. Renvoie la phrase que BUD répondra.
    ///
    /// Le chat répond depuis le dernier état connu, jamais en interrogeant
    /// Musique sur-le-champ : cette fonction est appelée sur le fil
    /// principal, et un osascript synchrone y gelait la frappe le temps
    /// d'un aller-retour. L'état a au plus quatre secondes, et l'annonce de
    /// Musique le corrige dès qu'un morceau change.
    func command(_ what: String) -> String {
        switch what {
        case "play", "pause", "playpause", "toggle":
            act({ $0.playing.toggle() }) { MusicBridge.playPause() }
            return "C'est fait."
        case "next":
            act({ _ in }) { MusicBridge.next() }
            return "Morceau suivant."
        case "previous", "prev":
            act({ _ in }) { MusicBridge.previous() }
            return "Morceau précédent."
        case "volup", "up":
            MusicBridge.changeVolume(by: 10); refresh()
            return "Volume monté."
        case "voldown", "down":
            MusicBridge.changeVolume(by: -10); refresh()
            return "Volume baissé."
        case "shuffle", "aleatoire":
            act({ $0.shuffle.toggle() }) { MusicBridge.toggleShuffle() }
            return "Lecture aléatoire basculée."
        case "open":
            MusicBridge.launch()
            return "J'ouvre Musique."
        default:
            refresh()
            if !MusicBridge.running() { return "Musique est fermée." }
            var n = last
            n.fill(from: MusicFeed.last, scriptSpoke: n.hasTrack,
                   estimate: MusicFeed.estimatedPosition())
            return n.hasTrack
                ? (n.playing ? "En lecture : \(n.oneLine)." : "En pause sur \(n.oneLine).")
                : "Rien en lecture."
        }
    }
}

// ═══════════════════════════════════════════════════════════
//  L'égaliseur
//
//  Honnêteté : macOS n'expose aucun niveau audio en sortie sans
//  capturer le flux, ce que BUD ne fait pas. Ces barres ne
//  mesurent donc rien — elles sont synthétiques, pilotées par
//  plusieurs sinusoïdes de fréquences premières entre elles pour
//  éviter tout motif qui se répète visiblement. C'est un signe
//  de vie, pas un instrument de mesure.
// ═══════════════════════════════════════════════════════════

final class EqualizerView: NSView {
    var playing = false {
        didSet {
            guard playing != oldValue else { return }
            if playing { start() } else { stop() }
            needsDisplay = true
        }
    }
    var bars = 5
    var tint: NSColor? = nil

    private var levels: [CGFloat] = []
    private var clock: CGFloat = 0
    private var timer: Timer?
    // Fréquences volontairement non harmoniques.
    private let freq: [CGFloat] = [5.3, 7.1, 4.3, 8.7, 6.1, 9.3, 3.7]
    private let phase: [CGFloat] = [0, 1.7, 0.9, 2.4, 3.1, 1.2, 0.4]

    override init(frame: NSRect) {
        super.init(frame: frame)
        wantsLayer = true
        levels = Array(repeating: 0.15, count: 7)
    }
    required init?(coder: NSCoder) { fatalError() }
    deinit { timer?.invalidate() }

    private func start() {
        guard timer == nil else { return }
        let t = Timer(timeInterval: 1.0 / 24.0, repeats: true) { [weak self] _ in
            guard let s = self else { return }
            guard s.window != nil, !s.isHiddenOrHasHiddenAncestor else { return }
            s.step()
        }
        RunLoop.main.add(t, forMode: .common)
        timer = t
    }

    private func stop() {
        timer?.invalidate()
        timer = nil
        for i in levels.indices { levels[i] = 0.12 }
    }

    func step() {
        clock += 1.0 / 24.0
        for i in 0..<min(bars, levels.count) {
            let a = sin(clock * freq[i] + phase[i])
            let b = sin(clock * freq[(i + 3) % freq.count] * 0.37 + phase[i])
            // Deux sinusoïdes et un grain aléatoire : jamais de motif net.
            var v = 0.5 + 0.34 * a + 0.16 * b
            v += CGFloat.random(in: -0.07...0.07)
            levels[i] = max(0.08, min(1, levels[i] * 0.45 + v * 0.55))
        }
        needsDisplay = true
    }

    override func draw(_ dirty: NSRect) {
        let n = max(1, min(bars, levels.count))
        let gap: CGFloat = 4
        let w = (bounds.width - gap * CGFloat(n - 1)) / CGFloat(n)
        guard w > 0 else { return }
        let c = tint ?? TH.accent

        for i in 0..<n {
            let lvl = playing ? levels[i] : 0.12
            let h = max(3, bounds.height * lvl)
            let r = NSRect(x: CGFloat(i) * (w + gap), y: 0, width: w, height: h)
            let p = NSBezierPath(roundedRect: r, xRadius: w / 2, yRadius: w / 2)
            c.withAlphaComponent(playing ? 0.55 + 0.4 * lvl : 0.22).setFill()
            p.fill()
        }
    }
}
EOF_BUDMUSIC_SWIFT

cat << 'EOF_BUDMUSICFEED_SWIFT' > "$SRC_DIR/BudMusicFeed.swift"
import Cocoa
import Foundation

// ═══════════════════════════════════════════════════════════
//  Ce que Musique annonce d'elle-même
//
//  Music.app publie une notification distribuée à chaque
//  changement : « com.apple.Music.playerInfo ». Elle porte le
//  titre, l'artiste, l'album, l'état et la durée.
//
//  Trois propriétés en font la source primaire, devant
//  AppleScript :
//
//  — elle ne demande aucune autorisation. Pas d'événement
//    Apple, donc rien à cocher dans Automatisation, et rien
//    qu'une nouvelle signature de BUD puisse invalider.
//  — elle ne coûte aucun processus. Pas d'osascript à lancer
//    toutes les quatre secondes.
//  — elle arrive quand ça change, pas quand on demande. Le
//    titre apparaît dans le notch au moment où le morceau
//    démarre, pas au sondage suivant.
//
//  Elle a une limite, honnêtement : elle ne dit rien tant que
//  rien ne change. BUD lancé pendant un morceau déjà en cours
//  ne la reçoit pas. C'est pourquoi AppleScript reste là, non
//  plus comme source unique mais comme second témoin.
//
//  Et elle ne donne pas la position de lecture. On ne
//  l'invente donc pas : elle n'est estimée que depuis un début
//  de morceau, où elle vaut zéro et où le temps écoulé suffit.
// ═══════════════════════════════════════════════════════════

struct MusicAnnounce {
    var title = ""
    var artist = ""
    var album = ""
    var playing = false
    /// Musique a dit « arrêté » : différent de « on ne sait pas ».
    var stopped = false
    var duration: Double = 0
    var trackKey = ""
    /// Quand l'annonce est arrivée, pour estimer la position.
    var at = Date()
    /// Vrai seulement si l'annonce marque un **début** de morceau. Reprendre
    /// après une pause produit la même notification sans position, et
    /// compter depuis cet instant placerait le curseur au début d'un
    /// morceau entamé. Mieux vaut ne rien afficher que se tromper.
    var fromStart = false

    var hasTrack: Bool { !title.isEmpty }
}

/// L'objet qui reçoit la notification. Le centre distribué veut une cible
/// et un sélecteur : c'est la seule forme qui accepte
/// `deliverImmediately`, et sans ce réglage le système peut retenir les
/// notifications quand l'application est occupée — ce qui est précisément
/// le moment où l'on veut la nouvelle.
final class MusicFeedListener: NSObject {
    @objc func playerInfo(_ note: Notification) {
        MusicFeed.absorb(note.userInfo)
    }
}

enum MusicFeed {
    private(set) static var last: MusicAnnounce?
    /// Prévenu sur le fil principal, à chaque annonce.
    static var onChange: (() -> Void)?

    private static var listener: MusicFeedListener?

    static func start() {
        guard listener == nil else { return }
        let l = MusicFeedListener()
        listener = l
        let c = DistributedNotificationCenter.default()
        // Les deux noms : Music sur Catalina et au-delà, iTunes avant.
        // Un système ne poste que le sien, l'autre observateur dort.
        for name in ["com.apple.Music.playerInfo", "com.apple.iTunes.playerInfo"] {
            c.addObserver(l, selector: #selector(MusicFeedListener.playerInfo(_:)),
                          name: Notification.Name(name), object: nil,
                          suspensionBehavior: .deliverImmediately)
        }
    }

    /// Oublie ce qu'on sait, quand Musique se ferme.
    static func forget() { last = nil }

    static func absorb(_ info: [AnyHashable: Any]?) {
        guard let info = info else { return }
        var a = MusicAnnounce()

        a.title = text(info["Name"])
        a.artist = text(info["Artist"])
        a.album = text(info["Album"])

        let state = text(info["Player State"]).lowercased()
        a.playing = state == "playing"
        a.stopped = state == "stopped"

        // « Total Time » est en millisecondes, et peut arriver en nombre
        // comme en chaîne selon la version.
        if let ms = number(info["Total Time"]), ms > 0 { a.duration = ms / 1000 }

        // L'identifiant persistant, quand il est là, distingue deux morceaux
        // de même titre. Sinon le triplet suffit — une radio n'en a pas.
        let pid = text(info["PersistentID"])
        a.trackKey = pid.isEmpty
            ? (a.title.isEmpty ? "" : "\(a.title)|\(a.artist)|\(a.album)")
            : pid

        // Un morceau arrêté n'efface pas le précédent titre : il le met en
        // pause. Mais un état « arrêté » sans titre, c'est Musique qui
        // s'en va, et là il faut vraiment oublier.
        if a.stopped && !a.hasTrack { last = nil; notify(); return }

        a.fromStart = a.playing && a.trackKey != (last?.trackKey ?? "")
        last = a
        notify()
    }

    private static func notify() {
        if Thread.isMainThread { onChange?() }
        else { DispatchQueue.main.async { onChange?() } }
    }

    /// La position estimée, et seulement quand elle est défendable.
    /// Rien d'autre que le temps écoulé depuis un début de morceau.
    static func estimatedPosition() -> Double? {
        guard let a = last, a.playing, a.fromStart, a.duration > 0 else { return nil }
        let t = Date().timeIntervalSince(a.at)
        guard t >= 0 else { return nil }
        return min(t, a.duration)
    }

    private static func text(_ v: Any?) -> String {
        guard let v = v else { return "" }
        if let s = v as? String { return s.trimmingCharacters(in: .whitespacesAndNewlines) }
        if let n = v as? NSNumber { return n.stringValue }
        return ""
    }

    private static func number(_ v: Any?) -> Double? {
        if let n = v as? NSNumber { return n.doubleValue }
        if let s = v as? String { return Double(s.replacingOccurrences(of: ",", with: ".")) }
        return nil
    }
}
EOF_BUDMUSICFEED_SWIFT

cat << 'EOF_BUDOAUTH_SWIFT' > "$SRC_DIR/BudOAuth.swift"
import Foundation
import Network
import CryptoKit
import AppKit

// ═══════════════════════════════════════════════════════════
//  OAuth 2.0 Google avec PKCE
//
//  Flux « application de bureau » : BUD ouvre le consentement dans
//  votre navigateur, écoute sur 127.0.0.1 le retour de Google, puis
//  échange le code contre des jetons. Le jeton de rafraîchissement
//  va dans le trousseau ; le jeton d'accès reste en mémoire.
//  Aucun identifiant ne transite par un serveur tiers.
// ═══════════════════════════════════════════════════════════

struct GoogleTokens {
    var access: String
    var refresh: String
    var expiry: Date
    var email: String
}

/// Petit serveur local qui attend la redirection de Google.
final class LoopbackCatcher {
    private var listener: NWListener?
    private let queue = DispatchQueue(label: "fr.lahbib.bud.oauth")
    private var finished = false

    /// Démarre l'écoute et renvoie le port retenu.
    ///
    /// Deux tentatives : d'abord restreint à la boucle locale, sinon sans
    /// restriction. Sans point d'ancrage, NWListener écoute sur toutes les
    /// interfaces — n'importe qui sur le même Wi-Fi pourrait frapper à ce
    /// port, alors que Google ne redirige que vers 127.0.0.1. Mais avec
    /// « port: .any », certaines versions renvoient 0 au lieu du port réel ;
    /// on vérifie donc, et on retombe sur l'écoute large plutôt que d'échouer.
    /// (Rien à voir avec macOS 15 : accepter une connexion TCP entrante ne
    ///  demande aucune autorisation « Réseau local ».)
    func start(timeout: TimeInterval = 180,
               onResult: @escaping (String?, String?) -> Void) -> UInt16? {
        if let port = attempt(loopbackOnly: true, timeout: timeout, onResult: onResult) {
            return port
        }
        stop()
        return attempt(loopbackOnly: false, timeout: timeout, onResult: onResult)
    }

    private func attempt(loopbackOnly: Bool, timeout: TimeInterval,
                         onResult: @escaping (String?, String?) -> Void) -> UInt16? {
        let params = NWParameters.tcp
        params.allowLocalEndpointReuse = true
        if loopbackOnly {
            params.requiredLocalEndpoint = .hostPort(host: "127.0.0.1", port: .any)
        }
        guard let l = try? NWListener(using: params) else { return nil }
        listener = l

        let ready = DispatchSemaphore(value: 0)
        l.stateUpdateHandler = { st in
            if case .ready = st { ready.signal() }
            if case .failed = st { ready.signal() }
        }

        l.newConnectionHandler = { [weak self] conn in
            conn.start(queue: self?.queue ?? .main)
            conn.receive(minimumIncompleteLength: 1, maximumLength: 8192) { data, _, _, _ in
                var code: String?
                var err: String?
                if let d = data, let req = String(data: d, encoding: .utf8),
                   let line = req.split(separator: "\r\n").first {
                    // GET /?code=...&scope=... HTTP/1.1
                    let parts = line.split(separator: " ")
                    if parts.count > 1 {
                        let path = String(parts[1])
                        if let q = path.split(separator: "?").dropFirst().first {
                            for pair in q.split(separator: "&") {
                                let kv = pair.split(separator: "=", maxSplits: 1).map(String.init)
                                guard kv.count == 2 else { continue }
                                let value = kv[1].removingPercentEncoding ?? kv[1]
                                if kv[0] == "code" { code = value }
                                if kv[0] == "error" { err = value }
                            }
                        }
                    }
                }
                let page = """
                <!doctype html><html lang="fr"><head><meta charset="utf-8">
                <title>BUD</title></head>
                <body style="font-family:-apple-system,system-ui;background:#0b0b0c;color:#f4f4f5;
                display:flex;align-items:center;justify-content:center;height:100vh;margin:0">
                <div style="text-align:center">
                <div style="font-size:48px">\(code != nil ? "✅" : "⚠️")</div>
                <h2 style="font-weight:600">\(code != nil ? "Compte relié à BUD" : "Connexion interrompue")</h2>
                <p style="opacity:.6">Vous pouvez fermer cet onglet et revenir à BUD.</p>
                </div></body></html>
                """
                let body = Data(page.utf8)
                let head = "HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\n"
                    + "Content-Length: \(body.count)\r\nConnection: close\r\n\r\n"
                conn.send(content: Data(head.utf8) + body, completion: .contentProcessed { _ in
                    conn.cancel()
                })
                guard let s = self, !s.finished else { return }
                s.finished = true
                DispatchQueue.main.async { onResult(code, err) }
                s.stop()
            }
        }

        l.start(queue: queue)
        _ = ready.wait(timeout: .now() + 5)
        guard let port = l.port?.rawValue, port != 0 else {
            l.cancel()
            listener = nil
            return nil
        }

        DispatchQueue.main.asyncAfter(deadline: .now() + timeout) { [weak self] in
            guard let s = self, !s.finished else { return }
            s.finished = true
            s.stop()
            onResult(nil, "délai dépassé")
        }
        return port
    }

    func stop() {
        listener?.cancel()
        listener = nil
    }
}

enum GoogleOAuth {

    static let scope = "https://mail.google.com/ openid email"

    // Non privés : l'appairage par téléphone (BudPhone) construit sa
    // propre URL de consentement avec le même PKCE.
    static func randomVerifier() -> String {
        var bytes = [UInt8](repeating: 0, count: 64)
        _ = SecRandomCopyBytes(kSecRandomDefault, bytes.count, &bytes)
        return Data(bytes).base64URL()
    }

    static func challenge(_ verifier: String) -> String {
        Data(SHA256.hash(data: Data(verifier.utf8))).base64URL()
    }

    /// Ouvre le consentement Google et renvoie les jetons.
    static func authorize(clientID: String, clientSecret: String,
                          completion: @escaping (GoogleTokens?, String?) -> Void) {
        let verifier = randomVerifier()
        let catcher = LoopbackCatcher()

        guard let port = catcher.start(onResult: { code, err in
            guard let code = code else {
                completion(nil, err ?? "aucun code reçu")
                return
            }
            exchange(clientID: clientID, clientSecret: clientSecret,
                     code: code, verifier: verifier, port: 0, completion: completion)
        }) else {
            completion(nil, "impossible d'ouvrir le port local d'écoute")
            return
        }
        lastPort = port

        var c = URLComponents(string: "https://accounts.google.com/o/oauth2/v2/auth")!
        c.queryItems = [
            URLQueryItem(name: "client_id", value: clientID),
            URLQueryItem(name: "redirect_uri", value: "http://127.0.0.1:\(port)"),
            URLQueryItem(name: "response_type", value: "code"),
            URLQueryItem(name: "scope", value: scope),
            URLQueryItem(name: "code_challenge", value: challenge(verifier)),
            URLQueryItem(name: "code_challenge_method", value: "S256"),
            URLQueryItem(name: "access_type", value: "offline"),
            URLQueryItem(name: "prompt", value: "consent")
        ]
        guard let url = c.url else {
            completion(nil, "URL d'autorisation invalide")
            return
        }
        NSWorkspace.shared.open(url)
    }

    private static var lastPort: UInt16 = 0

    private static func post(_ url: String, _ fields: [String: String],
                             _ done: @escaping ([String: Any]?, String?) -> Void) {
        var req = URLRequest(url: URL(string: url)!)
        req.httpMethod = "POST"
        req.setValue("application/x-www-form-urlencoded", forHTTPHeaderField: "Content-Type")
        req.httpBody = fields.map { k, v in
            let ev = v.addingPercentEncoding(withAllowedCharacters: .alphanumerics) ?? v
            return "\(k)=\(ev)"
        }.joined(separator: "&").data(using: .utf8)
        req.timeoutInterval = 25

        URLSession.shared.dataTask(with: req) { data, _, error in
            if let e = error { done(nil, e.localizedDescription); return }
            guard let d = data,
                  let j = try? JSONSerialization.jsonObject(with: d) as? [String: Any] else {
                done(nil, "réponse illisible de Google")
                return
            }
            if let err = j["error"] as? String {
                let desc = j["error_description"] as? String ?? ""
                done(nil, "\(err) \(desc)".trimmingCharacters(in: .whitespaces))
                return
            }
            done(j, nil)
        }.resume()
    }

    private static func exchange(clientID: String, clientSecret: String, code: String,
                                 verifier: String, port: UInt16,
                                 completion: @escaping (GoogleTokens?, String?) -> Void) {
        exchangeCode(clientID: clientID, clientSecret: clientSecret, code: code,
                     verifier: verifier, redirect: "http://127.0.0.1:\(lastPort)",
                     completion: completion)
    }

    /// Échange un code d'autorisation contre des jetons. L'URI de
    /// redirection est passée telle qu'elle a servi à la demande : le
    /// flux téléphone a la sienne.
    static func exchangeCode(clientID: String, clientSecret: String, code: String,
                             verifier: String, redirect: String,
                             completion: @escaping (GoogleTokens?, String?) -> Void) {
        var fields = [
            "client_id": clientID,
            "code": code,
            "code_verifier": verifier,
            "grant_type": "authorization_code",
            "redirect_uri": redirect
        ]
        if !clientSecret.isEmpty { fields["client_secret"] = clientSecret }

        post("https://oauth2.googleapis.com/token", fields) { j, err in
            guard let j = j,
                  let access = j["access_token"] as? String else {
                DispatchQueue.main.async { completion(nil, err ?? "jeton absent") }
                return
            }
            let refresh = j["refresh_token"] as? String ?? ""
            let ttl = (j["expires_in"] as? Double) ?? 3500
            userEmail(access) { mail in
                let t = GoogleTokens(access: access, refresh: refresh,
                                     expiry: Date().addingTimeInterval(ttl - 60),
                                     email: mail ?? "")
                DispatchQueue.main.async { completion(t, mail == nil ? "adresse introuvable" : nil) }
            }
        }
    }

    static func refresh(clientID: String, clientSecret: String, refreshToken: String,
                        done: @escaping (String?, Date?, String?) -> Void) {
        var fields = [
            "client_id": clientID,
            "refresh_token": refreshToken,
            "grant_type": "refresh_token"
        ]
        if !clientSecret.isEmpty { fields["client_secret"] = clientSecret }
        post("https://oauth2.googleapis.com/token", fields) { j, err in
            guard let j = j, let a = j["access_token"] as? String else {
                done(nil, nil, err ?? "rafraîchissement refusé")
                return
            }
            let ttl = (j["expires_in"] as? Double) ?? 3500
            done(a, Date().addingTimeInterval(ttl - 60), nil)
        }
    }

    static func userEmail(_ accessToken: String, done: @escaping (String?) -> Void) {
        var req = URLRequest(url: URL(string: "https://www.googleapis.com/oauth2/v3/userinfo")!)
        req.setValue("Bearer \(accessToken)", forHTTPHeaderField: "Authorization")
        req.timeoutInterval = 20
        URLSession.shared.dataTask(with: req) { data, _, _ in
            guard let d = data,
                  let j = try? JSONSerialization.jsonObject(with: d) as? [String: Any] else {
                done(nil); return
            }
            done(j["email"] as? String)
        }.resume()
    }
}

extension Data {
    func base64URL() -> String {
        base64EncodedString()
            .replacingOccurrences(of: "+", with: "-")
            .replacingOccurrences(of: "/", with: "_")
            .replacingOccurrences(of: "=", with: "")
    }
}

// ═══════════════════════════════════════════════════════════
//  Session Gmail : conserve les identifiants et sert un jeton valide
// ═══════════════════════════════════════════════════════════

final class GmailAuth {
    static let shared = GmailAuth()

    private let kClientID = "oauth.client.id"
    private let kSecret = "oauth.client.secret"
    private let kRefresh = "oauth.refresh"

    private var access: String?
    private var expiry = Date.distantPast

    var email: String = ""           // rempli par l'état enregistré

    var clientID: String {
        get { BudKeychain.get(kClientID) ?? "" }
        set { BudKeychain.set(newValue, account: kClientID) }
    }
    var clientSecret: String {
        get { BudKeychain.get(kSecret) ?? "" }
        set { BudKeychain.set(newValue, account: kSecret) }
    }
    private var refreshToken: String {
        get { BudKeychain.get(kRefresh) ?? "" }
        set { BudKeychain.set(newValue, account: kRefresh) }
    }

    var isConnected: Bool { !refreshToken.isEmpty && !email.isEmpty }
    var hasClient: Bool { !clientID.isEmpty }

    func store(_ t: GoogleTokens) {
        access = t.access
        expiry = t.expiry
        if !t.refresh.isEmpty { refreshToken = t.refresh }
        if !t.email.isEmpty { email = t.email }
    }

    func disconnect() {
        access = nil
        expiry = .distantPast
        BudKeychain.delete(kRefresh)
        email = ""
    }

    func forgetClient() {
        BudKeychain.delete(kClientID)
        BudKeychain.delete(kSecret)
    }

    /// Jeton d'accès utilisable, rafraîchi si besoin. Appel bloquant court.
    func validAccessToken() -> String? {
        if let a = access, Date() < expiry { return a }
        guard !refreshToken.isEmpty, !clientID.isEmpty else { return nil }
        let sem = DispatchSemaphore(value: 0)
        var token: String?
        GoogleOAuth.refresh(clientID: clientID, clientSecret: clientSecret,
                            refreshToken: refreshToken) { [weak self] a, exp, _ in
            if let a = a, let e = exp {
                self?.access = a
                self?.expiry = e
                token = a
            }
            sem.signal()
        }
        _ = sem.wait(timeout: .now() + 25)
        return token
    }

    /// Chaîne XOAUTH2 attendue par IMAP et SMTP.
    func xoauth2() -> String? {
        guard let t = validAccessToken(), !email.isEmpty else { return nil }
        let raw = "user=\(email)\u{01}auth=Bearer \(t)\u{01}\u{01}"
        return Data(raw.utf8).base64EncodedString()
    }
}
EOF_BUDOAUTH_SWIFT

cat << 'EOF_BUDPHONE_SWIFT' > "$SRC_DIR/BudPhone.swift"
import AppKit
import CoreImage
import Foundation
import QuartzCore

// ═══════════════════════════════════════════════════════════
//  Appairage Gmail par téléphone
//
//  BUD affiche un QR code, vous le scannez, l'application Google
//  de votre téléphone vous identifie. Rien n'est tapé au clavier
//  du Mac, aucun serveur tiers n'intervient.
//
//  Note technique honnête : le « device flow » de Google — le code
//  à six lettres sur google.com/device — n'accepte PAS les scopes
//  Gmail. Google le restreint à email, openid, profile, deux scopes
//  Drive et deux YouTube. D'où les deux voies ci-dessous.
//
//    Voie 1 · Mot de passe d'application (recommandée)
//      Le téléphone ouvre la page des mots de passe d'application,
//      déjà authentifié. Seize lettres à recopier dans BUD.
//
//    Voie 2 · OAuth Google
//      Le téléphone ouvre le consentement. La redirection pointe
//      vers le Mac et échoue donc sur le téléphone : son adresse
//      contient le code d'autorisation, qu'il suffit de coller.
//      Le vérificateur PKCE n'a jamais quitté le Mac, le code seul
//      ne vaut donc rien pour un tiers.
// ═══════════════════════════════════════════════════════════

let appPasswordURL = "https://myaccount.google.com/apppasswords"

enum QRCode {
    /// Rendu net : un module occupe un nombre entier de pixels,
    /// agrandi sans interpolation pour garder des arêtes franches.
    static func image(_ text: String, scale: CGFloat = 12) -> NSImage? {
        guard !text.isEmpty, let f = CIFilter(name: "CIQRCodeGenerator") else { return nil }
        f.setValue(Data(text.utf8), forKey: "inputMessage")
        // Une charge longue grossit la matrice : on baisse la redondance
        // pour garder des modules assez larges à l'écran.
        f.setValue(text.count > 180 ? "L" : "M", forKey: "inputCorrectionLevel")
        guard var out = f.outputImage else { return nil }

        if let fc = CIFilter(name: "CIFalseColor") {
            fc.setValue(out, forKey: kCIInputImageKey)
            fc.setValue(CIColor(red: 0.04, green: 0.04, blue: 0.05), forKey: "inputColor0")
            fc.setValue(CIColor(red: 1, green: 1, blue: 1), forKey: "inputColor1")
            if let o = fc.outputImage { out = o }
        }

        let big = out.samplingNearest().transformed(by: CGAffineTransform(scaleX: scale, y: scale))
        let rep = NSCIImageRep(ciImage: big)
        let img = NSImage(size: rep.size)
        img.addRepresentation(rep)
        return img
    }
}

// ═══════════════════════════════════════════════════════════
//  La plaque : fond blanc, QR net, équerres d'accent, balayage
// ═══════════════════════════════════════════════════════════

final class QRPlate: NSView {
    var payload: String = "" {
        didSet {
            guard payload != oldValue else { return }
            qr = QRCode.image(payload)
            needsDisplay = true
        }
    }
    var paired = false { didSet { needsDisplay = true } }

    private var qr: NSImage?
    private var scanT: CGFloat = 0
    private var timer: Timer?

    override init(frame: NSRect) {
        super.init(frame: frame)
        wantsLayer = true
    }
    required init?(coder: NSCoder) { fatalError() }
    deinit { timer?.invalidate() }

    func startScan() {
        guard timer == nil else { return }
        timer = Timer.scheduledTimer(withTimeInterval: 1.0 / 30.0, repeats: true) { [weak self] _ in
            guard let s = self else { return }
            // Inutile de peindre un panneau masqué : le balayage dort.
            guard s.window != nil, !s.isHiddenOrHasHiddenAncestor else { return }
            s.scanT += 1.0 / 30.0
            if s.scanT > 2.6 { s.scanT = 0 }
            s.needsDisplay = true
        }
        if let t = timer { RunLoop.main.add(t, forMode: .common) }
    }

    func stopScan() {
        timer?.invalidate()
        timer = nil
    }

    override func draw(_ dirty: NSRect) {
        guard let ctx = NSGraphicsContext.current else { return }
        let r = bounds.insetBy(dx: 1, dy: 1)

        // Plaque claire : un QR se lit mal sur fond sombre.
        let plate = NSBezierPath(roundedRect: r, xRadius: 20, yRadius: 20)
        NSColor(calibratedWhite: 0.985, alpha: 1).setFill()
        plate.fill()
        TH.accent.withAlphaComponent(0.22).setStroke()
        plate.lineWidth = 1
        plate.stroke()

        let inner = r.insetBy(dx: 16, dy: 16)

        if let img = qr {
            ctx.saveGraphicsState()
            ctx.imageInterpolation = .none
            // Côté entier : évite qu'un module soit coupé en deux pixels.
            let side = floor(min(inner.width, inner.height))
            let box = NSRect(x: inner.midX - side / 2, y: inner.midY - side / 2,
                             width: side, height: side)
            img.draw(in: box, from: .zero, operation: .sourceOver, fraction: paired ? 0.18 : 1)
            ctx.restoreGraphicsState()

            // Équerres d'accent aux quatre angles. Les bornes sont
            // calculées une par une : un tuple mixte CGFloat/Double
            // rend l'inférence ambiguë sur x86_64.
            let arm: CGFloat = 20, thick: CGFloat = 2.5
            TH.accent.setFill()
            let c = box.insetBy(dx: -7, dy: -7)
            let corners: [NSRect] = [
                NSRect(x: c.minX, y: c.maxY - thick, width: arm, height: thick),
                NSRect(x: c.minX, y: c.maxY - arm, width: thick, height: arm),
                NSRect(x: c.maxX - arm, y: c.maxY - thick, width: arm, height: thick),
                NSRect(x: c.maxX - thick, y: c.maxY - arm, width: thick, height: arm),
                NSRect(x: c.minX, y: c.minY, width: arm, height: thick),
                NSRect(x: c.minX, y: c.minY, width: thick, height: arm),
                NSRect(x: c.maxX - arm, y: c.minY, width: arm, height: thick),
                NSRect(x: c.maxX - thick, y: c.minY, width: thick, height: arm)
            ]
            for bracket in corners { NSBezierPath(rect: bracket).fill() }

            // Balayage : une bande d'accent descend puis disparaît.
            if !paired {
                let p = min(1, scanT / 1.5)
                if scanT < 1.5 {
                    let y = box.maxY - p * box.height
                    let band = NSRect(x: box.minX, y: y - 26, width: box.width, height: 26)
                    ctx.saveGraphicsState()
                    NSBezierPath(rect: box).setClip()
                    let fade = sin(p * .pi)
                    let g = NSGradient(colors: [TH.accent.withAlphaComponent(0),
                                                TH.accent.withAlphaComponent(0.30 * fade)])
                    g?.draw(in: band, angle: 90)
                    TH.accent.withAlphaComponent(0.65 * fade).setFill()
                    NSBezierPath(rect: NSRect(x: box.minX, y: y - 1.2, width: box.width, height: 1.2)).fill()
                    ctx.restoreGraphicsState()
                }
            }
        } else {
            drawString("QR indisponible", in: NSRect(x: inner.minX, y: inner.midY + 8,
                                                     width: inner.width, height: 18),
                       size: 12.5, weight: .semibold,
                       color: NSColor(calibratedWhite: 0.25, alpha: 1), align: .center)
            drawString("Utilisez « Copier le lien »", in: NSRect(x: inner.minX, y: inner.midY - 12,
                                                                 width: inner.width, height: 16),
                       size: 11, weight: .regular,
                       color: NSColor(calibratedWhite: 0.45, alpha: 1), align: .center)
        }

        if paired {
            let d: CGFloat = 76
            let ring = NSRect(x: r.midX - d / 2, y: r.midY - d / 2, width: d, height: d)
            TH.accent.setFill()
            NSBezierPath(ovalIn: ring).fill()
            drawSymbol("checkmark", center: NSPoint(x: r.midX, y: r.midY),
                       size: 36, weight: .bold, color: NSColor(calibratedWhite: 0.07, alpha: 0.95))
        }
    }
}

/// Fenêtre d'agrandissement : un QR confortable à scanner de loin.
final class QRZoom {
    static var panel: NSPanel?

    static func show(_ payload: String, title: String) {
        close()
        // 460 pt : l'URL de consentement fait ~69 modules, il faut
        // au moins 5 pt par module pour un appareil photo de téléphone.
        let side: CGFloat = 460
        let p = NSPanel(contentRect: NSRect(x: 0, y: 0, width: side, height: side + 54),
                        styleMask: [.titled, .closable, .utilityWindow],
                        backing: .buffered, defer: false)
        p.title = title
        p.isFloatingPanel = true
        p.level = .floating
        p.hidesOnDeactivate = false

        let host = NSView(frame: NSRect(x: 0, y: 0, width: side, height: side + 54))
        let plate = QRPlate(frame: NSRect(x: 18, y: 54, width: side - 36, height: side - 36))
        plate.payload = payload
        host.addSubview(plate)

        let hint = NSTextField(labelWithString: "Scannez avec l'appareil photo du téléphone.")
        hint.frame = NSRect(x: 0, y: 20, width: side, height: 18)
        hint.alignment = .center
        hint.font = NSFont.systemFont(ofSize: 11.5)
        hint.textColor = .secondaryLabelColor
        host.addSubview(hint)

        p.contentView = host
        p.center()
        p.makeKeyAndOrderFront(nil)
        NSApp.activate(ignoringOtherApps: true)
        panel = p
    }

    static func close() {
        panel?.orderOut(nil)
        panel = nil
    }
}

// ═══════════════════════════════════════════════════════════
//  OAuth démarré sur le Mac, consenti sur le téléphone
// ═══════════════════════════════════════════════════════════

final class PhoneOAuth {
    static let shared = PhoneOAuth()

    private var verifier = ""
    private var stateTok = ""
    private var redirect = ""
    private var catcher: LoopbackCatcher?

    var authURL: String = ""
    var armed: Bool { !verifier.isEmpty && !authURL.isEmpty }

    /// Prépare l'URL de consentement. Le guetteur local reste actif :
    /// si vous ouvrez le lien sur le Mac, l'appairage se termine seul.
    func arm(clientID: String, onAuto: @escaping (GoogleTokens?, String?) -> Void) -> String? {
        cancel()
        verifier = GoogleOAuth.randomVerifier()
        stateTok = String(GoogleOAuth.randomVerifier().prefix(24))

        let c = LoopbackCatcher()
        catcher = c
        guard let port = c.start(timeout: 900, onResult: { [weak self] code, err in
            guard let s = self else { return }
            guard let code = code else {
                if let e = err, e != "délai dépassé" { onAuto(nil, e) }
                return
            }
            s.exchange(clientID: clientID, code: code, completion: onAuto)
        }) else {
            return nil
        }
        redirect = "http://127.0.0.1:\(port)"

        var u = URLComponents(string: "https://accounts.google.com/o/oauth2/v2/auth")!
        u.queryItems = [
            URLQueryItem(name: "client_id", value: clientID),
            URLQueryItem(name: "redirect_uri", value: redirect),
            URLQueryItem(name: "response_type", value: "code"),
            URLQueryItem(name: "scope", value: GoogleOAuth.scope),
            URLQueryItem(name: "code_challenge", value: GoogleOAuth.challenge(verifier)),
            URLQueryItem(name: "code_challenge_method", value: "S256"),
            URLQueryItem(name: "access_type", value: "offline"),
            URLQueryItem(name: "prompt", value: "consent"),
            URLQueryItem(name: "state", value: stateTok)
        ]
        authURL = u.url?.absoluteString ?? ""
        return authURL.isEmpty ? nil : authURL
    }

    /// Accepte l'adresse complète recopiée du téléphone, ou le code seul.
    func finish(pasted raw: String, clientID: String,
                completion: @escaping (GoogleTokens?, String?) -> Void) {
        let s = raw.trimmingCharacters(in: .whitespacesAndNewlines)
        guard !s.isEmpty else { completion(nil, "Rien à coller."); return }
        guard armed else { completion(nil, "Relancez l'appairage : la demande a expiré."); return }

        var code = s
        var seenState: String?

        if s.contains("code=") {
            // Une adresse : on lit ses paramètres, avec ou sans « ? ».
            // Pas d'indexation directe : une adresse finissant par « ? »
            // ne produit qu'un seul morceau et ferait planter [1].
            let query = s.split(separator: "?", maxSplits: 1).dropFirst().first.map(String.init) ?? s
            for pair in query.split(separator: "&") {
                let kv = pair.split(separator: "=", maxSplits: 1).map(String.init)
                guard kv.count == 2 else { continue }
                let v = kv[1].removingPercentEncoding ?? kv[1]
                if kv[0] == "code" { code = v }
                if kv[0] == "state" { seenState = v }
                if kv[0] == "error" { completion(nil, "Google a répondu : \(v)"); return }
            }
        }

        if let st = seenState, st != stateTok {
            completion(nil, "Jeton d'état incohérent, appairage abandonné.")
            return
        }
        guard code.count > 12, !code.contains(" ") else {
            completion(nil, "Code d'autorisation introuvable dans ce texte.")
            return
        }
        exchange(clientID: clientID, code: code, completion: completion)
    }

    private func exchange(clientID: String, code: String,
                          completion: @escaping (GoogleTokens?, String?) -> Void) {
        let v = verifier, r = redirect
        cancel()
        GoogleOAuth.exchangeCode(clientID: clientID,
                                 clientSecret: GmailAuth.shared.clientSecret,
                                 code: code, verifier: v, redirect: r,
                                 completion: completion)
    }

    func cancel() {
        catcher?.stop()
        catcher = nil
        verifier = ""
        stateTok = ""
        authURL = ""
    }
}

// ═══════════════════════════════════════════════════════════
//  Le panneau
// ═══════════════════════════════════════════════════════════

final class PhonePanelView: NSView, NSTextFieldDelegate {
    private let hero: HeroHeader
    private var seg: SegmentedBar!
    private var plate: QRPlate!
    private var stepLabels: [NSTextField] = []
    private var hintLabel: NSTextField!
    private var statusLabel: NSTextField!

    private var emailField: NSTextField!
    private var passField: NSTextField!
    private var clientField: NSTextField!
    private var pasteField: NSTextField!
    private var actionBtn: GlassButton!
    private var zoomBtn: GlassButton!
    private var copyBtn: GlassButton!
    private var openBtn: GlassButton!
    private var disconnectBtn: GlassButton!
    private var linkedCard: NSView!
    private var linkedLabel: NSTextField!

    private var mode = 0          // 0 = mot de passe d'app, 1 = OAuth
    private var busy = false

    var onStatus: ((String) -> Void)?
    var onAccountChange: ((String) -> Void)?
    var prefillAddress: () -> String = { "" }

    override init(frame: NSRect) {
        hero = HeroHeader(frame: NSRect(x: 0, y: frame.height - 92, width: frame.width, height: 92),
                          title: "Téléphone",
                          subtitle: "Reliez Gmail depuis l'application Google de votre téléphone.")
        super.init(frame: frame)
        build()
        applyMode()
    }
    required init?(coder: NSCoder) { fatalError() }

    private func build() {
        let W = bounds.width, H = bounds.height
        addSubview(hero)

        seg = SegmentedBar(frame: NSRect(x: 0, y: H - 134, width: W, height: 36),
                           items: [SegmentedBar.Item(title: "Mot de passe d'app", icon: "key.fill"),
                                   SegmentedBar.Item(title: "OAuth Google", icon: "checkmark.shield.fill")])
        seg.onSelect = { [weak self] i in
            self?.mode = i
            self?.applyMode()
        }
        addSubview(seg)

        plate = QRPlate(frame: NSRect(x: 0, y: 226, width: 200, height: 200))
        addSubview(plate)

        // Colonne de droite : les trois étapes.
        let cx: CGFloat = 220, cw = W - 220
        addSubview(mkLabel("ÉTAPES", NSRect(x: cx, y: 408, width: cw, height: 14), 9.5, .bold, alpha: 0.32))
        var y: CGFloat = 348
        for i in 0..<3 {
            mkCard(self, NSRect(x: cx, y: y, width: cw, height: 56), radius: 12, alpha: 0.055)
            let dot = NSView(frame: NSRect(x: cx + 14, y: y + 17, width: 22, height: 22))
            dot.wantsLayer = true
            dot.layer?.cornerRadius = 11
            dot.layer?.backgroundColor = TH.accent.withAlphaComponent(0.18).cgColor
            dot.layer?.borderWidth = 1
            dot.layer?.borderColor = TH.accent.withAlphaComponent(0.35).cgColor
            addSubview(dot)
            addSubview(mkLabel("\(i + 1)", NSRect(x: cx + 14, y: y + 20, width: 22, height: 16),
                               11, .bold, alpha: 0.85, .center))

            let t = NSTextField(frame: NSRect(x: cx + 46, y: y + 8, width: cw - 60, height: 40))
            t.isBezeled = false
            t.drawsBackground = false
            t.isEditable = false
            t.isSelectable = false
            t.font = NSFont.systemFont(ofSize: 11.5)
            t.textColor = TH.dim(0.68)
            t.lineBreakMode = .byWordWrapping
            t.cell?.usesSingleLineMode = false
            t.cell?.wraps = true
            t.maximumNumberOfLines = 3
            ThemeRegistry.shared.register(t, alpha: 0.68)
            addSubview(t)
            stepLabels.append(t)
            y -= 64
        }

        hintLabel = NSTextField(frame: NSRect(x: 0, y: 186, width: W, height: 30))
        hintLabel.isBezeled = false
        hintLabel.drawsBackground = false
        hintLabel.isEditable = false
        hintLabel.isSelectable = false
        hintLabel.font = NSFont.systemFont(ofSize: 10.5)
        hintLabel.textColor = TH.dim(0.40)
        hintLabel.lineBreakMode = .byWordWrapping
        hintLabel.cell?.usesSingleLineMode = false
        hintLabel.cell?.wraps = true
        hintLabel.maximumNumberOfLines = 2
        ThemeRegistry.shared.register(hintLabel, alpha: 0.40)
        addSubview(hintLabel)

        // Rangée 1 : adresse (voie 1) ou identifiant client (voie 2).
        emailField = NSTextField(frame: NSRect(x: 0, y: 150, width: 300, height: 30))
        emailField.placeholderString = "adresse@gmail.com"
        emailField.font = NSFont.systemFont(ofSize: 12.5)
        addSubview(emailField)

        passField = NSTextField(frame: NSRect(x: 310, y: 150, width: 190, height: 30))
        passField.placeholderString = "abcd efgh ijkl mnop"
        passField.font = NSFont.monospacedDigitSystemFont(ofSize: 12.5, weight: .regular)
        addSubview(passField)

        clientField = NSTextField(frame: NSRect(x: 0, y: 150, width: 500, height: 30))
        clientField.placeholderString = "Identifiant client Google — …apps.googleusercontent.com"
        clientField.font = NSFont.systemFont(ofSize: 11.5)
        clientField.delegate = self
        addSubview(clientField)

        pasteField = NSTextField(frame: NSRect(x: 0, y: 112, width: 500, height: 30))
        pasteField.placeholderString = "Collez ici l'adresse copiée sur le téléphone"
        pasteField.font = NSFont.systemFont(ofSize: 11.5)
        addSubview(pasteField)

        actionBtn = GlassButton(frame: NSRect(x: 510, y: 148, width: W - 510, height: 34),
                                title: "Relier", icon: "link", prominent: true)
        actionBtn.onClick = { [weak self] _ in self?.commit() }
        addSubview(actionBtn)

        linkedCard = mkCard(self, NSRect(x: 0, y: 108, width: W, height: 44), radius: 12, alpha: 0.08)
        mkIcon(linkedCard, "checkmark.seal.fill", x: 14, y: 14, size: 15, alpha: 0.8)
        linkedLabel = mkLabel("", NSRect(x: 40, y: 13, width: W - 54, height: 18), 12, .semibold, alpha: 0.82)
        linkedCard.addSubview(linkedLabel)

        statusLabel = mkLabel("", NSRect(x: 0, y: 58, width: W, height: 34), 11, .medium, alpha: 0.55)
        statusLabel.lineBreakMode = .byWordWrapping
        statusLabel.cell?.usesSingleLineMode = false
        statusLabel.cell?.wraps = true
        statusLabel.maximumNumberOfLines = 2
        addSubview(statusLabel)

        let bw = (W - 36) / 4
        let specs: [(String, String, () -> Void)] = [
            ("Agrandir", "viewfinder", { [weak self] in self?.zoom() }),
            ("Copier le lien", "doc.on.doc", { [weak self] in self?.copyLink() }),
            ("Ouvrir ici", "arrow.up.right.square", { [weak self] in self?.openHere() }),
            ("Déconnecter", "xmark.circle", { [weak self] in self?.disconnect() })
        ]
        var btns: [GlassButton] = []
        for (i, s) in specs.enumerated() {
            let b = GlassButton(frame: NSRect(x: CGFloat(i) * (bw + 12), y: 0, width: bw, height: 42),
                                title: s.0, icon: s.1)
            b.onClick = { _ in s.2() }
            addSubview(b)
            btns.append(b)
        }
        zoomBtn = btns[0]; copyBtn = btns[1]; openBtn = btns[2]; disconnectBtn = btns[3]
        disconnectBtn.destructive = true
    }

    // ── Bascule entre les deux voies ──

    private func applyMode() {
        let a = prefillAddress()
        if emailField.stringValue.isEmpty {
            emailField.stringValue = MailRouter.account.isEmpty ? a : MailRouter.account
        }
        if clientField.stringValue.isEmpty { clientField.stringValue = GmailAuth.shared.clientID }

        if mode == 0 {
            stepLabels[0].stringValue = "Scannez ce code avec l'appareil photo du téléphone."
            stepLabels[1].stringValue = "L'application Google vous identifie, puis créez un mot de passe nommé « BUD »."
            stepLabels[2].stringValue = "Recopiez les seize lettres affichées, les espaces sont ignorés."
            hintLabel.stringValue = "Demande la validation en deux étapes sur le compte Google. Aucun identifiant client n'est nécessaire."
            plate.payload = appPasswordURL
            actionBtn.title = "Relier"
            actionBtn.iconName = "link"
        } else {
            stepLabels[0].stringValue = "Collez votre identifiant client, puis scannez le code — « Agrandir » le rend plus facile à viser."
            stepLabels[1].stringValue = "Autorisez BUD sur le téléphone. La page suivante ne se chargera pas — c'est normal, elle pointe vers votre Mac."
            stepLabels[2].stringValue = "Copiez l'adresse de cette page et collez-la ci-dessous."
            hintLabel.stringValue = "Demande un identifiant client Google de type « application de bureau ». Le vérificateur PKCE ne quitte jamais le Mac."
            armOAuth()
            actionBtn.title = "Terminer"
            actionBtn.iconName = "checkmark"
        }
        refresh()
    }

    private func armOAuth() {
        let id = clientField.stringValue.trimmingCharacters(in: .whitespacesAndNewlines)
        guard id.contains("apps.googleusercontent.com") else {
            plate.payload = ""
            statusLabel.stringValue = "Collez l'identifiant client, le QR code apparaîtra aussitôt."
            return
        }
        GmailAuth.shared.clientID = id
        guard let url = PhoneOAuth.shared.arm(clientID: id, onAuto: { [weak self] t, err in
            self?.settle(t, err, source: "Mac")
        }) else {
            plate.payload = ""
            statusLabel.stringValue = "Port local indisponible, réessayez dans un instant."
            return
        }
        plate.payload = url
        statusLabel.stringValue = "Prêt. Scannez le code, ou cliquez « Ouvrir ici » pour rester sur le Mac."
    }

    // ── Actions ──

    private func commit() {
        guard !busy else { return }
        if mode == 0 { linkAppPassword() } else { linkOAuth() }
    }

    private func linkAppPassword() {
        let mail = emailField.stringValue.trimmingCharacters(in: .whitespacesAndNewlines)
        let pass = GmailClient.normalizedPassword(passField.stringValue)
        guard mail.contains("@") else {
            statusLabel.stringValue = "Indiquez l'adresse Gmail complète."
            return
        }
        guard pass.count == 16 else {
            statusLabel.stringValue = "Un mot de passe d'application fait seize lettres — \(pass.count) saisie(s)."
            return
        }
        busy = true
        actionBtn.enabledFlag = false
        statusLabel.stringValue = "Vérification auprès de Gmail…"
        onStatus?("Vérification du compte Gmail")

        DispatchQueue.global(qos: .userInitiated).async {
            let err = GmailClient.testLogin(user: mail, password: pass)
            DispatchQueue.main.async { [weak self] in
                guard let s = self else { return }
                s.busy = false
                s.actionBtn.enabledFlag = true
                if let e = err {
                    s.statusLabel.stringValue = e
                    s.onStatus?("Gmail a refusé le mot de passe")
                    return
                }
                _ = BudKeychain.set(pass, account: mail)
                GmailAuth.shared.disconnect()
                MailRouter.account = mail
                s.passField.stringValue = ""
                s.celebrate("Compte relié · \(mail)")
                s.onAccountChange?(mail)
            }
        }
    }

    private func linkOAuth() {
        let id = clientField.stringValue.trimmingCharacters(in: .whitespacesAndNewlines)
        guard id.contains("apps.googleusercontent.com") else {
            statusLabel.stringValue = "Collez d'abord l'identifiant client Google."
            return
        }
        guard PhoneOAuth.shared.armed else {
            armOAuth()
            statusLabel.stringValue = "Appairage relancé : scannez le nouveau code."
            return
        }
        busy = true
        actionBtn.enabledFlag = false
        statusLabel.stringValue = "Échange du code contre les jetons…"
        PhoneOAuth.shared.finish(pasted: pasteField.stringValue, clientID: id) { [weak self] t, err in
            self?.settle(t, err, source: "téléphone")
        }
    }

    private func settle(_ t: GoogleTokens?, _ err: String?, source: String) {
        busy = false
        actionBtn.enabledFlag = true
        guard let t = t, !t.email.isEmpty else {
            if let e = err {
                statusLabel.stringValue = "Échec : \(e)"
                onStatus?("Appairage refusé")
            }
            refresh()
            return
        }
        GmailAuth.shared.store(t)
        if !MailRouter.account.isEmpty {
            BudKeychain.delete(MailRouter.account)
            MailRouter.account = ""
        }
        pasteField.stringValue = ""
        PhoneOAuth.shared.cancel()
        celebrate("Compte relié par OAuth · \(t.email) · validé depuis le \(source)")
        onAccountChange?(t.email)
    }

    private func celebrate(_ msg: String) {
        statusLabel.stringValue = msg
        onStatus?("Gmail connecté")
        plate.paired = true
        plate.stopScan()
        refresh()
        // La coche arrive en fondu : l'ancrage du calque d'une NSView
        // est en bas à gauche, une mise à l'échelle décalerait la plaque.
        plate.alphaValue = 0.35
        NSAnimationContext.runAnimationGroup { ctx in
            ctx.duration = 0.38
            ctx.timingFunction = CAMediaTimingFunction(controlPoints: 0.2, 0.9, 0.25, 1)
            plate.animator().alphaValue = 1
        }
        linkedCard.alphaValue = 0
        NSAnimationContext.runAnimationGroup { ctx in
            ctx.duration = 0.34
            linkedCard.animator().alphaValue = 1
        }
    }

    private func zoom() {
        guard !plate.payload.isEmpty else {
            statusLabel.stringValue = "Aucun code à agrandir pour l'instant."
            return
        }
        QRZoom.show(plate.payload, title: mode == 0 ? "Mots de passe d'application" : "Autorisation Google")
    }

    private func copyLink() {
        let link = mode == 0 ? appPasswordURL : PhoneOAuth.shared.authURL
        guard !link.isEmpty else {
            statusLabel.stringValue = "Aucun lien disponible pour l'instant."
            return
        }
        NSPasteboard.general.clearContents()
        NSPasteboard.general.setString(link, forType: .string)
        statusLabel.stringValue = "Lien copié. Envoyez-le à votre téléphone comme vous voulez."
        onStatus?("Lien d'appairage copié")
    }

    private func openHere() {
        let link = mode == 0 ? appPasswordURL : PhoneOAuth.shared.authURL
        guard !link.isEmpty, let u = URL(string: link) else {
            statusLabel.stringValue = "Aucun lien disponible pour l'instant."
            return
        }
        NSWorkspace.shared.open(u)
        statusLabel.stringValue = mode == 0
            ? "La page des mots de passe d'application s'ouvre sur le Mac."
            : "Consentement ouvert sur le Mac : BUD terminera tout seul."
    }

    private func disconnect() {
        GmailAuth.shared.disconnect()
        if !MailRouter.account.isEmpty {
            BudKeychain.delete(MailRouter.account)
            MailRouter.account = ""
        }
        PhoneOAuth.shared.cancel()
        plate.paired = false
        passField.stringValue = ""
        pasteField.stringValue = ""
        statusLabel.stringValue = "Compte déconnecté. BUD repasse par Mail.app."
        onStatus?("Compte Gmail déconnecté")
        onAccountChange?("")
        applyMode()
    }

    // ── Rafraîchissement ──

    func refresh() {
        // Le compte enregistré n'est restauré qu'après la construction
        // des panneaux : on complète les champs dès qu'il arrive.
        if emailField.stringValue.isEmpty {
            let known = MailRouter.account.isEmpty ? prefillAddress() : MailRouter.account
            emailField.stringValue = known
        }
        if clientField.stringValue.isEmpty { clientField.stringValue = GmailAuth.shared.clientID }

        let oauth = MailRouter.oauthReady
        let app = MailRouter.appPassword != nil
        let linked = oauth || app

        linkedCard.isHidden = !linked
        linkedLabel.stringValue = oauth
            ? "OAuth Google · \(GmailAuth.shared.email) · jetons dans le trousseau"
            : (app ? "Mot de passe d'application · \(MailRouter.account) · trousseau"
                   : "")
        disconnectBtn.enabledFlag = linked
        plate.paired = linked
        // En OAuth le code est dense : on met l'agrandissement en avant.
        zoomBtn.prominent = (mode == 1 && !linked)

        let showForm = !linked
        emailField.isHidden = !(showForm && mode == 0)
        passField.isHidden = !(showForm && mode == 0)
        clientField.isHidden = !(showForm && mode == 1)
        pasteField.isHidden = !(showForm && mode == 1)
        actionBtn.isHidden = !showForm
        zoomBtn.enabledFlag = !linked && !plate.payload.isEmpty
        copyBtn.enabledFlag = !linked

        if linked { plate.stopScan() } else { plate.startScan() }
        if linked && statusLabel.stringValue.isEmpty {
            statusLabel.stringValue = "Compte déjà relié. « Déconnecter » pour en changer."
        }
    }

    /// L'identifiant client vient d'être collé : on réarme le QR aussitôt.
    func controlTextDidEndEditing(_ obj: Notification) {
        guard (obj.object as? NSTextField) === clientField, mode == 1 else { return }
        armOAuth()
        refresh()
    }

    override func viewDidMoveToWindow() {
        super.viewDidMoveToWindow()
        if window == nil { plate.stopScan() }
    }
}
EOF_BUDPHONE_SWIFT

cat << 'EOF_BUDREMINDERS_SWIFT' > "$SRC_DIR/BudReminders.swift"
import Cocoa

// ═══════════════════════════════════════════════════════════
//  Rappels et alarmes
//  Stockage local : reminders.json. L'alarme sonne dans le notch,
//  avec report ou validation, même si aucune autre app n'est ouverte.
// ═══════════════════════════════════════════════════════════

struct Reminder: Codable {
    var id: String
    var title: String
    var fireAt: TimeInterval
    var repeatMode: Int        // 0 aucun · 1 chaque jour · 2 chaque semaine
    var done: Bool

    var date: Date { Date(timeIntervalSince1970: fireAt) }
    var repeatLabel: String {
        switch repeatMode {
        case 1: return "chaque jour"
        case 2: return "chaque semaine"
        default: return "une fois"
        }
    }
    var whenLabel: String {
        let f = DateFormatter()
        f.locale = Locale(identifier: "fr_FR")
        if Calendar.current.isDateInToday(date) { f.dateFormat = "'aujourd''hui à' HH'h'mm" }
        else if Calendar.current.isDateInTomorrow(date) { f.dateFormat = "'demain à' HH'h'mm" }
        else { f.dateFormat = "EEEE d MMMM 'à' HH'h'mm" }
        return f.string(from: date)
    }
}

final class ReminderStore {
    static let shared = ReminderStore()
    private let url = budSupportDir.appendingPathComponent("reminders.json")
    private(set) var items: [Reminder] = []

    init() { load() }

    func load() {
        if let d = try? Data(contentsOf: url),
           let r = try? JSONDecoder().decode([Reminder].self, from: d) { items = r }
        sort()
    }
    private func sort() { items.sort { $0.fireAt < $1.fireAt } }

    func save() {
        sort()
        let e = JSONEncoder()
        e.outputFormatting = .prettyPrinted
        if let d = try? e.encode(items) { try? d.write(to: url, options: .atomic) }
    }

    @discardableResult
    func add(title: String, at date: Date, repeatMode: Int = 0) -> Reminder {
        let r = Reminder(id: UUID().uuidString, title: title,
                         fireAt: date.timeIntervalSince1970, repeatMode: repeatMode, done: false)
        items.append(r)
        save()
        return r
    }

    func remove(id: String) {
        items.removeAll { $0.id == id }
        save()
    }

    func complete(id: String) {
        guard let i = items.firstIndex(where: { $0.id == id }) else { return }
        if items[i].repeatMode == 0 {
            items.remove(at: i)
        } else {
            let step: TimeInterval = items[i].repeatMode == 1 ? 86400 : 604800
            var next = items[i].fireAt
            while next <= Date().timeIntervalSince1970 { next += step }
            items[i].fireAt = next
            items[i].done = false
        }
        save()
    }

    func snooze(id: String, minutes: Int) {
        guard let i = items.firstIndex(where: { $0.id == id }) else { return }
        items[i].fireAt = Date().addingTimeInterval(Double(minutes) * 60).timeIntervalSince1970
        items[i].done = false
        save()
    }

    /// Le premier rappel dont l'heure est passée.
    func due() -> Reminder? {
        let now = Date().timeIntervalSince1970
        return items.first { !$0.done && $0.fireAt <= now }
    }

    func next() -> Reminder? {
        let now = Date().timeIntervalSince1970
        return items.first { $0.fireAt > now }
    }
}

/// Analyse une formulation française : « dans 20 minutes », « à 18h30 », « demain à 9h ».
enum ReminderParser {
    static func parse(_ raw: String) -> (title: String, date: Date)? {
        let lower = raw.lowercased()
            .folding(options: [.diacriticInsensitive], locale: Locale(identifier: "fr_FR"))
        var when: Date?
        var cut: String?

        if let r = lower.range(of: #"dans\s+(\d+)\s*(min|minute|minutes|h|heure|heures)"#,
                               options: .regularExpression) {
            let frag = String(lower[r])
            let n = Int(frag.filter { $0.isNumber }) ?? 0
            let isHour = frag.contains("h") && !frag.contains("min")
            when = Date().addingTimeInterval(Double(n) * (isHour ? 3600 : 60))
            cut = frag
        } else if let r = lower.range(of: #"(\d{1,2})\s*(h|:)\s*(\d{2})?"#, options: .regularExpression) {
            let frag = String(lower[r])
            let nums = frag.split(whereSeparator: { !$0.isNumber }).compactMap { Int($0) }
            guard let hour = nums.first, hour < 24 else { return nil }
            let minute = nums.count > 1 ? min(59, nums[1]) : 0
            var c = Calendar.current.dateComponents([.year, .month, .day], from: Date())
            c.hour = hour
            c.minute = minute
            var d = Calendar.current.date(from: c) ?? Date()
            if lower.contains("demain") { d = d.addingTimeInterval(86400) }
            else if d < Date() { d = d.addingTimeInterval(86400) }
            when = d
            cut = frag
        } else if lower.contains("demain") {
            var c = Calendar.current.dateComponents([.year, .month, .day], from: Date().addingTimeInterval(86400))
            c.hour = 9
            c.minute = 0
            when = Calendar.current.date(from: c)
            cut = "demain"
        }

        guard let date = when else { return nil }

        // Titre : on retire les mots de commande et l'expression temporelle
        var title = raw
        for m in ["rappelle-moi de", "rappelle moi de", "rappelle-moi", "rappelle moi",
                  "rappel :", "rappel:", "n'oublie pas de", "pense à", "pense a"] {
            if let r = title.lowercased().range(of: m) {
                title = String(title[r.upperBound...])
                break
            }
        }
        if let c = cut, let r = title.lowercased().range(of: c) {
            title.removeSubrange(r)
        }
        for w in [" demain", "demain ", " à ", " a "] {
            title = title.replacingOccurrences(of: w, with: " ")
        }
        title = title.trimmingCharacters(in: .whitespacesAndNewlines)
        if title.isEmpty { title = "Rappel" }
        return (title, date)
    }
}

final class RemindersPanelView: NSView {
    private let hero: HeroHeader
    private var nextTile: StatTile!, countTile: StatTile!
    private let scroll = NSScrollView(frame: .zero)
    private let listHost = NSView(frame: .zero)
    private var rows: [NSView] = []
    private var quickField: NSTextField!

    var onStatus: ((String) -> Void)?
    var onChanged: (() -> Void)?

    override init(frame: NSRect) {
        hero = HeroHeader(frame: NSRect(x: 0, y: frame.height - 92, width: frame.width, height: 92),
                          title: "Rappels", subtitle: "Une alarme dans le notch, même app fermée.")
        super.init(frame: frame)
        build()
    }
    required init?(coder: NSCoder) { fatalError() }

    private func build() {
        let W = bounds.width, H = bounds.height

        nextTile = StatTile(frame: NSRect(x: W - 330, y: H - 86, width: 190, height: 78),
                            caption: "Prochain", hint: "—")
        countTile = StatTile(frame: NSRect(x: W - 130, y: H - 86, width: 120, height: 78),
                             caption: "En attente", hint: "rappels actifs")
        [nextTile, countTile].forEach { addSubview($0) }

        mkSection(self, H - 116, W, "Ajouter")
        quickField = NSTextField(frame: NSRect(x: 0, y: H - 156, width: W - 230, height: 34))
        quickField.placeholderString = "Sortir les poubelles à 19h30 · dans 20 minutes · demain"
        quickField.font = NSFont.systemFont(ofSize: 12.5)
        quickField.target = self
        quickField.action = #selector(addFromField)
        addSubview(quickField)

        let bAdd = GlassButton(frame: NSRect(x: W - 222, y: H - 158, width: 106, height: 38),
                               title: "Ajouter", icon: "plus", prominent: true)
        bAdd.onClick = { [weak self] _ in self?.addFromField() }
        let bIn15 = GlassButton(frame: NSRect(x: W - 108, y: H - 158, width: 108, height: 38),
                                title: "Dans 15 min", icon: "clock", compact: true)
        bIn15.onClick = { [weak self] _ in
            guard let s = self else { return }
            let t = s.quickField.stringValue.trimmingCharacters(in: .whitespacesAndNewlines)
            s.create(title: t.isEmpty ? "Rappel" : t, date: Date().addingTimeInterval(900), repeatMode: 0)
        }
        [bAdd, bIn15].forEach { addSubview($0) }

        mkSection(self, H - 184, W, "À venir")
        scroll.frame = NSRect(x: 0, y: 56, width: W, height: H - 250)
        scroll.hasVerticalScroller = true
        scroll.scrollerStyle = .overlay
        scroll.drawsBackground = false
        scroll.borderType = .noBorder
        scroll.autohidesScrollers = true
        scroll.documentView = listHost
        addSubview(scroll)

        addSubview(mkLabel("Écrivez l'heure dans la phrase : BUD la comprend et garde le reste comme titre.",
                           NSRect(x: 0, y: 12, width: W, height: 16), 11, .regular, alpha: 0.33, .center))
    }

    @objc private func addFromField() {
        let raw = quickField.stringValue.trimmingCharacters(in: .whitespacesAndNewlines)
        guard !raw.isEmpty else { return }
        if let p = ReminderParser.parse(raw) {
            create(title: p.title, date: p.date, repeatMode: 0)
        } else {
            create(title: raw, date: Date().addingTimeInterval(3600), repeatMode: 0)
            onStatus?("Heure non comprise : rappel posé dans une heure.")
        }
    }

    private func create(title: String, date: Date, repeatMode: Int) {
        let r = ReminderStore.shared.add(title: title, at: date, repeatMode: repeatMode)
        quickField.stringValue = ""
        refresh()
        onChanged?()
        onStatus?("Rappel « \(r.title) » \(r.whenLabel)")
    }

    func refresh() {
        let items = ReminderStore.shared.items
        countTile.set("\(items.count)", hint: items.isEmpty ? "aucun rappel" : "rappels actifs")
        if let n = ReminderStore.shared.next() {
            let f = DateFormatter()
            f.locale = Locale(identifier: "fr_FR")
            f.dateFormat = "HH'h'mm"
            nextTile.set(f.string(from: n.date), hint: n.title)
            hero.set(subtitle: "Prochain : \(n.title), \(n.whenLabel).", trailing: "\(items.count)")
        } else {
            nextTile.set("—", hint: "rien de prévu")
            hero.set(subtitle: "Aucun rappel programmé.", trailing: "")
        }

        rows.forEach { $0.removeFromSuperview() }
        rows.removeAll()
        ThemeRegistry.shared.prune()

        let W = scroll.bounds.width - 6
        let rowH: CGFloat = 56
        let totalH = max(scroll.bounds.height, CGFloat(items.count) * rowH)
        listHost.frame = NSRect(x: 0, y: 0, width: W, height: totalH)

        let now = Date().timeIntervalSince1970
        for (i, r) in items.enumerated() {
            let y = totalH - CGFloat(i + 1) * rowH + 6
            let row = mkCard(listHost, NSRect(x: 0, y: y, width: W, height: rowH - 10), radius: 12)
            rows.append(row)
            let rh = row.bounds.height
            let late = r.fireAt <= now

            let iv = mkIcon(row, late ? "bell.badge.fill" : "bell.fill", x: 14, y: rh / 2 - 8, size: 14, alpha: 0.55)
            if late { iv.contentTintColor = warnColor }

            row.addSubview(mkFitLabel(r.title, x: 40, y: rh - 28, 12.5, .semibold))
            row.addSubview(mkFitLabel("\(r.whenLabel) · \(r.repeatLabel)", x: 40, y: 8, 10.5, .regular, alpha: 0.45))

            let bDone = GlassButton(frame: NSRect(x: W - 176, y: rh / 2 - 16, width: 82, height: 32),
                                    title: "Terminé", compact: true)
            bDone.onClick = { [weak self] _ in
                ReminderStore.shared.complete(id: r.id)
                self?.refresh()
                self?.onChanged?()
            }
            let bDel = GlassButton(frame: NSRect(x: W - 88, y: rh / 2 - 16, width: 80, height: 32),
                                   title: "Supprimer", compact: true)
            bDel.destructive = true
            bDel.onClick = { [weak self] _ in
                ReminderStore.shared.remove(id: r.id)
                self?.refresh()
                self?.onChanged?()
            }
            [bDone, bDel].forEach { row.addSubview($0) }
        }
    }
}
EOF_BUDREMINDERS_SWIFT

cat << 'EOF_BUDREPLYSTYLE_SWIFT' > "$SRC_DIR/BudReplyStyle.swift"
import Foundation

// ═══════════════════════════════════════════════════════════
//  Apprendre vos tournures
//
//  Il faut être précis sur ce que fait ce fichier, parce qu'il
//  serait facile de laisser croire qu'il écrit à votre place.
//
//  Il ne génère pas de langue. Il lit vos messages déjà
//  envoyés, en extrait les phrases que vous écrivez vraiment,
//  les classe par fonction — attaquer, demander, remercier,
//  conclure — et les ressort par fréquence. Une réponse
//  proposée est donc un assemblage de vos phrases, pas une
//  imitation de votre style par un modèle.
//
//  C'est moins impressionnant et beaucoup plus fiable : une
//  phrase que vous avez écrite trente fois vous ressemble par
//  construction, et aucun calcul ne peut la rendre maladroite.
//
//  Tout est local. Les corps envoyés sont lus par la connexion
//  IMAP que BUD a déjà, résumés en quelques dizaines de lignes
//  de statistiques, et les corps eux-mêmes ne sont pas gardés.
//  Le profil vit dans `style.json`, hors du dépôt.
// ═══════════════════════════════════════════════════════════

struct ReplyStyle: Codable {

    enum Role: String, Codable, CaseIterable {
        case lead      // la phrase qui ouvre le corps
        case ask       // une demande
        case thanks    // un remerciement
        case waiting   // « dans l'attente de votre retour »
        case close     // la dernière phrase avant la signature
    }

    struct Phrase: Codable {
        var text: String
        var count: Int
        var role: Role
    }

    /// Combien de messages envoyés ont été lus pour bâtir ce profil.
    var sampled = 0
    var updatedAt = ""
    /// Vous vouvoyez ou vous tutoyez. Relevé, pas supposé.
    var formal = true
    /// Longueur moyenne de vos corps, en mots. Sert à choisir entre une
    /// réponse de trois lignes et une réponse de dix.
    var bodyWords = 45
    var phrases: [Phrase] = []

    /// Vos phrases pour une fonction donnée, la plus fréquente d'abord.
    func best(_ role: Role, _ rank: Int = 0) -> String? {
        let p = phrases.filter { $0.role == role }.sorted { $0.count > $1.count }
        guard rank < p.count else { return nil }
        return p[rank].text
    }

    var isEmpty: Bool { sampled == 0 }
}

// ═══════════════════════════════════════════════════════════
//  Le classement des phrases
// ═══════════════════════════════════════════════════════════

enum StyleLearner {

    private static let file = budSupportDir.appendingPathComponent("style.json")

    static func load() -> ReplyStyle {
        guard let d = try? Data(contentsOf: file),
              let s = try? JSONDecoder().decode(ReplyStyle.self, from: d) else {
            return ReplyStyle()
        }
        return s
    }

    static func save(_ s: ReplyStyle) {
        guard let d = try? JSONEncoder().encode(s) else { return }
        try? d.write(to: file, options: .atomic)
    }

    // ─────────────────────────────────────────────────────────
    //  Nettoyer un corps envoyé
    //
    //  Un message envoyé contient presque toujours le message
    //  d'origine en dessous. Le garder apprendrait les phrases
    //  des autres, ce qui est exactement le contraire du but.
    // ─────────────────────────────────────────────────────────

    /// Les marqueurs de citation, dans les formes que produisent les
    /// clients courants en français et en anglais.
    private static let quoteCues = [
        "le ", "on ",                     // « Le 12 mars 2026 à 09:14, X a écrit : »
        "-----message d'origine",
        "-----original message",
        "de :", "from:", "envoyé :", "sent:",
        "début du message transféré",
        "begin forwarded message"
    ]

    private static let closers = ["cordialement", "bien à vous", "salutations",
                                  "respectueusement", "bonne journée", "bonne réception",
                                  "à bientôt", "sincères salutations"]

    /// Retire la salutation et la signature.
    ///
    /// Sans cela, « Bonjour, » se recollait à la phrase suivante — il n'a
    /// pas de ponctuation finale — et le répertoire retenait « Bonjour, Je
    /// fais suite à votre message. » au lieu de la phrase seule. Trois
    /// variantes de salutation donnaient alors trois phrases différentes,
    /// et aucune n'atteignait le seuil d'habitude.
    static func stripCivility(_ input: [String]) -> [String] {
        var lines = input
        while let first = lines.first {
            let t = first.trimmingCharacters(in: .whitespaces)
            let short = t.split(separator: " ").count <= 6
            let isGreeting = short && greetingCues.contains { t.lowercased().hasPrefix($0) }
            if t.isEmpty || isGreeting { lines.removeFirst() } else { break }
        }
        // À partir de la formule de clôture, plus rien n'est rédigé : ni la
        // formule, ni le nom qui la suit, ni la signature complète.
        for (i, l) in lines.enumerated() {
            let low = l.trimmingCharacters(in: .whitespaces).lowercased()
            if closers.contains(where: { low.hasPrefix($0) }) {
                lines = Array(lines[0..<i])
                break
            }
        }
        while let last = lines.last, last.trimmingCharacters(in: .whitespaces).isEmpty {
            lines.removeLast()
        }
        return lines
    }

    static func ownText(in body: String) -> String {
        var kept: [String] = []
        for raw in body.components(separatedBy: .newlines) {
            let line = raw.trimmingCharacters(in: .whitespaces)
            if line.hasPrefix(">") { break }
            let low = line.lowercased()
            // « Le … a écrit : » n'est une citation que si la ligne le dit
            // en entier : une phrase qui commence par « Le » ne l'est pas.
            if low.hasSuffix("a écrit :") || low.hasSuffix("a écrit:")
                || low.hasSuffix("wrote:") { break }
            if quoteCues.contains(where: { low.hasPrefix($0) && low.contains("@") }) { break }
            if low.hasPrefix("-----") { break }
            // Une signature coupe aussi : ce qui suit n'est pas rédigé.
            if line == "--" || line == "-- " { break }
            kept.append(raw)
        }
        return stripCivility(kept).joined(separator: "\n")
    }

    /// Découpe en phrases. Le point d'une abréviation ne doit pas couper :
    /// on exige donc une majuscule ou une fin de texte après le point.
    static func sentences(in text: String) -> [String] {
        var out: [String] = []
        var cur = ""
        let chars = Array(text.replacingOccurrences(of: "\n", with: " "))
        var i = 0
        while i < chars.count {
            let c = chars[i]
            cur.append(c)
            if c == "." || c == "!" || c == "?" {
                var j = i + 1
                while j < chars.count, chars[j] == " " { j += 1 }
                let atEnd = j >= chars.count
                let nextIsUpper = !atEnd && (chars[j].isUppercase || chars[j].isNumber)
                if atEnd || nextIsUpper {
                    let s = cur.trimmingCharacters(in: .whitespaces)
                    if !s.isEmpty { out.append(s) }
                    cur = ""
                }
            }
            i += 1
        }
        let s = cur.trimmingCharacters(in: .whitespaces)
        if !s.isEmpty { out.append(s) }
        return out
    }

    private static let askCues = ["pourriez-vous", "pouvez-vous", "serait-il possible",
                                  "je souhaiterais", "j'aimerais", "auriez-vous",
                                  "je vous prie de", "merci de bien vouloir"]
    private static let thanksCues = ["merci", "je vous remercie", "remerciements"]
    private static let waitCues = ["dans l'attente", "je reste", "je demeure",
                                   "n'hésitez pas", "je me tiens", "à votre disposition"]
    private static let greetingCues = ["bonjour", "bonsoir", "madame", "monsieur", "cher",
                                       "chère", "cordialement", "salutations", "bien à vous",
                                       "respectueusement"]

    /// Les salutations et les signatures ne s'apprennent pas : elles sont
    /// imposées par ailleurs, et les compter encombrerait le répertoire
    /// sans rien apporter.
    private static func isCivility(_ low: String) -> Bool {
        let words = low.split(separator: " ").count
        guard words <= 6 else { return false }
        return greetingCues.contains { low.hasPrefix($0) }
    }

    static func role(of sentence: String, isFirst: Bool, isLast: Bool) -> ReplyStyle.Role? {
        let low = sentence.lowercased()
        if isCivility(low) { return nil }
        // Une phrase trop courte ou trop longue n'est pas réutilisable :
        // en dessous de trois mots elle ne dit rien, au-delà de quarante
        // elle est trop liée à son contexte pour resservir.
        let words = sentence.split(separator: " ").count
        guard words >= 3, words <= 40 else { return nil }

        if waitCues.contains(where: { low.contains($0) }) { return .waiting }
        if askCues.contains(where: { low.contains($0) }) { return .ask }
        if thanksCues.contains(where: { low.contains($0) }) { return .thanks }
        if isFirst { return .lead }
        if isLast { return .close }
        return nil
    }

    /// Construit le profil depuis une liste de corps envoyés.
    ///
    /// Fonction pure : pas de réseau, pas de fichier. C'est ce qui permet
    /// de la rejouer sur des exemples et de vérifier son verdict.
    static func profile(from bodies: [String]) -> ReplyStyle {
        var s = ReplyStyle()
        var counts: [String: (count: Int, role: ReplyStyle.Role)] = [:]
        var totalWords = 0
        var bodiesKept = 0
        var tu = 0, vous = 0

        for body in bodies {
            let own = ownText(in: body)
            let sents = sentences(in: own).filter { !$0.isEmpty }
            guard !sents.isEmpty else { continue }
            bodiesKept += 1
            totalWords += own.split(separator: " ").count

            let low = own.lowercased()
            // Le vouvoiement se compte sur des formes sans ambiguïté :
            // « tu » isolé, « vous » isolé. « votre » appartient aux deux
            // registres dans une formule de politesse.
            for w in low.split(whereSeparator: { !$0.isLetter }) {
                if w == "tu" || w == "toi" || w == "ton" || w == "ta" { tu += 1 }
                if w == "vous" || w == "votre" || w == "vos" { vous += 1 }
            }

            for (i, sent) in sents.enumerated() {
                guard let r = role(of: sent, isFirst: i == 0, isLast: i == sents.count - 1)
                else { continue }
                let key = canonical(sent)
                if let old = counts[key] { counts[key] = (old.count + 1, old.role) }
                else { counts[key] = (1, r) }
            }
        }

        s.sampled = bodiesKept
        s.formal = vous >= tu
        s.bodyWords = bodiesKept > 0 ? max(12, totalWords / bodiesKept) : 45
        s.updatedAt = shortDateString()

        // On garde les trois meilleures par fonction : au-delà, ce sont
        // des phrases vues une seule fois, qui ne disent rien d'une
        // habitude.
        var kept: [ReplyStyle.Phrase] = []
        for r in ReplyStyle.Role.allCases {
            let pool = counts.filter { $0.value.role == r }
                .map { ReplyStyle.Phrase(text: $0.key, count: $0.value.count, role: r) }
                .sorted { ($0.count, $1.text.count) > ($1.count, $0.text.count) }
            kept.append(contentsOf: pool.prefix(3))
        }
        s.phrases = kept
        return s
    }

    /// Verse une réponse que vous venez d'envoyer au profil.
    ///
    /// Le profil complet se refait depuis le serveur, mais attendre ce
    /// relevé-là voudrait dire qu'une tournure adoptée aujourd'hui ne
    /// compte que demain. Un message envoyé est un exemple immédiat.
    static func absorbOne(_ body: String) {
        var s = load()
        let own = ownText(in: body)
        let sents = sentences(in: own).filter { !$0.isEmpty }
        guard !sents.isEmpty else { return }

        for (i, sent) in sents.enumerated() {
            guard let r = role(of: sent, isFirst: i == 0, isLast: i == sents.count - 1)
            else { continue }
            let key = canonical(sent)
            if let idx = s.phrases.firstIndex(where: { $0.text == key && $0.role == r }) {
                s.phrases[idx].count += 1
            } else {
                s.phrases.append(ReplyStyle.Phrase(text: key, count: 1, role: r))
            }
        }

        // Le même plafond qu'au relevé complet : trois par fonction. Sans
        // lui, le fichier grossirait d'une phrase à chaque envoi, et les
        // phrases vues une fois noieraient les habitudes.
        var kept: [ReplyStyle.Phrase] = []
        for r in ReplyStyle.Role.allCases {
            let pool = s.phrases.filter { $0.role == r }.sorted { $0.count > $1.count }
            kept.append(contentsOf: pool.prefix(3))
        }
        s.phrases = kept
        s.sampled += 1
        s.updatedAt = shortDateString()
        save(s)
    }

    /// Relit le dossier des envois et refait le profil. Hors fil principal :
    /// quarante corps à rapatrier prennent plusieurs secondes.
    static func relearn(_ done: @escaping (ReplyStyle) -> Void) {
        DispatchQueue.global(qos: .utility).async {
            let bodies = MailRouter.sentBodies()
            let s = bodies.isEmpty ? load() : profile(from: bodies)
            if !bodies.isEmpty { save(s) }
            DispatchQueue.main.async { done(s) }
        }
    }

    /// Deux phrases identiques à un espace ou une majuscule près sont la
    /// même phrase : sans cela, chaque variante compterait pour une et
    /// aucune n'atteindrait le seuil d'habitude.
    static func canonical(_ s: String) -> String {
        let collapsed = s.split(separator: " ", omittingEmptySubsequences: true)
            .joined(separator: " ")
        return collapsed.trimmingCharacters(in: .whitespacesAndNewlines)
    }
}

// ═══════════════════════════════════════════════════════════
//  Ce que le message reçu demande
//
//  Même détection que le sous-agent `mail-actions`, et pour la
//  même raison : les en-têtes et les tournures explicites, pas
//  les mots-clés d'un objet, qu'un expéditeur choisit.
// ═══════════════════════════════════════════════════════════

enum MailAsk: String {
    case payment       // une facture, une échéance de paiement
    case confirm       // une confirmation attendue
    case question      // une question posée
    case appointment   // un rendez-vous à fixer ou à confirmer
    case document      // une pièce demandée
    case plain         // rien de précis : un accusé de réception suffit

    var label: String {
        switch self {
        case .payment:     return "Facture ou paiement"
        case .confirm:     return "Confirmation attendue"
        case .question:    return "Question posée"
        case .appointment: return "Rendez-vous"
        case .document:    return "Pièce demandée"
        case .plain:       return "Accusé de réception"
        }
    }
}

enum MailReader {

    /// Ce que le message attend de vous.
    ///
    /// L'ordre des tests est l'ordre des conséquences : une facture se
    /// traite avant une question, parce que s'y tromper coûte plus cher.
    static func ask(subject: String, body: String) -> MailAsk {
        let t = fold(subject + " " + body)

        if contains(t, ["facture", "echeance", "reglement", "prelevement", "impaye",
                        "montant du", "a payer", "paiement"]) { return .payment }
        if contains(t, ["rendez vous", "rdv", "creneau", "disponibilite",
                        "vous recevoir", "entretien"]) { return .appointment }
        if contains(t, ["merci de confirmer", "veuillez confirmer", "confirmez",
                        "accuser reception", "votre accord", "valider"]) { return .confirm }
        if contains(t, ["piece jointe manquante", "nous transmettre", "merci de nous envoyer",
                        "justificatif", "attestation", "merci de fournir"]) { return .document }
        if contains(t, ["pourriez vous", "pouvez vous", "quelle est", "quel est",
                        "comment", "serait il possible", "?"]) { return .question }
        return .plain
    }

    private static func contains(_ haystack: String, _ needles: [String]) -> Bool {
        needles.contains { haystack.contains($0) }
    }

    /// Minuscules, sans accents, espaces réduits — mais le point
    /// d'interrogation reste : c'est lui qui signale une question, et la
    /// normalisation générale de la voix l'effacerait.
    static func fold(_ s: String) -> String {
        let folded = s.folding(options: [.diacriticInsensitive, .caseInsensitive],
                               locale: Locale(identifier: "fr_FR"))
        let kept = folded.map { ch -> Character in
            (ch.isLetter || ch.isNumber || ch == "?") ? ch : " "
        }
        return String(kept).split(separator: " ").joined(separator: " ")
    }
}

// ═══════════════════════════════════════════════════════════
//  La rédaction
//
//  Deux règles imposées, qui ne se discutent pas : l'ouverture
//  est « Bonjour, Monsieur ou Madame, » et la clôture
//  « Cordialement, merci. ». Elles encadrent le corps, et le
//  corps seul est touché par le style appris.
// ═══════════════════════════════════════════════════════════

enum ReplyWriter {

    static let opening = "Bonjour, Monsieur ou Madame,"
    static let closing = "Cordialement, merci."
    /// L'endroit où BUD ne peut pas écrire à votre place. Le tiroir le
    /// sélectionne à l'ouverture : il suffit de taper par-dessus.
    static let placeholder = "(votre réponse ici)"

    struct Draft {
        var label: String        // le nom du bouton qui le choisit
        var text: String
    }

    /// Trois propositions pour un même message : l'une accuse réception,
    /// l'une répond sur le fond, l'une demande un délai. On ne devine pas
    /// laquelle vous voulez — vous choisissez.
    static func drafts(for m: MailMessage, body: String, style: ReplyStyle) -> [Draft] {
        let ask = MailReader.ask(subject: m.subject, body: body)
        let who = MailGuard.displayName(in: m.sender)
        let about = subjectPhrase(m.subject)

        var out: [Draft] = []
        out.append(Draft(label: "Accusé de réception",
                         text: assemble(core: acknowledge(ask, about: about), style: style)))
        out.append(Draft(label: "Réponse sur le fond",
                         text: assemble(core: substantive(ask, about: about, who: who,
                                                          style: style),
                                        style: style)))
        out.append(Draft(label: "Demande de délai",
                         text: assemble(core: delay(ask, about: about), style: style)))
        return out
    }

    /// Le corps, encadré par l'ouverture et la clôture imposées, et
    /// terminé par une de vos phrases d'attente quand BUD en connaît une.
    static func assemble(core: [String], style: ReplyStyle) -> String {
        var lines = [opening, ""]
        lines.append(contentsOf: core)

        // Votre tournure d'attente, si elle a été relevée. Sinon rien :
        // mieux vaut une réponse courte qu'une phrase qui n'est pas la
        // vôtre ajoutée pour faire nombre.
        if let w = style.best(.waiting) {
            lines.append("")
            lines.append(w)
        }
        lines.append("")
        lines.append(closing)
        return lines.joined(separator: "\n")
    }

    /// L'objet transformé en complément utilisable dans une phrase.
    /// « Re: Facture novembre » devient « votre message au sujet de
    /// « Facture novembre » ».
    static func subjectPhrase(_ subject: String) -> String {
        var s = subject.trimmingCharacters(in: .whitespaces)
        // Les préfixes de réponse et de transfert s'empilent : on les
        // retire tous, pas seulement le premier.
        var cut = true
        while cut {
            cut = false
            for p in ["re :", "re:", "ref :", "ref:", "rép :", "rep:", "tr :", "tr:",
                      "fwd :", "fwd:", "fw :", "fw:"] {
                if s.lowercased().hasPrefix(p) {
                    s = String(s.dropFirst(p.count)).trimmingCharacters(in: .whitespaces)
                    cut = true
                }
            }
        }
        return s.isEmpty ? "votre message" : "votre message au sujet de « \(s) »"
    }

    private static func acknowledge(_ ask: MailAsk, about: String) -> [String] {
        switch ask {
        case .payment:
            return ["J'ai bien reçu \(about) et j'en prends connaissance.",
                    "Je reviens vers vous dès que j'ai procédé aux vérifications nécessaires."]
        case .appointment:
            return ["J'ai bien reçu \(about).",
                    "Je vous confirme ma disponibilité et reste à votre écoute pour arrêter un créneau."]
        case .confirm:
            return ["J'ai bien reçu \(about) et je vous en confirme la bonne réception."]
        case .document:
            return ["J'ai bien reçu \(about).",
                    "Je vous fais parvenir les éléments demandés dans les meilleurs délais."]
        case .question, .plain:
            return ["J'ai bien reçu \(about) et je vous en remercie.",
                    "Je reviens vers vous rapidement."]
        }
    }

    /// Votre phrase d'attaque, quand BUD en connaît une, avec l'objet du
    /// message greffé dedans.
    ///
    /// C'est là que l'apprentissage sert vraiment. Si vous écrivez
    /// systématiquement « Je fais suite à votre message. », la réponse
    /// proposée commence par cette phrase-là — la vôtre — et non par une
    /// formule que BUD aurait choisie. L'objet s'y glisse à la place de
    /// « votre message », ce qui donne « Je fais suite à votre message au
    /// sujet de « Facture novembre ». »
    static func lead(_ style: ReplyStyle, about: String) -> String {
        guard let own = style.best(.lead) else { return "Je fais suite à \(about)." }
        guard about != "votre message",
              let r = own.range(of: "votre message") else { return own }
        return own.replacingCharacters(in: r, with: about)
    }

    private static func substantive(_ ask: MailAsk, about: String, who: String,
                                    style: ReplyStyle) -> [String] {
        let party = who.isEmpty ? "" : " auprès de \(who)"
        let opener = lead(style, about: about)
        switch ask {
        case .payment:
            return [opener,
                    "Après vérification, le règlement sera effectué dans les délais indiqués.",
                    "Si un élément manque à mon dossier\(party), merci de me le préciser."]
        case .appointment:
            return [opener,
                    "Le créneau proposé me convient. À défaut, je suis disponible en fin de journée."]
        case .confirm:
            return [opener,
                    "Je vous confirme mon accord sur les éléments que vous m'avez transmis."]
        case .document:
            return [opener,
                    "Vous trouverez les pièces demandées en réponse à ce message."]
        case .question:
            return [opener,
                    "Voici les éléments de réponse :",
                    placeholder]
        case .plain:
            return [opener,
                    placeholder]
        }
    }

    private static func delay(_ ask: MailAsk, about: String) -> [String] {
        let what: String
        switch ask {
        case .payment:   what = "le règlement"
        case .document:  what = "la transmission des pièces"
        case .confirm:   what = "ma confirmation"
        default:         what = "ma réponse complète"
        }
        return ["J'ai bien reçu \(about).",
                "Pourriez-vous m'accorder un délai supplémentaire pour \(what) ?",
                "Je reviens vers vous au plus tard la semaine prochaine."]
    }
}
EOF_BUDREPLYSTYLE_SWIFT

cat << 'EOF_BUDSCRIPTEXAMPLES_SWIFT' > "$SRC_DIR/BudScriptExamples.swift"
import Foundation

// ═══════════════════════════════════════════════════════════
//  Trois sous-agents d'exemple
//
//  Posés dans ~/Library/Application Support/BUD-Assistant/
//  scripts/ au premier lancement, jamais écrasés ensuite : vos
//  modifications survivent aux mises à jour de BUD.
//
//  Ils sont écrits en Python 3, présent dès que les outils en
//  ligne de commande le sont — ce que BUD exige déjà pour
//  compiler. Ils servent autant d'exemples que d'outils : les
//  copier est la façon la plus courte d'en écrire un quatrième.
//
//  Chacun se teste seul, sans lancer BUD :
//      echo '{"contract":1,"agent":"tidy-downloads"}' | ./run
// ═══════════════════════════════════════════════════════════

extension ScriptAgents {

    /// (dossier, manifeste, exécutable)
    static let examples: [(String, String, String)] = [

        // ─────────────────────────────────────────────────────
        //  1. Les actions en attente, extraites du courrier
        //
        //  Il lit le cache que BUD écrit déjà. Aucun accès au
        //  réseau, aucun identifiant : le travail coûteux est
        //  fait une fois par BUD, les sous-agents le relisent.
        // ─────────────────────────────────────────────────────
        ("mail-actions",
         """
         {
           "title": "Actions en attente",
           "detail": "Relit la boîte déjà relevée et en extrait ce qui demande une réponse, un paiement ou une échéance.",
           "timeout": 15,
           "every": 30,
           "contract": 1
         }
         """,
         #"""
         #!/usr/bin/env python3
         # -*- coding: utf-8 -*-
         """Extrait les actions en attente du cache de courrier de BUD.

         Entrée : le contrat AgentInput sur stdin.
         Sortie : le contrat AgentOutput sur stdout.

         Ne touche ni au réseau ni aux identifiants : BUD a déjà relevé la
         boîte, ce script ne fait que relire ce qu'il a écrit.
         """
         import json, os, re, sys, unicodedata

         def fold(s):
             s = (s or "").lower()
             return "".join(c for c in unicodedata.normalize("NFD", s)
                            if unicodedata.category(c) != "Mn")

         # Chaque règle : (genre, niveau, expressions). L'ordre compte — la
         # première qui correspond l'emporte, et les plus engageantes
         # viennent en premier.
         RULES = [
             ("Paiement",     "action",  [r"\ba regler\b", r"\bmontant du\b", r"\bimpaye\b",
                                          r"\bechec de (?:paiement|prelevement)\b",
                                          r"\bfacture (?:a|en attente)", r"\bpayer avant\b"]),
             ("Échéance",     "action",  [r"\bavant le \d", r"\bd ?ici le \d", r"\bexpire le \d",
                                          r"\bau plus tard\b", r"\bsous \d+ ?(?:h|heures|jours)\b",
                                          r"\bdate limite\b", r"\bderniers? jours?\b"]),
             ("Confirmation", "action",  [r"\bconfirmez\b", r"\bveuillez confirmer\b",
                                          r"\bvalidez votre\b", r"\bconfirmation requise\b"]),
             ("Réponse",      "action",  [r"\bdans l attente de (?:votre|ta) reponse\b",
                                          r"\bpeux-?tu\b", r"\bpourriez-?vous\b",
                                          r"\bmerci de (?:me )?(?:confirmer|repondre|revenir)\b",
                                          r"\brsvp\b", r"\bqu en penses?-?(?:tu|vous)\b"]),
         ]

         def classify(text):
             t = fold(text)
             for kind, level, pats in RULES:
                 for p in pats:
                     if re.search(p, t):
                         return kind, level
             return None, None

         def main():
             try:
                 json.load(sys.stdin)          # on valide l'entrée même sans s'en servir
             except Exception:
                 pass
             support = os.environ.get("BUD_SUPPORT", "")
             cache = os.path.join(support, "inbox-cache.json")
             if not os.path.exists(cache):
                 print(json.dumps({"contract": 1, "ok": True,
                                   "summary": "Aucune boîte relevée pour l'instant.",
                                   "items": []}, ensure_ascii=False))
                 return
             with open(cache, encoding="utf-8") as f:
                 box = json.load(f)

             items = []
             for m in box.get("messages", []):
                 subject = m.get("subject", "")
                 snippet = (m.get("snippet", "") or "")[:600]
                 kind, level = classify(subject + " " + snippet)
                 if not kind:
                     continue
                 sender = m.get("sender", "") or "(inconnu)"
                 score = (m.get("threat") or {}).get("score", 0)

                 # Un message signalé ne devient jamais une tâche. « Confirmez
                 # votre compte » dans un courriel dangereux n'est pas une
                 # action à faire : c'est exactement le piège. On le remonte
                 # en avertissement, pas en liste de choses à faire.
                 if score >= 25:
                     items.append({
                         "title": "Demande suspecte : %s" % subject[:70],
                         "detail": "%s — BUD a relevé un risque (score %d). "
                                   "Ne répondez pas sans vérifier." % (sender[:60], score),
                         "level": "warning", "open": ""})
                 else:
                     items.append({
                         "title": "%s — %s" % (kind, subject[:70]),
                         "detail": sender[:80],
                         "level": level, "open": ""})

             todo = sum(1 for i in items if i["level"] == "action")
             warn = len(items) - todo
             summary = "%d action(s) en attente" % todo
             if warn:
                 summary += ", %d demande(s) suspecte(s)" % warn
             print(json.dumps({"contract": 1, "ok": True, "summary": summary,
                               "items": items[:40]}, ensure_ascii=False))

         if __name__ == "__main__":
             main()
         """#),

        // ─────────────────────────────────────────────────────
        //  2. Le rangement des téléchargements
        //
        //  Par défaut il ne déplace rien : il dit ce qu'il
        //  ferait. Un agent qui range des fichiers tout seul au
        //  premier lancement est un agent qu'on désinstalle.
        // ─────────────────────────────────────────────────────
        ("tidy-downloads",
         """
         {
           "title": "Ranger les téléchargements",
           "detail": "Propose un classement par type des fichiers de Téléchargements. Ne déplace rien sans y être invité.",
           "timeout": 20,
           "every": 0,
           "contract": 1
         }
         """,
         #"""
         #!/usr/bin/env python3
         # -*- coding: utf-8 -*-
         """Classe les téléchargements par type.

         Par défaut, simulation : le script dit ce qu'il ferait. Pour
         exécuter réellement, BUD passe {"payload": {"apply": "yes"}}.

         Un agent qui déplace des fichiers dès son installation est un
         agent qu'on désinstalle : le défaut est donc l'inaction.
         """
         import json, os, shutil, sys

         GROUPS = {
             "Images":    {".png", ".jpg", ".jpeg", ".gif", ".heic", ".webp", ".tiff"},
             "Documents": {".pdf", ".docx", ".pages", ".txt", ".md", ".rtf", ".odt"},
             "Tableurs":  {".xlsx", ".numbers", ".csv", ".tsv"},
             "Archives":  {".zip", ".dmg", ".pkg", ".tar", ".gz", ".7z"},
             "Audio":     {".mp3", ".m4a", ".wav", ".aiff", ".flac"},
             "Vidéo":     {".mp4", ".mov", ".m4v", ".avi", ".mkv"},
         }

         def group_of(name):
             ext = os.path.splitext(name)[1].lower()
             for g, exts in GROUPS.items():
                 if ext in exts:
                     return g
             return None

         def main():
             try:
                 data = json.load(sys.stdin)
             except Exception:
                 data = {}
             apply = (data.get("payload") or {}).get("apply") == "yes"
             dl = os.path.expanduser("~/Downloads")
             if not os.path.isdir(dl):
                 print(json.dumps({"contract": 1, "ok": False,
                                   "error": "Dossier Téléchargements introuvable."}))
                 return

             items, moved = [], 0
             for name in sorted(os.listdir(dl)):
                 if name.startswith("."):
                     continue
                 src = os.path.join(dl, name)
                 if not os.path.isfile(src):
                     continue
                 # Un téléchargement en cours ne se range pas.
                 if name.endswith((".download", ".crdownload", ".part")):
                     continue
                 g = group_of(name)
                 if not g:
                     continue
                 dst_dir = os.path.join(dl, g)
                 dst = os.path.join(dst_dir, name)
                 if apply:
                     os.makedirs(dst_dir, exist_ok=True)
                     # Jamais d'écrasement : on numérote.
                     base, ext = os.path.splitext(name)
                     n = 1
                     while os.path.exists(dst):
                         dst = os.path.join(dst_dir, "%s-%d%s" % (base, n, ext))
                         n += 1
                     shutil.move(src, dst)
                     moved += 1
                     items.append({"title": "Rangé : %s" % name[:60],
                                   "detail": "→ Téléchargements/%s" % g,
                                   "level": "info", "open": dst_dir})
                 else:
                     items.append({"title": name[:60],
                                   "detail": "irait dans Téléchargements/%s" % g,
                                   "level": "info", "open": src})

             if apply:
                 summary = "%d fichier(s) rangé(s)." % moved
             elif items:
                 summary = "%d fichier(s) à ranger. Relancez avec « appliquer »." % len(items)
             else:
                 summary = "Rien à ranger."
             print(json.dumps({"contract": 1, "ok": True, "summary": summary,
                               "items": items[:40]}, ensure_ascii=False))

         if __name__ == "__main__":
             main()
         """#),

        // ─────────────────────────────────────────────────────
        //  3. La veille locale
        //
        //  Ce qu'on vérifierait soi-même de temps en temps et
        //  qu'on oublie toujours.
        // ─────────────────────────────────────────────────────
        ("watch-local",
         """
         {
           "title": "Veille locale",
           "detail": "Disque, corbeille, caches, sauvegardes : ce qu'on vérifierait de temps en temps et qu'on oublie.",
           "timeout": 25,
           "every": 180,
           "contract": 1
         }
         """,
         #"""
         #!/usr/bin/env python3
         # -*- coding: utf-8 -*-
         """Quelques vérifications locales, sans réseau ni privilèges.

         Chaque contrôle est indépendant et protégé : un disque absent ou
         une commande indisponible ne doit pas faire échouer le reste.
         """
         import json, os, shutil, subprocess, sys, time

         def human(n):
             for u in ("o", "Ko", "Mo", "Go", "To"):
                 if n < 1024:
                     return "%.0f %s" % (n, u)
                 n /= 1024.0
             return "%.0f To" % n

         def dir_size(path, cap_seconds=4):
             """Taille d'un dossier, avec une limite de temps : parcourir une
             corbeille de cent mille fichiers ne doit pas tenir l'agent."""
             total, stop = 0, time.time() + cap_seconds
             for root, dirs, files in os.walk(path, onerror=lambda e: None):
                 for f in files:
                     try:
                         total += os.lstat(os.path.join(root, f)).st_size
                     except OSError:
                         pass
                 if time.time() > stop:
                     return total, True
             return total, False

         def main():
             try:
                 json.load(sys.stdin)
             except Exception:
                 pass
             items = []

             # Espace du disque de démarrage
             try:
                 u = shutil.disk_usage("/")
                 pct = u.free * 100 // u.total
                 items.append({
                     "title": "Disque : %s libres (%d %%)" % (human(u.free), pct),
                     "detail": "sur %s" % human(u.total),
                     "level": "warning" if pct <= 10 else "info", "open": ""})
             except Exception:
                 pass

             # Corbeille
             try:
                 trash = os.path.expanduser("~/.Trash")
                 if os.path.isdir(trash):
                     size, partial = dir_size(trash)
                     if size > 512 * 1024 * 1024:
                         items.append({
                             "title": "Corbeille : %s%s" % (human(size), " ou plus" if partial else ""),
                             "detail": "Vider la corbeille libérerait cette place.",
                             "level": "action", "open": trash})
             except Exception:
                 pass

             # Caches utilisateur
             try:
                 caches = os.path.expanduser("~/Library/Caches")
                 if os.path.isdir(caches):
                     size, partial = dir_size(caches)
                     if size > 2 * 1024 ** 3:
                         items.append({
                             "title": "Caches : %s%s" % (human(size), " ou plus" if partial else ""),
                             "detail": "Les applications les reconstruiront au besoin.",
                             "level": "info", "open": caches})
             except Exception:
                 pass

             # Dernière sauvegarde Time Machine
             try:
                 out = subprocess.run(["/usr/bin/tmutil", "latestbackup"],
                                      capture_output=True, text=True, timeout=6)
                 if out.returncode == 0 and out.stdout.strip():
                     items.append({"title": "Dernière sauvegarde Time Machine",
                                   "detail": os.path.basename(out.stdout.strip()),
                                   "level": "info", "open": ""})
                 else:
                     items.append({"title": "Aucune sauvegarde Time Machine",
                                   "detail": "Aucun instantané trouvé sur ce Mac.",
                                   "level": "warning", "open": ""})
             except Exception:
                 pass

             warn = sum(1 for i in items if i["level"] in ("warning", "action"))
             summary = "%d point(s) d'attention" % warn if warn else "Rien à signaler."
             print(json.dumps({"contract": 1, "ok": True, "summary": summary,
                               "items": items}, ensure_ascii=False))

         if __name__ == "__main__":
             main()
         """#),
    ]
}
EOF_BUDSCRIPTEXAMPLES_SWIFT

cat << 'EOF_BUDSCRIPTS_SWIFT' > "$SRC_DIR/BudScripts.swift"
import Cocoa

// ═══════════════════════════════════════════════════════════
//  Sous-agents — le socle
//
//  Un sous-agent est un exécutable posé dans un dossier, qui
//  reçoit du JSON sur son entrée standard et en rend sur sa
//  sortie standard. Rien d'autre.
//
//  Pourquoi des processus et non des greffons chargés dans BUD :
//
//  — Un greffon partage la mémoire de l'application. Un script
//    qui boucle, qui épuise la mémoire ou qui plante emporte
//    BUD avec lui. Un processus séparé, on le tue.
//  — Un greffon impose un langage et une interface binaire. Un
//    processus accepte du shell, du Python, du Swift compilé,
//    n'importe quoi d'exécutable.
//  — Un sous-agent se teste depuis le Terminal, seul, sans
//    lancer BUD : `echo '{}' | ./run`. C'est ce qui rend le
//    système réellement extensible, bien plus que son API.
//
//  Le contrat tient en deux structures, `AgentInput` et
//  `AgentOutput`, et il est versionné.
//
//  ── Sécurité ──
//
//  Exécuter ce qu'on trouve dans un dossier est un pouvoir
//  dangereux. Quatre règles l'encadrent, et aucune n'est
//  décorative :
//
//  1. Les entrées passent par l'entrée standard, jamais par la
//     ligne de commande. Un argument se retrouve dans la table
//     des processus, visible de tout le système, et finit tôt
//     ou tard interpolé dans un shell.
//  2. Le dossier des scripts ne doit être inscriptible que par
//     son propriétaire. Un dossier ouvert en écriture à tous
//     est une élévation de privilège : quiconque peut y écrire
//     fait exécuter son code sous votre compte, par BUD.
//  3. Délai maximal, puis mise à mort. Un script qui ne rend
//     pas la main ne doit pas occuper une ressource
//     indéfiniment.
//  4. Sortie plafonnée. Un script qui écrit sans fin ne doit
//     pas faire gonfler la mémoire de BUD.
// ═══════════════════════════════════════════════════════════

// ───────────────────────────────────────────────────────────
//  Le contrat
// ───────────────────────────────────────────────────────────

/// Le manifeste, lu dans `manifest.json` à côté de l'exécutable.
struct AgentManifest: Codable {
    /// Identifiant : le nom du dossier. Sert de clé partout.
    var name: String = ""
    var title: String = ""
    var detail: String = ""
    /// Délai maximal d'exécution, en secondes.
    var timeout: Double = 20
    /// Période d'exécution automatique, en minutes. 0 = sur demande.
    var every: Int = 0
    /// Version du contrat attendue. BUD refuse ce qu'il ne sait pas lire.
    var contract: Int = 1
}

/// Ce que BUD écrit sur l'entrée standard du sous-agent.
struct AgentInput: Codable {
    var contract = 1
    var agent = ""
    var invokedAt = ""
    /// Le dossier de BUD, pour qu'un script y dépose ses propres fichiers.
    var support = ""
    /// Données libres fournies par l'appelant.
    var payload: [String: String] = [:]
}

/// Une ligne de résultat. C'est l'unité que BUD sait afficher.
struct AgentItem: Codable {
    var title = ""
    var detail = ""
    /// « info », « action » ou « warning ». Tout autre valeur vaut « info ».
    var level = "info"
    /// Chemin de fichier ou adresse à ouvrir au clic. Facultatif.
    var open = ""
}

/// Ce que le sous-agent doit écrire sur sa sortie standard.
struct AgentOutput: Codable {
    var contract = 1
    var ok = true
    var summary = ""
    var items: [AgentItem] = []
    var error: String?

    static func failure(_ why: String) -> AgentOutput {
        AgentOutput(ok: false, summary: "", items: [], error: why)
    }
}

// ───────────────────────────────────────────────────────────
//  Le moteur
// ───────────────────────────────────────────────────────────

final class ScriptAgents {

    static let shared = ScriptAgents()
    private init() {}

    /// 256 Ko de sortie : largement de quoi rendre quelques centaines de
    /// lignes, et pas de quoi faire gonfler BUD si un script s'emballe.
    private let maxOutput = 256 * 1024

    var dir: URL { budSupportDir.appendingPathComponent("scripts") }

    // ── Découverte ──

    /// Les sous-agents installés, triés par titre.
    func discover() -> [AgentManifest] {
        let fm = FileManager.default
        guard let entries = try? fm.contentsOfDirectory(at: dir,
                                                        includingPropertiesForKeys: nil) else {
            return []
        }
        var out: [AgentManifest] = []
        for folder in entries {
            var isDir: ObjCBool = false
            guard fm.fileExists(atPath: folder.path, isDirectory: &isDir), isDir.boolValue else { continue }
            let mf = folder.appendingPathComponent("manifest.json")
            guard let d = try? Data(contentsOf: mf),
                  var m = try? JSONDecoder().decode(AgentManifest.self, from: d) else { continue }
            // Le nom du dossier fait foi : un manifeste qui s'en écarte
            // pourrait désigner l'exécutable d'un autre agent.
            m.name = folder.lastPathComponent
            guard m.contract == 1 else { continue }
            if m.title.isEmpty { m.title = m.name }
            out.append(m)
        }
        return out.sorted { $0.title.localizedCaseInsensitiveCompare($1.title) == .orderedAscending }
    }

    // ── Vérifications avant exécution ──

    /// Tout ce qu'il faut vérifier avant d'exécuter quoi que ce soit.
    /// Le verdict de la vérification. Un `Result` aurait demandé un type
    /// d'erreur conforme à `Error` : ici la raison est une phrase destinée
    /// à l'utilisateur, pas une erreur à propager, et une énumération le
    /// dit plus franchement.
    private enum Prepared {
        case ready(URL, AgentManifest)
        case refused(String)
    }

    private func prepare(_ name: String) -> Prepared {
        // Un nom d'agent ne sert qu'à nommer un dossier : tout ce qui
        // pourrait remonter l'arborescence est écarté avant toute chose.
        guard !name.isEmpty, !name.contains("/"), !name.contains(".."),
              name.range(of: "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
                         options: .regularExpression) != nil else {
            return .refused("Nom de sous-agent refusé : « \(name) ».")
        }
        guard let m = discover().first(where: { $0.name == name }) else {
            return .refused("Sous-agent « \(name) » introuvable.")
        }
        let folder = dir.appendingPathComponent(name)
        let exe = folder.appendingPathComponent("run")

        let fm = FileManager.default
        guard fm.isExecutableFile(atPath: exe.path) else {
            return .refused("« \(name)/run » n'existe pas ou n'est pas exécutable.")
        }

        // Le dossier ne doit être inscriptible que par son propriétaire.
        // Sinon n'importe quel processus y déposerait un script que BUD
        // exécuterait sous votre compte.
        if let attrs = try? fm.attributesOfItem(atPath: folder.path),
           let perm = attrs[.posixPermissions] as? NSNumber {
            let p = perm.uint16Value
            if p & 0o022 != 0 {
                return .refused("« \(name) » est inscriptible par d'autres comptes : "
                    + "BUD ne l'exécutera pas. Corrigez avec chmod 755.")
            }
        }
        return .ready(exe, m)
    }

    // ── Exécution ──

    /// Exécute un sous-agent hors du fil principal et rend son résultat
    /// sur le fil principal. L'interface n'est jamais bloquée, quel que
    /// soit le temps que prend le script.
    func run(_ name: String, payload: [String: String] = [:],
             done: @escaping (AgentOutput) -> Void) {
        let exe: URL
        let manifest: AgentManifest
        switch prepare(name) {
        case .refused(let why):
            DispatchQueue.main.async { done(.failure(why)) }
            return
        case .ready(let e, let m):
            exe = e
            manifest = m
        }

        var input = AgentInput()
        input.agent = name
        input.support = budSupportDir.path
        input.payload = payload
        let f = ISO8601DateFormatter()
        input.invokedAt = f.string(from: Date())

        DispatchQueue.global(qos: .utility).async { [weak self] in
            guard let s = self else { return }
            let result = s.execute(exe, manifest: manifest, input: input)
            DispatchQueue.main.async { done(result) }
        }
    }

    private func execute(_ exe: URL, manifest: AgentManifest, input: AgentInput) -> AgentOutput {
        guard let payload = try? JSONEncoder().encode(input) else {
            return .failure("Entrée non encodable.")
        }

        let p = Process()
        p.executableURL = exe
        // Aucun argument. Les données passent par l'entrée standard : un
        // argument serait lisible par tout le système dans la table des
        // processus, et finirait interpolé dans un shell.
        p.arguments = []
        p.currentDirectoryURL = exe.deletingLastPathComponent()
        // Un environnement réduit : le script hérite de quoi tourner, pas
        // de l'ensemble des variables de l'application.
        p.environment = ["PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
                         "HOME": NSHomeDirectory(),
                         "BUD_SUPPORT": budSupportDir.path,
                         "LANG": "fr_FR.UTF-8"]

        let inPipe = Pipe(), outPipe = Pipe(), errPipe = Pipe()
        p.standardInput = inPipe
        p.standardOutput = outPipe
        p.standardError = errPipe

        do { try p.run() } catch {
            return .failure("Lancement impossible : \(error.localizedDescription)")
        }

        // Les trois tuyaux vivent en parallèle. Écrire l'entrée en entier
        // avant de lire la sortie bloquerait dès que le script répond plus
        // vite qu'il ne consomme.
        let g = DispatchGroup()
        let q = DispatchQueue(label: "fr.lahbib.bud.agent", attributes: .concurrent)
        var outData = Data(), errData = Data()
        g.enter(); q.async {
            outData = outPipe.fileHandleForReading.readDataToEndOfFile(); g.leave()
        }
        g.enter(); q.async {
            errData = errPipe.fileHandleForReading.readDataToEndOfFile(); g.leave()
        }
        q.async {
            inPipe.fileHandleForWriting.write(payload)
            try? inPipe.fileHandleForWriting.close()
        }

        // Délai maximal, puis mise à mort. `terminate` envoie SIGTERM, que
        // certains scripts ignorent ; SIGKILL suit, et lui ne s'ignore pas.
        let deadline = DispatchTime.now() + manifest.timeout
        let waiter = DispatchQueue(label: "fr.lahbib.bud.agent.wait")
        var timedOut = false
        let sem = DispatchSemaphore(value: 0)
        waiter.async { p.waitUntilExit(); sem.signal() }
        if sem.wait(timeout: deadline) == .timedOut {
            timedOut = true
            p.terminate()
            if sem.wait(timeout: .now() + 2) == .timedOut {
                kill(p.processIdentifier, SIGKILL)
            }
        }
        g.wait()

        if timedOut {
            return .failure("« \(manifest.name) » n'a pas répondu en "
                + "\(Int(manifest.timeout)) s et a été arrêté.")
        }

        if outData.count > maxOutput {
            return .failure("« \(manifest.name) » a produit plus de 256 Ko : sortie ignorée.")
        }

        guard p.terminationStatus == 0 else {
            let e = String(data: errData.prefix(600), encoding: .utf8)?
                .trimmingCharacters(in: .whitespacesAndNewlines) ?? ""
            return .failure("« \(manifest.name) » a échoué (code \(p.terminationStatus))"
                + (e.isEmpty ? "." : " : \(e)"))
        }

        guard !outData.isEmpty else {
            return .failure("« \(manifest.name) » n'a rien écrit sur sa sortie standard.")
        }
        guard var parsed = try? JSONDecoder().decode(AgentOutput.self, from: outData) else {
            let raw = String(data: outData.prefix(200), encoding: .utf8) ?? ""
            return .failure("« \(manifest.name) » n'a pas rendu de JSON valide : \(raw)")
        }
        // Un script peut dire qu'il a échoué tout en rendant du JSON ; on
        // ne réécrit pas son verdict, on s'assure juste qu'il est lisible.
        if parsed.summary.isEmpty && parsed.ok {
            parsed.summary = "\(parsed.items.count) élément(s)."
        }
        return parsed
    }

    // ── Installation des exemples ──

    /// Pose les sous-agents d'exemple au premier lancement. N'écrase
    /// jamais un fichier existant : vos modifications survivent aux mises
    /// à jour de BUD.
    func installExamples() {
        let fm = FileManager.default
        try? fm.createDirectory(at: dir, withIntermediateDirectories: true,
                                attributes: [.posixPermissions: 0o755])
        for (name, manifest, body) in ScriptAgents.examples {
            let folder = dir.appendingPathComponent(name)
            let exe = folder.appendingPathComponent("run")
            guard !fm.fileExists(atPath: exe.path) else { continue }
            try? fm.createDirectory(at: folder, withIntermediateDirectories: true,
                                    attributes: [.posixPermissions: 0o755])
            try? manifest.write(to: folder.appendingPathComponent("manifest.json"),
                                atomically: true, encoding: .utf8)
            try? body.write(to: exe, atomically: true, encoding: .utf8)
            try? fm.setAttributes([.posixPermissions: 0o755], ofItemAtPath: exe.path)
        }
    }
}
EOF_BUDSCRIPTS_SWIFT

cat << 'EOF_BUDSNIPPETS_SWIFT' > "$SRC_DIR/BudSnippets.swift"
import Cocoa
import Carbon.HIToolbox

// ═══════════════════════════════════════════════════════════
//  Dictée rapide, snippets et notes éclair
//  Persistance : snippets.json + quicknotes.md dans Application Support
// ═══════════════════════════════════════════════════════════

struct Snippet: Codable {
    var title: String
    var body: String
}

final class SnippetStore {
    static let shared = SnippetStore()
    private let url = budSupportDir.appendingPathComponent("snippets.json")
    private(set) var items: [Snippet] = []

    init() { load() }

    func load() {
        if let d = try? Data(contentsOf: url),
           let s = try? JSONDecoder().decode([Snippet].self, from: d) {
            items = s
        } else {
            items = [
                Snippet(title: "Signature", body: "Bien à toi,\nLahbib"),
                Snippet(title: "Disponibilités", body: "Je suis disponible cette semaine, dis-moi ce qui t'arrange."),
                Snippet(title: "Relance douce", body: "Petit rappel au sujet de ma demande précédente, merci d'avance.")
            ]
            save()
        }
    }

    func save() {
        let e = JSONEncoder()
        e.outputFormatting = [.prettyPrinted, .withoutEscapingSlashes]
        if let d = try? e.encode(items) { try? d.write(to: url, options: .atomic) }
    }

    func add(_ s: Snippet) { items.insert(s, at: 0); save() }
    func remove(at i: Int) { guard items.indices.contains(i) else { return }; items.remove(at: i); save() }
    func update(_ i: Int, _ s: Snippet) { guard items.indices.contains(i) else { return }; items[i] = s; save() }
}

/// Journal des captures rapides, en Markdown lisible hors de l'app.
final class QuickNotesStore {
    static let shared = QuickNotesStore()
    let url = budSupportDir.appendingPathComponent("quicknotes.md")

    func append(_ text: String) {
        let f = DateFormatter()
        f.locale = Locale(identifier: "fr_FR")
        f.dateFormat = "yyyy-MM-dd HH:mm"
        let entry = "\n- **\(f.string(from: Date()))** — \(text.replacingOccurrences(of: "\n", with: "  \n  "))\n"
        if let h = try? FileHandle(forWritingTo: url) {
            h.seekToEndOfFile()
            h.write(entry.data(using: .utf8)!)
            try? h.close()
        } else {
            let header = "# Notes rapides BUD\n"
            try? (header + entry).write(to: url, atomically: true, encoding: .utf8)
        }
    }

    func recent(_ n: Int) -> [String] {
        guard let s = try? String(contentsOf: url, encoding: .utf8) else { return [] }
        return s.components(separatedBy: "\n")
            .filter { $0.hasPrefix("- **") }
            .suffix(n).reversed()
            .map { $0.replacingOccurrences(of: "- **", with: "").replacingOccurrences(of: "** — ", with: " · ") }
    }
}

// ── Collage dans l'app active (nécessite l'accès Accessibilité) ──

func accessibilityGranted(prompt: Bool) -> Bool {
    let key = kAXTrustedCheckOptionPrompt.takeUnretainedValue() as String
    return AXIsProcessTrustedWithOptions([key: prompt] as CFDictionary)
}

@discardableResult
func pasteIntoFrontApp() -> Bool {
    guard accessibilityGranted(prompt: false) else { return false }
    guard let src = CGEventSource(stateID: .combinedSessionState) else { return false }
    let v = CGKeyCode(kVK_ANSI_V)
    let down = CGEvent(keyboardEventSource: src, virtualKey: v, keyDown: true)
    let up = CGEvent(keyboardEventSource: src, virtualKey: v, keyDown: false)
    down?.flags = .maskCommand
    up?.flags = .maskCommand
    down?.post(tap: .cghidEventTap)
    up?.post(tap: .cghidEventTap)
    return true
}

/// Tente de déclencher la dictée système (raccourci « appuyer deux fois sur Fn »).
@discardableResult
func triggerSystemDictation() -> Bool {
    guard accessibilityGranted(prompt: true) else { return false }
    guard let src = CGEventSource(stateID: .combinedSessionState) else { return false }
    let fn = CGKeyCode(kVK_Function)
    for _ in 0..<2 {
        CGEvent(keyboardEventSource: src, virtualKey: fn, keyDown: true)?.post(tap: .cghidEventTap)
        CGEvent(keyboardEventSource: src, virtualKey: fn, keyDown: false)?.post(tap: .cghidEventTap)
        usleep(60_000)
    }
    return true
}

// ── Fenêtre de capture rapide ──

final class CaptureWindow: NSPanel, NSTextViewDelegate {
    private var textView: NSTextView!
    private var hintLabel: NSTextField!
    var onSubmit: ((String, CaptureTarget) -> Void)?

    enum CaptureTarget { case clipboard, note, snippet }

    init() {
        let size = NSSize(width: 520, height: 196)
        let sf = (NSScreen.main ?? NSScreen.screens[0]).visibleFrame
        let origin = NSPoint(x: sf.midX - size.width / 2, y: sf.midY - size.height / 2 + 80)
        super.init(contentRect: NSRect(origin: origin, size: size),
                   styleMask: [.borderless, .nonactivatingPanel],
                   backing: .buffered, defer: false)
        isOpaque = false
        backgroundColor = .clear
        hasShadow = true
        level = .modalPanel
        isMovableByWindowBackground = true
        collectionBehavior = [.canJoinAllSpaces, .fullScreenAuxiliary]
        build(size)
    }

    override var canBecomeKey: Bool { true }

    private func build(_ size: NSSize) {
        let host = NSView(frame: NSRect(origin: .zero, size: size))
        host.wantsLayer = true
        contentView = host

        let blur = NSVisualEffectView(frame: host.bounds)
        blur.autoresizingMask = [.width, .height]
        blur.material = .hudWindow
        blur.blendingMode = .behindWindow
        blur.state = .active
        blur.wantsLayer = true
        blur.layer?.cornerRadius = 20
        blur.layer?.masksToBounds = true
        host.addSubview(blur)

        let bg = NSView(frame: host.bounds)
        bg.autoresizingMask = [.width, .height]
        bg.wantsLayer = true
        bg.layer?.cornerRadius = 20
        bg.layer?.backgroundColor = TH.base.withAlphaComponent(TH.glass == 0 ? 1 : 0.55).cgColor
        bg.layer?.borderWidth = 1
        bg.layer?.borderColor = TH.fill(0.12).cgColor
        host.addSubview(bg)

        host.addSubview(mkLabel("Capture rapide", NSRect(x: 22, y: size.height - 36, width: 300, height: 20), 14, .bold))
        hintLabel = mkLabel("⏎ copier · ⇧⏎ note · Échap fermer",
                            NSRect(x: size.width - 262, y: size.height - 34, width: 240, height: 16),
                            10.5, .medium, alpha: 0.4, .right)
        host.addSubview(hintLabel)

        let scroll = NSScrollView(frame: NSRect(x: 20, y: 60, width: size.width - 40, height: size.height - 108))
        scroll.drawsBackground = false
        scroll.borderType = .noBorder
        scroll.hasVerticalScroller = true
        scroll.scrollerStyle = .overlay
        scroll.wantsLayer = true
        scroll.layer?.cornerRadius = 12
        scroll.layer?.masksToBounds = true

        let big: CGFloat = 1_000_000
        let tv = NSTextView(frame: NSRect(x: 0, y: 0, width: size.width - 40, height: size.height - 108))
        tv.minSize = NSSize(width: 0, height: size.height - 108)
        tv.maxSize = NSSize(width: big, height: big)
        tv.isVerticallyResizable = true
        tv.isHorizontallyResizable = false
        tv.autoresizingMask = [.width]
        tv.textContainer?.containerSize = NSSize(width: size.width - 40, height: big)
        tv.textContainer?.widthTracksTextView = true
        tv.drawsBackground = true
        tv.backgroundColor = TH.fill(0.07)
        tv.textColor = TH.text
        tv.insertionPointColor = TH.text
        tv.font = NSFont.systemFont(ofSize: 14)
        tv.isRichText = false
        tv.textContainerInset = NSSize(width: 10, height: 10)
        tv.delegate = self
        scroll.documentView = tv
        textView = tv
        host.addSubview(scroll)

        let bw = (size.width - 52) / 4
        let b1 = GlassButton(frame: NSRect(x: 20, y: 16, width: bw, height: 34),
                             title: "Copier", icon: "doc.on.doc.fill", prominent: true, compact: true)
        b1.onClick = { [weak self] _ in self?.submit(.clipboard) }
        let b2 = GlassButton(frame: NSRect(x: 24 + bw, y: 16, width: bw, height: 34),
                             title: "Note", icon: "note.text", compact: true)
        b2.onClick = { [weak self] _ in self?.submit(.note) }
        let b3 = GlassButton(frame: NSRect(x: 28 + bw * 2, y: 16, width: bw, height: 34),
                             title: "Snippet", icon: "text.badge.plus", compact: true)
        b3.onClick = { [weak self] _ in self?.submit(.snippet) }
        let b4 = GlassButton(frame: NSRect(x: 32 + bw * 3, y: 16, width: bw, height: 34),
                             title: "Dicter", icon: "mic.fill", compact: true)
        b4.onClick = { [weak self] _ in self?.dictate() }
        [b1, b2, b3, b4].forEach { host.addSubview($0) }
    }

    func present() {
        textView.string = ""
        makeKeyAndOrderFront(nil)
        NSApp.activate(ignoringOtherApps: true)
        makeFirstResponder(textView)
    }

    private func dictate() {
        makeFirstResponder(textView)
        if !triggerSystemDictation() {
            hintLabel.stringValue = "Autorise BUD dans Confidentialité → Accessibilité"
        } else {
            hintLabel.stringValue = "Parle… (ou appuie deux fois sur Fn)"
        }
    }

    private func submit(_ target: CaptureTarget) {
        let t = textView.string.trimmingCharacters(in: .whitespacesAndNewlines)
        orderOut(nil)
        guard !t.isEmpty else { return }
        onSubmit?(t, target)
    }

    override func cancelOperation(_ sender: Any?) { orderOut(nil) }

    func textView(_ tv: NSTextView, doCommandBy sel: Selector) -> Bool {
        if sel == #selector(NSResponder.insertNewline(_:)) {
            submit(NSEvent.modifierFlags.contains(.shift) ? .note : .clipboard)
            return true
        }
        if sel == #selector(NSResponder.cancelOperation(_:)) {
            orderOut(nil)
            return true
        }
        return false
    }
}

/// Panneau Dictée & snippets.
final class SnippetsPanelView: NSView {
    private let hero: HeroHeader
    private var rows: [NSView] = []
    private let listHost = NSView(frame: .zero)
    private let scroll = NSScrollView(frame: .zero)
    private var statusLabel: NSTextField!

    var onStatus: ((String) -> Void)?
    var onCapture: (() -> Void)?

    override init(frame: NSRect) {
        hero = HeroHeader(frame: NSRect(x: 0, y: frame.height - 92, width: frame.width, height: 92),
                          title: "Dictée & snippets",
                          subtitle: "⌘⌥D ouvre la capture, où que vous soyez.")
        super.init(frame: frame)
        build()
    }
    required init?(coder: NSCoder) { fatalError() }

    private func build() {
        let W = bounds.width, H = bounds.height
        addSubview(hero)

        let bCap = GlassButton(frame: NSRect(x: 0, y: H - 148, width: W * 0.54 - 6, height: 44),
                               title: "Capture rapide  ⌘⌥D", icon: "mic.fill", prominent: true)
        bCap.onClick = { [weak self] _ in self?.onCapture?() }
        let bNew = GlassButton(frame: NSRect(x: W * 0.54 + 6, y: H - 148, width: W * 0.46 - 6, height: 44),
                               title: "Nouveau snippet", icon: "plus")
        bNew.onClick = { [weak self] _ in self?.editSnippet(nil) }
        [bCap, bNew].forEach { addSubview($0) }

        mkSection(self, H - 174, W, "Snippets enregistrés")

        scroll.frame = NSRect(x: 0, y: 44, width: W, height: H - 226)
        scroll.hasVerticalScroller = true
        scroll.scrollerStyle = .overlay
        scroll.drawsBackground = false
        scroll.borderType = .noBorder
        scroll.autohidesScrollers = true
        scroll.documentView = listHost
        addSubview(scroll)

        statusLabel = mkLabel("Un clic copie le snippet dans le presse-papiers.",
                              NSRect(x: 0, y: 8, width: W, height: 18), 11, .regular, alpha: 0.4, .center)
        addSubview(statusLabel)
    }

    func setStatus(_ s: String) { statusLabel.stringValue = s }

    func refresh() {
        rows.forEach { $0.removeFromSuperview() }
        rows.removeAll()
        ThemeRegistry.shared.prune()

        let items = SnippetStore.shared.items
        hero.set(trailing: items.isEmpty ? "" : "\(items.count) snippets")

        let W = scroll.bounds.width - 6
        let rowH: CGFloat = 62
        let totalH = max(scroll.bounds.height, CGFloat(items.count) * rowH)
        listHost.frame = NSRect(x: 0, y: 0, width: W, height: totalH)

        for (i, s) in items.enumerated() {
            let y = totalH - CGFloat(i + 1) * rowH + 6
            let row = mkCard(listHost, NSRect(x: 0, y: y, width: W, height: rowH - 10), radius: 12)
            rows.append(row)
            let rh = row.bounds.height

            mkIcon(row, "text.quote", x: 14, y: rh - 28, size: 13, alpha: 0.55)
            row.addSubview(mkFitLabel(s.title, x: 38, y: rh - 28, 12.5, .semibold))

            let preview = s.body.replacingOccurrences(of: "\n", with: " · ")
            let prev = mkLabel(String(preview.prefix(90)), NSRect(x: 38, y: 8, width: W - 200, height: 15),
                               10.5, .regular, alpha: 0.42)
            row.addSubview(prev)

            let copy = GlassButton(frame: NSRect(x: W - 190, y: 10, width: 76, height: 32),
                                   title: "Copier", compact: true)
            copy.idx = i
            copy.onClick = { [weak self] b in self?.copySnippet(b.idx) }
            let edit = GlassButton(frame: NSRect(x: W - 108, y: 10, width: 54, height: 32),
                                   title: "", icon: "pencil", compact: true)
            edit.idx = i
            edit.onClick = { [weak self] b in self?.editSnippet(b.idx) }
            let del = GlassButton(frame: NSRect(x: W - 48, y: 10, width: 44, height: 32),
                                  title: "", icon: "trash", compact: true)
            del.destructive = true
            del.idx = i
            del.onClick = { [weak self] b in
                SnippetStore.shared.remove(at: b.idx)
                self?.refresh()
            }
            [copy, edit, del].forEach { row.addSubview($0) }
        }
    }

    private func copySnippet(_ i: Int) {
        guard SnippetStore.shared.items.indices.contains(i) else { return }
        let s = SnippetStore.shared.items[i]
        NSPasteboard.general.clearContents()
        NSPasteboard.general.setString(s.body, forType: .string)
        onStatus?("« \(s.title) » copié dans le presse-papiers")
    }

    private func editSnippet(_ i: Int?) {
        let existing = i.flatMap { SnippetStore.shared.items.indices.contains($0) ? SnippetStore.shared.items[$0] : nil }
        let a = NSAlert()
        a.messageText = existing == nil ? "Nouveau snippet" : "Modifier le snippet"
        a.informativeText = "Un titre court, puis le contenu à coller."
        a.addButton(withTitle: "Enregistrer")
        a.addButton(withTitle: "Annuler")

        let container = NSView(frame: NSRect(x: 0, y: 0, width: 380, height: 140))
        let titleField = NSTextField(frame: NSRect(x: 0, y: 110, width: 380, height: 24))
        titleField.placeholderString = "Titre"
        titleField.stringValue = existing?.title ?? ""
        container.addSubview(titleField)

        let sc = NSScrollView(frame: NSRect(x: 0, y: 0, width: 380, height: 100))
        sc.hasVerticalScroller = true
        sc.borderType = .bezelBorder
        let tv = NSTextView(frame: NSRect(x: 0, y: 0, width: 380, height: 100))
        tv.isRichText = false
        tv.font = NSFont.systemFont(ofSize: 12.5)
        tv.string = existing?.body ?? ""
        sc.documentView = tv
        container.addSubview(sc)
        a.accessoryView = container

        NSApp.activate(ignoringOtherApps: true)
        guard a.runModal() == .alertFirstButtonReturn else { return }
        let title = titleField.stringValue.trimmingCharacters(in: .whitespacesAndNewlines)
        let body = tv.string
        guard !title.isEmpty || !body.isEmpty else { return }
        let s = Snippet(title: title.isEmpty ? String(body.prefix(24)) : title, body: body)
        if let idx = i { SnippetStore.shared.update(idx, s) } else { SnippetStore.shared.add(s) }
        refresh()
    }
}
